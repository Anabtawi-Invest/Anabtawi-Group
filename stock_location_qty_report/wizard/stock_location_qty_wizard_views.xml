<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_stock_location_qty_wizard_form" model="ir.ui.view">
        <field name="name">stock.location.qty.wizard.form</field>
        <field name="model">stock.location.qty.wizard</field>
        <field name="arch" type="xml">
            <form string="Stock Location Quantity Report">
                <group>
                    <group string="Incoming / Outgoing Mode">
                        <field name="qty_mode" widget="radio"/>
                        <field name="date_from" invisible="qty_mode != 'done'"/>
                        <field name="date_to" invisible="qty_mode != 'done'"/>
                    </group>
                    <group string="Options">
                        <field name="include_child_locations"/>
                        <field name="hide_zero_lines"/>
                    </group>
                </group>
                <group>
                    <group string="Locations">
                        <field name="all_locations"/>
                        <field name="location_ids"
                               widget="many2many_tags"
                               invisible="all_locations"
                               required="not all_locations"
                               options="{'no_create': True}"/>
                    </group>
                    <group string="Products">
                        <field name="all_products"/>
                        <field name="product_ids"
                               widget="many2many_tags"
                               invisible="all_products"
                               required="not all_products"
                               options="{'no_create': True}"/>
                    </group>
                </group>
                <footer>
                    <button name="action_generate_report"
                            type="object"
                            string="View Report"
                            class="btn-primary"/>
                    <button name="action_export_excel"
                            type="object"
                            string="Export Excel"
                            class="btn-secondary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_stock_location_qty_wizard" model="ir.actions.act_window">
        <field name="name">Stock Location Quantity Report</field>
        <field name="res_model">stock.location.qty.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_stock_location_qty_report"
              name="Stock Location Quantity Report"
              parent="stock.menu_warehouse_report"
              action="action_stock_location_qty_wizard"
              sequence="45"/>

</odoo>
