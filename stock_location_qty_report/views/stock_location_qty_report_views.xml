<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_stock_location_qty_report_line_list" model="ir.ui.view">
        <field name="name">stock.location.qty.report.line.list</field>
        <field name="model">stock.location.qty.report.line</field>
        <field name="arch" type="xml">
            <list string="Stock Location Quantity Report" create="false" edit="false" delete="false">
                <field name="qty_mode" optional="hide"/>
                <field name="location_name"/>
                <field name="location_id" column_invisible="True"/>
                <field name="default_code" optional="show"/>
                <field name="product_id"/>
                <field name="uom_name"/>
                <field name="uom_id" column_invisible="True"/>
                <field name="qty_on_hand" sum="Total On Hand"/>
                <field name="qty_incoming" sum="Total Incoming"/>
                <field name="qty_outgoing" sum="Total Outgoing"/>
                <field name="qty_forecast" sum="Total Forecast"/>
            </list>
        </field>
    </record>

    <record id="view_stock_location_qty_report_line_pivot" model="ir.ui.view">
        <field name="name">stock.location.qty.report.line.pivot</field>
        <field name="model">stock.location.qty.report.line</field>
        <field name="arch" type="xml">
            <pivot string="Stock Location Quantity Report">
                <field name="location_id" type="row"/>
                <field name="product_id" type="row"/>
                <field name="qty_on_hand" type="measure"/>
                <field name="qty_incoming" type="measure"/>
                <field name="qty_outgoing" type="measure"/>
                <field name="qty_forecast" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_stock_location_qty_report_line_search" model="ir.ui.view">
        <field name="name">stock.location.qty.report.line.search</field>
        <field name="model">stock.location.qty.report.line</field>
        <field name="arch" type="xml">
            <search string="Stock Location Quantity Report">
                <field name="product_id"
                       string="Product"
                       filter_domain="['|', '|',
                           ('product_id.default_code', 'ilike', self),
                           ('product_id.barcode', 'ilike', self),
                           ('product_id.name', 'ilike', self)]"/>
                <field name="location_id" string="Location"/>
                <field name="location_name" string="Location Name"/>
                <field name="default_code" string="Internal Reference"/>
                <separator/>
                <filter string="With On Hand"
                        name="with_on_hand"
                        domain="[('qty_on_hand', '!=', 0)]"/>
                <filter string="With Incoming"
                        name="with_incoming"
                        domain="[('qty_incoming', '!=', 0)]"/>
                <filter string="With Outgoing"
                        name="with_outgoing"
                        domain="[('qty_outgoing', '!=', 0)]"/>
                <separator/>
                <group>
                    <filter string="Location" name="group_by_location" context="{'group_by': 'location_id'}"/>
                    <filter string="Product" name="group_by_product" context="{'group_by': 'product_id'}"/>
                </group>
            </search>
        </field>
    </record>

</odoo>
