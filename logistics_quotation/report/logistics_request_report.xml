<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Report Action -->
    <record id="action_report_logistics_request" model="ir.actions.report">
        <field name="name">Freight Quotation Request (RFQ)</field>
        <field name="model">logistics.request</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">logistics_quotation.report_logistics_request_template</field>
        <field name="report_file">logistics_quotation.report_logistics_request_template</field>
        <field name="print_report_name">'Freight_RFQ_%s' % (object.name.replace('/', '_'))</field>
        <field name="binding_model_id" ref="model_logistics_request"/>
        <field name="binding_type">report</field>
    </record>

    <!-- QWeb PDF Template -->
    <template id="report_logistics_request_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page">
                        <div class="oe_structure"/>

                        <h2 class="mt-4 mb-4">
                            <span>Freight Quotation Request (RFQ)</span>
                            <br/>
                            <small class="text-muted" t-field="doc.name"/>
                        </h2>

                        <div class="row mt-4 mb-4">
                            <div class="col-6">
                                <strong>Origin / Source Reference:</strong>
                                <p t-if="doc.source_type == 'sale' and doc.sale_order_id" t-field="doc.sale_order_id.name"/>
                                <p t-if="doc.source_type == 'purchase' and doc.purchase_order_id" t-field="doc.purchase_order_id.name"/>
                                <p t-if="not doc.sale_order_id and not doc.purchase_order_id">Standalone Freight Inquiry</p>

                                <strong>Shipping Mode:</strong>
                                <p t-field="doc.shipping_mode"/>

                                <strong>Environment Control:</strong>
                                <p t-field="doc.shipment_type"/>
                            </div>
                            <div class="col-6">
                                <strong>Container / Cargo Spec:</strong>
                                <p t-field="doc.container_size"/>

                                <strong>Destination / Delivery Address:</strong>
                                <p t-field="doc.destination_address"/>
                            </div>
                        </div>

                        <h4 class="mt-4 mb-3">Cargo Packaging &amp; Item Specifications</h4>
                        <table class="table table-sm table-bordered">
                            <thead class="table-light">
                                <tr>
                                    <th>#</th>
                                    <th>Description / Packaging Spec</th>
                                    <th class="text-end">Quantity</th>
                                    <th class="text-center">UoM</th>
                                    <th class="text-end">Gross Weight (kg)</th>
                                    <th class="text-end">Volume (m³)</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-set="idx" t-value="1"/>
                                <t t-foreach="doc.item_ids" t-as="item">
                                    <tr>
                                        <td><t t-esc="idx"/></td>
                                        <td><span t-field="item.name"/></td>
                                        <td class="text-end"><span t-field="item.quantity"/></td>
                                        <td class="text-center"><span t-field="item.product_uom_id.name"/></td>
                                        <td class="text-end"><span t-field="item.weight"/></td>
                                        <td class="text-end"><span t-field="item.volume"/></td>
                                    </tr>
                                    <t t-set="idx" t-value="idx + 1"/>
                                </t>
                            </tbody>
                        </table>

                        <div class="row mt-3">
                            <div class="col-6 offset-6">
                                <table class="table table-sm text-end">
                                    <tr>
                                        <td><strong>Total Gross Weight:</strong></td>
                                        <td><span t-field="doc.total_weight"/> kg</td>
                                    </tr>
                                    <tr>
                                        <td><strong>Total Volume:</strong></td>
                                        <td><span t-field="doc.total_volume"/> m³ (CBM)</td>
                                    </tr>
                                </table>
                            </div>
                        </div>

                        <div class="mt-4" t-if="doc.package_details">
                            <strong>Special Handling / Package Notes:</strong>
                            <p t-field="doc.package_details"/>
                        </div>

                        <div class="oe_structure"/>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
