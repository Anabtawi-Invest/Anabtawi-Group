<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Email Template for Freight RFQ -->
        <record id="email_template_logistics_rfq" model="mail.template">
            <field name="name">Logistics: Send Freight RFQ to Forwarder</field>
            <field name="model_id" ref="model_logistics_request"/>
            <field name="subject">Freight Quotation Request: {{ object.name }} - {{ (object.shipping_mode or '').upper() }} Cargo</field>
            <field name="email_from">{{ object.company_id.email_formatted or user.email_formatted }}</field>
            <field name="report_template_ids" eval="[(4, ref('action_report_logistics_request'))]"/>
            <field name="description">Template sent to freight forwarders with RFQ details and PDF attachment</field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px; font-family: Arial, sans-serif; font-size: 14px; color: #333333;">
                    <p style="margin: 0px; padding: 0px;">
                        Dear Freight Forwarder,
                        <br/><br/>
                        Please find attached our <strong>Freight Quotation Request (RFQ <t t-out="object.name or ''"/>)</strong> for your review and bidding.
                        <br/><br/>
                        <strong><u>Cargo &amp; Logistics Summary:</u></strong>
                        <ul>
                            <li><strong>Request Reference:</strong> <t t-out="object.name or ''"/></li>
                            <li><strong>Shipping Mode:</strong> <t t-out="object.shipping_mode or ''"/></li>
                            <li><strong>Environment Control:</strong> <t t-out="object.shipment_type or ''"/></li>
                            <li><strong>Container / Package Spec:</strong> <t t-out="object.container_size or ''"/></li>
                            <li><strong>Total Gross Weight:</strong> <t t-out="object.total_weight or 0"/> kg</li>
                            <li><strong>Total CBM Volume:</strong> <t t-out="object.total_volume or 0"/> m³</li>
                            <li><strong>Destination Address:</strong> <t t-out="object.destination_address or 'As per attached document'"/></li>
                        </ul>
                        <br/>
                        <div style="margin: 20px 0px; text-align: center;">
                            <a t-att-href="ctx.get('custom_token_url')" style="background-color: #875A7B; padding: 12px 24px; text-decoration: none; color: #ffffff; border-radius: 6px; font-weight: bold; display: inline-block;">
                                📤 Submit Your Quotation Online
                            </a>
                        </div>
                        <br/>
                        You may click the button above to upload your quote PDF, prices, and transit days directly into our system portal.
                        <br/><br/>
                        Best regards,
                        <br/>
                        <strong><t t-out="user.name or ''"/></strong><br/>
                        <t t-out="object.company_id.name or ''"/>
                    </p>
                </div>
            </field>
            <field name="auto_delete" eval="False"/>
        </record>
    </data>
</odoo>
