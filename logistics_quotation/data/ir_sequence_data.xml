<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Sequence for Logistics Requests -->
        <record id="seq_logistics_request" model="ir.sequence">
            <field name="name">Logistics Request</field>
            <field name="code">logistics.request</field>
            <field name="prefix">LQR/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
