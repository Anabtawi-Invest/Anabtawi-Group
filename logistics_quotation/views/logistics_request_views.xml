<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Logistics Request List View -->
    <record id="view_logistics_request_tree" model="ir.ui.view">
        <field name="name">logistics.request.list</field>
        <field name="model">logistics.request</field>
        <field name="arch" type="xml">
            <list string="Logistics Requests">
                <field name="name"/>
                <field name="source_type"/>
                <field name="incoterm_id"/>
                <field name="sale_order_id" optional="show"/>
                <field name="purchase_order_id" optional="show"/>
                <field name="shipping_mode"/>
                <field name="shipment_type"/>
                <field name="container_size"/>
                <field name="invitation_count" string="Invited Forwarders"/>
                <field name="submitted_count" string="Responded"/>
                <field name="selected_line_id"/>
                <field name="approval_state" widget="badge" decoration-warning="approval_state == 'pending'" decoration-success="approval_state == 'approved'" decoration-danger="approval_state == 'rejected'" optional="show"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="state" widget="badge" decoration-info="state == 'rfq'" decoration-warning="state == 'quoted'" decoration-success="state == 'confirmed'" decoration-muted="state == 'cancelled'"/>
            </list>
        </field>
    </record>

    <!-- Logistics Request Form View -->
    <record id="view_logistics_request_form" model="ir.ui.view">
        <field name="name">logistics.request.form</field>
        <field name="model">logistics.request</field>
        <field name="arch" type="xml">
            <form string="Logistics Request">
                <header>
                    <button name="action_broadcast_rfq" string="🚀 Broadcast RFQ to Approved Forwarders" type="object" class="btn-primary" invisible="state not in ('draft', 'rfq')"/>
                    <button name="action_send_rfq_email" string="Send Manual RFQ Email" type="object" class="btn-secondary" invisible="state not in ('draft', 'rfq')"/>
                    <button name="action_print_rfq" string="Download RFQ (PDF)" type="object" class="btn-secondary" icon="fa-download"/>
                    
                    <button name="action_approve_logistics" string="✓ Approve Quotation" type="object" class="btn-success" invisible="approval_state != 'pending'"/>
                    <button name="action_reject_logistics" string="✗ Reject Quotation" type="object" class="btn-danger" invisible="approval_state != 'pending'"/>

                    <button name="action_confirm_logistics" string="Confirm Logistics Order" type="object" class="oe_highlight" invisible="state not in ('quoted', 'rfq', 'draft')"/>
                    <button name="action_reset_draft" string="Reset to Draft" type="object" class="btn-secondary" invisible="state not in ('cancelled')"/>
                    <button name="action_cancel" string="Cancel" type="object" class="btn-secondary" invisible="state in ('confirmed', 'cancelled')"/>
                    
                    <field name="state" widget="statusbar" statusbar_visible="draft,rfq,quoted,confirmed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_po" type="object" class="oe_stat_button" icon="fa-shopping-cart" invisible="not generated_po_id">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Forwarder PO</span>
                            </div>
                        </button>
                        <button type="object" name="action_broadcast_rfq" class="oe_stat_button" icon="fa-paper-plane">
                            <div class="o_stat_info">
                                <span class="o_stat_value"><field name="invitation_count"/></span>
                                <span class="o_stat_text">Invited</span>
                            </div>
                        </button>
                        <button type="object" name="action_broadcast_rfq" class="oe_stat_button" icon="fa-check-square-o">
                            <div class="o_stat_info">
                                <span class="o_stat_value"><field name="submitted_count"/></span>
                                <span class="o_stat_text">Responded</span>
                            </div>
                        </button>
                    </div>
                    
                    <div class="alert alert-warning mb-3" role="alert" invisible="approval_state != 'pending'">
                        ⚠️ <strong>Manager Approval Required:</strong> The selected freight quotation exceeds the threshold limit. Please review and approve before confirming the order.
                    </div>
                    
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Origin &amp; Request Info">
                            <field name="source_type" widget="radio" options="{'horizontal': true}"/>
                            <field name="sale_order_id" invisible="source_type != 'sale'" required="source_type == 'sale'"/>
                            <field name="purchase_order_id" invisible="source_type != 'purchase'" required="source_type == 'purchase'"/>
                            <field name="incoterm_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group string="Shipping Specifications">
                            <field name="shipping_mode"/>
                            <field name="shipment_type"/>
                            <field name="container_size"/>
                            <field name="temperature_control_notes"/>
                        </group>
                    </group>
                    <group>
                        <group string="Compliance &amp; Insurance">
                            <field name="cargo_insurance_required"/>
                            <field name="is_hazardous"/>
                        </group>
                        <group string="Calculated Cargo Totals">
                            <field name="total_weight"/>
                            <field name="total_volume"/>
                        </group>
                    </group>
                    <group string="Destination / Shipping Address">
                        <field name="destination_address" nolabel="1" placeholder="Destination port or warehouse address..."/>
                    </group>
                    <group string="Special Package &amp; Cargo Notes">
                        <field name="package_details" nolabel="1" placeholder="Dimensions, gross weight, volume (CBM), special handling notes..."/>
                    </group>
                    <notebook>
                        <page string="📦 Cargo &amp; Item Breakdown (Price Confidential)" name="cargo_items">
                            <field name="item_ids">
                                <list editable="bottom">
                                    <field name="product_id"/>
                                    <field name="name"/>
                                    <field name="quantity"/>
                                    <field name="product_uom_id"/>
                                    <field name="weight"/>
                                    <field name="volume"/>
                                </list>
                            </field>
                        </page>
                        <page string="📊 Live Forwarder Response Tracker" name="invitations">
                            <field name="invitation_ids" readonly="1">
                                <list>
                                    <field name="partner_id"/>
                                    <field name="email"/>
                                    <field name="state" widget="badge" decoration-warning="state == 'pending'" decoration-success="state == 'submitted'" decoration-danger="state == 'declined'"/>
                                    <field name="submitted_date"/>
                                    <field name="quote_line_id"/>
                                </list>
                            </field>
                        </page>
                        <page string="💵 Forwarder Bids &amp; PDF Quotes" name="forwarder_bids">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="partner_id"/>
                                    <field name="currency_id" invisible="1"/>
                                    <field name="origin_handling_fee" widget="monetary"/>
                                    <field name="freight_cost" widget="monetary"/>
                                    <field name="destination_handling_fee" widget="monetary"/>
                                    <field name="customs_clearance_fee" widget="monetary"/>
                                    <field name="price_total" widget="monetary" readonly="1"/>
                                    <field name="transit_time_days"/>
                                    <field name="free_days_port"/>
                                    <field name="quote_filename" invisible="1"/>
                                    <field name="quote_attachment" widget="binary" filename="quote_filename" string="Quote PDF / Scan"/>
                                    <field name="notes"/>
                                </list>
                            </field>
                        </page>
                        <page string="🏆 Winning Quote &amp; PO Creation" name="winning_quote">
                            <group>
                                <field name="selected_line_id" options="{'no_create': True}"/>
                                <field name="requires_approval"/>
                                <field name="approval_state" widget="badge" decoration-warning="approval_state == 'pending'" decoration-success="approval_state == 'approved'" decoration-danger="approval_state == 'rejected'"/>
                                <field name="generated_po_id"/>
                            </group>
                        </page>
                        <page string="🚢 Post-Award Shipment Tracking" name="shipment_tracking">
                            <group>
                                <group string="Carrier &amp; Document Tracking">
                                    <field name="bl_awb_number" placeholder="e.g., MAEU123456789"/>
                                    <field name="container_number" placeholder="e.g., MSCU9876543 / Truck #"/>
                                    <field name="vessel_flight_name" placeholder="e.g., MAERSK MC-KINNEY MOLLER V.2401"/>
                                </group>
                                <group string="Milestone Dates">
                                    <field name="etd_date"/>
                                    <field name="eta_date"/>
                                </group>
                            </group>
                        </page>
                        <page string="Internal Notes" name="notes">
                            <field name="notes" placeholder="Additional internal observations..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Logistics Request Search View -->
    <record id="view_logistics_request_search" model="ir.ui.view">
        <field name="name">logistics.request.search</field>
        <field name="model">logistics.request</field>
        <field name="arch" type="xml">
            <search string="Logistics Requests">
                <field name="name"/>
                <field name="sale_order_id"/>
                <field name="purchase_order_id"/>
                <field name="bl_awb_number"/>
                <field name="container_number"/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="RFQs Sent" name="rfq" domain="[('state', '=', 'rfq')]"/>
                <filter string="Quotes Received" name="quoted" domain="[('state', '=', 'quoted')]"/>
                <filter string="Pending Approval" name="pending_approval" domain="[('approval_state', '=', 'pending')]"/>
                <filter string="Confirmed" name="confirmed" domain="[('state', '=', 'confirmed')]"/>
                <separator/>
                <filter string="Outbound (Sales Export)" name="sales" domain="[('source_type', '=', 'sale')]"/>
                <filter string="Inbound (Purchase Import)" name="purchase" domain="[('source_type', '=', 'purchase')]"/>
                <group>
                    <filter string="Source Type" name="group_source" domain="[]" context="{'group_by': 'source_type'}"/>
                    <filter string="Shipping Mode" name="group_mode" domain="[]" context="{'group_by': 'shipping_mode'}"/>
                    <filter string="Incoterm" name="group_incoterm" domain="[]" context="{'group_by': 'incoterm_id'}"/>
                    <filter string="Status" name="group_state" domain="[]" context="{'group_by': 'state'}"/>
                    <filter string="Approval Status" name="group_approval" domain="[]" context="{'group_by': 'approval_state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action Window for Logistics Request -->
    <record id="action_logistics_request" model="ir.actions.act_window">
        <field name="name">Logistics Requests</field>
        <field name="res_model">logistics.request</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_logistics_request_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new Logistics Quotation Request!
            </p>
            <p>
                Manage forwarder RFQs, compare freight bids, enforce financial approval guardrails, and track post-award shipments seamlessly.
            </p>
        </field>
    </record>

    <!-- Top Level App Menu & Submenu -->
    <menuitem id="menu_logistics_root" name="Logistics" sequence="35" web_icon="logistics_quotation,static/description/icon.png"/>
    <menuitem id="menu_logistics_requests" name="Logistics Requests" parent="menu_logistics_root" action="action_logistics_request" sequence="10"/>

    <!-- Inherit Sales Order Form to add Header Action Button -->
    <record id="view_order_form_inherit_logistics" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.logistics</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_request_shipping_cost" string="Request Shipping Cost" type="object" class="btn-primary" invisible="state in ('done', 'cancel')"/>
            </xpath>
        </field>
    </record>

    <!-- Inherit Purchase Order Form to add Header Action Button -->
    <record id="view_purchase_order_form_inherit_logistics" model="ir.ui.view">
        <field name="name">purchase.order.form.inherit.logistics</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_request_shipping_cost" string="Request Shipping Cost" type="object" class="btn-primary" invisible="state in ('done', 'cancel')"/>
            </xpath>
        </field>
    </record>
</odoo>
