<odoo>
    <record id="seq_construction_budget_po" model="ir.sequence">
        <field name="name">Construction PO Control Reference</field>
        <field name="code">construction.budget.po</field>
        <field name="prefix">CPO/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_construction_budget_receipt" model="ir.sequence">
        <field name="name">Construction Item Receipt Reference</field>
        <field name="code">construction.budget.receipt</field>
        <field name="prefix">REC/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_construction_budget_invoice" model="ir.sequence">
        <field name="name">Construction Vendor Bill Reference</field>
        <field name="code">construction.budget.invoice</field>
        <field name="prefix">INV/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>

