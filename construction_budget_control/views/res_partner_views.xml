<odoo>
    <record id="view_partner_form_inherit_construction" model="ir.ui.view">
        <field name="name">res.partner.form.inherit.construction</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_construction_pos" type="object" class="oe_stat_button" icon="fa-file-text-o" invisible="not is_construction_vendor and po_count == 0">
                    <field name="po_count" widget="statinfo" string="POs"/>
                </button>
                <button name="action_view_construction_receipts" type="object" class="oe_stat_button" icon="fa-truck" invisible="not is_construction_vendor and receipt_count == 0">
                    <field name="receipt_count" widget="statinfo" string="Receipts"/>
                </button>
                <button name="action_view_construction_invoices" type="object" class="oe_stat_button" icon="fa-pencil-square-o" invisible="not is_construction_vendor and invoice_count == 0">
                    <field name="invoice_count" widget="statinfo" string="Bills"/>
                </button>
            </xpath>
            <xpath expr="//field[@name='category_id']" position="after">
                <field name="is_construction_vendor"/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Construction Budget Control" name="construction_budget_tab" invisible="not is_construction_vendor and po_count == 0 and invoice_count == 0 and receipt_count == 0">
                    <notebook>
                        <page string="Purchase Orders" name="construction_pos">
                            <field name="po_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="project_id"/>
                                    <field name="po_number"/>
                                    <field name="po_date"/>
                                    <field name="amount" sum="Total"/>
                                    <field name="delivery_status" widget="badge"/>
                                    <field name="invoice_status" widget="badge"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                        <page string="Item Receipts (Inventory)" name="construction_receipts">
                            <field name="receipt_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="po_id"/>
                                    <field name="project_id"/>
                                    <field name="date"/>
                                    <field name="reference"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                        <page string="Vendor Bills (Invoices)" name="construction_invoices">
                            <field name="invoice_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="vendor_bill_ref"/>
                                    <field name="po_id"/>
                                    <field name="project_id"/>
                                    <field name="date"/>
                                    <field name="due_date"/>
                                    <field name="amount" sum="Total Amount"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </page>
            </xpath>
        </field>
    </record>

    <record id="action_construction_vendor" model="ir.actions.act_window">
        <field name="name">Vendors / Subcontractors</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[('is_construction_vendor', '=', True)]</field>
        <field name="context">{'default_is_construction_vendor': True, 'default_supplier_rank': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first Construction Vendor</p>
            <p>Add vendors and subcontractors specifically for construction budget control.</p>
        </field>
    </record>
</odoo>
