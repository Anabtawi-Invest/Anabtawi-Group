<odoo>
    <record id="view_partner_form_inherit_construction" model="ir.ui.view">
        <field name="name">res.partner.form.inherit.construction</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='category_id']" position="after">
                <field name="is_construction_vendor"/>
            </xpath>
        </field>
    </record>

    <record id="action_construction_vendor" model="ir.actions.act_window">
        <field name="name">Vendors / Subcontractors</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[('is_construction_vendor', '=', True)]</field>
        <field name="context">{'default_is_construction_vendor': True, 'default_supplier_rank': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first Construction Vendor</p>
            <p>Add vendors and subcontractors specifically for construction budget control.</p>
        </field>
    </record>
</odoo>
