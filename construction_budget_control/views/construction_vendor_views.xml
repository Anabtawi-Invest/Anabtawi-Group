<odoo>
    <record id="view_construction_vendor_list" model="ir.ui.view">
        <field name="name">construction.vendor.list</field>
        <field name="model">construction.vendor</field>
        <field name="arch" type="xml">
            <list string="Vendors / Subcontractors">
                <field name="name"/>
                <field name="code"/>
                <field name="phone"/>
                <field name="email"/>
                <field name="city"/>
                <field name="po_count"/>
                <field name="construction_invoice_count"/>
            </list>
        </field>
    </record>

    <record id="view_construction_vendor_form" model="ir.ui.view">
        <field name="name">construction.vendor.form</field>
        <field name="model">construction.vendor</field>
        <field name="arch" type="xml">
            <form string="Construction Vendor / Subcontractor">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_construction_pos" type="object" class="oe_stat_button" icon="fa-file-text-o">
                            <field name="po_count" widget="statinfo" string="POs"/>
                        </button>
                        <button name="action_view_construction_receipts" type="object" class="oe_stat_button" icon="fa-truck">
                            <field name="receipt_count" widget="statinfo" string="Receipts"/>
                        </button>
                        <button name="action_view_construction_invoices" type="object" class="oe_stat_button" icon="fa-pencil-square-o">
                            <field name="construction_invoice_count" widget="statinfo" string="Bills"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="e.g. Acme Construction Supplies / Subcontractor Ltd" required="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Contact Details">
                            <field name="code"/>
                            <field name="phone" widget="phone"/>
                            <field name="mobile" widget="phone"/>
                            <field name="email" widget="email"/>
                            <field name="website" widget="url" placeholder="e.g. https://www.example.com"/>
                            <field name="vat"/>
                        </group>
                        <group string="Address &amp; Company">
                            <span class="o_form_label o_td_label" name="address_name">
                                <b>Site / Office Address</b>
                            </span>
                            <div class="o_address_format">
                                <field name="street" placeholder="Street..." class="o_address_street"/>
                                <field name="street2" placeholder="Street 2..." class="o_address_street"/>
                                <field name="city" placeholder="City" class="o_address_city"/>
                                <field name="state_id" class="o_address_state" placeholder="State" options="{'no_open': True}"/>
                                <field name="zip" placeholder="ZIP" class="o_address_zip"/>
                                <field name="country_id" placeholder="Country" class="o_address_country" options="{'no_open': True}"/>
                            </div>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Construction POs" name="construction_pos">
                            <field name="po_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="project_id"/>
                                    <field name="po_number"/>
                                    <field name="po_date"/>
                                    <field name="amount" sum="Total"/>
                                    <field name="delivery_status" widget="badge"/>
                                    <field name="invoice_status" widget="badge"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                        <page string="Construction Receipts" name="construction_receipts">
                            <field name="receipt_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="po_id"/>
                                    <field name="project_id"/>
                                    <field name="date"/>
                                    <field name="reference"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                        <page string="Construction Vendor Bills" name="construction_invoices">
                            <field name="construction_invoice_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="vendor_bill_ref"/>
                                    <field name="po_id"/>
                                    <field name="project_id"/>
                                    <field name="date"/>
                                    <field name="due_date"/>
                                    <field name="amount" sum="Total Amount"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes &amp; Terms">
                            <field name="notes" placeholder="Vendor terms, payment instructions or additional notes..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_construction_vendor_search" model="ir.ui.view">
        <field name="name">construction.vendor.search</field>
        <field name="model">construction.vendor</field>
        <field name="arch" type="xml">
            <search string="Vendors / Subcontractors">
                <field name="name"/>
                <field name="code"/>
                <field name="phone"/>
                <field name="email"/>
                <field name="city"/>
            </search>
        </field>
    </record>

    <record id="action_construction_vendor" model="ir.actions.act_window">
        <field name="name">Vendors / Subcontractors</field>
        <field name="res_model">construction.vendor</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_construction_vendor_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first Construction Vendor</p>
            <p>Add vendors and subcontractors specifically for construction budget control.</p>
        </field>
    </record>
</odoo>
