<odoo>
    <record id="module_category_construction_budget" model="ir.module.category">
        <field name="name">Construction Budget Control</field>
        <field name="sequence">20</field>
    </record>

    <record id="group_construction_user" model="res.groups">
        <field name="name">Project Handler / Purchase Requester</field>
        <field name="category_id" ref="module_category_construction_budget"/>
    </record>

    <record id="group_construction_accounting_approver" model="res.groups">
        <field name="name">Accounting Manager Approver</field>
        <field name="category_id" ref="module_category_construction_budget"/>
        <field name="implied_ids" eval="[(4, ref('group_construction_user'))]"/>
    </record>

    <record id="group_construction_gm_approver" model="res.groups">
        <field name="name">CEO / General Manager Approver</field>
        <field name="category_id" ref="module_category_construction_budget"/>
        <field name="implied_ids" eval="[(4, ref('group_construction_user'))]"/>
    </record>

    <record id="group_construction_chairman_approver" model="res.groups">
        <field name="name">Chairman Approver</field>
        <field name="category_id" ref="module_category_construction_budget"/>
        <field name="implied_ids" eval="[(4, ref('group_construction_user'))]"/>
    </record>

    <record id="group_construction_manager" model="res.groups">
        <field name="name">Administrator</field>
        <field name="category_id" ref="module_category_construction_budget"/>
        <field name="implied_ids" eval="[(4, ref('group_construction_accounting_approver')),
                                         (4, ref('group_construction_gm_approver')),
                                         (4, ref('group_construction_chairman_approver'))]"/>
    </record>

    <!-- Record rules for Purchase Orders -->
    <record id="construction_po_rule_user" model="ir.rule">
        <field name="name">Construction PO: requester or project manager only</field>
        <field name="model_id" ref="model_construction_budget_po"/>
        <field name="domain_force">['|', ('requested_by', '=', user.id), ('project_id.project_manager_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_construction_user'))]"/>
    </record>

    <record id="construction_po_rule_accounting" model="ir.rule">
        <field name="name">Construction PO: accounting approvers see all</field>
        <field name="model_id" ref="model_construction_budget_po"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_construction_accounting_approver'))]"/>
    </record>

    <record id="construction_po_rule_gm" model="ir.rule">
        <field name="name">Construction PO: GM/CEO approvers see all</field>
        <field name="model_id" ref="model_construction_budget_po"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_construction_gm_approver'))]"/>
    </record>

    <record id="construction_po_rule_chairman" model="ir.rule">
        <field name="name">Construction PO: Chairman approvers see all</field>
        <field name="model_id" ref="model_construction_budget_po"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_construction_chairman_approver'))]"/>
    </record>

    <!-- Record rules for Project Budget Materials -->
    <record id="construction_material_rule_user" model="ir.rule">
        <field name="name">Construction Material: project manager or handler</field>
        <field name="model_id" ref="model_construction_project_budget_material"/>
        <field name="domain_force">['|', ('project_id.project_manager_id', '=', user.id), ('create_uid', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_construction_user'))]"/>
    </record>

    <record id="construction_material_rule_accounting" model="ir.rule">
        <field name="name">Construction Material: accounting approvers see all</field>
        <field name="model_id" ref="model_construction_project_budget_material"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_construction_accounting_approver'))]"/>
    </record>

    <record id="construction_material_rule_gm" model="ir.rule">
        <field name="name">Construction Material: CEO approvers see all</field>
        <field name="model_id" ref="model_construction_project_budget_material"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_construction_gm_approver'))]"/>
    </record>

    <record id="construction_material_rule_chairman" model="ir.rule">
        <field name="name">Construction Material: Chairman approvers see all</field>
        <field name="model_id" ref="model_construction_project_budget_material"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_construction_chairman_approver'))]"/>
    </record>
</odoo>
