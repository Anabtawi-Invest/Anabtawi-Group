<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_ai_reporting" model="ir.module.category">
        <field name="name">AI Reporting</field>
        <field name="sequence">35</field>
    </record>

    <record id="group_ai_reporting_user" model="res.groups">
        <field name="name">AI Reporting User</field>
        <field name="category_id" ref="module_category_ai_reporting"/>
    </record>

    <record id="group_ai_reporting_analyst" model="res.groups">
        <field name="name">AI Reporting Analyst</field>
        <field name="category_id" ref="module_category_ai_reporting"/>
        <field name="implied_ids" eval="[(4, ref('group_ai_reporting_user'))]"/>
    </record>

    <record id="group_ai_reporting_manager" model="res.groups">
        <field name="name">AI Reporting Manager</field>
        <field name="category_id" ref="module_category_ai_reporting"/>
        <field name="implied_ids" eval="[(4, ref('group_ai_reporting_analyst'))]"/>
    </record>

    <record id="group_ai_reporting_administrator" model="res.groups">
        <field name="name">AI Reporting Administrator</field>
        <field name="category_id" ref="module_category_ai_reporting"/>
        <field name="implied_ids" eval="[(4, ref('group_ai_reporting_manager'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>

