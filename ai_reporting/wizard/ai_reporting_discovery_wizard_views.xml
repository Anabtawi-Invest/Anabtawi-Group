<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ai_reporting_discovery_wizard_form" model="ir.ui.view">
        <field name="name">ai.reporting.discovery.wizard.form</field>
        <field name="model">ai.reporting.discovery.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="scan_addons"/>
                    <field name="build_query_templates"/>
                    <field name="result_json" widget="json" readonly="1"/>
                </group>
                <footer>
                    <button name="action_run_discovery" type="object" string="Scan Odoo and Build Queries" class="btn-primary"/>
                    <button string="Close" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_ai_reporting_discovery_wizard" model="ir.actions.act_window">
        <field name="name">Discovery</field>
        <field name="res_model">ai.reporting.discovery.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
