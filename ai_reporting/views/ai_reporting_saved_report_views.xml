<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ai_reporting_saved_report_tree" model="ir.ui.view">
        <field name="name">ai.reporting.saved.report.list</field>
        <field name="model">ai.reporting.saved.report</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="owner_id"/>
                <field name="visibility"/>
                <field name="source_model_name"/>
                <field name="report_type"/>
                <field name="state"/>
                <field name="version"/>
                <field name="last_refresh_date"/>
                <field name="last_record_count"/>
            </list>
        </field>
    </record>

    <record id="view_ai_reporting_saved_report_form" model="ir.ui.view">
        <field name="name">ai.reporting.saved.report.form</field>
        <field name="model">ai.reporting.saved.report</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_run" type="object" string="Run" class="btn-primary" invisible="state != 'active'"/>
                    <button name="action_create_draft_version" type="object" string="Create Draft Version" invisible="state != 'active'"/>
                    <button name="action_archive" type="object" string="Archive" invisible="state == 'archived'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="description"/>
                            <field name="owner_id"/>
                            <field name="company_id"/>
                            <field name="visibility"/>
                        </group>
                        <group>
                            <field name="source_model_name"/>
                            <field name="source_model_ids" widget="many2many_tags"/>
                            <field name="report_type"/>
                            <field name="visualization_type"/>
                            <field name="chart_type"/>
                            <field name="version"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Definition">
                            <field name="report_definition_json" widget="json"/>
                            <field name="parameter_schema_json" widget="json"/>
                        </page>
                        <page string="Query">
                            <field name="domain_json" widget="json"/>
                            <field name="groupby_json" widget="json"/>
                            <field name="measures_json" widget="json"/>
                            <field name="calculated_measures_json" widget="json"/>
                            <field name="order_json" widget="json"/>
                        </page>
                        <page string="Sharing">
                            <field name="shared_user_ids" widget="many2many_tags"/>
                            <field name="shared_group_ids" widget="many2many_tags"/>
                            <field name="share_ids"/>
                        </page>
                        <page string="Execution">
                            <group>
                                <field name="last_refresh_date" readonly="1"/>
                                <field name="last_execution_status" readonly="1"/>
                                <field name="last_execution_time" readonly="1"/>
                                <field name="last_record_count" readonly="1"/>
                            </group>
                        </page>
                        <page string="Confirmation">
                            <group>
                                <field name="confirmed_by" readonly="1"/>
                                <field name="confirmation_date" readonly="1"/>
                                <field name="confirmed_revision" readonly="1"/>
                                <field name="confirmed_definition_hash" readonly="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_ai_reporting_saved_report" model="ir.actions.act_window">
        <field name="name">Advanced Reports</field>
        <field name="res_model">ai.reporting.saved.report</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>

