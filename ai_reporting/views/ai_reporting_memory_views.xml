<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ai_reporting_memory_tree" model="ir.ui.view">
        <field name="name">ai.reporting.memory.list</field>
        <field name="model">ai.reporting.memory</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="memory_type"/>
                <field name="intent_code"/>
                <field name="source_model_name"/>
                <field name="language_code"/>
                <field name="state"/>
                <field name="confidence_score"/>
                <field name="use_count"/>
                <field name="estimated_tokens_saved"/>
                <field name="last_used_at"/>
            </list>
        </field>
    </record>

    <record id="view_ai_reporting_memory_form" model="ir.ui.view">
        <field name="name">ai.reporting.memory.form</field>
        <field name="model">ai.reporting.memory</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_validate" type="object" string="Validate" class="btn-primary" invisible="state not in ('draft', 'rejected')"/>
                    <button name="action_approve" type="object" string="Approve" class="btn-primary" invisible="state not in ('validated', 'draft')"/>
                    <button name="action_disable" type="object" string="Disable" invisible="state == 'disabled'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="memory_type"/>
                            <field name="intent_code"/>
                            <field name="source_model_name"/>
                            <field name="language_code"/>
                            <field name="confidence_score"/>
                        </group>
                        <group>
                            <field name="owner_id"/>
                            <field name="company_id"/>
                            <field name="allowed_company_ids" widget="many2many_tags"/>
                            <field name="visibility"/>
                            <field name="shared_user_ids" widget="many2many_tags"/>
                            <field name="shared_group_ids" widget="many2many_tags"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Question">
                            <group>
                                <field name="normalized_question"/>
                                <field name="question_hash" readonly="1"/>
                                <field name="plan_fingerprint" readonly="1"/>
                            </group>
                        </page>
                        <page string="Plan">
                            <field name="plan_json" widget="json"/>
                            <field name="parameter_schema_json" widget="json"/>
                        </page>
                        <page string="Phrases">
                            <field name="phrase_ids"/>
                        </page>
                        <page string="Usage">
                            <group>
                                <field name="use_count" readonly="1"/>
                                <field name="successful_use_count" readonly="1"/>
                                <field name="failure_count" readonly="1"/>
                                <field name="last_used_at" readonly="1"/>
                                <field name="estimated_tokens_saved" readonly="1"/>
                            </group>
                            <field name="execution_ids"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_ai_reporting_memory_search" model="ir.ui.view">
        <field name="name">ai.reporting.memory.search</field>
        <field name="model">ai.reporting.memory</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="intent_code"/>
                <field name="source_model_name"/>
                <filter name="approved" string="Approved" domain="[('state','=','approved')]"/>
                <filter name="answer_query" string="Ask AI Query" domain="[('memory_type','=','answer_query')]"/>
                <filter name="advanced_report" string="Advanced Report" domain="[('memory_type','=','advanced_report')]"/>
                <group>
                    <filter name="group_state" string="State" context="{'group_by':'state'}"/>
                    <filter name="group_type" string="Type" context="{'group_by':'memory_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_ai_reporting_memory" model="ir.actions.act_window">
        <field name="name">Local Memory</field>
        <field name="res_model">ai.reporting.memory</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_ai_reporting_memory_search"/>
    </record>

    <record id="view_ai_reporting_memory_phrase_tree" model="ir.ui.view">
        <field name="name">ai.reporting.memory.phrase.list</field>
        <field name="model">ai.reporting.memory.phrase</field>
        <field name="arch" type="xml">
            <list>
                <field name="phrase"/>
                <field name="memory_id"/>
                <field name="language_code"/>
                <field name="variant_type"/>
                <field name="translation_status"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="action_ai_reporting_memory_phrase" model="ir.actions.act_window">
        <field name="name">Terminology</field>
        <field name="res_model">ai.reporting.memory.phrase</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_ai_reporting_memory_execution_tree" model="ir.ui.view">
        <field name="name">ai.reporting.memory.execution.list</field>
        <field name="model">ai.reporting.memory.execution</field>
        <field name="arch" type="xml">
            <list create="0" edit="0">
                <field name="create_date"/>
                <field name="user_id"/>
                <field name="resolution_type"/>
                <field name="memory_id"/>
                <field name="saved_report_id"/>
                <field name="provider_called"/>
                <field name="tokens_saved"/>
                <field name="execution_time_ms"/>
                <field name="status"/>
            </list>
        </field>
    </record>

    <record id="action_ai_reporting_memory_execution" model="ir.actions.act_window">
        <field name="name">Usage Analytics</field>
        <field name="res_model">ai.reporting.memory.execution</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>

