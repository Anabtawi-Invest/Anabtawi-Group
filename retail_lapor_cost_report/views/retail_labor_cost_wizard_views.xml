<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Form View for Pop-up Wizard -->
    <record id="view_retail_labor_cost_wizard_form" model="ir.ui.view">
        <field name="name">retail.labor.cost.wizard.form</field>
        <field name="model">retail.labor.cost.wizard</field>
        <field name="arch" type="xml">
            <form string="Retail Labor Cost Report">
                <div class="alert alert-primary d-flex align-items-center mb-3" role="alert">
                    <div>
                        <strong>Retail Labor Cost &amp; Profit Report | تقرير تكلفة عمالة وأرباح أفرع الريتيل</strong><br/>
                        تقرير تحليلي لأفرع قسم الريتيل يجمع:
                        <strong>أرباح المبيعات (من نقاط البيع POS)</strong> +
                        <strong>تكلفة موظفي الفرع (بناءً على أيام دوامهم الفعلي وأجر الساعة)</strong> +
                        <strong>ساعات الأوفر تايم (المعتمدة وغير المعتمدة)</strong>.
                    </div>
                </div>

                <!-- KPI Totals Cards Banner -->
                <div class="row g-2 mb-3 text-center">
                    <div class="col-md-2">
                        <div class="p-2 border rounded bg-light">
                            <div class="text-muted small">الأفرع المشمولة</div>
                            <div class="fs-5 fw-bold text-dark"><field name="total_branches" readonly="1"/></div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="p-2 border rounded" style="background-color: #EFF6FF;">
                            <div class="text-muted small">إجمالي مبيعات الأفرع</div>
                            <div class="fs-5 fw-bold text-primary">
                                <field name="total_sales" widget="monetary" options="{'currency_field': 'currency_id'}" readonly="1"/>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="p-2 border rounded" style="background-color: #FEF2F2;">
                            <div class="text-muted small">إجمالي تكلفة الموظفين</div>
                            <div class="fs-5 fw-bold" style="color: #B91C1C;">
                                <field name="total_labor_cost" widget="monetary" options="{'currency_field': 'currency_id'}" readonly="1"/>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-2">
                        <div class="p-2 border rounded" style="background-color: #ECFDF5;">
                            <div class="text-muted small">أوفر تايم معتمد</div>
                            <div class="fs-5 fw-bold" style="color: #047857;">
                                <field name="total_approved_ot" readonly="1"/> <small>ساعة</small>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-2">
                        <div class="p-2 border rounded" style="background-color: #FFFBEB;">
                            <div class="text-muted small">أوفر تايم غير معتمد</div>
                            <div class="fs-5 fw-bold" style="color: #B45309;">
                                <field name="total_unapproved_ot" readonly="1"/> <small>ساعة</small>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Filters -->
                <group>
                    <group string="Period &amp; Company / الشركة والفترة">
                        <field name="company_id" options="{'no_create': True}"/>
                        <field name="date_from"/>
                        <field name="date_to"/>
                        <field name="currency_id" invisible="1"/>
                    </group>
                    <group string="Retail Branches Scope / نطاق أفرع الريتيل">
                        <field name="retail_department_id" options="{'no_create': True}" placeholder="Retail Main Department..."/>
                        <field name="branch_department_ids" widget="many2many_tags" domain="[('company_id', '=', company_id), ('id', 'child_of', retail_department_id)]" options="{'no_create': True}" placeholder="Select Branches..."/>
                        <div colspan="2" class="mt-2">
                            <button name="action_calculate_preview" type="object" string="🔄 Refresh Calculations / تحديث البيانات" class="btn btn-outline-primary btn-sm"/>
                        </div>
                    </group>
                </group>

                <!-- Live In-Wizard Preview Table -->
                <notebook>
                    <page string="Branches Summary / ملخص الأفرع" name="branches_preview">
                        <field name="line_ids" readonly="1">
                            <list decoration-danger="labor_cost > sales_profit and sales_profit > 0" decoration-warning="sales_profit == 0">
                                <field name="branch_name" class="fw-bold"/>
                                <field name="sales_profit" widget="monetary" options="{'currency_field': 'currency_id'}" class="text-primary fw-bold"/>
                                <field name="employee_count"/>
                                <field name="attendance_days"/>
                                <field name="labor_cost" widget="monetary" options="{'currency_field': 'currency_id'}" class="text-danger fw-bold"/>
                                <field name="approved_ot_hours" class="text-success"/>
                                <field name="unapproved_ot_hours" class="text-warning"/>
                                <field name="total_ot_hours" class="fw-bold"/>
                                <field name="net_margin" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                <field name="labor_pct" string="Labor %"/>
                                <field name="currency_id" column_invisible="1"/>
                                <field name="notes" optional="show"/>
                            </list>
                        </field>
                    </page>
                </notebook>

                <group invisible="not file_data" class="mt-2">
                    <field name="filename" invisible="1"/>
                    <field name="file_data" filename="filename" string="Download Excel File"/>
                </group>

                <footer>
                    <button name="action_export_xlsx" type="object" string="Export to Excel / تصدير التقرير" class="btn-primary"/>
                    <button string="Close / إغلاق" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Action Window for Pop-up (target=new) -->
    <record id="action_retail_labor_cost_wizard" model="ir.actions.act_window">
        <field name="name">Retail Labor Cost Report</field>
        <field name="res_model">retail.labor.cost.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- Menu Item under Payroll -> Reporting -->
    <menuitem id="menu_retail_labor_cost_report"
              name="Retail Labor Cost Report"
              action="action_retail_labor_cost_wizard"
              sequence="75"
              groups="hr_payroll.group_hr_payroll_user"/>

    <!-- Dynamic Menu Parent Resolver -->
    <function model="retail.labor.cost.wizard" name="_attach_reporting_menu"/>
</odoo>
