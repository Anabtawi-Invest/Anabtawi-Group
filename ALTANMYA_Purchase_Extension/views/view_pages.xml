<?xml version="1.0" encoding="utf-8"?>
<odoo>
   <data>
        <record id="view_tanmya_purchase_stage_type" model="ir.ui.view">
            <field name="name">Purchase type</field>
            <field name="model">tanmya.purchase.stage.type</field>
            <field name="arch" type="xml">

                <form>
                    <group>
                        <field name="name"/>
                        <field name="company_id"/>
                        <field name="currency" widget="selection"/>
                        <field name="minrange"/>
                        <field name="maxrange"/>
                    </group>
                    <field name="stages" widget="one2many" context="{'show_attribute': False}">
                        <list string="stages" editable="bottom">
                            <field name="code"/>
                            <field name="name"/>
                            <field name="approvetype" widget="selection"/>
                            <field name="stageusers" widget="many2many_tags" options="{'no_create_edit': True, 'color_field': 'color'}"/>
                            <field name="stageorder"/>
                            <field name="company_id" column_invisible="True"/>
                        </list>
                    </field>
                </form>

            </field>
        </record>



       <record id="view_purchase_form_inherit" model="ir.ui.view">
        <field name="name">purchase.order.inherit</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
<!--            <notebook position="inside">-->
                <field name="currency_id" position="after">
                    <field name="purchasetype"
                             widget="selection"
                             readonly="not userisadmin"
                             domain="[('company_id', '=', company_id)]"/>
                    <field name="showpending" invisible="1"/>
                    <field name="userisadmin" invisible="1"/>

                </field>
                <field name="state" position="before">
                   <button name="action_approve" string="Approve" type="object" invisible="not showpending" />
                   <button name="action_decline"  string="Decline" type="object" invisible="not showpending" />
                </field>
<!--            </notebook>-->
        </field>
    </record>

   </data>

</odoo>