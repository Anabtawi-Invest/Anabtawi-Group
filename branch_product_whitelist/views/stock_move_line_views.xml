<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="stock_move_line_product_selector_branch" model="ir.ui.view">
        <field name="name">stock.move.line.barcode.product.branch.whitelist</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock_barcode.stock_move_line_product_selector"/>
        <field name="arch" type="xml">
            <field name="company_id" position="after">
                <field name="branch_product_id_domain" invisible="1"/>
            </field>
            <field name="product_id" position="attributes">
                <attribute name="domain">branch_product_id_domain</attribute>
            </field>
        </field>
    </record>

</odoo>
