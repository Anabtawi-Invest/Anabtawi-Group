<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- The payslip templates use web.basic_layout (no wkhtmltopdf header/footer), so the
         default A4 margins and header spacing only waste space and push the signature
         block onto a second page. -->
    <record id="paperformat_payslip_compact" model="report.paperformat">
        <field name="name">Payslip A4 compact</field>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">8</field>
        <field name="margin_bottom">8</field>
        <field name="margin_left">7</field>
        <field name="margin_right">7</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">90</field>
    </record>

    <record id="hr_payroll.action_report_payslip" model="ir.actions.report">
        <field name="paperformat_id" ref="paperformat_payslip_compact"/>
    </record>
</odoo>
