<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="pos_onsite_price.OnSitePricePopup" owl="1">
        <Dialog size="'md'" title="popupTitle">
            <div class="o_pos_onsite_price_popup" t-on-click.stop="">
                <div class="rounded px-3 py-3 mb-3 bg-primary text-white">
                    <span class="fw-bold" t-esc="popupTitle"/>
                    <small class="d-block opacity-75" t-esc="popupSubtitle"/>
                </div>
                <div class="d-flex flex-column gap-2">
                    <button
                        class="btn btn-lg py-3"
                        t-att-class="state.selected === 'on_site' ? 'btn-success' : 'btn-outline-success'"
                        t-on-click.stop="() => this.select('on_site')">
                        <t t-esc="onSiteLabel"/>
                    </button>
                    <button
                        class="btn btn-lg py-3"
                        t-att-class="state.selected === 'cutting' ? 'btn-warning' : 'btn-outline-warning'"
                        t-on-click.stop="() => this.select('cutting')">
                        <t t-esc="cuttingLabel"/>
                    </button>
                    <button
                        class="btn btn-lg py-3"
                        t-att-class="state.selected === 'none' ? 'btn-secondary' : 'btn-outline-secondary'"
                        t-on-click.stop="() => this.select('none')">
                        <t t-esc="pledgeLabel"/>
                    </button>
                </div>
            </div>
            <t t-set-slot="footer">
                <button class="btn btn-light" t-on-click.stop="cancel" t-esc="cancelLabel"/>
                <button
                    class="btn btn-primary"
                    t-att-disabled="!state.selected"
                    t-on-click.stop="confirm"
                    t-esc="confirmLabel"/>
            </t>
        </Dialog>
    </t>
</templates>
