<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pos_onsite_price_menu_list" model="ir.ui.view">
        <field name="name">pos.onsite.price.menu.list</field>
        <field name="model">pos.onsite.price.menu</field>
        <field name="arch" type="xml">
            <list string="On-Site Prices">
                <field name="pos_config_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_pos_onsite_price_menu_form" model="ir.ui.view">
        <field name="name">pos.onsite.price.menu.form</field>
        <field name="model">pos.onsite.price.menu</field>
        <field name="arch" type="xml">
            <form string="On-Site Prices">
                <sheet>
                    <group>
                        <field name="pos_config_id"/>
                        <field name="name" invisible="1"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="currency_id" invisible="1"/>
                    </group>
                    <notebook>
                        <page string="Quantity Ranges" name="ranges">
                            <field name="range_ids" nolabel="1">
                                <list editable="bottom">
                                    <field name="is_on_site"/>
                                    <field name="min_qty"/>
                                    <field name="max_qty"/>
                                    <field name="price_per_kilo"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Products" name="products">
                            <field name="product_line_ids" nolabel="1">
                                <list editable="bottom">
                                    <field name="product_id"/>
                                    <field name="multiple"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_pos_onsite_price_menu" model="ir.actions.act_window">
        <field name="name">On-Site Prices</field>
        <field name="res_model">pos.onsite.price.menu</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="menu_pos_onsite_price"
        name="On-Site Prices"
        parent="point_of_sale.menu_point_root"
        action="action_pos_onsite_price_menu"
        sequence="54"
        groups="point_of_sale.group_pos_user,point_of_sale.group_pos_manager"/>
    <menuitem
        id="menu_pos_onsite_price_config"
        name="On-Site Prices"
        parent="point_of_sale.menu_point_config_product"
        action="action_pos_onsite_price_menu"
        sequence="50"
        groups="point_of_sale.group_pos_user,point_of_sale.group_pos_manager"/>
</odoo>
