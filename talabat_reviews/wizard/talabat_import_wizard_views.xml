<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_talabat_import_wizard_form" model="ir.ui.view">
        <field name="name">talabat.import.wizard.form</field>
        <field name="model">talabat.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Import Talabat Reviews">
                <group>
                    <field name="data_file" filename="data_filename"/>
                    <field name="data_filename" invisible="1"/>
                    <field name="json_text" placeholder="Paste JSON here…"/>
                </group>
                <footer>
                    <button name="action_import" type="object" string="Import" class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_talabat_import_wizard" model="ir.actions.act_window">
        <field name="name">Import Reviews JSON</field>
        <field name="res_model">talabat.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
