<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <record id="module_category_talabat_reviews" model="ir.module.category">
            <field name="name">Talabat Reviews</field>
            <field name="sequence">56</field>
        </record>
        <record id="group_talabat_reviews_user" model="res.groups">
            <field name="name">User</field>
            <field name="category_id" ref="module_category_talabat_reviews"/>
        </record>
        <record id="group_talabat_reviews_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="category_id" ref="module_category_talabat_reviews"/>
            <field name="implied_ids" eval="[(4, ref('group_talabat_reviews_user'))]"/>
            <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>
    </data>
</odoo>
