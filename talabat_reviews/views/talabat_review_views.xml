<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_talabat_review_list" model="ir.ui.view">
        <field name="name">talabat.review.list</field>
        <field name="model">talabat.review</field>
        <field name="arch" type="xml">
            <list>
                <field name="review_datetime"/>
                <field name="store_id"/>
                <field name="pos_config_id" optional="show"/>
                <field name="rating"/>
                <field name="order_number"/>
                <field name="comment"/>
                <field name="awaiting_reply"/>
                <field name="can_dispute"/>
                <field name="line_count"/>
            </list>
        </field>
    </record>

    <record id="view_talabat_review_form" model="ir.ui.view">
        <field name="name">talabat.review.form</field>
        <field name="model">talabat.review</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="store_id"/>
                            <field name="pos_config_id"/>
                            <field name="order_number"/>
                            <field name="review_datetime"/>
                            <field name="rating"/>
                        </group>
                        <group>
                            <field name="awaiting_reply"/>
                            <field name="replied"/>
                            <field name="can_dispute"/>
                            <field name="disputed"/>
                            <field name="external_uid"/>
                        </group>
                    </group>
                    <group string="Comment">
                        <field name="comment" nolabel="1" colspan="2"/>
                    </group>
                    <notebook>
                        <page string="Order products" name="lines">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="product_name"/>
                                    <field name="quantity"/>
                                    <field name="unit_price"/>
                                    <field name="product_id"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_talabat_review" model="ir.actions.act_window">
        <field name="name">Talabat Reviews</field>
        <field name="res_model">talabat.review</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
