<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!-- Purchase Order: Quality Control approved-supplier status     -->
    <!-- ============================================================ -->
    <record id="view_purchase_order_form_qc" model="ir.ui.view">
        <field name="name">purchase.order.form.inherit.qc</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">

            <xpath expr="//div[hasclass('oe_title')]" position="after">
                <div class="alert alert-danger mb-0" role="alert"
                     invisible="qc_supplier_status != 'blocked' or qc_block_overridden">
                    <strong>Blocked supplier (Quality Control).</strong>
                    This supplier is blocked on the Approved Supplier list.
                    The order cannot be confirmed until a Quality Manager
                    grants a documented override below.
                </div>
                <div class="alert alert-success mb-0" role="alert"
                     invisible="qc_supplier_status != 'blocked' or not qc_block_overridden">
                    <strong>Blocked supplier — override granted.</strong>
                    Overridden by <field name="qc_override_by_id" readonly="1" class="oe_inline"/>
                    on <field name="qc_override_date" readonly="1" class="oe_inline"/>.
                    Reason: <field name="qc_override_reason" readonly="1" class="oe_inline"/>
                </div>
                <div class="alert alert-warning mb-0" role="alert"
                     invisible="qc_supplier_status != 'conditional'">
                    <strong>Conditional supplier (Quality Control).</strong>
                    Check the approved scope and certificate validity before
                    ordering.
                </div>
                <group invisible="qc_supplier_status != 'blocked' or qc_block_overridden"
                       groups="site_quality_control.group_qc_quality_manager">
                    <field name="qc_override_reason"
                           placeholder="Justification required to override the block..."/>
                </group>
                <button name="action_qc_override_block" type="object"
                        string="Override Block &amp; Allow Purchase"
                        class="btn-warning mb-2"
                        invisible="qc_supplier_status != 'blocked' or qc_block_overridden"
                        groups="site_quality_control.group_qc_quality_manager"/>
            </xpath>

            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="qc_supplier_status" widget="badge"
                       decoration-success="qc_supplier_status == 'approved'"
                       decoration-warning="qc_supplier_status == 'conditional'"
                       decoration-danger="qc_supplier_status == 'blocked'"
                       invisible="not qc_supplier_status"/>
                <field name="qc_block_overridden" invisible="1"/>
            </xpath>

            <xpath expr="//button[@name='button_confirm']" position="before">
                <field name="qc_supplier_status" invisible="1"/>
            </xpath>

        </field>
    </record>

</odoo>
