<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ================= Sales & Profitability (SQL report) ================= -->
    <record id="view_online_campaign_performance_list" model="ir.ui.view">
        <field name="name">online.campaign.performance.report.list</field>
        <field name="model">online.campaign.performance.report</field>
        <field name="arch" type="xml">
            <list string="Sales &amp; Profitability" create="0" edit="0" delete="0" sample="1">
                <field name="date"/>
                <field name="aggregator_id"/>
                <field name="campaign_id"/>
                <field name="is_campaign_order" string="Campaign Order" optional="hide"/>
                <field name="session_id" optional="hide"/>
                <field name="order_count" sum="Orders"/>
                <field name="line_count" optional="hide" sum="Lines"/>
                <field name="gross_amount" widget="monetary" sum="Gross"/>
                <field name="discount_amount" widget="monetary" sum="Discount"/>
                <field name="aggregator_contribution" widget="monetary" optional="hide" sum="Aggregator Contribution"/>
                <field name="company_contribution" widget="monetary" sum="Company Contribution"/>
                <field name="estimated_commission" widget="monetary" sum="Commission"/>
                <field name="customer_collections" widget="monetary" optional="hide" sum="Customer Collections"/>
                <field name="estimated_net_proceeds" widget="monetary" sum="Net Proceeds"/>
                <field name="estimated_campaign_cost" widget="monetary" sum="Campaign Cost"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_online_campaign_performance_pivot" model="ir.ui.view">
        <field name="name">online.campaign.performance.report.pivot</field>
        <field name="model">online.campaign.performance.report</field>
        <field name="arch" type="xml">
            <pivot string="Sales &amp; Profitability" sample="1">
                <field name="aggregator_id" type="row"/>
                <field name="campaign_id" type="row"/>
                <field name="date" interval="month" type="col"/>
                <field name="gross_amount" type="measure"/>
                <field name="company_contribution" type="measure"/>
                <field name="estimated_commission" type="measure"/>
                <field name="estimated_net_proceeds" type="measure"/>
                <field name="estimated_campaign_cost" type="measure"/>
                <field name="order_count" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_online_campaign_performance_graph" model="ir.ui.view">
        <field name="name">online.campaign.performance.report.graph</field>
        <field name="model">online.campaign.performance.report</field>
        <field name="arch" type="xml">
            <graph string="Sales &amp; Profitability" type="bar" stacked="0" sample="1">
                <field name="aggregator_id"/>
                <field name="gross_amount" type="measure"/>
                <field name="estimated_net_proceeds" type="measure"/>
                <field name="estimated_campaign_cost" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_online_campaign_performance_search" model="ir.ui.view">
        <field name="name">online.campaign.performance.report.search</field>
        <field name="model">online.campaign.performance.report</field>
        <field name="arch" type="xml">
            <search>
                <field name="aggregator_id"/>
                <field name="campaign_id"/>
                <field name="session_id"/>
                <filter name="this_month" string="This Month"
                        domain="[('date', '&gt;=', context_today().strftime('%Y-%m-01'))]"/>
                <separator/>
                <filter name="campaign_orders" string="Campaign Sales" domain="[('is_campaign_order', '=', True)]"/>
                <filter name="non_campaign_orders" string="Non-Campaign Sales" domain="[('is_campaign_order', '=', False)]"/>
                <group>
                    <filter name="group_aggregator" string="Aggregator" context="{'group_by': 'aggregator_id'}"/>
                    <filter name="group_campaign" string="Campaign" context="{'group_by': 'campaign_id'}"/>
                    <filter name="group_sale_type" string="Campaign / Non-Campaign" context="{'group_by': 'is_campaign_order'}"/>
                    <filter name="group_month" string="Month" context="{'group_by': 'date:month'}"/>
                    <filter name="group_session" string="POS Session" context="{'group_by': 'session_id'}"/>
                    <filter name="group_company" string="Company" context="{'group_by': 'company_id'}" groups="base.group_multi_company"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_online_campaign_profitability" model="ir.actions.act_window">
        <field name="name">Sales &amp; Profitability</field>
        <field name="res_model">online.campaign.performance.report</field>
        <field name="view_mode">graph,pivot,list</field>
        <field name="search_view_id" ref="view_online_campaign_performance_search"/>
        <field name="domain">[('aggregator_id', '!=', False)]</field>
        <field name="context">{'search_default_this_month': 1, 'search_default_group_aggregator': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No aggregator sales yet</p>
            <p>Sales paid with an aggregator payment method appear here after the POS session is closed.</p>
        </field>
    </record>

    <!-- ================= Order lines (pos.order.line) ================= -->
    <record id="view_online_campaign_discount_report_list" model="ir.ui.view">
        <field name="name">pos.order.line.online.campaign.report.list</field>
        <field name="model">pos.order.line</field>
        <field name="arch" type="xml">
            <list string="Aggregator Order Lines" create="0" edit="0" delete="0" default_order="online_order_date desc" sample="1">
                <field name="online_order_date" string="Date"/>
                <field name="online_aggregator_id" string="Aggregator"/>
                <field name="online_campaign_id" string="Campaign"/>
                <field name="order_id" string="Order"/>
                <field name="online_aggregator_order_ref" string="Aggregator Ref" optional="show"/>
                <field name="product_id"/>
                <field name="online_gross_amount" string="Gross" widget="monetary" sum="Gross"/>
                <field name="online_discount_amount" string="Discount" widget="monetary" sum="Discount"/>
                <field name="aggregator_contribution_amount" string="Aggregator Share" widget="monetary" optional="hide" sum="Aggregator"/>
                <field name="company_contribution_amount" string="Company Share" widget="monetary" optional="hide" sum="Company"/>
                <field name="aggregator_commission_amount" string="Commission" widget="monetary" sum="Commission"/>
                <field name="online_customer_paid_amount" string="Customer Paid" widget="monetary" sum="Customer Paid"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="online_session_id" string="POS Session" optional="hide"/>
                <field name="online_cashier_id" string="Cashier" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_online_campaign_line_pivot" model="ir.ui.view">
        <field name="name">pos.order.line.online.campaign.pivot</field>
        <field name="model">pos.order.line</field>
        <field name="arch" type="xml">
            <pivot string="Aggregator Order Lines" sample="1">
                <field name="online_aggregator_id" type="row"/>
                <field name="online_campaign_id" type="row"/>
                <field name="online_order_date" interval="month" type="col"/>
                <field name="online_gross_amount" type="measure"/>
                <field name="online_discount_amount" type="measure"/>
                <field name="aggregator_contribution_amount" type="measure"/>
                <field name="company_contribution_amount" type="measure"/>
                <field name="aggregator_commission_amount" type="measure"/>
                <field name="online_customer_paid_amount" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_online_campaign_line_graph" model="ir.ui.view">
        <field name="name">pos.order.line.online.campaign.graph</field>
        <field name="model">pos.order.line</field>
        <field name="arch" type="xml">
            <graph string="Aggregator Order Lines" type="bar" stacked="1" sample="1">
                <field name="online_aggregator_id"/>
                <field name="online_discount_amount" type="measure"/>
                <field name="company_contribution_amount" type="measure"/>
                <field name="aggregator_commission_amount" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_online_campaign_discount_report_search" model="ir.ui.view">
        <field name="name">pos.order.line.online.campaign.report.search</field>
        <field name="model">pos.order.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="online_aggregator_id"/>
                <field name="online_campaign_id"/>
                <field name="order_id"/>
                <field name="online_aggregator_order_ref"/>
                <field name="product_id"/>
                <field name="online_session_id"/>
                <filter name="campaign_orders" string="Campaign Sales" domain="[('online_campaign_id', '!=', False)]"/>
                <filter name="non_campaign_orders" string="Non-Campaign Sales" domain="[('online_campaign_id', '=', False), ('online_aggregator_id', '!=', False)]"/>
                <group>
                    <filter name="group_aggregator" string="Aggregator" context="{'group_by': 'online_aggregator_id'}"/>
                    <filter name="group_campaign" string="Campaign" context="{'group_by': 'online_campaign_id'}"/>
                    <filter name="group_product" string="Product" context="{'group_by': 'product_id'}"/>
                    <filter name="group_session" string="POS Session" context="{'group_by': 'online_session_id'}"/>
                    <filter name="group_date" string="Day" context="{'group_by': 'online_order_date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_online_campaign_discount_report" model="ir.actions.act_window">
        <field name="name">Aggregator Order Lines</field>
        <field name="res_model">pos.order.line</field>
        <field name="view_mode">list,pivot,graph</field>
        <field name="view_id" ref="view_online_campaign_discount_report_list"/>
        <field name="search_view_id" ref="view_online_campaign_discount_report_search"/>
        <field name="domain">[('online_aggregator_id', '!=', False)]</field>
    </record>
</odoo>
