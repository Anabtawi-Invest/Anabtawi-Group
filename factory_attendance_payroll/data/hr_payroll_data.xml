<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Base Reconciled Calculation Rule (Hidden Informational Rule) -->
    <record id="rule_reconciled_attendance_hours" model="hr.salary.rule">
        <field name="name">Attendance Reconciled Hours Variance</field>
        <field name="code">ATT_RECON_VAR</field>
        <field name="category_id" ref="hr_payroll.BASIC"/>
        <field name="sequence">50</field>
        <field name="appears_on_payslip" eval="False"/>
        <field name="condition_select">none</field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">
# Informational calculation rule: monetary amount is 0.0 JOD so it does not alter basic pay
result = 0.0
        </field>
        <field name="struct_id" search="[]"/>
    </record>

    <!-- Net Remaining Overtime (Banked to Extra Hours - 0 JOD Salary Payout) -->
    <record id="rule_net_overtime_allowance" model="hr.salary.rule">
        <field name="name">Net Reconciled Overtime</field>
        <field name="code">OT_NET</field>
        <field name="category_id" ref="hr_payroll.ALW"/>
        <field name="sequence">60</field>
        <field name="appears_on_payslip" eval="True"/>
        <field name="condition_select">python</field>
        <field name="condition_python">
net_var = round(payslip.attendance_net_reconciled, 2) if payslip else 0.0
result = net_var &gt; 0.01
        </field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">
# Overtime is banked to Extra Hours, NOT paid on monthly cash salary (0.0 JOD)
# HR can pay banked extra hours anytime via Salary Inputs
result = 0.0
        </field>
        <field name="struct_id" search="[]"/>
    </record>

    <!-- Net Undertime Shortfall - Tier 3 Cash Deduction -->
    <record id="rule_net_undertime_deduction" model="hr.salary.rule">
        <field name="name">Non-Attendance Deduction</field>
        <field name="code">DED_UNDERTIME</field>
        <field name="category_id" ref="hr_payroll.DED"/>
        <field name="sequence">70</field>
        <field name="appears_on_payslip" eval="True"/>
        <field name="condition_select">python</field>
        <field name="condition_python">
cash_hrs = round(payslip.undertime_cash_deduction_hours, 2) if payslip else 0.0
result = cash_hrs &gt;= 0.01
        </field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">
deficit_hours = round(payslip.undertime_cash_deduction_hours, 2) if payslip else 0.0
if deficit_hours &lt; 0.01:
    result = 0.0
else:
    wage = employee.wage or 0.0
    # Dynamic hourly rate: wage / total scheduled hours from worked days lines
    total_scheduled_hours = sum(line.number_of_hours for line in payslip.worked_days_line_ids)
    if total_scheduled_hours &gt; 0:
        hourly_rate = wage / total_scheduled_hours
    else:
        # Fallback to standard 6-day work week schedule if lines are not generated
        weekly_hours = employee.resource_calendar_id.full_time_required_hours or 49.5
        hourly_rate = (wage / 26.0) / (weekly_hours / 6.0)
    hourly_rate = round(hourly_rate, 4)
    result = -(deficit_hours * hourly_rate)
        </field>
        <field name="struct_id" search="[]"/>
    </record>

    <!-- Termination Clearance Input Types -->
    <record id="input_type_clear_extra" model="hr.payslip.input.type">
        <field name="name">Termination: Extra Hours Settlement / مخالصة ساعات إضافية</field>
        <field name="code">CLEAR_EXTRA</field>
        <field name="country_id" eval="False"/>
    </record>

    <record id="input_type_clear_annual" model="hr.payslip.input.type">
        <field name="name">Termination: Annual Leave Settlement / مخالصة إجازة سنوية</field>
        <field name="code">CLEAR_ANNUAL</field>
        <field name="country_id" eval="False"/>
    </record>

    <record id="input_type_clear_pto" model="hr.payslip.input.type">
        <field name="name">Termination: Paid Time Off Settlement / مخالصة إجازة مدفوعة</field>
        <field name="code">CLEAR_PTO</field>
        <field name="country_id" eval="False"/>
    </record>

    <!-- Termination Clearance Salary Rules -->
    <record id="rule_clear_extra_hours" model="hr.salary.rule">
        <field name="name">Termination Extra Hours Settlement</field>
        <field name="code">CLEAR_EXTRA</field>
        <field name="category_id" ref="hr_payroll.ALW"/>
        <field name="sequence">61</field>
        <field name="appears_on_payslip" eval="True"/>
        <field name="condition_select">python</field>
        <field name="condition_python">result = bool(inputs.get('CLEAR_EXTRA') and inputs['CLEAR_EXTRA'].amount &gt; 0)</field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">result = inputs['CLEAR_EXTRA'].amount if 'CLEAR_EXTRA' in inputs else 0.0</field>
        <field name="struct_id" search="[]"/>
    </record>

    <record id="rule_clear_annual_leave" model="hr.salary.rule">
        <field name="name">Termination Annual Leave Settlement</field>
        <field name="code">CLEAR_ANNUAL</field>
        <field name="category_id" ref="hr_payroll.ALW"/>
        <field name="sequence">62</field>
        <field name="appears_on_payslip" eval="True"/>
        <field name="condition_select">python</field>
        <field name="condition_python">result = bool(inputs.get('CLEAR_ANNUAL') and inputs['CLEAR_ANNUAL'].amount &gt; 0)</field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">result = inputs['CLEAR_ANNUAL'].amount if 'CLEAR_ANNUAL' in inputs else 0.0</field>
        <field name="struct_id" search="[]"/>
    </record>

    <record id="rule_clear_paid_time_off" model="hr.salary.rule">
        <field name="name">Termination Paid Time Off Settlement</field>
        <field name="code">CLEAR_PTO</field>
        <field name="category_id" ref="hr_payroll.ALW"/>
        <field name="sequence">63</field>
        <field name="appears_on_payslip" eval="True"/>
        <field name="condition_select">python</field>
        <field name="condition_python">result = bool(inputs.get('CLEAR_PTO') and inputs['CLEAR_PTO'].amount &gt; 0)</field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">result = inputs['CLEAR_PTO'].amount if 'CLEAR_PTO' in inputs else 0.0</field>
        <field name="struct_id" search="[]"/>
    </record>
</odoo>
