<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Preserve legacy XML IDs with unique names to prevent Odoo module upgrader orphan record deletion -->
        <record id="test_factory_employee" model="hr.employee">
            <field name="name">Factory Employee Overtime Test 1</field>
            <field name="job_title">Factory Technician</field>
            <field name="work_email">factory.ot1@example.com</field>
            <field name="wage">500.0</field>
        </record>

        <record id="test_undertime_employee" model="hr.employee">
            <field name="name">Factory Employee Undertime Test 1</field>
            <field name="job_title">Factory Operator</field>
            <field name="work_email">factory.ut1@example.com</field>
            <field name="wage">500.0</field>
        </record>

        <record id="factory_test_1_employee" model="hr.employee">
            <field name="name">Factory Employee Overtime Test 2</field>
            <field name="job_title">Factory Technician</field>
            <field name="work_email">factory.ot2@example.com</field>
            <field name="wage">500.0</field>
        </record>

        <record id="factory_test_2_employee" model="hr.employee">
            <field name="name">Factory Employee Undertime Test 2</field>
            <field name="job_title">Factory Operator</field>
            <field name="work_email">factory.ut2@example.com</field>
            <field name="wage">500.0</field>
        </record>

        <!-- EMPLOYEE 1: Factory Employee Overtime (+5:00 Net OT, Wage 500 JOD) -->
        <record id="factory_emp_ot" model="hr.employee">
            <field name="name">Factory Employee Overtime</field>
            <field name="job_title">Factory Technician</field>
            <field name="work_email">factory.ot@example.com</field>
            <field name="wage">500.0</field>
        </record>

        <!-- EMPLOYEE 2: Factory Employee Undertime (-2:00 Net UT, Wage 500 JOD) -->
        <record id="factory_emp_ut" model="hr.employee">
            <field name="name">Factory Employee Undertime</field>
            <field name="job_title">Factory Operator</field>
            <field name="work_email">factory.ut@example.com</field>
            <field name="wage">500.0</field>
        </record>

        <!-- Clean Demo Attendance Logs -->
        <record id="att_ot_01" model="hr.attendance">
            <field name="employee_id" ref="factory_emp_ot"/>
            <field name="check_in">2026-07-01 08:00:00</field>
            <field name="check_out">2026-07-01 18:30:00</field>
        </record>
        <record id="att_ut_01" model="hr.attendance">
            <field name="employee_id" ref="factory_emp_ut"/>
            <field name="check_in">2026-07-01 08:00:00</field>
            <field name="check_out">2026-07-01 16:30:00</field>
        </record>
    </data>
</odoo>
