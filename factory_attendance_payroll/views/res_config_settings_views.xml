<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_inherit_factory_payroll" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.factory.payroll</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="hr_payroll.res_config_settings_view_form"/>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='hr_payroll']/block[@id='hr_payroll_settings']" position="inside">
                <setting string="Factory Overtime Calculation" help="When unchecked, any extra hours worked by employees are treated as unpaid hours and will not generate overtime or affect payslips.">
                    <field name="enable_overtime_calculation"/>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
