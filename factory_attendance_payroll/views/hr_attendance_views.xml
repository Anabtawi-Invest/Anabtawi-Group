<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherit Attendance Form View with priority 99 to display separate Lateness vs Extra Hours metrics -->
    <record id="hr_attendance_view_form_inherit_factory_metrics" model="ir.ui.view">
        <field name="name">hr.attendance.form.inherit.factory.metrics</field>
        <field name="model">hr.attendance</field>
        <field name="inherit_id" ref="hr_attendance.hr_attendance_view_form"/>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <!-- Ensure statusbar is directly clickable -->
            <xpath expr="//field[@name='overtime_status']" position="attributes">
                <attribute name="options">{'clickable': '1'}</attribute>
            </xpath>

            <!-- Ensure standard Approve button is visible only when there are extra hours to approve -->
            <xpath expr="//button[@name='action_approve_overtime']" position="attributes">
                <attribute name="invisible">overtime_status not in ['to_approve', 'refused'] or not overtime_status or daily_overtime_hours &lt; 0.75</attribute>
            </xpath>

            <!-- Hide native overtime_hours and daily_variance_hours in favor of separate clean fields -->
            <xpath expr="//field[@name='overtime_hours']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <!-- Add separate Break, Net Worked Hours, Daily Lateness, and Daily Extra Hours -->
            <xpath expr="//field[@name='worked_hours']" position="after">
                <field name="attendance_break_hours" widget="float_time" readonly="1" string="Lunch Break Deducted"/>
                <field name="net_worked_hours" widget="float_time" readonly="1" string="Net Worked Hours"/>
                <field name="daily_undertime_hours" widget="float_time" readonly="1" string="Daily Lateness"/>
                <field name="daily_overtime_hours" widget="float_time" readonly="1" string="Daily Extra Hours"/>
                <field name="is_public_holiday" readonly="1" string="Public Holiday"/>
            </xpath>
        </field>
    </record>

    <!-- Inherit Attendance Tree/List View to display Net Worked Hours, Daily Lateness, Daily Extra Hours -->
    <record id="view_attendance_tree_inherit_factory_metrics" model="ir.ui.view">
        <field name="name">hr.attendance.tree.inherit.factory.metrics</field>
        <field name="model">hr.attendance</field>
        <field name="inherit_id" ref="hr_attendance.view_attendance_tree"/>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='worked_hours']" position="after">
                <field name="net_worked_hours" widget="float_time" optional="show" string="Net Worked Hours"/>
                <field name="daily_undertime_hours" widget="float_time" optional="show" string="Daily Lateness"/>
                <field name="daily_overtime_hours" widget="float_time" optional="show" string="Daily Extra Hours"/>
                <field name="is_public_holiday" optional="show" string="Public Holiday"/>
                <button name="action_approve_factory_overtime" type="object" icon="fa-check text-success"
                        title="Approve Extra Hours"
                        invisible="daily_overtime_hours &lt; 0.75 or overtime_status == 'approved'"/>
                <button name="action_refuse_factory_overtime" type="object" icon="fa-times text-danger"
                        title="Refuse Extra Hours"
                        invisible="daily_overtime_hours &lt; 0.75 or overtime_status == 'refused'"/>
            </xpath>
        </field>
    </record>

    <!-- Inherit Attendance Tree Management View with priority 99 -->
    <record id="view_attendance_tree_management_inherit_factory_metrics" model="ir.ui.view">
        <field name="name">hr.attendance.tree.management.inherit.factory.metrics</field>
        <field name="model">hr.attendance</field>
        <field name="inherit_id" ref="hr_attendance.view_attendance_tree_management"/>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='worked_hours']" position="after">
                <field name="net_worked_hours" widget="float_time" optional="show" string="Net Worked Hours"/>
                <field name="daily_undertime_hours" widget="float_time" optional="show" string="Daily Lateness"/>
                <field name="daily_overtime_hours" widget="float_time" optional="show" string="Daily Extra Hours"/>
                <field name="is_public_holiday" optional="show" string="Public Holiday"/>
            </xpath>
            <xpath expr="//list/button[@name='action_approve_overtime' and @icon='fa-check']" position="attributes">
                <attribute name="invisible">overtime_status not in ['to_approve', 'refused'] or daily_overtime_hours &lt; 0.75</attribute>
            </xpath>
        </field>
    </record>

    <!-- Inherit Attendance Search/Filter View to add quick filters for Lateness and Extra Hours -->
    <record id="hr_attendance_view_filter_inherit_factory_metrics" model="ir.ui.view">
        <field name="name">hr.attendance.view.filter.inherit.factory.metrics</field>
        <field name="model">hr.attendance</field>
        <field name="inherit_id" ref="hr_attendance.hr_attendance_view_filter"/>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <xpath expr="//filter[last()]" position="after">
                <separator/>
                <filter string="Has Lateness" name="filter_has_lateness" domain="[('daily_undertime_hours', '&gt;', 0)]"/>
                <filter string="Has Extra Hours" name="filter_has_extra_hours" domain="[('daily_overtime_hours', '&gt;=', 0.75)]"/>
                <filter string="Public Holiday Attendance" name="filter_public_holiday" domain="[('is_public_holiday', '=', True)]"/>
            </xpath>
        </field>
    </record>
</odoo>
