<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_payslip_form_inherit_attendance_reconciliation" model="ir.ui.view">
        <field name="name">hr.payslip.form.inherit.attendance.reconciliation</field>
        <field name="model">hr.payslip</field>
        <field name="inherit_id" ref="hr_payroll.view_hr_payslip_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="before">
                <group string="Attendance &amp; Reconciliation Tracking" name="attendance_reconciliation_tracking">
                    <group string="Gross Calculations (Before Reconciliation)">
                        <field name="attendance_gross_overtime" widget="float_time" readonly="1"/>
                        <field name="attendance_gross_undertime" widget="float_time" readonly="1"/>
                    </group>
                    <group string="Net Result &amp; 3-Tier Settlement">
                        <field name="attendance_net_reconciled" widget="float_time" readonly="1"/>
                        <field name="undertime_covered_by_extra_hours" widget="float_time" readonly="1"/>
                        <field name="undertime_covered_by_annual_leave" widget="float_time" readonly="1"/>
                        <field name="undertime_cash_deduction_hours" widget="float_time" readonly="1"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
