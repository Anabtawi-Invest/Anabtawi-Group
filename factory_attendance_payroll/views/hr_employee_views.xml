<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_employee_form_inherit_lunch_break_rule" model="ir.ui.view">
        <field name="name">hr.employee.form.inherit.lunch.break.rule</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <!-- Place before Schedule so fields stay visible even when payroll
                 modules inject Employer Costs / payment fields after Pay Category. -->
            <xpath expr="//page[@name='payroll_information']//separator[@name='schedule']" position="before">
                <separator string="Work Station &amp; Break" name="factory_work_station_break"/>
                <field name="employee_work_station"/>
                <field name="break_duration_hours" widget="float_time"/>
            </xpath>
            <xpath expr="//page[@name='payroll_information']//field[@name='resource_calendar_id'][last()]" position="after">
                <field name="x_studio_manager" groups="hr_payroll.group_hr_payroll_user"/>
            </xpath>
        </field>
    </record>
</odoo>
