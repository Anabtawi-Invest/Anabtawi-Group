<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_employee_form_inherit_lunch_break_rule" model="ir.ui.view">
        <field name="name">hr.employee.form.inherit.lunch.break.rule</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='payroll_information']//field[@name='structure_type_id']" position="after">
                <field name="employee_work_station"/>
                <field name="break_duration_hours"/>
            </xpath>
        </field>
    </record>
</odoo>
