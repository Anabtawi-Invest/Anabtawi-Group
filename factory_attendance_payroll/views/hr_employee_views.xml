<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_employee_form_inherit_lunch_break_rule" model="ir.ui.view">
        <field name="name">hr.employee.form.inherit.lunch.break.rule</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Attendance &amp; Break Rules" name="attendance_break_rules">
                    <group>
                        <group string="Lunch Break Configuration">
                            <field name="lunch_break_rule" widget="radio"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
