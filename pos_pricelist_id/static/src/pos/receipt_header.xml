<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t
        t-name="pos_pricelist_id.ReceiptHeaderExtension"
        t-inherit="point_of_sale.ReceiptHeader"
        t-inherit-mode="extension"
    >
        <xpath
            expr="//div[contains(@class, 'pos-receipt-customer')]"
            position="after"
        >
            <div
                t-if="order.customer_id_number"
                class="pos-receipt-customer mt-1"
            >
                <div>
                    ID Number:
                    <t t-esc="order.customer_id_number"/>
                </div>
            </div>
        </xpath>
    </t>

</templates>
