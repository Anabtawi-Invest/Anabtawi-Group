<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_bank_draft_restriction" model="ir.ui.view">
        <field name="name">account.move.form.bank.draft.restriction</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='button_draft']" position="before">
                <field name="bank_draft_restricted" invisible="1"/>
            </xpath>
            <xpath expr="//button[@name='button_draft']" position="attributes">
                <attribute name="invisible">not show_reset_to_draft_button or bank_draft_restricted</attribute>
            </xpath>
        </field>
    </record>
</odoo>
