<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="pos_predefined_discounts.ControlButtons" t-inherit="point_of_sale.ControlButtons" t-inherit-mode="extension">
        <xpath
            expr="//t[@t-if='props.showRemainingButtons']/div/button[hasclass('o_pricelist_button')]"
            position="before">
            <button
                t-if="pos.config.module_pos_discount and pos.config.discount_product_id and pos.cashier._role !== 'minimal'"
                class="js_employee_discount"
                t-att-class="buttonClass"
                t-on-click="() => this.clickEmployeeDiscount()">
                <i class="fa fa-user me-1"/>Employee Discount
            </button>
        </xpath>
    </t>
</templates>
