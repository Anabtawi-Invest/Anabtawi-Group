<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-inherit="point_of_sale.ClosePosPopup" t-inherit-mode="extension" owl="1">
        <xpath expr="//div[hasclass('payment-methods-overview')]" position="before">
            <div t-if="shouldShowPledgeClosingSection()" class="w-100 mb-3 p-2 border rounded bg-light">
                <div t-if="shouldShowPledgeCollectedBlock()" class="mb-2">
                    <div class="d-flex align-items-center justify-content-between fw-bold">
                        <span t-esc="pledgeCollectedTitle()"/>
                        <span t-esc="env.utils.formatCurrency(props.pledge_completion_details.collected_total || 0)"/>
                    </div>
                    <div class="d-flex align-items-center justify-content-between text-muted border-start ps-2">
                        <span t-esc="pledgeCollectedCountLabel()"/>
                        <span t-esc="props.pledge_completion_details.collected_count"/>
                    </div>
                </div>
                <div t-if="shouldShowPledgeReturnedBlock()">
                    <div class="d-flex align-items-center justify-content-between fw-bold text-danger">
                        <span t-esc="pledgeReturnedTitle()"/>
                        <span t-esc="env.utils.formatCurrency(props.pledge_completion_details.returned_total || 0)"/>
                    </div>
                    <div class="d-flex align-items-center justify-content-between text-muted border-start ps-2">
                        <span t-esc="pledgeReturnedCountLabel()"/>
                        <span t-esc="props.pledge_completion_details.returned_count"/>
                    </div>
                    <div t-if="shouldShowPledgeReturnPaymentMethods()"
                         class="mt-1 pt-1 border-top">
                        <div class="text-muted small fw-bold mb-1" t-esc="pledgeReturnPaymentMethodLabel()"/>
                        <t t-foreach="pledgeReturnPaymentMethods()" t-as="pmRow" t-key="pmRow.payment_method_id or pmRow_index">
                            <div class="d-flex align-items-center justify-content-between text-muted border-start ps-2">
                                <span t-esc="pledgeReturnPaymentMethodLineLabel(pmRow)"/>
                                <span t-esc="env.utils.formatCurrency(pmRow.amount || 0)"/>
                            </div>
                        </t>
                    </div>
                    <div t-elif="props.pledge_completion_details.return_cash"
                         class="d-flex align-items-center justify-content-between text-muted border-start ps-2">
                        <span t-esc="pledgeReturnCashLabel()"/>
                        <span t-esc="env.utils.formatCurrency(props.pledge_completion_details.return_cash)"/>
                    </div>
                    <div t-if="!shouldShowPledgeReturnPaymentMethods() and props.pledge_completion_details.return_bank"
                         class="d-flex align-items-center justify-content-between text-muted border-start ps-2">
                        <span t-esc="pledgeReturnBankLabel()"/>
                        <span t-esc="env.utils.formatCurrency(props.pledge_completion_details.return_bank)"/>
                    </div>
                </div>
            </div>
        </xpath>
    </t>
</templates>
