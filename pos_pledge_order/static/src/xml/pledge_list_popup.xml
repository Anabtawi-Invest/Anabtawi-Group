<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-name="pos_pledge.PledgeListPopup">
    <Dialog title="title" size="'lg'">
        <div class="p-3">

            <!-- SEARCH BAR -->
            <div class="mb-3">
                <input type="text"
                       class="form-control"
                       t-att-placeholder="searchPlaceholder"
                       t-on-input="onSearchInput"
                       t-on-keydown="onSearchKeydown"
                       autofocus="autofocus"/>
            </div>

            <!-- PLEDGES COUNT -->
            <t t-if="state.pledges.length">
                <div class="mb-2">
                    <small class="text-muted">
                        <i class="fa fa-list me-1"/>
                        <t t-if="state.search">
                            <t t-esc="showingPledgesLabel"/>
                        </t>
                        <t t-else="">
                            <t t-esc="activePledgesFoundLabel"/>
                        </t>
                    </small>
                </div>
            </t>

            <!-- NO PLEDGES FOUND -->
            <t t-if="!state.pledges.length">
                <div class="alert alert-warning">
                    <i class="fa fa-exclamation-triangle me-2"/>
                    <t t-esc="noActivePledgesLabel"/>
                </div>
            </t>

            <!-- NO SEARCH RESULTS -->
            <t t-if="state.pledges.length and !filteredPledges.length">
                <div class="alert alert-info">
                    <i class="fa fa-search me-2"/>
                    <t t-esc="noSearchResultsLabel"/>
                </div>
            </t>

            <!-- PLEDGE LIST -->
            <div class="pledge-list" t-if="filteredPledges.length" style="max-height: 320px; overflow-y: auto;">
                <t t-foreach="filteredPledges" t-as="pledge" t-key="pledge.id">
                    <div t-att-class="pledgeCardClass(pledge)"
                         style="transition: all 0.2s; cursor: pointer;"
                         t-on-click="() => this.togglePledgeSelection(pledge)">
                        <div class="card-body p-3">
                            <div class="d-flex justify-content-between align-items-start gap-2">
                                <div class="pt-1">
                                    <input type="checkbox"
                                           t-att-checked="isPledgeSelected(pledge)"
                                           t-on-click.stop="() => this.togglePledgeSelection(pledge)"/>
                                </div>
                                <div class="flex-grow-1">
                                    <h5 class="card-title mb-1">
                                        <i class="fa fa-handshake-o me-2 text-info"/>
                                        <t t-esc="pledge.name"/>
                                    </h5>
                                    <p class="card-text mb-1">
                                        <i class="fa fa-user me-1 text-muted"/>
                                        <strong><t t-esc="pledge.partner_id[1]"/></strong>
                                    </p>
                                    <t t-if="pledge.employee_name">
                                        <p class="card-text mb-1">
                                            <i class="fa fa-user-tie me-1 text-primary"/>
                                            <strong><t t-esc="pledge.employee_name"/></strong>
                                        </p>
                                    </t>
                                </div>
                                <div class="text-end">
                                    <h4 class="mb-0 text-success">
                                        <t t-esc="formatCurrency(pledge.pledge_amount)"/>
                                    </h4>
                                    <div class="d-flex gap-2 mt-2">
                                        <button class="btn btn-sm btn-info"
                                                t-on-click.stop="() => this.showPledgeDetails(pledge)">
                                            <i class="fa fa-eye me-1"/>
                                            <t t-esc="showLabel"/>
                                        </button>
                                        <button class="btn btn-sm btn-primary"
                                                t-on-click.stop="() => this.togglePledgeSelection(pledge)">
                                            <i class="fa fa-check me-1"/>
                                            <t t-esc="isPledgeSelected(pledge) ? unselectLabel : selectLabel"/>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </t>
            </div>

            <!-- PAYMENT METHOD -->
            <t t-if="hasSelectedPledges">
                <div class="mt-3">
                    <div class="alert alert-warning mb-3">
                        <div>
                            <strong><t t-esc="selectedCountLabel"/></strong>
                        </div>
                        <div>
                            <strong><t t-esc="pledgeAmountLabel"/></strong>
                            <span t-esc="selectedReturnAmountFmt"/>
                        </div>
                        <small class="d-block mt-1" t-esc="returnHintText"/>
                    </div>

                    <div class="form-group mb-0">
                        <label><strong t-esc="paymentMethodLabel"/></label>
                        <div t-if="!state.payment_methods.length"
                             class="alert alert-warning mb-0">
                            <span t-esc="noEligiblePaymentMethodsText"/>
                        </div>
                        <div t-else="" class="paymentmethods-container mb-0">
                            <div class="paymentmethods d-flex flex-column gap-2">
                                <t t-foreach="state.payment_methods" t-as="pm" t-key="pm.id">
                                    <div role="button"
                                         t-att-class="paymentMethodRowClass(pm)"
                                         t-on-click="() => this.selectPaymentMethod(pm)">
                                        <div class="payment-method-display d-flex align-items-center gap-2 text-wrap lh-sm">
                                            <img class="payment-method-icon"
                                                 t-att-src="paymentMethodIconSrc(pm)"
                                                 alt=""/>
                                            <span class="payment-name" t-esc="pm.name"/>
                                        </div>
                                        <span class="text-danger fw-bold" t-esc="selectedReturnAmountFmt"/>
                                    </div>
                                </t>
                            </div>
                        </div>
                    </div>
                </div>
            </t>
        </div>

        <t t-set-slot="footer">
            <button class="btn btn-secondary" t-on-click.stop="cancel">
                <i class="fa fa-times me-1"/>
                <t t-esc="cancelLabel"/>
            </button>
            <button class="btn btn-primary"
                    t-on-click.stop="confirmReturn"
                    t-att-disabled="!hasSelectedPledges or !state.selected_payment_method_id ? 'disabled' : undefined">
                <i class="fa fa-undo me-1"/>
                <t t-esc="returnPledgeLabel"/>
            </button>
        </t>
    </Dialog>

    <!-- PLEDGE DETAILS POPUP -->
    <Dialog t-if="state.selectedPledgeDetails" title="detailsTitle">
        <div class="p-3">
            <t t-set="pledge" t-value="state.selectedPledgeDetails"/>

            <div class="mb-3">
                <h4 class="mb-2">
                    <i class="fa fa-handshake-o me-2 text-info"/>
                    <t t-esc="pledge.name"/>
                </h4>
                <div class="badge" t-att-class="pledge.state === 'active' ? 'bg-success' : (pledge.state === 'returned' ? 'bg-warning' : 'bg-secondary')">
                    <t t-esc="pledge.state.toUpperCase()"/>
                </div>
            </div>

            <div class="mb-3">
                <div class="mb-2">
                    <strong><i class="fa fa-user me-1 text-muted"/> <t t-esc="customerLabel"/></strong>
                    <div class="ms-3"><t t-esc="pledge.partner_id[1]"/></div>
                    <t t-if="pledge.partner_phone">
                        <div class="ms-3 text-muted">
                            <i class="fa fa-phone me-1"/>
                            <t t-esc="pledge.partner_phone"/>
                        </div>
                    </t>
                </div>
                <t t-if="pledge.employee_name">
                    <div class="mb-2">
                        <strong><i class="fa fa-user-tie me-1 text-primary"/> <t t-esc="employeeLabel"/></strong>
                        <div class="ms-3"><t t-esc="pledge.employee_name"/></div>
                    </div>
                </t>
            </div>

            <div class="mb-3">
                <h5 class="mb-2"><t t-esc="amountsLabel"/></h5>
                <div class="table-responsive">
                    <table class="table table-sm table-bordered">
                        <tbody>
                            <tr>
                                <td><strong><t t-esc="pledgeAmountLabel"/></strong></td>
                                <td class="text-end text-success">
                                    <strong><t t-esc="formatCurrency(pledge.pledge_amount)"/></strong>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <t t-if="pledge.products and pledge.products.length">
                <div class="mb-3">
                    <h5 class="mb-2"><t t-esc="productsLabel"/></h5>
                    <div class="table-responsive">
                        <table class="table table-sm table-bordered">
                            <thead>
                                <tr>
                                    <th><t t-esc="productColumnLabel"/></th>
                                    <th class="text-end"><t t-esc="qtyColumnLabel"/></th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="pledge.products" t-as="product" t-key="product.id">
                                    <tr>
                                        <td><t t-esc="product.name"/></td>
                                        <td class="text-end"><t t-esc="product.qty"/></td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </div>
            </t>

            <div class="mt-3 text-end">
                <button class="btn btn-secondary" t-on-click="() => this.state.selectedPledgeDetails = null">
                    <i class="fa fa-times me-1"/>
                    <t t-esc="closeLabel"/>
                </button>
            </div>
        </div>
    </Dialog>
</t>

</templates>
