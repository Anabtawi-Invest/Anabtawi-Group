<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_pos_site_service_menu_form" model="ir.ui.view">
        <field name="name">pos.site.service.menu.form</field>
        <field name="model">pos.site.service.menu</field>
        <field name="arch" type="xml">
            <form string="Site Service" create="false" delete="false">
                <sheet>
                    <group>
                        <group>
                            <field name="enable_site_service"/>
                        </group>
                        <group invisible="not enable_site_service">
                            <field name="threshold"/>
                            <field name="service_product_id"/>
                            <field name="service_price"/>
                        </group>
                    </group>
                    <notebook invisible="not enable_site_service">
                        <page string="Products" name="products">
                            <field name="line_ids" nolabel="1">
                                <list editable="bottom">
                                    <field name="product_id"/>
                                    <field name="pledge_product_id" options="{'no_create': True}"/>
                                    <field name="multiple"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                    <field name="name" invisible="1"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_pos_site_service_menu" model="ir.actions.server">
        <field name="name">Site Service</field>
        <field name="model_id" ref="model_pos_site_service_menu"/>
        <field name="state">code</field>
        <field name="code">action = model.action_open_settings()</field>
    </record>

    <menuitem id="menu_pos_site_service"
              name="Site Service"
              parent="point_of_sale.menu_point_root"
              action="action_pos_site_service_menu"
              sequence="55"
              groups="point_of_sale.group_pos_manager"/>

</odoo>
