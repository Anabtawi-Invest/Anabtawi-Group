<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <!-- Keep standard "Print Full Receipt" (OrderReceipt with pledge section).
         Hide the basic receipt button when configured. -->
    <t t-name="pos_pledge.ReceiptScreen"
       t-inherit="point_of_sale.ReceiptScreen"
       t-inherit-mode="extension">

        <xpath expr="//button[hasclass('print')][2]" position="attributes">
            <attribute name="style">display: none;</attribute>
        </xpath>
    </t>

</templates>
