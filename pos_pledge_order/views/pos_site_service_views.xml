<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_pos_site_service_menu_list" model="ir.ui.view">
        <field name="name">pos.site.service.menu.list</field>
        <field name="model">pos.site.service.menu</field>
        <field name="arch" type="xml">
            <list string="Site Service Menus">
                <field name="name"/>
                <field name="pos_config_id"/>
                <field name="enable_site_service"/>
                <field name="threshold"/>
                <field name="service_product_id"/>
                <field name="service_price"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_pos_site_service_menu_form" model="ir.ui.view">
        <field name="name">pos.site.service.menu.form</field>
        <field name="model">pos.site.service.menu</field>
        <field name="arch" type="xml">
            <form string="Site Service Menu">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Menu name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="pos_config_id"/>
                            <field name="enable_site_service"/>
                            <field name="company_id" groups="base.group_multi_company" invisible="1"/>
                        </group>
                        <group invisible="not enable_site_service">
                            <field name="threshold"/>
                            <field name="service_product_id"/>
                            <field name="service_price"/>
                        </group>
                    </group>
                    <notebook invisible="not enable_site_service">
                        <page string="Products" name="products">
                            <field name="line_ids" nolabel="1">
                                <list editable="bottom">
                                    <field name="product_id"/>
                                    <field name="multiple"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_pos_site_service_menu_search" model="ir.ui.view">
        <field name="name">pos.site.service.menu.search</field>
        <field name="model">pos.site.service.menu</field>
        <field name="arch" type="xml">
            <search string="Site Service Menus">
                <field name="name"/>
                <field name="pos_config_id"/>
                <filter string="Enabled" name="enabled" domain="[('enable_site_service', '=', True)]"/>
                <filter string="Disabled" name="disabled" domain="[('enable_site_service', '=', False)]"/>
                <group>
                    <filter string="Point of Sale" name="group_pos_config" context="{'group_by': 'pos_config_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_pos_site_service_menu" model="ir.actions.act_window">
        <field name="name">Site Service</field>
        <field name="res_model">pos.site.service.menu</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_pos_site_service_menu_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a site service menu for a Point of Sale.
            </p>
            <p>
                Define the threshold, service product, price, and the products included in the score calculation.
            </p>
        </field>
    </record>

    <menuitem id="menu_pos_site_service"
              name="Site Service"
              parent="point_of_sale.menu_point_root"
              action="action_pos_site_service_menu"
              sequence="55"
              groups="point_of_sale.group_pos_manager"/>

</odoo>
