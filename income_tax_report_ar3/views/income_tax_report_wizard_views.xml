<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Wizard Form View -->
    <record id="view_income_tax_report_wizard_form" model="ir.ui.view">
        <field name="name">income.tax.report.wizard.form</field>
        <field name="model">income.tax.report.wizard</field>
        <field name="arch" type="xml">
            <form string="شهادة ضريبة الدخل والرواتب (AR/3)">
                <sheet>
                    <div class="oe_title">
                        <h2>شهادة مجموع الرواتب والأجور والضريبة المقتطعة (AR/3)</h2>
                        <p class="text-muted">
                            النموذج الرسمي المعتمد لدى دائرة ضريبة الدخل والمبيعات الأردنية (QP 177-F3)
                        </p>
                    </div>

                    <group>
                        <group string="معلومات الموظف والشهادة">
                            <field name="employee_id" options="{'no_create': True}"/>
                            <field name="tax_year"/>
                            <field name="months_worked"/>
                            <field name="employee_address" placeholder="اتركه فارغاً أو أدخل العنوان إذا رغبت"/>
                            <field name="report_date"/>
                        </group>
                        <group string="بيانات التعيين وصاحب العمل">
                            <field name="company_id" options="{'no_create': True}"/>
                            <field name="hire_date"/>
                            <field name="end_date" placeholder="اتركه فارغاً إذا كان الموظف على رأس عمله"/>
                            <field name="employer_name"/>
                            <field name="employer_tax_id"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="البيانات المالية (الرواتب والضريبة)" name="financial_data">
                            <div class="row">
                                <div class="col-6" style="border-right: 1px solid #dee2e6; padding-right: 15px;">
                                    <h4 class="text-primary font-weight-bold mb-3">1. إجمالي الرواتب والأجور</h4>
                                    <group>
                                        <field name="gross_salary_wages"/>
                                        <field name="gross_non_monthly"/>
                                        <field name="gross_board_rewards"/>
                                        <field name="gross_eos_pre_2010"/>
                                        <field name="gross_eos_2010_2014"/>
                                        <field name="gross_eos_post_2015"/>
                                        <field name="gross_other_amounts"/>
                                        <field name="gross_total" readonly="1" class="font-weight-bold text-success"/>
                                    </group>
                                </div>
                                <div class="col-6" style="padding-left: 15px;">
                                    <h4 class="text-primary font-weight-bold mb-3">2. الضريبة المقتطعة</h4>
                                    <group>
                                        <field name="tax_salary_wages"/>
                                        <field name="tax_non_monthly"/>
                                        <field name="tax_board_rewards"/>
                                        <field name="tax_eos_pre_2010"/>
                                        <field name="tax_eos_2010_2014"/>
                                        <field name="tax_eos_post_2015"/>
                                        <field name="tax_other_amounts"/>
                                        <field name="tax_national_contrib"/>
                                        <field name="tax_total" readonly="1" class="font-weight-bold text-danger"/>
                                    </group>
                                </div>
                            </div>
                        </page>
                    </notebook>
                </sheet>

                <footer>
                    <button name="action_print_pdf" string="تحميل التقرير (PDF)" type="object" class="btn btn-primary" icon="fa-download"/>
                    <button string="إلغاء" class="btn btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Wizard Action Window -->
    <record id="action_income_tax_report_wizard" model="ir.actions.act_window">
        <field name="name">Income TAX report (AR/3)</field>
        <field name="res_model">income.tax.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" eval="False"/>
    </record>

</odoo>
