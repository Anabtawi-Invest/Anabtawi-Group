<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_employee_form_inherit_employee_request_password" model="ir.ui.view">
        <field name="name">hr.employee.form.employee_request.password</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='hr_settings']/group[@name='settings_group']" position="inside">
                <group string="Employee Request" name="employee_request_group" groups="hr.group_hr_manager">
                    <div colspan="2" class="text-muted mb-2">
                        After Save, "Employee OTP Expires At" must become ~5 minutes from now.
                        If it stays on an old date, the password was not written to the database
                        (form value only). Prefer "Generate OTP".
                    </div>
                    <field name="employee_password" widget="password_eye_char"/>
                    <field name="employee_password_generated_at" readonly="1"/>
                    <field name="employee_password_expires_at" readonly="1"/>
                    <button
                        name="action_generate_employee_portal_otp_button"
                        type="object"
                        string="Generate OTP"
                        class="btn-primary"
                        groups="hr.group_hr_manager"
                    />
                </group>
            </xpath>
        </field>
    </record>
</odoo>
