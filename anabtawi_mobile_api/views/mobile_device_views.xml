<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_anabtawi_mobile_device_list" model="ir.ui.view">
        <field name="name">anabtawi.mobile.device.list</field>
        <field name="model">anabtawi.mobile.device</field>
        <field name="arch" type="xml">
            <list string="Employee App Devices">
                <field name="user_id"/>
                <field name="device_name"/>
                <field name="platform"/>
                <field name="manufacturer"/>
                <field name="model_name"/>
                <field name="app_version"/>
                <field name="registered_ip"/>
                <field name="active"/>
                <field name="last_login"/>
            </list>
        </field>
    </record>

    <record id="view_anabtawi_mobile_device_form" model="ir.ui.view">
        <field name="name">anabtawi.mobile.device.form</field>
        <field name="model">anabtawi.mobile.device</field>
        <field name="arch" type="xml">
            <form string="Employee App Device">
                <header>
                    <button name="action_reset_device" type="object" string="Reset Device"
                            class="btn-primary" confirm="Reset this Employee App device and revoke its tokens?"/>
                </header>
                <sheet>
                    <group>
                        <group string="Employee App">
                            <field name="user_id"/>
                            <field name="device_uid" readonly="1"/>
                            <field name="device_name" readonly="1"/>
                            <field name="active"/>
                            <field name="last_login" readonly="1"/>
                            <field name="registered_ip" readonly="1"/>
                        </group>
                        <group string="Device">
                            <field name="platform" readonly="1"/>
                            <field name="manufacturer" readonly="1"/>
                            <field name="model_name" readonly="1"/>
                            <field name="app_version" readonly="1"/>
                            <field name="token_expires_at" readonly="1"/>
                            <field name="refresh_token_expires_at" readonly="1"/>
                        </group>
                    </group>
                    <group string="Technical" groups="base.group_system">
                        <field name="token_index" readonly="1"/>
                        <field name="refresh_token_index" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_anabtawi_mobile_device" model="ir.actions.act_window">
        <field name="name">Employee App Devices</field>
        <field name="res_model">anabtawi.mobile.device</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_employee_app_settings_root" name="Employee App"
              parent="hr.menu_hr_root" sequence="95" groups="hr.group_hr_manager"/>
    <menuitem id="menu_anabtawi_mobile_device" name="Devices"
              parent="menu_employee_app_settings_root" action="action_anabtawi_mobile_device"
              sequence="10" groups="hr.group_hr_manager"/>
</odoo>
