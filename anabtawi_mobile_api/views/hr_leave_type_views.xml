<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_leave_type_view_form_employee_app_limit" model="ir.ui.view">
        <field name="name">hr.leave.type.view.form.employee.app.limit</field>
        <field name="model">hr.leave.type</field>
        <field name="inherit_id" ref="hr_holidays.edit_holiday_status_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='request_unit']" position="after">
                <field name="employee_app_limit_enabled"/>
                <label for="employee_app_max_request" invisible="not employee_app_limit_enabled"/>
                <div class="o_row" invisible="not employee_app_limit_enabled">
                    <field name="employee_app_max_request" nolabel="1" class="oe_inline"/>
                    <field name="employee_app_max_request_uom" nolabel="1" class="oe_inline"/>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
