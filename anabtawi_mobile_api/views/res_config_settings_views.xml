<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_employee_app_leave_type_list" model="ir.ui.view">
        <field name="name">anabtawi.employee.app.leave.type.list</field>
        <field name="model">anabtawi.employee.app.leave.type</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="leave_type_id"/>
            </list>
        </field>
    </record>

    <record id="res_config_settings_view_form_employee_app_timeoff" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.employee.app.timeoff</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="Time Off" name="anabtawi_employee_app_timeoff" groups="base.group_system">
                    <block title="Employee App" name="employee_app_timeoff_types">
                        <setting string="Time off types in the Employee App" help="Only the time off types added here are shown when an employee requests leave in the app.">
                            <field name="employee_app_leave_type_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="leave_type_id"/>
                                    <field name="company_id" column_invisible="1"/>
                                </list>
                            </field>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <record id="action_employee_app_timeoff_settings" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="context">{'module': 'anabtawi_employee_app_timeoff', 'bin_size': False}</field>
    </record>

    <menuitem
        id="menu_employee_app_timeoff_settings"
        name="Employee App"
        parent="hr_holidays.menu_hr_holidays_configuration"
        action="action_employee_app_timeoff_settings"
        sequence="50"
        groups="base.group_system"/>

    <record id="employee_app_leave_type_company_rule" model="ir.rule">
        <field name="name">Employee App time off types multi-company</field>
        <field name="model_id" ref="model_anabtawi_employee_app_leave_type"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
