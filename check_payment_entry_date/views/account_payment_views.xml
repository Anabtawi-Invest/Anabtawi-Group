<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_payment_form_entry_date" model="ir.ui.view">
        <field name="name">account.payment.form.check.entry.date</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='group1']/field[@name='date']" position="before">
                <field name="is_check_payment" invisible="1"/>
            </xpath>
            <xpath expr="//group[@name='group1']/field[@name='date']" position="attributes">
                <attribute name="invisible">is_check_payment</attribute>
            </xpath>
            <xpath expr="//group[@name='group1']/field[@name='date']" position="after">
                <field name="check_date"
                       invisible="not is_check_payment"
                       required="is_check_payment"/>
            </xpath>
        </field>
    </record>

    <record id="view_account_journal_form_check_entry_date" model="ir.ui.view">
        <field name="name">account.journal.form.check.entry.date</field>
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="account.view_account_journal_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='inbound_payment_method_line_ids']/list/field[@name='name']" position="after">
                <field name="is_check_payment"/>
            </xpath>
            <xpath expr="//field[@name='outbound_payment_method_line_ids']/list/field[@name='name']" position="after">
                <field name="is_check_payment"/>
            </xpath>
        </field>
    </record>
</odoo>
