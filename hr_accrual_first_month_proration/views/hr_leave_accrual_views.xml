<?xml version='1.0' encoding='UTF-8' ?>
<odoo>
    <record id="hr_accrual_plan_view_form_first_month" model="ir.ui.view">
        <field name="name">hr.leave.accrual.plan.form.first.month</field>
        <field name="model">hr.leave.accrual.plan</field>
        <field name="inherit_id" ref="hr_holidays.hr_accrual_plan_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='transition_mode']/parent::span" position="after">
                <label class="fw-bold" for="prorate_first_month" string="Prorate first month:"/>
                <span>
                    <field class="ms-1" name="prorate_first_month"/>
                </span>
                <label class="fw-bold" for="prorate_last_month" string="Prorate last month:"/>
                <span>
                    <field class="ms-1" name="prorate_last_month"/>
                </span>
            </xpath>
        </field>
    </record>
</odoo>
