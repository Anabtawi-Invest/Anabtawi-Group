<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Same xmlid as the old Has Pledge checkbox view: deactivate it on upgrade. -->
    <record id="product_template_form_view_pos_pledge" model="ir.ui.view">
        <field name="name">product.template.form.pos.pledge</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="active" eval="False"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <div class="d-none" groups="base.group_no_one"/>
            </xpath>
        </field>
    </record>
</odoo>
