<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_pos_advance_order_full_receipt">
        <t t-call="web.basic_layout">
            <t t-foreach="docs" t-as="o">
                <div class="page">
                    <div style="max-width: 80mm; font-family: monospace; font-size: 12px;">
                        <div class="text-center" style="border-bottom: 1px dashed #000; padding-bottom: 6px; margin-bottom: 6px;">
                            <div><strong t-esc="o.company_id.name"/></div>
                            <div>Advance Order Receipt (Full Paid)</div>
                            <div t-esc="o.name"/>
                        </div>

                        <div style="margin-bottom: 6px;">
                            <div><strong>Customer:</strong> <span t-esc="o.partner_id.display_name"/></div>
                            <div><strong>Date:</strong> <span t-esc="o.picking_date"/></div>
                            <div t-if="o._get_effective_pricelist()">
                                <strong>Pricelist:</strong>
                                <span t-esc="o._get_effective_pricelist().display_name"/>
                            </div>
                        </div>

                        <div style="border-bottom: 1px dashed #000; padding-bottom: 6px; margin-bottom: 6px;">
                            <table style="width: 100%;">
                                <thead>
                                    <tr>
                                        <th style="text-align:left;">Item</th>
                                        <th style="text-align:right;">Qty</th>
                                        <th style="text-align:right;">Subtotal</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="o.line_ids.filtered(lambda l: not l.display_type)" t-as="l">
                                        <tr>
                                            <td style="text-align:left;">
                                                <span t-esc="l.product_id.display_name"/>
                                            </td>
                                            <td style="text-align:right;">
                                                <span t-esc="l.product_qty"/>
                                            </td>
                                            <td style="text-align:right;">
                                                <span t-esc="o.currency_id.format(l.price_subtotal)"/>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </div>

                        <div style="border-bottom: 1px dashed #000; padding-bottom: 6px; margin-bottom: 6px;">
                            <t t-set="deposit_payments" t-value="o.payment_line_ids.filtered(lambda l: l.payment_stage == 'deposit')"/>
                            <t t-set="completion_payments" t-value="o.payment_line_ids.filtered(lambda l: l.payment_stage == 'completion')"/>
                            <t t-if="deposit_payments">
                                <div><strong>Deposit Payments</strong></div>
                                <t t-foreach="deposit_payments" t-as="pay_line">
                                    <div style="display:flex; justify-content:space-between;">
                                        <span t-esc="pay_line.payment_method_id.display_name"/>
                                        <span t-esc="o.currency_id.format(pay_line.amount)"/>
                                    </div>
                                </t>
                            </t>
                            <t t-elif="o.pos_payment_method_id">
                                <div style="display:flex; justify-content:space-between;">
                                    <span>Deposit Payment</span>
                                    <span t-esc="o.pos_payment_method_id.display_name"/>
                                </div>
                            </t>
                            <t t-if="completion_payments">
                                <div style="margin-top: 4px;"><strong>Completion Payments</strong></div>
                                <t t-foreach="completion_payments" t-as="pay_line">
                                    <div style="display:flex; justify-content:space-between;">
                                        <span t-esc="pay_line.payment_method_id.display_name"/>
                                        <span t-esc="o.currency_id.format(pay_line.amount)"/>
                                    </div>
                                </t>
                            </t>
                            <div style="display:flex; justify-content:space-between;">
                                <span>Total</span>
                                <span t-esc="o.currency_id.format(o.amount_total)"/>
                            </div>
                            <div style="display:flex; justify-content:space-between;">
                                <span>Paid Amount</span>
                                <span t-esc="o.currency_id.format(o.amount_paid)"/>
                            </div>
                            <div style="display:flex; justify-content:space-between;">
                                <span>Amount Tendered</span>
                                <span t-esc="o.currency_id.format(o.amount_tendered)"/>
                            </div>
                            <div style="display:flex; justify-content:space-between;">
                                <span>Change Returned</span>
                                <span t-esc="o.currency_id.format(o.change_amount)"/>
                            </div>
                            <div style="display:flex; justify-content:space-between;">
                                <span>Remaining Amount Tendered</span>
                                <span t-esc="o.currency_id.format(o.remaining_amount_tendered)"/>
                            </div>
                            <div style="display:flex; justify-content:space-between;">
                                <span>Remaining Change Returned</span>
                                <span t-esc="o.currency_id.format(o.remaining_change_amount)"/>
                            </div>
                            <div style="display:flex; justify-content:space-between;">
                                <span>Remaining</span>
                                <span t-esc="o.currency_id.format(0.0)"/>
                            </div>
                        </div>

                        <div class="text-center">
                            <div>Thank you</div>
                        </div>
                    </div>
                </div>
            </t>
        </t>
    </template>
</odoo>

