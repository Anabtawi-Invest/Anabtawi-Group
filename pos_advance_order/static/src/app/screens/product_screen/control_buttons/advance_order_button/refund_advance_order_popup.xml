<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="pos_advance_order.RefundAdvanceOrderPopup" owl="1">
        <Dialog size="'lg'" title="popupTitle">
            <div class="o_pos_refund_advance_popup" t-on-click.stop="">
                <div class="rounded-top px-3 py-2 mb-3 bg-warning text-dark">
                    <span class="fw-bold" t-esc="popupTitle"/>
                    <small class="d-block opacity-75" t-esc="popupSubtitle"/>
                </div>
                <div class="form-group mb-3">
                    <label><strong t-esc="searchLabel"/></label>
                    <input
                        type="text"
                        class="form-control"
                        t-att-placeholder="searchPlaceholder"
                        t-att-value="state.search"
                        t-on-input="onSearchInput"
                        t-att-disabled="state.loading ? 'disabled' : undefined"
                    />
                </div>

                <div class="table-responsive border rounded" style="max-height: 360px; overflow: auto;">
                    <table class="table table-sm table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th style="width: 32px;"></th>
                                <th t-esc="colAdvanceLabel"/>
                                <th t-esc="colCustomerLabel"/>
                                <th t-esc="colPhoneLabel"/>
                                <th t-esc="colPickingPosLabel"/>
                                <th t-esc="colTotalLabel"/>
                                <th t-esc="colRefundLabel"/>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-if="!filteredOrders.length">
                                <tr>
                                    <td colspan="7" class="text-center text-muted py-3">
                                        <t t-esc="noOrdersText"/>
                                    </td>
                                </tr>
                            </t>
                            <t t-foreach="filteredOrders" t-as="order" t-key="order.id">
                                <tr t-on-click="() => this.selectOrder(order.id)" style="cursor: pointer;">
                                    <td>
                                        <input
                                            type="radio"
                                            name="selected_refund_advance_order"
                                            t-att-checked="state.selected_order_id === order.id"
                                            t-on-click.stop="() => this.selectOrder(order.id)"
                                        />
                                    </td>
                                    <td t-esc="order.name"/>
                                    <td t-esc="order.partner_id and order.partner_id[1] or ''"/>
                                    <td t-esc="order.partner_phone || ''"/>
                                    <td t-esc="order.pos_config_id and order.pos_config_id[1] or ''"/>
                                    <td t-esc="order.amount_total"/>
                                    <td class="fw-bold text-danger" t-esc="order.advance_amount"/>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>

                <div t-if="state.selected_order_id" class="alert alert-warning mt-3 mb-0">
                    <div>
                        <strong t-esc="colRefundLabel"/>:
                        <span t-esc="selectedRefundAmountFmt"/>
                    </div>
                    <small class="d-block mt-1" t-esc="refundHintText"/>
                </div>
            </div>

            <t t-set-slot="footer">
                <button class="btn btn-secondary" t-on-click.stop="cancel" t-esc="cancelButtonLabel"/>
                <button
                    class="btn btn-warning"
                    t-on-click.stop="confirm"
                    t-att-disabled="state.loading or !state.selected_order_id ? 'disabled' : undefined"
                >
                    <t t-esc="refundButtonLabel"/>
                </button>
            </t>
        </Dialog>
    </t>
</templates>
