<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="pos_advance_order.AdvanceOrderReceipt">
        <div class="pos-receipt advance-order-receipt">
            <!-- Header -->
            <div class="advance-receipt-header">
                <div class="fw-bolder fs-5" t-esc="props.receipt.companyName"/>
                <div class="text-muted" t-esc="props.receipt.posName"/>
                <div t-if="!props.receipt.isRefund" class="advance-receipt-title">ADVANCE ORDER RECEIPT</div>
                <div t-if="props.receipt.isRefund" class="advance-receipt-title">ADVANCE REFUND RECEIPT</div>
                <div class="advance-receipt-ref" t-esc="props.receipt.reference"/>
            </div>

            <!-- Customer & payment info -->
            <div class="advance-receipt-meta">
                <div class="advance-receipt-meta-row">
                    <span>Date</span>
                    <span t-esc="props.receipt.date"/>
                </div>
                <div class="advance-receipt-meta-row">
                    <span>Customer</span>
                    <span t-esc="props.receipt.customerName"/>
                </div>
                <div t-if="props.receipt.customerPhone" class="advance-receipt-meta-row">
                    <span>Phone</span>
                    <span t-esc="props.receipt.customerPhone"/>
                </div>
                <div class="advance-receipt-meta-row">
                    <span>Payment</span>
                    <span t-esc="paymentMethodLabel"/>
                </div>
            </div>

            <!-- Order lines -->
            <div t-if="!props.receipt.isRefund">
                <div class="advance-receipt-lines-header">
                    <span class="advance-col-item">Item</span>
                    <span class="advance-col-qty">Qty</span>
                    <span class="advance-col-price">Amount</span>
                </div>
                <t t-foreach="props.receipt.lines" t-as="line" t-key="line_index">
                    <div class="advance-receipt-line">
                        <span class="advance-col-item" t-esc="line.name"/>
                        <span class="advance-col-qty" t-esc="line.qty"/>
                        <span class="advance-col-price" t-esc="formatCurrency(line.subtotal)"/>
                    </div>
                </t>
            </div>

            <!-- Amounts summary -->
            <div class="advance-receipt-summary">
                <div t-if="!props.receipt.isRefund" class="advance-summary-row">
                    <span>Order Total</span>
                    <span t-esc="formatCurrency(props.receipt.total)"/>
                </div>
                <div t-if="props.receipt.isRefund" class="advance-summary-row">
                    <span>Original Order Total</span>
                    <span t-esc="formatCurrency(props.receipt.total)"/>
                </div>
                <div t-if="!props.receipt.isRefund and props.receipt.pledgeAmount > 0" class="advance-summary-row advance-pledge-row">
                    <span>Pledge Amount</span>
                    <span t-esc="formatCurrency(props.receipt.pledgeAmount)"/>
                </div>
                <div t-if="!props.receipt.isRefund" class="advance-summary-row advance-deposit-row">
                    <span>Advance Paid (Deposit)</span>
                    <span t-esc="formatCurrency(props.receipt.advanceAmount)"/>
                </div>
                <div t-if="props.receipt.isRefund" class="advance-summary-row">
                    <span>Refunded to Customer</span>
                    <span class="text-danger fw-bolder" t-esc="formatCurrency(props.receipt.advanceAmount)"/>
                </div>
                <div t-if="!props.receipt.isRefund" class="advance-summary-row">
                    <span>Amount Tendered</span>
                    <span t-esc="formatCurrency(props.receipt.amountTendered)"/>
                </div>
                <div t-if="!props.receipt.isRefund and props.receipt.changeDue > 0" class="advance-summary-row advance-change-row">
                    <span>Change Returned</span>
                    <span t-esc="formatCurrency(props.receipt.changeDue)"/>
                </div>
                <div t-if="!props.receipt.isRefund" class="advance-summary-row advance-remaining-row">
                    <span>Remaining Balance</span>
                    <span t-esc="formatCurrency(props.receipt.remainingAmount)"/>
                </div>
            </div>

            <div t-if="!props.receipt.isRefund and props.receipt.remainingAmount > 0" class="advance-receipt-note">
                Please pay the remaining balance when picking up your order.
            </div>

            <div class="advance-receipt-footer">
                <div>Thank you for your order!</div>
            </div>
        </div>
    </t>
</templates>
