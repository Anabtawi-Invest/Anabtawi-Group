<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- 2. Header Button on Payslips List View inside Payrun -->
    <record id="view_hr_payslip_list_pfr_bank" model="ir.ui.view">
        <field name="name">hr.payslip.list.pfr.bank</field>
        <field name="model">hr.payslip</field>
        <field name="inherit_id" ref="hr_payroll.view_hr_payslip_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list/header" position="inside">
                <button string="Export Bank File"
                        name="action_export_bank_xlsx"
                        type="object"
                        class="btn-secondary"
                        groups="hr_payroll.group_hr_payroll_user"
                        icon="fa-university"/>
            </xpath>
        </field>
    </record>

    <!-- 3. Action Menu on Pay Run (Form & List View) -->
    <record id="action_payrun_export_bank_server" model="ir.actions.server">
        <field name="name">Export Bank File</field>
        <field name="model_id" ref="hr_payroll.model_hr_payslip_run"/>
        <field name="binding_model_id" ref="hr_payroll.model_hr_payslip_run"/>
        <field name="binding_view_types">form,list</field>
        <field name="state">code</field>
        <field name="code">
action = records.action_export_bank_xlsx()
        </field>
    </record>
</odoo>
