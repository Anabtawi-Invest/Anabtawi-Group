<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pfr_advance_wizard_form" model="ir.ui.view">
        <field name="name">pfr.advance.wizard.form</field>
        <field name="model">pfr.advance.wizard</field>
        <field name="arch" type="xml">
            <form string="Mid-month Advance">
                <field name="state" invisible="1"/>
                <group>
                    <group>
                        <field name="date_cutoff" readonly="state == 'done'"/>
                        <field name="advance_percent"/>
                        <field name="input_type_id" options="{'no_create': True}"/>
                    </group>
                    <group>
                        <field name="month_start"/>
                        <field name="employee_ids" widget="many2many_tags"/>
                        <field name="total_advance"/>
                    </group>
                </group>
                <field name="line_ids" invisible="state == 'draft'">
                    <list editable="bottom" create="0" delete="0">
                        <field name="selected"/>
                        <field name="employee_id"/>
                        <field name="wage" optional="hide"/>
                        <field name="worked_days"/>
                        <field name="rest_days"/>
                        <field name="absent_days"/>
                        <field name="lateness_hours" widget="float_time"/>
                        <field name="covered_hours" widget="float_time"/>
                        <field name="cash_hours" widget="float_time"/>
                        <field name="earned"/>
                        <field name="advance"/>
                        <field name="note"/>
                    </list>
                </field>
                <footer>
                    <button name="action_calculate" type="object" string="Calculate" class="btn-primary"
                            invisible="state == 'done'"/>
                    <button name="action_create_adjustments" type="object" string="Create Salary Adjustments"
                            class="btn-primary" invisible="state != 'calculated'"
                            confirm="Create a One Time Salary Adjustment for every selected employee?"/>
                    <button string="Close" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_pfr_advance_wizard" model="ir.actions.act_window">
        <field name="name">Mid-month Advance</field>
        <field name="res_model">pfr.advance.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_pfr_advance_wizard" name="Mid-month Advance"
              parent="hr_payroll.menu_hr_payroll_report" action="action_pfr_advance_wizard" sequence="55"/>
</odoo>
