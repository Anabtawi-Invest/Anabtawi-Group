<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pfr_advance_wizard_form" model="ir.ui.view">
        <field name="name">pfr.advance.wizard.form</field>
        <field name="model">pfr.advance.wizard</field>
        <field name="arch" type="xml">
            <form string="Mid-month Advance">
                <field name="state" invisible="1"/>
                <div class="alert alert-info d-flex align-items-center justify-content-between mb-3" role="alert" invisible="state != 'done'">
                    <div>
                        <strong>Salary Adjustments Done / Historical Run Loaded.</strong>
                        <div>You can re-download the <strong>Audit XLSX</strong> or the <strong>Bank Transfer File</strong>, or <strong>Cash Sheet</strong> anytime below.</div>
                    </div>
                    <button name="action_reset_draft" type="object" string="New Advance Run"
                            class="btn btn-sm btn-outline-primary" icon="fa-refresh"/>
                </div>
                <group string="Previous Advance Runs (Log &amp; Re-export)">
                    <field name="history_batch" widget="selection" placeholder="Select a past completed run from the log..."/>
                    <div>
                        <button name="action_load_history" type="object" string="Load Past Run"
                                class="btn btn-secondary me-2" invisible="not history_batch" icon="fa-history"/>
                        <button name="action_view_salary_attachments" type="object" string="View All in Salary Attachments"
                                class="btn btn-link" icon="fa-external-link"/>
                    </div>
                </group>
                <group string="Advance Parameters" invisible="state == 'done'">
                    <group>
                        <field name="company_id" options="{'no_create': True, 'no_open': True}"/>
                        <field name="date_cutoff"/>
                        <field name="advance_percent"/>
                        <field name="batch_name"/>
                        <field name="input_type_id" options="{'no_create': True}"/>
                    </group>
                    <group>
                        <field name="month_start"/>
                        <field name="employee_ids" widget="many2many_tags" domain="[('company_id', '=', company_id)]" options="{'no_create': True}"/>
                        <field name="total_advance"/>
                    </group>
                </group>
                <group string="Active Run Summary" invisible="state != 'done'">
                    <group>
                        <field name="company_id" readonly="1" options="{'no_create': True, 'no_open': True}"/>
                        <field name="date_cutoff" readonly="1"/>
                        <field name="month_start" readonly="1"/>
                    </group>
                    <group>
                        <field name="total_advance" readonly="1"/>
                    </group>
                </group>
                <group string="Excel Adjustments (Offline Review)" invisible="state == 'done'">
                    <field name="file_name" invisible="1"/>
                    <field name="excel_file" filename="file_name" placeholder="Upload modified Excel to adjust advance amounts"/>
                </group>
                <field name="line_ids" invisible="state == 'draft'">
                    <list editable="bottom" create="0" delete="0">
                        <field name="selected"/>
                        <field name="employee_id"/>
                        <field name="start_date" optional="show"/>
                        <field name="wage" optional="hide"/>
                        <field name="worked_days" string="Attendance Days"/>
                        <field name="rest_days" optional="hide"/>
                        <field name="absent_days" string="Absent Days"/>
                        <field name="sick_leave_days" optional="show"/>
                        <field name="annual_leave_days" optional="show"/>
                        <field name="other_paid_leave_days" optional="hide"/>
                        <field name="annual_leave_balance" optional="show"/>
                        <field name="extra_hours_balance" optional="show"/>
                        <field name="paid_leave_balance" optional="hide"/>
                        <field name="paid_days" optional="hide"/>
                        <field name="daily_wage" optional="hide"/>
                        <field name="deduction"/>
                        <field name="earned"/>
                        <field name="advance"/>
                        <field name="note"/>
                    </list>
                </field>
                <footer>
                    <button name="action_calculate" type="object" string="Calculate" class="btn-primary"
                            invisible="state == 'done'"/>
                    <button name="action_import_xlsx" type="object" string="Import XLSX" class="btn-secondary"
                            invisible="state == 'done' or not excel_file" icon="fa-upload"/>
                    <button name="action_create_adjustments" type="object" string="Create Salary Adjustments"
                            class="btn-primary" invisible="state != 'calculated'"
                            confirm="Create a One Time Salary Adjustment for every selected employee?"/>
                    <button name="action_export_xlsx" type="object" string="Export XLSX"
                            invisible="state == 'draft'" icon="fa-download"/>
                    <button name="action_export_bank_xlsx" type="object" string="Export Bank File"
                            invisible="state == 'draft'" icon="fa-university"/>
                    <button name="action_export_cash_xlsx" type="object" string="Export Cash Sheet"
                            invisible="state == 'draft'" icon="fa-money"/>
                    <button string="Close" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_pfr_advance_wizard" model="ir.actions.act_window">
        <field name="name">Mid-month Advance</field>
        <field name="res_model">pfr.advance.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_pfr_advance_wizard" name="Mid-month Advance"
              parent="hr_payroll.menu_hr_payroll_report" action="action_pfr_advance_wizard" sequence="55"/>
</odoo>
