<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherit Attendance Form View -->
    <record id="hr_attendance_view_form_inherit_recon" model="ir.ui.view">
        <field name="name">hr.attendance.form.inherit.recon</field>
        <field name="model">hr.attendance</field>
        <field name="inherit_id" ref="hr_attendance.hr_attendance_view_form"/>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='overtime_status']" position="attributes">
                <attribute name="options">{'clickable': '1'}</attribute>
            </xpath>
            <xpath expr="//button[@name='action_approve_overtime']" position="attributes">
                <attribute name="invisible">overtime_status not in ['to_approve', 'refused'] or not overtime_status or daily_overtime_hours &lt; 0.75</attribute>
            </xpath>
            <xpath expr="//field[@name='overtime_hours']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='worked_hours']" position="after">
                <field name="attendance_break_hours" widget="float_time" readonly="1" string="Lunch Break Deducted"/>
                <field name="net_worked_hours" widget="float_time" readonly="1" string="Net Worked Hours"/>
                <field name="daily_undertime_hours" widget="float_time" readonly="1" string="Daily Lateness"/>
                <field name="daily_overtime_hours" widget="float_time" readonly="1" string="Daily Extra Hours"/>
            </xpath>
        </field>
    </record>

    <!-- Inherit Attendance Tree/List View -->
    <record id="view_attendance_tree_inherit_recon" model="ir.ui.view">
        <field name="name">hr.attendance.tree.inherit.recon</field>
        <field name="model">hr.attendance</field>
        <field name="inherit_id" ref="hr_attendance.view_attendance_tree"/>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='worked_hours']" position="after">
                <field name="net_worked_hours" widget="float_time" optional="show" string="Net Worked Hours"/>
                <field name="daily_undertime_hours" widget="float_time" optional="show" string="Daily Lateness"/>
                <field name="daily_overtime_hours" widget="float_time" optional="show" string="Daily Extra Hours"/>
                <button name="action_approve_factory_overtime" type="object" icon="fa-check text-success"
                        title="Approve Extra Hours"
                        invisible="daily_overtime_hours &lt; 0.75 or overtime_status == 'approved'"/>
                <button name="action_refuse_factory_overtime" type="object" icon="fa-times text-danger"
                        title="Refuse Extra Hours"
                        invisible="daily_overtime_hours &lt; 0.75 or overtime_status == 'refused'"/>
            </xpath>
        </field>
    </record>

    <!-- Inherit Attendance Tree Management View -->
    <record id="view_attendance_tree_management_inherit_recon" model="ir.ui.view">
        <field name="name">hr.attendance.tree.management.inherit.recon</field>
        <field name="model">hr.attendance</field>
        <field name="inherit_id" ref="hr_attendance.view_attendance_tree_management"/>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='worked_hours']" position="after">
                <field name="net_worked_hours" widget="float_time" optional="show" string="Net Worked Hours"/>
                <field name="daily_undertime_hours" widget="float_time" optional="show" string="Daily Lateness"/>
                <field name="daily_overtime_hours" widget="float_time" optional="show" string="Daily Extra Hours"/>
            </xpath>
        </field>
    </record>
</odoo>
