<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Default Scoring Dimensions -->
        <record id="dimension_skills" model="ai.scoring.dimension">
            <field name="name">Skills Match</field>
            <field name="code">skills</field>
            <field name="icon">🔧</field>
            <field name="weight">35</field>
            <field name="sequence">10</field>
            <field name="is_default">True</field>
            <field name="color">#714B67</field>
            <field name="description">Evaluate how closely the candidate technical and soft skills match the required and preferred skills specified for the job position.</field>
        </record>

        <record id="dimension_experience" model="ai.scoring.dimension">
            <field name="name">Experience Relevance</field>
            <field name="code">experience</field>
            <field name="icon">📊</field>
            <field name="weight">30</field>
            <field name="sequence">20</field>
            <field name="is_default">True</field>
            <field name="color">#00A09D</field>
            <field name="description">Assess the candidate career trajectory, total years of relevant work experience, and industry relevance.</field>
        </record>

        <record id="dimension_education" model="ai.scoring.dimension">
            <field name="name">Education &amp; Qualifications</field>
            <field name="code">education</field>
            <field name="icon">🎓</field>
            <field name="weight">15</field>
            <field name="sequence">30</field>
            <field name="is_default">True</field>
            <field name="color">#F0AD4E</field>
            <field name="description">Check degree level, field of study, relevant certifications, and continuous learning indicator.</field>
        </record>

        <record id="dimension_cultural" model="ai.scoring.dimension">
            <field name="name">Cultural Fit &amp; Soft Skills</field>
            <field name="code">cultural_fit</field>
            <field name="icon">🤝</field>
            <field name="weight">20</field>
            <field name="sequence">40</field>
            <field name="is_default">True</field>
            <field name="color">#5CB85C</field>
            <field name="description">Evaluate teamwork, communication skills, adaptability, leadership potential, and alignment with organizational culture.</field>
        </record>

    </data>
</odoo>
