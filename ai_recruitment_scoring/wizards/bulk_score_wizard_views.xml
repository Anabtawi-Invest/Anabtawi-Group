<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!-- Wizard Form View                                             -->
    <!-- ============================================================ -->
    <record id="view_bulk_score_wizard_form" model="ir.ui.view">
        <field name="name">ai.recruitment.bulk.score.wizard.form</field>
        <field name="model">ai.recruitment.bulk.score.wizard</field>
        <field name="arch" type="xml">
            <form string="Bulk AI Scoring">
                <header>
                    <button name="action_start_bulk_scoring"
                            string="🚀 Start AI Analysis"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button string="Close"
                            class="btn-secondary"
                            special="cancel"
                            invisible="state != 'done'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,processing,done"/>
                </header>
                <sheet>
                    <group invisible="state != 'draft'">
                        <group>
                            <field name="mode"/>
                            <field name="total_count" readonly="1"/>
                        </group>
                    </group>
                    <group invisible="state == 'draft'">
                        <group>
                            <field name="progress_count"/>
                            <field name="total_count"/>
                        </group>
                    </group>
                    <group invisible="state != 'draft'">
                        <field name="applicant_ids" widget="many2many_tags"
                               options="{'no_create': True}"/>
                    </group>
                    <group invisible="state == 'draft'">
                        <field name="result_log" readonly="1"
                               widget="text" nolabel="1" colspan="2"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action to open the wizard -->
    <record id="action_bulk_score_wizard" model="ir.actions.act_window">
        <field name="name">Bulk AI Scoring</field>
        <field name="res_model">ai.recruitment.bulk.score.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="hr_recruitment.model_hr_applicant"/>
        <field name="binding_view_types">list</field>
    </record>

</odoo>
