<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!-- hr.applicant Form View — AI Analysis Tab                     -->
    <!-- ============================================================ -->
    <record id="hr_applicant_view_form_ai" model="ir.ui.view">
        <field name="name">hr.applicant.form.inherit.ai.recruitment</field>
        <field name="model">hr.applicant</field>
        <field name="inherit_id" ref="hr_recruitment.hr_applicant_view_form"/>
        <field name="arch" type="xml">

            <!-- Add AI action buttons to the header -->
            <xpath expr="//header" position="inside">
                <button name="action_ai_analyze"
                        string="🤖 AI Analyze CV"
                        type="object"
                        class="btn-primary"
                        groups="ai_recruitment_scoring.group_ai_recruitment_user"
                        help="Extract CV text and run full AI analysis (scoring + summary + questions)"/>
                <button name="action_ai_generate_questions"
                        string="💡 Generate Questions"
                        type="object"
                        class="btn-secondary"
                        groups="ai_recruitment_scoring.group_ai_recruitment_user"
                        help="Re-generate interview questions based on existing CV text"/>
                <button name="action_clear_ai_data"
                        string="🗑️ Clear AI Data"
                        type="object"
                        class="btn-link text-danger"
                        groups="ai_recruitment_scoring.group_ai_recruitment_manager"
                        confirm="Are you sure you want to clear all AI analysis data for this applicant?"/>
            </xpath>

            <!-- Add AI Score badge near the top of the form -->
            <xpath expr="//div[hasclass('oe_title')]" position="after">
                <div class="row" invisible="ai_score == 0">
                    <div class="col-md-12">
                        <div class="alert alert-info d-flex align-items-center py-2 mb-3"
                             role="alert" style="border-radius: 8px;">
                            <strong class="me-2">🤖 AI Score:</strong>
                            <field name="ai_score" widget="progressbar"
                                   options="{'max_value': 100, 'editable': false}"
                                   style="width: 200px;"/>
                            <span class="ms-2 badge rounded-pill"
                                  style="font-size: 14px;">
                                <field name="ai_score_label"/>
                            </span>
                            <span class="ms-auto text-muted small">
                                Analyzed: <field name="ai_analyzed_date" widget="datetime"/>
                            </span>
                        </div>
                    </div>
                </div>
            </xpath>

            <!-- Add AI Analysis notebook page -->
            <xpath expr="//notebook" position="inside">
                <page string="🤖 AI Analysis" name="ai_analysis">

                    <!-- Dynamic Dimension Scores -->
                    <group string="AI Scoring Breakdown" invisible="not ai_score_ids">
                        <field name="ai_score_ids" nolabel="1" colspan="2" readonly="1">
                            <list decoration-success="score >= 70"
                                  decoration-warning="score >= 40 and score &lt; 70"
                                  decoration-danger="score &lt; 40"
                                  create="0" delete="0" edit="0">
                                <field name="dimension_icon" string=" " width="30px"/>
                                <field name="dimension_id" string="Dimension"/>
                                <field name="score" widget="progressbar"
                                       options="{'max_value': 100}"/>
                                <field name="weight" string="Weight %"/>
                                <field name="weighted_score" string="Weighted"/>
                            </list>
                        </field>
                    </group>

                    <!-- Strengths & Weaknesses -->
                    <group string="Assessment" col="2"
                           invisible="not ai_strengths and not ai_weaknesses">
                        <group>
                            <field name="ai_strengths" widget="text" readonly="1"
                                   string="✅ Key Strengths"/>
                        </group>
                        <group>
                            <field name="ai_weaknesses" widget="text" readonly="1"
                                   string="⚠️ Areas of Concern"/>
                        </group>
                    </group>

                    <!-- AI Summary -->
                    <group string="AI Candidate Summary"
                           invisible="not ai_summary">
                        <field name="ai_summary" nolabel="1" colspan="2"
                               readonly="1" widget="html"/>
                    </group>

                    <!-- Interview Questions -->
                    <group string="AI Interview Questions"
                           invisible="not ai_questions">
                        <field name="ai_questions" nolabel="1" colspan="2"
                               readonly="1" widget="html"/>
                    </group>

                    <!-- Skill Gap Data (raw, for developers/export) -->
                    <group string="Skill Gap Analysis (Raw Data)"
                           invisible="not ai_skill_gaps"
                           groups="base.group_no_one">
                        <field name="ai_skill_gaps" widget="text" readonly="1"
                               nolabel="1" colspan="2"/>
                    </group>

                    <!-- Cached CV Text (debug mode) -->
                    <group string="Extracted CV Text"
                           invisible="not ai_cv_text"
                           groups="base.group_no_one">
                        <field name="ai_cv_text" widget="text" readonly="1"
                               nolabel="1" colspan="2"/>
                    </group>

                </page>
            </xpath>

        </field>
    </record>

    <!-- ============================================================ -->
    <!-- hr.applicant Kanban View — AI Score Badge                    -->
    <!-- ============================================================ -->
    <record id="hr_applicant_view_kanban_ai" model="ir.ui.view">
        <field name="name">hr.applicant.kanban.inherit.ai.recruitment</field>
        <field name="model">hr.applicant</field>
        <field name="inherit_id" ref="hr_recruitment.hr_kanban_view_applicant"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='application_status']" position="after">
                <field name="ai_score"/>
            </xpath>
            <xpath expr="//footer//field[@name='user_id']" position="before">
                <span t-if="record.ai_score.raw_value > 0"
                      t-attf-class="badge rounded-pill #{record.ai_score.raw_value >= 70 ? 'text-bg-success' : record.ai_score.raw_value >= 40 ? 'text-bg-warning' : 'text-bg-danger'}"
                      t-att-title="'AI Score'"
                      style="font-size: 11px;">
                    🤖 <t t-esc="Math.round(record.ai_score.raw_value)"/>/100
                </span>
            </xpath>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- hr.applicant Tree View — AI Score Column                     -->
    <!-- ============================================================ -->
    <record id="hr_applicant_view_tree_ai" model="ir.ui.view">
        <field name="name">hr.applicant.tree.inherit.ai.recruitment</field>
        <field name="model">hr.applicant</field>
        <field name="inherit_id" ref="hr_recruitment.crm_case_tree_view_job"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='stage_id']" position="after">
                <field name="ai_score" string="AI Score"
                       widget="progressbar"
                       options="{'max_value': 100, 'editable': false}"
                       optional="show"/>
            </xpath>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- Search View — Filter by AI Score                             -->
    <!-- ============================================================ -->
    <record id="hr_applicant_view_search_ai" model="ir.ui.view">
        <field name="name">hr.applicant.search.inherit.ai.recruitment</field>
        <field name="model">hr.applicant</field>
        <field name="inherit_id" ref="hr_recruitment.hr_applicant_view_search"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <separator/>
                <filter string="AI Scored" name="ai_scored"
                        domain="[('ai_score', '>', 0)]"/>
                <filter string="Excellent Match (≥85)" name="ai_excellent"
                        domain="[('ai_score', '>=', 85)]"/>
                <filter string="Strong Match (≥70)" name="ai_strong"
                        domain="[('ai_score', '>=', 70)]"/>
                <filter string="Moderate Match (≥50)" name="ai_moderate"
                        domain="[('ai_score', '>=', 50)]"/>
                <filter string="Weak Match (&lt;50)" name="ai_weak"
                        domain="[('ai_score', '>', 0), ('ai_score', '&lt;', 50)]"/>
                <filter string="Not Scored" name="ai_not_scored"
                        domain="[('ai_score', '=', 0)]"/>
                <separator/>
                <group expand="0" string="Group By">
                    <filter string="AI Score Label" name="group_ai_label"
                            context="{'group_by': 'ai_score_label'}"/>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
