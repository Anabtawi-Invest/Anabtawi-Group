<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!-- Menu Items                                                   -->
    <!-- ============================================================ -->

    <!-- AI Recruitment Settings action -->
    <record id="action_ai_recruitment_settings" model="ir.actions.act_window">
        <field name="name">AI Recruitment Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="context">{'module': 'ai_recruitment_scoring'}</field>
    </record>

    <!-- Scoring Dimensions menu under Recruitment → Configuration -->
    <menuitem id="menu_ai_scoring_dimensions"
              name="AI Scoring Dimensions"
              action="action_ai_scoring_dimensions"
              parent="hr_recruitment.menu_hr_recruitment_configuration"
              sequence="50"
              groups="ai_recruitment_scoring.group_ai_recruitment_manager"/>

</odoo>
