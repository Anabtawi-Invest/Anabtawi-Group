<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!-- res.config.settings Form View (Inherit)                      -->
    <!-- ============================================================ -->
    <record id="res_config_settings_view_form_ai_recruitment" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.ai.recruitment</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="AI Recruitment" string="AI Recruitment"
                     data-key="ai_recruitment_scoring">
                    <block title="AI Provider Configuration"
                           help="Configure the AI engine used for CV analysis and scoring.">
                        <setting title="AI Provider"
                                 help="Choose between Google Gemini or OpenAI for recruitment AI features.">
                            <div class="content-group">
                                <div class="row mt16">
                                    <label for="ai_provider" class="col-lg-3 o_light_label"/>
                                    <field name="ai_provider" class="col-lg-4"/>
                                </div>
                                <div class="row mt8">
                                    <label for="ai_api_key" class="col-lg-3 o_light_label"/>
                                    <field name="ai_api_key" class="col-lg-4"
                                           password="True"/>
                                </div>
                                <div class="row mt8">
                                    <label for="ai_model" class="col-lg-3 o_light_label"/>
                                    <field name="ai_model" class="col-lg-4"
                                           placeholder="e.g. gemini-2.0-flash or gpt-4o"/>
                                </div>
                            </div>
                        </setting>
                        <setting title="Response Settings"
                                 help="Control language and generation parameters.">
                            <div class="content-group">
                                <div class="row mt16">
                                    <label for="ai_language" class="col-lg-3 o_light_label"/>
                                    <field name="ai_language" class="col-lg-4"/>
                                </div>
                                <div class="row mt8">
                                    <label for="ai_max_questions" class="col-lg-3 o_light_label"/>
                                    <field name="ai_max_questions" class="col-lg-2"/>
                                </div>
                                <div class="row mt8">
                                    <label for="ai_temperature" class="col-lg-3 o_light_label"/>
                                    <field name="ai_temperature" class="col-lg-2"
                                           widget="float"
                                           options="{'step': 0.1}"/>
                                </div>
                            </div>
                        </setting>
                    </block>
                    <block title="Notifications"
                           help="Configure how users are notified when AI analysis completes.">
                        <setting title="Odoo Notifications"
                                 help="Send Odoo internal notifications (chatter/inbox) on analysis completion.">
                            <div class="content-group">
                                <div class="row mt16">
                                    <label for="ai_notify_odoo" class="col-lg-3 o_light_label"/>
                                    <field name="ai_notify_odoo" class="col-lg-1"/>
                                </div>
                            </div>
                        </setting>
                        <setting title="Email Notifications (Optional)"
                                 help="Also send an email when AI analysis completes. Useful for bulk scoring.">
                            <div class="content-group">
                                <div class="row mt16">
                                    <label for="ai_notify_email" class="col-lg-3 o_light_label"/>
                                    <field name="ai_notify_email" class="col-lg-1"/>
                                </div>
                            </div>
                        </setting>
                        <setting title="Notify Additional Users"
                                 help="Select users who should always be notified (in addition to the user who triggered the analysis).">
                            <div class="content-group">
                                <div class="row mt16">
                                    <label for="ai_notify_user_ids" class="col-lg-3 o_light_label"/>
                                    <field name="ai_notify_user_ids" class="col-lg-6"
                                           widget="many2many_tags"
                                           options="{'no_create': True}"/>
                                </div>
                            </div>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

</odoo>
