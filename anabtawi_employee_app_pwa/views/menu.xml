<odoo>
    <!-- URL-only entry: /employee-portal. The app remains upgradeable in Apps. -->
    <record id="action_employee_app_pwa" model="ir.actions.act_url">
        <field name="name">Employee App</field>
        <field name="url">/employee-portal</field>
        <field name="target">self</field>
    </record>

    <menuitem
        id="menu_employee_app_pwa_root"
        name="Employee App"
        sequence="9999"
        action="action_employee_app_pwa"
        groups="base.group_no_one"/>
</odoo>
