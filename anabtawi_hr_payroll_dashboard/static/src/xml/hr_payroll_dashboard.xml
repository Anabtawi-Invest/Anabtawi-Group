<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="anabtawi_hr_payroll_dashboard.HrPayrollDashboard" owl="1">
        <div class="o_hr_payroll_dashboard_wrapper">
            <!-- Header & Filter Toolbar -->
            <div class="o_hr_dashboard_header">
                <div class="o_dashboard_title">
                    <h2><i class="fa fa-users text-primary"/> HR &amp; Payroll Executive Dashboard</h2>
                    <span class="subtitle">
                        Unified corporate payroll, overtime, attendance &amp; bank payment analytics
                        <t t-if="data.date_from and data.date_to">
                            (<t t-esc="data.date_from"/> to <t t-esc="data.date_to"/>)
                        </t>
                    </span>
                </div>
                <div class="o_dashboard_filters">
                    <!-- Quick Date Range Buttons -->
                    <div class="btn-group btn-group-period" role="group">
                        <button type="button" class="btn btn-outline-primary" t-att-class="{'active': state.period === 'this_month'}" t-on-click="() => this.setPeriod('this_month')">This Month</button>
                        <button type="button" class="btn btn-outline-primary" t-att-class="{'active': state.period === 'prev_month'}" t-on-click="() => this.setPeriod('prev_month')">Prev Month</button>
                        <button type="button" class="btn btn-outline-primary" t-att-class="{'active': state.period === 'this_quarter'}" t-on-click="() => this.setPeriod('this_quarter')">Quarter</button>
                        <button type="button" class="btn btn-outline-primary" t-att-class="{'active': state.period === 'this_year'}" t-on-click="() => this.setPeriod('this_year')">This Year</button>
                    </div>

                    <!-- Payrun Batch Selector Dropdown -->
                    <select class="form-select filter_select" t-on-change="onPayrunChange">
                        <option value="0">-- All / Custom Range --</option>
                        <t t-foreach="data.payrun_batches" t-as="batch" t-key="batch.id">
                            <option t-att-value="batch.id" t-att-selected="state.payrun_id === batch.id">
                                <t t-esc="batch.name"/> (<t t-esc="batch.date_start"/>)
                            </option>
                        </t>
                    </select>

                    <div class="d-flex align-items-center gap-2">
                        <input type="date" class="form-control filter_input" t-model="state.date_from"/>
                        <span class="text-muted">to</span>
                        <input type="date" class="form-control filter_input" t-model="state.date_to"/>
                        <button class="btn btn-primary" t-on-click="fetchDashboardData">
                            <i class="fa fa-refresh me-1"/> Apply
                        </button>
                        <button class="btn btn-success ms-1" t-on-click="exportExcel">
                            <i class="fa fa-file-excel-o me-1"/> Export Full Excel Package
                        </button>
                    </div>
                </div>
            </div>

            <!-- Department Selector Tabs -->
            <div class="o_department_selector_bar mb-4">
                <ul class="nav nav-pills department_pills">
                    <li class="nav-item">
                        <button type="button" class="nav-link" t-att-class="{'active': isDeptSelected('all')}" t-on-click="() => this.selectDepartment('all')">
                            <i class="fa fa-th-large me-1"/> All Departments (<t t-esc="data.departments.length"/>)
                        </button>
                    </li>
                    <t t-foreach="data.all_departments" t-as="dept_item" t-key="dept_item.id">
                        <li class="nav-item">
                            <button type="button" class="nav-link" t-att-class="{'active': isDeptSelected(dept_item.id)}" t-on-click="() => this.selectDepartment(dept_item.id)">
                                <i class="fa fa-building me-1"/> <t t-esc="dept_item.name"/>
                            </button>
                        </li>
                    </t>
                </ul>
            </div>

            <!-- Loader -->
            <t t-if="state.loading">
                <div class="text-center p-5">
                    <div class="spinner-border text-primary" role="status" style="width: 3rem; height: 3rem;">
                        <span class="visually-hidden">Calculating Payroll Analytics...</span>
                    </div>
                    <p class="mt-3 text-muted fw-bold">Calculating corporate HR, overtime, and payroll statistics...</p>
                </div>
            </t>

            <!-- Main Dashboard Body -->
            <t t-else="">
                <!-- KPI Summary Grid -->
                <div class="o_kpi_grid">
                    <!-- Total Net Salaries -->
                    <div class="o_kpi_card card-net clickable_kpi" t-on-click="() => this.onKpiClick('net_salary')" title="Click to view all payslips">
                        <div class="kpi_icon"><i class="fa fa-money text-primary"/></div>
                        <div class="kpi_title">Total Net Salaries (صافي الرواتب)</div>
                        <div class="kpi_value"><t t-esc="formatCurrency(data.kpis.total_net_salary)"/> <span class="fs-6 fw-normal text-muted">JOD</span></div>
                        <div class="kpi_subtext d-flex justify-content-between align-items-center">
                            <span><t t-esc="data.kpis.payslip_count"/> Payslips</span>
                            <span class="drill_badge"><i class="fa fa-search-plus me-1"/>Drill Down</span>
                        </div>
                    </div>

                    <!-- Total Gross Salaries -->
                    <div class="o_kpi_card card-gross clickable_kpi" t-on-click="() => this.onKpiClick('gross_salary')" title="Click to view payslips">
                        <div class="kpi_icon"><i class="fa fa-briefcase text-purple"/></div>
                        <div class="kpi_title">Gross Salaries (إجمالي الرواتب)</div>
                        <div class="kpi_value"><t t-esc="formatCurrency(data.kpis.total_gross_salary)"/> <span class="fs-6 fw-normal text-muted">JOD</span></div>
                        <div class="kpi_subtext d-flex justify-content-between align-items-center">
                            <span class="badge bg-purple text-white badge_sub">Full Gross</span>
                            <span class="drill_badge"><i class="fa fa-search-plus me-1"/>Drill Down</span>
                        </div>
                    </div>

                    <!-- Total Basic Salaries -->
                    <div class="o_kpi_card card-basic clickable_kpi" t-on-click="() => this.onKpiClick('basic_salary')" title="Click to view payslips">
                        <div class="kpi_icon"><i class="fa fa-database text-info"/></div>
                        <div class="kpi_title">Basic Salaries (الأساسي)</div>
                        <div class="kpi_value"><t t-esc="formatCurrency(data.kpis.total_basic_salary)"/> <span class="fs-6 fw-normal text-muted">JOD</span></div>
                        <div class="kpi_subtext d-flex justify-content-between align-items-center">
                            <span class="badge bg-info text-white badge_sub">Base Wage</span>
                            <span class="drill_badge"><i class="fa fa-search-plus me-1"/>Drill Down</span>
                        </div>
                    </div>

                    <!-- Total Allowances -->
                    <div class="o_kpi_card card-alw clickable_kpi" t-on-click="() => this.onKpiClick('allowances')" title="Click to view allowance lines">
                        <div class="kpi_icon"><i class="fa fa-gift text-success"/></div>
                        <div class="kpi_title">Total Allowances (العلاوات والمكافآت)</div>
                        <div class="kpi_value text-success"><t t-esc="formatCurrency(data.kpis.total_allowances)"/> <span class="fs-6 fw-normal text-muted">JOD</span></div>
                        <div class="kpi_subtext d-flex justify-content-between align-items-center">
                            <span class="badge bg-success badge_sub">Takleef &amp; Bonus</span>
                            <span class="drill_badge"><i class="fa fa-search-plus me-1"/>Drill Down</span>
                        </div>
                    </div>

                    <!-- Total Deductions -->
                    <div class="o_kpi_card card-ded clickable_kpi" t-on-click="() => this.onKpiClick('deductions')" title="Click to view deduction lines">
                        <div class="kpi_icon"><i class="fa fa-scissors text-danger"/></div>
                        <div class="kpi_title">Total Deductions (الخصومات والاقتطاعات)</div>
                        <div class="kpi_value text-danger"><t t-esc="formatCurrency(data.kpis.total_deductions)"/> <span class="fs-6 fw-normal text-muted">JOD</span></div>
                        <div class="kpi_subtext d-flex justify-content-between align-items-center">
                            <span class="badge bg-danger badge_sub">Loans &amp; Penalties</span>
                            <span class="drill_badge"><i class="fa fa-search-plus me-1"/>Drill Down</span>
                        </div>
                    </div>

                    <!-- Social Security -->
                    <div class="o_kpi_card card-ssc clickable_kpi" t-on-click="() => this.onKpiClick('social_security')" title="Click to view social security lines">
                        <div class="kpi_icon"><i class="fa fa-shield text-warning"/></div>
                        <div class="kpi_title">Social Security (الضمان الاجتماعي)</div>
                        <div class="kpi_value"><t t-esc="formatCurrency(data.kpis.total_social_security)"/> <span class="fs-6 fw-normal text-muted">JOD</span></div>
                        <div class="kpi_subtext d-flex justify-content-between align-items-center">
                            <span class="badge bg-warning text-dark badge_sub">Employee Share</span>
                            <span class="drill_badge"><i class="fa fa-search-plus me-1"/>Drill Down</span>
                        </div>
                    </div>

                    <!-- Income Tax -->
                    <div class="o_kpi_card card-tax clickable_kpi" t-on-click="() => this.onKpiClick('tax')" title="Click to view income tax lines">
                        <div class="kpi_icon"><i class="fa fa-percent text-primary"/></div>
                        <div class="kpi_title">Income Tax (ضريبة الدخل)</div>
                        <div class="kpi_value"><t t-esc="formatCurrency(data.kpis.total_income_tax)"/> <span class="fs-6 fw-normal text-muted">JOD</span></div>
                        <div class="kpi_subtext d-flex justify-content-between align-items-center">
                            <span class="badge bg-primary badge_sub">Income Tax</span>
                            <span class="drill_badge"><i class="fa fa-search-plus me-1"/>Drill Down</span>
                        </div>
                    </div>

                    <!-- Overtime Amount & Hours -->
                    <div class="o_kpi_card card-ot clickable_kpi" t-on-click="() => this.onKpiClick('overtime')" title="Click to view overtime worked days">
                        <div class="kpi_icon"><i class="fa fa-clock-o text-danger"/></div>
                        <div class="kpi_title">Overtime (العمل الإضافي)</div>
                        <div class="kpi_value text-primary"><t t-esc="formatCurrency(data.kpis.total_overtime_amount)"/> <span class="fs-6 fw-normal text-muted">JOD</span></div>
                        <div class="kpi_subtext d-flex justify-content-between align-items-center">
                            <span class="fw-bold text-dark"><t t-esc="formatDecimal(data.kpis.total_overtime_hours, 1)"/> OT Hours</span>
                            <span class="drill_badge"><i class="fa fa-search-plus me-1"/>Drill Down</span>
                        </div>
                    </div>

                    <!-- Lateness & Subtracted Hours -->
                    <div class="o_kpi_card card-late clickable_kpi" t-on-click="() => this.onKpiClick('lateness')" title="Click to view lateness worked days">
                        <div class="kpi_icon"><i class="fa fa-hourglass-end text-warning"/></div>
                        <div class="kpi_title">Lateness &amp; Shortages (خصم ساعات)</div>
                        <div class="kpi_value text-warning"><t t-esc="formatDecimal(data.kpis.total_lateness_hours, 1)"/> <span class="fs-6 fw-normal text-muted">Hours</span></div>
                        <div class="kpi_subtext d-flex justify-content-between align-items-center">
                            <span class="badge bg-warning text-dark badge_sub"><t t-esc="formatCurrency(data.kpis.total_lateness_amount)"/> JOD</span>
                            <span class="drill_badge"><i class="fa fa-search-plus me-1"/>Drill Down</span>
                        </div>
                    </div>

                    <!-- Headcount -->
                    <div class="o_kpi_card card-headcount clickable_kpi" t-on-click="() => this.onKpiClick('headcount')" title="Click to view employee list">
                        <div class="kpi_icon"><i class="fa fa-user-circle text-success"/></div>
                        <div class="kpi_title">Active Headcount (عدد الموظفين)</div>
                        <div class="kpi_value text-success"><t t-esc="data.kpis.headcount"/> <span class="fs-6 fw-normal text-muted">Employees</span></div>
                        <div class="kpi_subtext d-flex justify-content-between align-items-center">
                            <span class="text-muted">Avg: <t t-esc="formatCurrency(data.kpis.avg_salary_per_emp)"/> JOD</span>
                            <span class="drill_badge"><i class="fa fa-search-plus me-1"/>Drill Down</span>
                        </div>
                    </div>
                </div>

                <!-- Highlights & Operations Row -->
                <div class="o_highlights_grid">
                    <!-- Attendance Reconciliation Box -->
                    <div class="highlight_card">
                        <div class="card_header">
                            <i class="fa fa-calendar-check-o text-primary fs-4"/>
                            <h5>Attendance &amp; Hours Reconciliation (تسوية الساعات)</h5>
                        </div>
                        <div class="row g-2">
                            <div class="col-6">
                                <div class="highlight_stat_box">
                                    <span class="stat_label">Scheduled Hours (المجدولة)</span>
                                    <span class="stat_value"><t t-esc="formatDecimal(data.operational_highlights.scheduled_hours, 1)"/> h</span>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="highlight_stat_box">
                                    <span class="stat_label">Approved Hours (المعتمدة)</span>
                                    <span class="stat_value text-success"><t t-esc="formatDecimal(data.operational_highlights.approved_hours, 1)"/> h</span>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="highlight_stat_box">
                                    <span class="stat_label">Extra / OT Hours (ساعات إضافية)</span>
                                    <span class="stat_value text-primary">+<t t-esc="formatDecimal(data.operational_highlights.extra_ot_hours, 1)"/> h</span>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="highlight_stat_box">
                                    <span class="stat_label">Lateness (ساعات مخصومة)</span>
                                    <span class="stat_value text-danger">-<t t-esc="formatDecimal(data.operational_highlights.subtracted_late_hours, 1)"/> h</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Payment Channels / Bank Transfer vs Cash -->
                    <div class="highlight_card">
                        <div class="card_header">
                            <i class="fa fa-university text-success fs-4"/>
                            <h5>Bank &amp; Payment Methods (قنوات الدفع والبنوك)</h5>
                        </div>
                        <t t-foreach="data.channels" t-as="ch" t-key="ch.name">
                            <div class="p-3 mb-2 rounded bg-light border">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <span class="fw-bold"><t t-esc="ch.name"/></span>
                                    <span class="badge bg-primary"><t t-esc="ch.count"/> Employees</span>
                                </div>
                                <div class="d-flex justify-content-between align-items-center">
                                    <span class="fs-5 fw-bold text-dark"><t t-esc="formatCurrency(ch.amount)"/> JOD</span>
                                    <span class="fw-bold text-muted"><t t-esc="ch.percentage"/>% of Total</span>
                                </div>
                            </div>
                        </t>
                    </div>

                    <!-- Top Overtime Departments -->
                    <div class="highlight_card">
                        <div class="card_header">
                            <i class="fa fa-line-chart text-warning fs-4"/>
                            <h5>Top Overtime Departments (أعلى الأقسام عملاً إضافياً)</h5>
                        </div>
                        <ul class="list-group list-group-flush">
                            <t t-foreach="data.operational_highlights.top_ot_departments" t-as="ot_dept" t-key="ot_dept.department_id">
                                <li class="list-group-item d-flex justify-content-between align-items-center px-0 py-2">
                                    <span class="fw-bold text-dark"><t t-esc="ot_dept.department_name"/></span>
                                    <div class="text-end">
                                        <span class="badge bg-warning text-dark me-2"><t t-esc="formatDecimal(ot_dept.overtime_hours, 1)"/> Hours</span>
                                        <span class="fw-bold text-primary"><t t-esc="formatCurrency(ot_dept.overtime_amount)"/> JOD</span>
                                    </div>
                                </li>
                            </t>
                        </ul>
                    </div>
                </div>

                <!-- Departmental Breakdown Data Table -->
                <div class="o_department_table_card">
                    <div class="table_header_controls">
                        <div>
                            <h4><i class="fa fa-table text-primary me-2"/> Departmental Payroll &amp; Operations Breakdown</h4>
                            <span class="text-muted small">Comprehensive breakdown by department with sorting, search, and totals</span>
                        </div>
                        <div class="d-flex gap-2 align-items-center">
                            <input type="text" class="form-control form-control-sm" placeholder="Search department..." t-model="state.searchQuery" style="max-width: 220px;"/>
                            <button class="btn btn-sm btn-outline-success" t-on-click="exportExcel">
                                <i class="fa fa-file-excel-o me-1"/> Export to Excel
                            </button>
                        </div>
                    </div>

                    <div class="table-responsive">
                        <table class="o_dashboard_table table table-hover">
                            <thead>
                                <tr>
                                    <th t-on-click="() => this.sortBy('department_name')">
                                        Department <i class="fa fa-sort ms-1"/>
                                    </th>
                                    <th class="text-center" t-on-click="() => this.sortBy('headcount')">
                                        Headcount <i class="fa fa-sort ms-1"/>
                                    </th>
                                    <th class="text-end" t-on-click="() => this.sortBy('basic_salary')">
                                        Basic Wage <i class="fa fa-sort ms-1"/>
                                    </th>
                                    <th class="text-end" t-on-click="() => this.sortBy('allowances')">
                                        Allowances <i class="fa fa-sort ms-1"/>
                                    </th>
                                    <th class="text-end" t-on-click="() => this.sortBy('overtime_amount')">
                                        Overtime (OT) <i class="fa fa-sort ms-1"/>
                                    </th>
                                    <th class="text-end" t-on-click="() => this.sortBy('gross_salary')">
                                        Gross Salary <i class="fa fa-sort ms-1"/>
                                    </th>
                                    <th class="text-end" t-on-click="() => this.sortBy('deductions')">
                                        Deductions <i class="fa fa-sort ms-1"/>
                                    </th>
                                    <th class="text-end" t-on-click="() => this.sortBy('social_security')">
                                        Social Security <i class="fa fa-sort ms-1"/>
                                    </th>
                                    <th class="text-end" t-on-click="() => this.sortBy('income_tax')">
                                        Income Tax <i class="fa fa-sort ms-1"/>
                                    </th>
                                    <th class="text-end" t-on-click="() => this.sortBy('net_salary')">
                                        Net Salary <i class="fa fa-sort ms-1"/>
                                    </th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="sortedDepartments" t-as="d" t-key="d.department_id">
                                    <tr>
                                        <td class="fw-bold text-dark">
                                            <i class="fa fa-folder-open-o text-muted me-2"/>
                                            <t t-esc="d.department_name"/>
                                        </td>
                                        <td class="text-center">
                                            <span class="badge bg-light text-dark border px-2 py-1"><t t-esc="d.headcount"/></span>
                                        </td>
                                        <td class="text-end"><t t-esc="formatCurrency(d.basic_salary)"/></td>
                                        <td class="text-end text-success"><t t-esc="formatCurrency(d.allowances)"/></td>
                                        <td class="text-end text-primary">
                                            <t t-esc="formatCurrency(d.overtime_amount)"/>
                                            <div class="small text-muted"><t t-esc="formatDecimal(d.overtime_hours, 1)"/> hrs</div>
                                        </td>
                                        <td class="text-end fw-bold"><t t-esc="formatCurrency(d.gross_salary)"/></td>
                                        <td class="text-end text-danger"><t t-esc="formatCurrency(d.deductions)"/></td>
                                        <td class="text-end text-warning"><t t-esc="formatCurrency(d.social_security)"/></td>
                                        <td class="text-end text-info"><t t-esc="formatCurrency(d.income_tax)"/></td>
                                        <td class="text-end fw-bold text-primary fs-6"><t t-esc="formatCurrency(d.net_salary)"/></td>
                                    </tr>
                                </t>
                            </tbody>
                            <tfoot>
                                <tr>
                                    <td>Grand Total</td>
                                    <td class="text-center"><t t-esc="data.kpis.headcount"/></td>
                                    <td class="text-end"><t t-esc="formatCurrency(data.kpis.total_basic_salary)"/></td>
                                    <td class="text-end text-success"><t t-esc="formatCurrency(data.kpis.total_allowances)"/></td>
                                    <td class="text-end text-primary"><t t-esc="formatCurrency(data.kpis.total_overtime_amount)"/></td>
                                    <td class="text-end"><t t-esc="formatCurrency(data.kpis.total_gross_salary)"/></td>
                                    <td class="text-end text-danger"><t t-esc="formatCurrency(data.kpis.total_deductions)"/></td>
                                    <td class="text-end text-warning"><t t-esc="formatCurrency(data.kpis.total_social_security)"/></td>
                                    <td class="text-end text-info"><t t-esc="formatCurrency(data.kpis.total_income_tax)"/></td>
                                    <td class="text-end text-primary fs-6"><t t-esc="formatCurrency(data.kpis.total_net_salary)"/></td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            </t>
        </div>
    </t>
</templates>
