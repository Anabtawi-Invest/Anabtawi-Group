<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- QWeb PDF Report Action for C-Level Executive Briefing -->
    <record id="action_report_executive_payroll_pdf" model="ir.actions.report">
        <field name="name">C-Level Executive Briefing Report (PDF)</field>
        <field name="model">hr.payroll.dashboard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">anabtawi_hr_payroll_dashboard.report_executive_payroll_pdf_document</field>
        <field name="report_file">Executive_Payroll_Briefing</field>
        <field name="binding_model_id" ref="hr_payroll.model_hr_payslip"/>
        <field name="binding_type">report</field>
    </record>

    <!-- QWeb Document Template -->
    <template id="report_executive_payroll_pdf_document">
        <t t-call="web.external_layout">
            <t t-set="doc" t-value="docs and docs[0] or False"/>
            <div class="page" style="font-family: Arial, sans-serif; color: #0f172a; font-size: 10pt;">
                <!-- Header Title Banner -->
                <div style="background-color: #0f172a; color: #ffffff; padding: 14px 18px; border-radius: 6px; margin-bottom: 16px; border-left: 6px solid #2563eb;">
                    <table style="width: 100%; border: none;">
                        <tr>
                            <td style="vertical-align: middle;">
                                <h2 style="margin: 0; color: #ffffff; font-size: 16pt; font-weight: bold;">
                                    HR &amp; Payroll Executive Board Briefing
                                </h2>
                                <p style="margin: 4px 0 0 0; font-size: 9.5pt; color: #e2e8f0;">
                                    Workforce Movement, Underlying Cost Bridge (Excl. EOS), 3-Month Trend &amp; Turnover Risk Review
                                </p>
                            </td>
                            <td style="text-align: right; vertical-align: middle; font-size: 8.5pt; color: #f8fafc;">
                                <strong>Generated Date:</strong> <t t-esc="context_timestamp(datetime.datetime.now()).strftime('%Y-%m-%d %H:%M')"/><br/>
                                <strong>Period:</strong> <t t-esc="data.get('date_from', '')"/> to <t t-esc="data.get('date_to', '')"/>
                            </td>
                        </tr>
                    </table>
                </div>

                <!-- Executive Summary & Cost Bridge Cards -->
                <t t-set="cb" t-value="data.get('cost_bridge', {})"/>
                <t t-set="wm" t-value="data.get('workforce_movement', {})"/>
                <table style="width: 100%; margin-bottom: 16px; border-collapse: separate; border-spacing: 8px;">
                    <tr>
                        <td style="width: 25%; background: #ffffff; border: 1px solid #cbd5e1; border-top: 4px solid #6d28d9; border-radius: 6px; padding: 10px; text-align: center;">
                            <span style="font-size: 8pt; color: #334155; font-weight: bold; text-transform: uppercase;">Reported Workforce Cost</span>
                            <h3 style="margin: 4px 0 0 0; color: #6d28d9; font-size: 13.5pt;"><t t-esc="'{:,.3f}'.format(cb.get('reported_workforce_cost', 0.0))"/> JOD</h3>
                            <small style="color: #475569;">EOS Included: <t t-esc="'{:,.3f}'.format(cb.get('eos_settlement_cost', 0.0))"/> JOD</small>
                        </td>
                        <td style="width: 25%; background: #ffffff; border: 1px solid #cbd5e1; border-top: 4px solid #047857; border-radius: 6px; padding: 10px; text-align: center;">
                            <span style="font-size: 8pt; color: #334155; font-weight: bold; text-transform: uppercase;">Underlying Cost (Excl. EOS)</span>
                            <h3 style="margin: 4px 0 0 0; color: #047857; font-size: 13.5pt;"><t t-esc="'{:,.3f}'.format(cb.get('underlying_workforce_cost', 0.0))"/> JOD</h3>
                            <small style="color: #475569;">Avg/Emp: <t t-esc="'{:,.3f}'.format(cb.get('underlying_avg_cost_per_emp', 0.0))"/> JOD</small>
                        </td>
                        <td style="width: 25%; background: #ffffff; border: 1px solid #cbd5e1; border-top: 4px solid #1d4ed8; border-radius: 6px; padding: 10px; text-align: center;">
                            <span style="font-size: 8pt; color: #334155; font-weight: bold; text-transform: uppercase;">Net Salaries Disbursed</span>
                            <h3 style="margin: 4px 0 0 0; color: #1d4ed8; font-size: 13.5pt;"><t t-esc="'{:,.3f}'.format(data.get('kpis', {}).get('total_net_salary', 0.0))"/> JOD</h3>
                            <small style="color: #475569;">Overtime: <t t-esc="'{:,.3f}'.format(data.get('kpis', {}).get('total_overtime_amount', 0.0))"/> JOD</small>
                        </td>
                        <td style="width: 25%; background: #ffffff; border: 1px solid #cbd5e1; border-top: 4px solid #0f766e; border-radius: 6px; padding: 10px; text-align: center;">
                            <span style="font-size: 8pt; color: #334155; font-weight: bold; text-transform: uppercase;">Headcount Movement</span>
                            <h3 style="margin: 4px 0 0 0; color: #0f766e; font-size: 13.5pt;"><t t-esc="wm.get('beginning_hc', 0)"/> → <t t-esc="wm.get('ending_hc', 0)"/> Staff</h3>
                            <small style="color: #475569;">+<t t-esc="wm.get('new_hires', 0)"/> Hires / −<t t-esc="wm.get('separations', 0)"/> Exits (<t t-esc="wm.get('turnover_rate', 0.0)"/>%)</small>
                        </td>
                    </tr>
                </table>

                <!-- Section 1: 3-Month Rolling Board Trend & MoM Comparison -->
                <t t-set="trend" t-value="data.get('three_month_trend', {})"/>
                <t t-if="trend.get('rows')">
                    <div style="margin-bottom: 16px;">
                        <h4 style="color: #0f172a; border-bottom: 2px solid #1e3a8a; padding-bottom: 4px; margin-bottom: 8px; font-size: 11pt;">
                            1. 3-Month Rolling Board Trend &amp; Month-over-Month Comparison (<t t-esc="trend.get('m2_label', '')"/> — <t t-esc="trend.get('m0_label', '')"/>)
                        </h4>
                        <table style="width: 100%; border-collapse: collapse; font-size: 8.5pt;">
                            <thead>
                                <tr style="background-color: #0f172a; color: #ffffff;">
                                    <th style="padding: 6px 8px; border: 1px solid #334155; text-align: left;">Board Executive KPI</th>
                                    <th style="padding: 6px 8px; border: 1px solid #334155; text-align: center;"><t t-esc="trend.get('m2_label', 'M-2')"/></th>
                                    <th style="padding: 6px 8px; border: 1px solid #334155; text-align: center;"><t t-esc="trend.get('m1_label', 'M-1')"/></th>
                                    <th style="padding: 6px 8px; border: 1px solid #334155; text-align: center;"><t t-esc="trend.get('m0_label', 'Current')"/></th>
                                    <th style="padding: 6px 8px; border: 1px solid #334155; text-align: center;">MoM Change</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="trend.get('rows', [])" t-as="tr">
                                    <tr>
                                        <td style="padding: 5px 8px; border: 1px solid #cbd5e1; font-weight: bold; color: #0f172a;"><t t-esc="tr.get('kpi', '')"/></td>
                                        <td style="padding: 5px 8px; border: 1px solid #cbd5e1; text-align: center; color: #475569;"><t t-esc="tr.get('m2', '')"/></td>
                                        <td style="padding: 5px 8px; border: 1px solid #cbd5e1; text-align: center; color: #0f172a;"><t t-esc="tr.get('m1', '')"/></td>
                                        <td style="padding: 5px 8px; border: 1px solid #cbd5e1; text-align: center; font-weight: bold; color: #1d4ed8; background-color: #f0f9ff;"><t t-esc="tr.get('m0', '')"/></td>
                                        <td style="padding: 5px 8px; border: 1px solid #cbd5e1; text-align: center; font-weight: bold;">
                                            <t t-esc="tr.get('mom', '')"/>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </t>

                <!-- Section 2: Corporate Workforce Labor Cost & Headcount Bridge by Business Unit -->
                <t t-if="data.get('labor_cost_report')">
                    <div style="margin-bottom: 16px;">
                        <h4 style="color: #0f172a; border-bottom: 2px solid #047857; padding-bottom: 4px; margin-bottom: 8px; font-size: 11pt;">
                            2. Corporate Workforce Labor Cost &amp; Headcount Bridge by Business Unit (تقرير تكاليف القوى العاملة)
                        </h4>
                        <table style="width: 100%; border-collapse: collapse; font-size: 8pt;">
                            <thead>
                                <tr style="background-color: #065f46; color: #ffffff;">
                                    <th style="padding: 5px 6px; border: 1px solid #047857; text-align: left;">Business Unit</th>
                                    <th style="padding: 5px 6px; border: 1px solid #047857; text-align: center;">Beg HC</th>
                                    <th style="padding: 5px 6px; border: 1px solid #047857; text-align: center;">Hires</th>
                                    <th style="padding: 5px 6px; border: 1px solid #047857; text-align: center;">Exits</th>
                                    <th style="padding: 5px 6px; border: 1px solid #047857; text-align: center;">End HC</th>
                                    <th style="padding: 5px 6px; border: 1px solid #047857; text-align: right;">Basic</th>
                                    <th style="padding: 5px 6px; border: 1px solid #047857; text-align: right;">Allowances</th>
                                    <th style="padding: 5px 6px; border: 1px solid #047857; text-align: right;">Overtime</th>
                                    <th style="padding: 5px 6px; border: 1px solid #047857; text-align: right;">Co. SS + Med</th>
                                    <th style="padding: 5px 6px; border: 1px solid #047857; text-align: right;">EOS</th>
                                    <th style="padding: 5px 6px; border: 1px solid #047857; text-align: right;">Total Cost</th>
                                    <th style="padding: 5px 6px; border: 1px solid #047857; text-align: right;">Avg Excl. EOS</th>
                                    <th style="padding: 5px 6px; border: 1px solid #047857; text-align: center;">Turnover</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="data.get('labor_cost_report', [])" t-as="sbu">
                                    <tr>
                                        <td style="padding: 5px 6px; border: 1px solid #cbd5e1; font-weight: bold;"><t t-esc="sbu.get('sbu_display_name', '')"/></td>
                                        <td style="padding: 5px 6px; border: 1px solid #cbd5e1; text-align: center;"><t t-esc="sbu.get('beginning_hc', 0)"/></td>
                                        <td style="padding: 5px 6px; border: 1px solid #cbd5e1; text-align: center; color: #047857; font-weight: bold;">+<t t-esc="sbu.get('new_hires', 0)"/></td>
                                        <td style="padding: 5px 6px; border: 1px solid #cbd5e1; text-align: center; color: #b91c1c; font-weight: bold;">−<t t-esc="sbu.get('separations', 0)"/></td>
                                        <td style="padding: 5px 6px; border: 1px solid #cbd5e1; text-align: center; font-weight: bold;"><t t-esc="sbu.get('ending_hc', 0)"/></td>
                                        <td style="padding: 5px 6px; border: 1px solid #cbd5e1; text-align: right;"><t t-esc="'{:,.1f}'.format(sbu.get('basic_salary', 0.0))"/></td>
                                        <td style="padding: 5px 6px; border: 1px solid #cbd5e1; text-align: right;"><t t-esc="'{:,.1f}'.format(sbu.get('allowances', 0.0))"/></td>
                                        <td style="padding: 5px 6px; border: 1px solid #cbd5e1; text-align: right; color: #c2410c;"><t t-esc="'{:,.1f}'.format(sbu.get('overtime_amount', 0.0))"/></td>
                                        <td style="padding: 5px 6px; border: 1px solid #cbd5e1; text-align: right;"><t t-esc="'{:,.1f}'.format(sbu.get('social_security_comp', 0.0) + sbu.get('health_ins_comp', 0.0))"/></td>
                                        <td style="padding: 5px 6px; border: 1px solid #cbd5e1; text-align: right; color: #b91c1c;"><t t-esc="'{:,.1f}'.format(sbu.get('eos_amount', 0.0))"/></td>
                                        <td style="padding: 5px 6px; border: 1px solid #cbd5e1; text-align: right; font-weight: bold; color: #1e40af;"><t t-esc="'{:,.1f}'.format(sbu.get('total_workforce_cost', 0.0))"/></td>
                                        <td style="padding: 5px 6px; border: 1px solid #cbd5e1; text-align: right; font-weight: bold;"><t t-esc="'{:,.1f}'.format(sbu.get('underlying_avg_cost_per_emp', 0.0))"/></td>
                                        <td style="padding: 5px 6px; border: 1px solid #cbd5e1; text-align: center;"><t t-esc="sbu.get('turnover_rate', 0.0)"/>%</td>
                                    </tr>
                                </t>
                            </tbody>
                            <t t-set="lct" t-value="data.get('labor_cost_totals', {})"/>
                            <tfoot t-if="lct">
                                <tr style="background-color: #0f172a; color: #ffffff; font-weight: bold;">
                                    <td style="padding: 6px;">GRAND TOTAL (الإجمالي)</td>
                                    <td style="padding: 6px; text-align: center;"><t t-esc="lct.get('beginning_hc', 0)"/></td>
                                    <td style="padding: 6px; text-align: center;">+<t t-esc="lct.get('new_hires', 0)"/></td>
                                    <td style="padding: 6px; text-align: center;">−<t t-esc="lct.get('separations', 0)"/></td>
                                    <td style="padding: 6px; text-align: center;"><t t-esc="lct.get('ending_hc', 0)"/></td>
                                    <td style="padding: 6px; text-align: right;"><t t-esc="'{:,.1f}'.format(lct.get('basic_salary', 0.0))"/></td>
                                    <td style="padding: 6px; text-align: right;"><t t-esc="'{:,.1f}'.format(lct.get('allowances', 0.0))"/></td>
                                    <td style="padding: 6px; text-align: right;"><t t-esc="'{:,.1f}'.format(lct.get('overtime_amount', 0.0))"/></td>
                                    <td style="padding: 6px; text-align: right;"><t t-esc="'{:,.1f}'.format(lct.get('social_security_comp', 0.0) + lct.get('health_ins_comp', 0.0))"/></td>
                                    <td style="padding: 6px; text-align: right;"><t t-esc="'{:,.1f}'.format(lct.get('eos_amount', 0.0))"/></td>
                                    <td style="padding: 6px; text-align: right;"><t t-esc="'{:,.1f}'.format(lct.get('total_workforce_cost', 0.0))"/></td>
                                    <td style="padding: 6px; text-align: right;"><t t-esc="'{:,.1f}'.format(lct.get('underlying_avg_cost_per_emp', 0.0))"/></td>
                                    <td style="padding: 6px; text-align: center;"><t t-esc="lct.get('turnover_rate', 0.0)"/>%</td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </t>

                <!-- Section 3: Executive Conclusion & Recommended Priorities -->
                <t t-set="ins" t-value="data.get('executive_insights', {})"/>
                <t t-if="ins">
                    <div style="margin-bottom: 16px;">
                        <h4 style="color: #0f172a; border-bottom: 2px solid #1d4ed8; padding-bottom: 4px; margin-bottom: 8px; font-size: 11pt;">
                            3. Executive Conclusion, Attention Points &amp; Board Priorities
                        </h4>
                        <table style="width: 100%; border-collapse: separate; border-spacing: 8px; font-size: 8.5pt;">
                            <tr>
                                <td style="width: 33%; vertical-align: top; background: #ecfdf5; border: 1px solid #6ee7b7; border-radius: 6px; padding: 10px;">
                                    <strong style="color: #065f46; display: block; margin-bottom: 6px;">Positives &amp; Achievements</strong>
                                    <ul style="margin: 0; padding-left: 16px; color: #0f172a;">
                                        <t t-foreach="ins.get('positives', [])" t-as="p_item">
                                            <li style="margin-bottom: 4px;"><t t-esc="p_item"/></li>
                                        </t>
                                    </ul>
                                </td>
                                <td style="width: 33%; vertical-align: top; background: #fef2f2; border: 1px solid #fca5a5; border-radius: 6px; padding: 10px;">
                                    <strong style="color: #991b1b; display: block; margin-bottom: 6px;">Requires Executive Attention</strong>
                                    <ul style="margin: 0; padding-left: 16px; color: #0f172a;">
                                        <t t-foreach="ins.get('attention_points', [])" t-as="a_item">
                                            <li style="margin-bottom: 4px;"><t t-esc="a_item"/></li>
                                        </t>
                                    </ul>
                                </td>
                                <td style="width: 34%; vertical-align: top; background: #eff6ff; border: 1px solid #93c5fd; border-radius: 6px; padding: 10px;">
                                    <strong style="color: #1e3a8a; display: block; margin-bottom: 6px;">Recommended Board Priorities</strong>
                                    <ul style="margin: 0; padding-left: 16px; color: #0f172a;">
                                        <t t-foreach="ins.get('priorities', [])" t-as="r_item">
                                            <li style="margin-bottom: 4px;"><t t-esc="r_item"/></li>
                                        </t>
                                    </ul>
                                </td>
                            </tr>
                        </table>
                    </div>
                </t>

                <!-- Signoff Footer -->
                <div style="margin-top: 22px; padding-top: 12px; border-top: 1px solid #cbd5e1; font-size: 8.5pt; color: #334155;">
                    <table style="width: 100%;">
                        <tr>
                            <td style="width: 33%; text-align: center;">
                                _______________________<br/>
                                <strong>Prepared by HR Director</strong>
                            </td>
                            <td style="width: 33%; text-align: center;">
                                _______________________<br/>
                                <strong>Reviewed by CFO</strong>
                            </td>
                            <td style="width: 33%; text-align: center;">
                                _______________________<br/>
                                <strong>Approved by CEO</strong>
                            </td>
                        </tr>
                    </table>
                </div>
            </div>
        </t>
    </template>
</odoo>
