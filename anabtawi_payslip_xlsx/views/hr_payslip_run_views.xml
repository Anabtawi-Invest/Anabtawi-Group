<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Pay Run Form View Extension: Add header with PayRun Audit button -->
    <record id="view_hr_payslip_run_form_xlsx_export" model="ir.ui.view">
        <field name="name">hr.payslip.run.form.xlsx.export</field>
        <field name="model">hr.payslip.run</field>
        <field name="inherit_id" ref="hr_payroll.hr_payslip_run_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <header>
                    <button string="PayRun Audit"
                            name="action_export_payrun_excel"
                            type="object"
                            class="btn-primary"
                            invisible="not slip_ids"
                            groups="hr_payroll.group_hr_payroll_user"/>
                </header>
            </xpath>
        </field>
    </record>

    <!-- Server Action on Pay Run Action Menu (Form & List View) -->
    <record id="action_payrun_excel_report_server" model="ir.actions.server">
        <field name="name">PayRun Audit</field>
        <field name="model_id" ref="hr_payroll.model_hr_payslip_run"/>
        <field name="binding_model_id" ref="hr_payroll.model_hr_payslip_run"/>
        <field name="binding_view_types">form,list</field>
        <field name="state">code</field>
        <field name="code">
action = records.action_export_payrun_excel()
        </field>
    </record>
</odoo>
