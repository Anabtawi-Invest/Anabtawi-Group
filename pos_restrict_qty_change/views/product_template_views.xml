<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_view_restrict_qty" model="ir.ui.view">
        <field name="name">product.template.form.pos.restrict.qty</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook/page[@name='sales']" position="inside">
                <group string="POS Quantity" name="pos_restrict_qty" invisible="not available_in_pos">
                    <field name="pos_allowed_change_qty"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
