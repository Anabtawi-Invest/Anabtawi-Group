<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!-- Historical branch scores (imported)                          -->
    <!-- ============================================================ -->
    <record id="view_qc_historical_score_list" model="ir.ui.view">
        <field name="name">qc.historical.score.list</field>
        <field name="model">qc.historical.score</field>
        <field name="arch" type="xml">
            <list string="Historical Scores" editable="bottom"
                  decoration-danger="total_score &lt; 60"
                  decoration-success="total_score &gt;= 90">
                <field name="branch_id"/>
                <field name="name"/>
                <field name="period_date"/>
                <field name="total_score"/>
                <field name="grade_id"/>
                <field name="source" optional="show"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_qc_historical_score_form" model="ir.ui.view">
        <field name="name">qc.historical.score.form</field>
        <field name="model">qc.historical.score</field>
        <field name="arch" type="xml">
            <form string="Historical Score">
                <sheet>
                    <group>
                        <group>
                            <field name="branch_id"/>
                            <field name="name"/>
                            <field name="period_date"/>
                        </group>
                        <group>
                            <field name="total_score"/>
                            <field name="grade_id" readonly="1"/>
                            <field name="source"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <field name="note" placeholder="Notes..."/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_qc_historical_score_search" model="ir.ui.view">
        <field name="name">qc.historical.score.search</field>
        <field name="model">qc.historical.score</field>
        <field name="arch" type="xml">
            <search string="Historical Scores">
                <field name="branch_id"/>
                <field name="name"/>
                <field name="grade_id"/>
                <group>
                    <filter name="group_branch" string="Site"
                            context="{'group_by': 'branch_id'}"/>
                    <filter name="group_grade" string="Grade"
                            context="{'group_by': 'grade_id'}"/>
                    <filter name="group_period" string="Period"
                            context="{'group_by': 'period_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_qc_historical_score_graph" model="ir.ui.view">
        <field name="name">qc.historical.score.graph</field>
        <field name="model">qc.historical.score</field>
        <field name="arch" type="xml">
            <graph string="Historical Scores" type="line">
                <field name="period_date" interval="month"/>
                <field name="total_score" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="action_qc_historical_score" model="ir.actions.act_window">
        <field name="name">Historical Scores</field>
        <field name="res_model">qc.historical.score</field>
        <field name="view_mode">list,form,graph</field>
        <field name="search_view_id" ref="view_qc_historical_score_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Import historical branch scores</p>
            <p>Use the Import button (Favorites &gt; Import records) with the
               provided CSV template to load overall branch results from before
               the module went live.</p>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- Historical factor averages (imported)                        -->
    <!-- ============================================================ -->
    <record id="view_qc_historical_factor_average_list" model="ir.ui.view">
        <field name="name">qc.historical.factor.average.list</field>
        <field name="model">qc.historical.factor.average</field>
        <field name="arch" type="xml">
            <list string="Historical Factor Averages" editable="bottom">
                <field name="name"/>
                <field name="factor_template_id" optional="show"/>
                <field name="period_label"/>
                <field name="period_date"/>
                <field name="average_score"/>
                <field name="source" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_qc_historical_factor_average_search" model="ir.ui.view">
        <field name="name">qc.historical.factor.average.search</field>
        <field name="model">qc.historical.factor.average</field>
        <field name="arch" type="xml">
            <search string="Historical Factor Averages">
                <field name="name"/>
                <field name="factor_template_id"/>
                <group>
                    <filter name="group_factor" string="Factor"
                            context="{'group_by': 'name'}"/>
                    <filter name="group_period" string="Period"
                            context="{'group_by': 'period_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_qc_historical_factor_average_graph" model="ir.ui.view">
        <field name="name">qc.historical.factor.average.graph</field>
        <field name="model">qc.historical.factor.average</field>
        <field name="arch" type="xml">
            <graph string="Historical Factor Averages" type="bar">
                <field name="name"/>
                <field name="average_score" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="action_qc_historical_factor_average" model="ir.actions.act_window">
        <field name="name">Historical Factor Averages</field>
        <field name="res_model">qc.historical.factor.average</field>
        <field name="view_mode">list,graph</field>
        <field name="search_view_id" ref="view_qc_historical_factor_average_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Import factor averages</p>
            <p>Load the ten overall factor averages from the historical summary
               using the provided CSV template.</p>
        </field>
    </record>

</odoo>
