<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!-- SOP / controlled documents                                   -->
    <!-- ============================================================ -->
    <record id="view_qc_document_list" model="ir.ui.view">
        <field name="name">qc.document.list</field>
        <field name="model">qc.document</field>
        <field name="arch" type="xml">
            <list string="Quality Documents"
                  decoration-danger="is_review_due"
                  decoration-muted="state == 'obsolete'">
                <field name="code"/>
                <field name="name"/>
                <field name="version"/>
                <field name="document_type"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'approved'"
                       decoration-warning="state == 'draft'"/>
                <field name="approved_by_id" optional="show"/>
                <field name="approval_date" optional="show"/>
                <field name="review_due_date"/>
                <field name="is_review_due" optional="show"/>
                <field name="company_id" groups="base.group_multi_company"
                       optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_qc_document_form" model="ir.ui.view">
        <field name="name">qc.document.form</field>
        <field name="model">qc.document</field>
        <field name="arch" type="xml">
            <form string="Quality Document">
                <header>
                    <button name="action_approve" string="Approve" type="object"
                            class="oe_highlight" invisible="state != 'draft'"
                            groups="site_quality_control.group_qc_quality_manager"/>
                    <button name="action_new_version" string="New Version"
                            type="object" invisible="state != 'approved'"/>
                    <button name="action_obsolete" string="Mark Obsolete"
                            type="object" invisible="state != 'approved'"
                            groups="site_quality_control.group_qc_quality_manager"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,approved"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Document title"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="version"/>
                            <field name="document_type"/>
                            <field name="file" filename="file_name"/>
                            <field name="file_name" invisible="1"/>
                        </group>
                        <group>
                            <field name="approved_by_id"/>
                            <field name="approval_date"/>
                            <field name="review_due_date"/>
                            <field name="company_id"
                                   groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <field name="note" placeholder="Notes..."/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_qc_document" model="ir.actions.act_window">
        <field name="name">SOP Documents</field>
        <field name="res_model">qc.document</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Register your procedures</p>
            <p>Versioned, approved quality documents (SOPs, HACCP plan,
               policies) with periodic review dates.</p>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- Training records                                             -->
    <!-- ============================================================ -->
    <record id="view_qc_training_list" model="ir.ui.view">
        <field name="name">qc.training.record.list</field>
        <field name="model">qc.training.record</field>
        <field name="arch" type="xml">
            <list string="Training Records" decoration-danger="is_expired">
                <field name="employee_id"/>
                <field name="name"/>
                <field name="branch_id" optional="show"/>
                <field name="date"/>
                <field name="trainer" optional="show"/>
                <field name="valid_until"/>
                <field name="result" widget="badge"
                       decoration-success="result == 'pass'"
                       decoration-danger="result == 'fail'"/>
                <field name="is_expired" optional="show"/>
                <field name="company_id" groups="base.group_multi_company"
                       optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_qc_training_form" model="ir.ui.view">
        <field name="name">qc.training.record.form</field>
        <field name="model">qc.training.record</field>
        <field name="arch" type="xml">
            <form string="Training Record">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Training topic"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="employee_id"/>
                            <field name="branch_id"/>
                            <field name="date"/>
                            <field name="trainer"/>
                        </group>
                        <group>
                            <field name="valid_until"/>
                            <field name="result"/>
                            <field name="certificate"
                                   filename="certificate_name"/>
                            <field name="certificate_name" invisible="1"/>
                            <field name="company_id"
                                   groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <field name="note" placeholder="Notes..."/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_qc_training_search" model="ir.ui.view">
        <field name="name">qc.training.record.search</field>
        <field name="model">qc.training.record</field>
        <field name="arch" type="xml">
            <search string="Training Records">
                <field name="employee_id"/>
                <field name="name"/>
                <field name="branch_id"/>
                <filter name="expired" string="Expired"
                        domain="[('is_expired', '=', True)]"/>
                <group>
                    <filter name="group_employee" string="Employee"
                            context="{'group_by': 'employee_id'}"/>
                    <filter name="group_topic" string="Topic"
                            context="{'group_by': 'name'}"/>
                    <filter name="group_branch" string="Site"
                            context="{'group_by': 'branch_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_qc_training" model="ir.actions.act_window">
        <field name="name">Training Records</field>
        <field name="res_model">qc.training.record</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_qc_training_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Record trainings</p>
            <p>Food-safety training and competency records per employee, with
               validity tracking (expired records show in red).</p>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- Allergens                                                    -->
    <!-- ============================================================ -->
    <record id="view_qc_allergen_list" model="ir.ui.view">
        <field name="name">qc.allergen.list</field>
        <field name="model">qc.allergen</field>
        <field name="arch" type="xml">
            <list string="Allergens" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="description" optional="show"/>
            </list>
        </field>
    </record>

    <record id="action_qc_allergen" model="ir.actions.act_window">
        <field name="name">Allergens</field>
        <field name="res_model">qc.allergen</field>
        <field name="view_mode">list</field>
    </record>

    <!-- ============================================================ -->
    <!-- Approved suppliers                                           -->
    <!-- ============================================================ -->
    <record id="view_qc_approved_supplier_list" model="ir.ui.view">
        <field name="name">qc.approved.supplier.list</field>
        <field name="model">qc.approved.supplier</field>
        <field name="arch" type="xml">
            <list string="Approved Suppliers"
                  decoration-danger="status == 'blocked'"
                  decoration-warning="status == 'conditional'">
                <field name="partner_id"/>
                <field name="status" widget="badge"
                       decoration-success="status == 'approved'"
                       decoration-warning="status == 'conditional'"
                       decoration-danger="status == 'blocked'"/>
                <field name="scope" optional="show"/>
                <field name="approval_date"/>
                <field name="expiry_date" optional="show"/>
                <field name="company_id" groups="base.group_multi_company"
                       optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_qc_approved_supplier_form" model="ir.ui.view">
        <field name="name">qc.approved.supplier.form</field>
        <field name="model">qc.approved.supplier</field>
        <field name="arch" type="xml">
            <form string="Approved Supplier">
                <sheet>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="status"/>
                            <field name="scope"/>
                        </group>
                        <group>
                            <field name="approval_date"/>
                            <field name="expiry_date"/>
                            <field name="company_id"
                                   groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group>
                        <field name="certificates"/>
                        <field name="note"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_qc_approved_supplier" model="ir.actions.act_window">
        <field name="name">Approved Suppliers</field>
        <field name="res_model">qc.approved.supplier</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Build the supplier list</p>
            <p>Approved / conditional / blocked suppliers. Blocked suppliers
               cannot have deliveries accepted at receiving.</p>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- Management reviews                                           -->
    <!-- ============================================================ -->
    <record id="view_qc_management_review_list" model="ir.ui.view">
        <field name="name">qc.management.review.list</field>
        <field name="model">qc.management.review</field>
        <field name="arch" type="xml">
            <list string="Management Reviews">
                <field name="name"/>
                <field name="date"/>
                <field name="period_start"/>
                <field name="period_end"/>
                <field name="chair_id"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"/>
                <field name="company_id" groups="base.group_multi_company"
                       optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_qc_management_review_form" model="ir.ui.view">
        <field name="name">qc.management.review.form</field>
        <field name="model">qc.management.review</field>
        <field name="arch" type="xml">
            <form string="Management Review">
                <header>
                    <button name="action_done" string="Complete" type="object"
                            class="oe_highlight" invisible="state != 'draft'"
                            groups="site_quality_control.group_qc_quality_manager"/>
                    <button name="action_reopen" string="Reopen" type="object"
                            invisible="state != 'done'"
                            groups="site_quality_control.group_qc_admin"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="date" readonly="state != 'draft'"/>
                            <field name="period_start"
                                   readonly="state != 'draft'"/>
                            <field name="period_end"
                                   readonly="state != 'draft'"/>
                            <field name="chair_id"
                                   readonly="state != 'draft'"/>
                            <field name="attendee_ids" widget="many2many_tags"
                                   readonly="state != 'draft'"/>
                            <field name="company_id"
                                   groups="base.group_multi_company"/>
                        </group>
                        <group string="Period KPIs">
                            <field name="inspection_count"/>
                            <field name="avg_score"/>
                            <field name="critical_count"/>
                            <field name="open_ca_count"/>
                            <field name="overdue_ca_count"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Inputs / Findings" name="inputs">
                            <field name="inputs_summary"
                                   readonly="state != 'draft'"
                                   placeholder="Audit results, complaints, trends, resources..."/>
                        </page>
                        <page string="Decisions" name="decisions">
                            <field name="decisions"
                                   readonly="state != 'draft'"
                                   placeholder="Decisions and improvement actions..."/>
                        </page>
                        <page string="Follow-up Actions" name="actions">
                            <field name="action_ids"
                                   context="{'default_management_review_id': id}">
                                <list>
                                    <field name="name"/>
                                    <field name="branch_id"/>
                                    <field name="responsible_id"/>
                                    <field name="due_date"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_qc_management_review" model="ir.actions.act_window">
        <field name="name">Management Reviews</field>
        <field name="res_model">qc.management.review</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Hold a management review</p>
            <p>Periodic review of quality performance with KPIs, decisions and
               follow-up actions (ISO 22000 §9.3).</p>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- Recalls                                                      -->
    <!-- ============================================================ -->
    <record id="view_qc_recall_list" model="ir.ui.view">
        <field name="name">qc.recall.list</field>
        <field name="model">qc.recall</field>
        <field name="arch" type="xml">
            <list string="Recalls"
                  decoration-danger="result == 'fail'"
                  decoration-success="result == 'pass'">
                <field name="name"/>
                <field name="recall_type"/>
                <field name="product_description"/>
                <field name="lot_ref" optional="show"/>
                <field name="date_started"/>
                <field name="duration_hours" optional="show"/>
                <field name="recovery_rate" optional="show"/>
                <field name="result" widget="badge"/>
                <field name="state" widget="badge"/>
                <field name="company_id" groups="base.group_multi_company"
                       optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_qc_recall_form" model="ir.ui.view">
        <field name="name">qc.recall.form</field>
        <field name="model">qc.recall</field>
        <field name="arch" type="xml">
            <form string="Recall">
                <header>
                    <button name="action_close" string="Close" type="object"
                            class="oe_highlight" invisible="state != 'open'"/>
                    <button name="action_reopen" string="Reopen" type="object"
                            invisible="state != 'closed'"
                            groups="site_quality_control.group_qc_admin"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="recall_type"
                                   readonly="state != 'open'"/>
                            <field name="product_description"
                                   readonly="state != 'open'"/>
                            <field name="lot_id" readonly="state != 'open'"/>
                            <field name="lot_ref" readonly="state != 'open'"/>
                            <field name="branch_ids" widget="many2many_tags"
                                   readonly="state != 'open'"/>
                            <field name="company_id"
                                   groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="initiated_by_id"/>
                            <field name="date_started"
                                   readonly="state != 'open'"/>
                            <field name="date_completed"
                                   readonly="state != 'open'"/>
                            <field name="duration_hours"/>
                            <field name="qty_affected"
                                   readonly="state != 'open'"/>
                            <field name="qty_recovered"
                                   readonly="state != 'open'"/>
                            <field name="recovery_rate"/>
                            <field name="result" readonly="state != 'open'"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Scenario / Reason" name="reason">
                            <field name="reason" readonly="state != 'open'"/>
                        </page>
                        <page string="Traceability" name="trace">
                            <field name="receiving_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="branch_id"/>
                                    <field name="date"/>
                                    <field name="supplier_id"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                        <page string="Findings" name="findings">
                            <field name="note" readonly="state != 'open'"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_qc_recall" model="ir.actions.act_window">
        <field name="name">Recalls</field>
        <field name="res_model">qc.recall</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Run a mock recall</p>
            <p>Document real recalls and periodic traceability exercises:
               trace the lot, measure recovery and elapsed time.</p>
        </field>
    </record>

</odoo>
