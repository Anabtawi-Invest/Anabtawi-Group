<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_qc_branch_list" model="ir.ui.view">
        <field name="name">qc.branch.list</field>
        <field name="model">qc.branch</field>
        <field name="arch" type="xml">
            <list string="Sites">
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="region"/>
                <field name="manager_id"/>
                <field name="inspector_id"/>
                <field name="inspection_frequency"/>
                <field name="min_passing_score"/>
                <field name="last_score" optional="show"/>
                <field name="last_grade_id" optional="show"/>
                <field name="open_corrective_count" optional="hide"/>
                <field name="overdue_corrective_count" optional="hide"
                       decoration-danger="overdue_corrective_count > 0"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_qc_branch_form" model="ir.ui.view">
        <field name="name">qc.branch.form</field>
        <field name="model">qc.branch</field>
        <field name="arch" type="xml">
            <form string="Site">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger"
                            invisible="active"/>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_inspections" type="object"
                                class="oe_stat_button" icon="fa-clipboard">
                            <field name="inspection_count" widget="statinfo"
                                   string="Inspections"/>
                        </button>
                        <button name="action_view_corrective_actions" type="object"
                                class="oe_stat_button" icon="fa-wrench">
                            <field name="open_corrective_count" widget="statinfo"
                                   string="Open Actions"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Site name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="region"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group>
                            <field name="manager_id"/>
                            <field name="inspector_id"/>
                            <field name="inspection_frequency"/>
                            <field name="min_passing_score"/>
                        </group>
                    </group>
                    <group string="Operational Links (optional)">
                        <field name="warehouse_id"/>
                        <field name="pos_config_id"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_qc_branch_search" model="ir.ui.view">
        <field name="name">qc.branch.search</field>
        <field name="model">qc.branch</field>
        <field name="arch" type="xml">
            <search string="Sites">
                <field name="name"/>
                <field name="code"/>
                <field name="region"/>
                <field name="manager_id"/>
                <field name="inspector_id"/>
                <filter name="archived" string="Archived"
                        domain="[('active', '=', False)]"/>
                <group>
                    <filter name="group_region" string="Region"
                            context="{'group_by': 'region'}"/>
                    <filter name="group_frequency" string="Frequency"
                            context="{'group_by': 'inspection_frequency'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_qc_branch" model="ir.actions.act_window">
        <field name="name">Sites</field>
        <field name="res_model">qc.branch</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_qc_branch_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first site</p>
            <p>Maintain the directory of sites (branches, departments, factories) to be inspected.</p>
        </field>
    </record>

</odoo>
