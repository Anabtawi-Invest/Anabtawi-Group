<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_qc_daily_checklist_form" model="ir.ui.view">
        <field name="name">qc.daily.checklist.form</field>
        <field name="model">qc.daily.checklist</field>
        <field name="arch" type="xml">
            <form string="Daily Checklist">
                <header>
                    <button name="action_done" string="Mark as Done" type="object"
                            class="oe_highlight" invisible="state != 'todo'"/>
                    <button name="action_load_lines" string="Reload Tasks"
                            type="object" invisible="state != 'todo'"/>
                    <button name="action_unlock" string="Unlock" type="object"
                            invisible="state != 'done'"
                            groups="site_quality_control.group_qc_admin"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="todo,done"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Done" bg_color="text-bg-success"
                            invisible="state != 'done'"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="branch_id" readonly="state != 'todo'"/>
                            <field name="template_id" readonly="state != 'todo'"/>
                            <field name="date" readonly="state != 'todo'"/>
                            <field name="round" readonly="state != 'todo'"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="user_id"/>
                            <field name="done_datetime"/>
                            <field name="progress" widget="progressbar"/>
                            <field name="out_of_range_count"
                                   decoration-danger="out_of_range_count > 0"/>
                        </group>
                    </group>
                    <group groups="site_quality_control.group_qc_admin"
                           invisible="state != 'done'">
                        <field name="unlock_reason"
                               placeholder="Reason required to unlock this record..."/>
                        <field name="unlock_count"/>
                    </group>
                    <notebook>
                        <page string="Tasks" name="tasks">
                            <field name="line_ids" readonly="state == 'done'">
                                <list editable="bottom"
                                      default_order="section_sequence, sequence"
                                      decoration-danger="out_of_range"
                                      decoration-muted="not_applicable">
                                    <field name="section_sequence" column_invisible="1"/>
                                    <field name="sequence" column_invisible="1"/>
                                    <field name="section" readonly="1"/>
                                    <field name="name" readonly="1"/>
                                    <field name="answer_type" readonly="1"
                                           optional="hide"/>
                                    <field name="is_done"/>
                                    <field name="value"/>
                                    <field name="uom_name" readonly="1" optional="show"/>
                                    <field name="target_value" readonly="1"
                                           optional="show"/>
                                    <field name="tolerance_min" readonly="1"
                                           optional="hide"/>
                                    <field name="tolerance_max" readonly="1"
                                           optional="hide"/>
                                    <field name="instrument_id" optional="show"/>
                                    <field name="ccp_id" readonly="1"
                                           optional="show"/>
                                    <field name="out_of_range" readonly="1"/>
                                    <field name="not_applicable"/>
                                    <field name="comment" optional="show"/>
                                    <field name="photo" widget="image" optional="hide"/>
                                    <field name="is_critical" readonly="1"
                                           optional="show"/>
                                    <field name="is_complete" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="note" placeholder="Notes..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_qc_daily_checklist_list" model="ir.ui.view">
        <field name="name">qc.daily.checklist.list</field>
        <field name="model">qc.daily.checklist</field>
        <field name="arch" type="xml">
            <list string="Daily Checklists"
                  decoration-success="state == 'done'"
                  decoration-danger="out_of_range_count > 0">
                <field name="name"/>
                <field name="branch_id"/>
                <field name="date"/>
                <field name="round"/>
                <field name="template_id" optional="show"/>
                <field name="user_id" optional="show"/>
                <field name="progress" widget="progressbar"/>
                <field name="out_of_range_count"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-warning="state == 'todo'"/>
                <field name="company_id" groups="base.group_multi_company"
                       optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_qc_daily_checklist_search" model="ir.ui.view">
        <field name="name">qc.daily.checklist.search</field>
        <field name="model">qc.daily.checklist</field>
        <field name="arch" type="xml">
            <search string="Daily Checklists">
                <field name="name"/>
                <field name="branch_id"/>
                <field name="user_id"/>
                <filter name="today" string="Today"
                        domain="[('date', '=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter name="todo" string="To Do"
                        domain="[('state', '=', 'todo')]"/>
                <filter name="with_issues" string="Out of Range"
                        domain="[('line_ids.out_of_range', '=', True)]"/>
                <group>
                    <filter name="group_branch" string="Site"
                            context="{'group_by': 'branch_id'}"/>
                    <filter name="group_date" string="Date"
                            context="{'group_by': 'date'}"/>
                    <filter name="group_state" string="Status"
                            context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_qc_daily_checklist" model="ir.actions.act_window">
        <field name="name">Daily Checklists</field>
        <field name="res_model">qc.daily.checklist</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_qc_daily_checklist_search"/>
        <field name="context">{'search_default_today': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No daily checklist yet</p>
            <p>Daily checklists are generated automatically every morning for
               each active site, or can be created manually.</p>
        </field>
    </record>

</odoo>
