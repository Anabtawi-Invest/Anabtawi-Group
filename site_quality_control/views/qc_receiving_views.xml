<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_qc_receiving_form" model="ir.ui.view">
        <field name="name">qc.receiving.inspection.form</field>
        <field name="model">qc.receiving.inspection</field>
        <field name="arch" type="xml">
            <form string="Receiving Inspection">
                <header>
                    <button name="action_accept" string="Accept Delivery"
                            type="object" class="oe_highlight"
                            invisible="state != 'todo'"/>
                    <button name="action_reject" string="Reject Delivery"
                            type="object" invisible="state != 'todo'"/>
                    <button name="action_load_lines" string="Reload Checks"
                            type="object" invisible="state != 'todo'"/>
                    <button name="action_unlock" string="Unlock" type="object"
                            invisible="state == 'todo'"
                            groups="site_quality_control.group_qc_admin"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="todo,accepted"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Accepted"
                            bg_color="text-bg-success"
                            invisible="state != 'accepted'"/>
                    <widget name="web_ribbon" title="Rejected"
                            bg_color="text-bg-danger"
                            invisible="state != 'rejected'"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="branch_id" readonly="state != 'todo'"/>
                            <field name="template_id" readonly="state != 'todo'"/>
                            <field name="date" readonly="state != 'todo'"/>
                            <field name="supplier_id" readonly="state != 'todo'"/>
                            <field name="product_description"
                                   readonly="state != 'todo'"/>
                            <field name="company_id"
                                   groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="picking_id" readonly="state != 'todo'"/>
                            <field name="lot_id" readonly="state != 'todo'"/>
                            <field name="lot_ref" readonly="state != 'todo'"/>
                            <field name="user_id"/>
                            <field name="decision_datetime"/>
                            <field name="progress" widget="progressbar"/>
                            <field name="out_of_range_count"
                                   decoration-danger="out_of_range_count > 0"/>
                        </group>
                    </group>
                    <group invisible="state == 'accepted' and not reject_reason">
                        <field name="reject_reason"
                               readonly="state != 'todo'"
                               placeholder="Mandatory when rejecting the delivery..."/>
                    </group>
                    <group groups="site_quality_control.group_qc_admin"
                           invisible="state == 'todo'">
                        <field name="unlock_reason"
                               placeholder="Reason required to unlock this record..."/>
                        <field name="unlock_count"/>
                    </group>
                    <notebook>
                        <page string="Checks" name="checks">
                            <field name="line_ids" readonly="state != 'todo'">
                                <list editable="bottom"
                                      default_order="section_sequence, sequence"
                                      decoration-danger="out_of_range"
                                      decoration-muted="not_applicable">
                                    <field name="section_sequence"
                                           column_invisible="1"/>
                                    <field name="sequence" column_invisible="1"/>
                                    <field name="section" readonly="1"/>
                                    <field name="name" readonly="1"/>
                                    <field name="answer_type" readonly="1"
                                           optional="hide"/>
                                    <field name="is_done"/>
                                    <field name="value"/>
                                    <field name="uom_name" readonly="1"
                                           optional="show"/>
                                    <field name="target_value" readonly="1"
                                           optional="show"/>
                                    <field name="tolerance_min" readonly="1"
                                           optional="hide"/>
                                    <field name="tolerance_max" readonly="1"
                                           optional="hide"/>
                                    <field name="instrument_id"
                                           optional="show"/>
                                    <field name="ccp_id" readonly="1"
                                           optional="show"/>
                                    <field name="out_of_range" readonly="1"/>
                                    <field name="not_applicable"/>
                                    <field name="comment" optional="show"/>
                                    <field name="photo_ids" widget="many2many_binary"
                                           optional="show"/>
                                    <field name="is_critical" readonly="1"
                                           optional="show"/>
                                    <field name="is_complete"
                                           column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="note" placeholder="Notes..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_qc_receiving_list" model="ir.ui.view">
        <field name="name">qc.receiving.inspection.list</field>
        <field name="model">qc.receiving.inspection</field>
        <field name="arch" type="xml">
            <list string="Receiving Inspections"
                  decoration-success="state == 'accepted'"
                  decoration-danger="state == 'rejected'">
                <field name="name"/>
                <field name="branch_id"/>
                <field name="date"/>
                <field name="supplier_id"/>
                <field name="product_description" optional="show"/>
                <field name="picking_id" optional="hide"/>
                <field name="lot_ref" optional="hide"/>
                <field name="out_of_range_count"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'accepted'"
                       decoration-danger="state == 'rejected'"
                       decoration-warning="state == 'todo'"/>
                <field name="company_id" groups="base.group_multi_company"
                       optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_qc_receiving_search" model="ir.ui.view">
        <field name="name">qc.receiving.inspection.search</field>
        <field name="model">qc.receiving.inspection</field>
        <field name="arch" type="xml">
            <search string="Receiving Inspections">
                <field name="name"/>
                <field name="branch_id"/>
                <field name="supplier_id"/>
                <field name="lot_ref"/>
                <filter name="todo" string="To Do"
                        domain="[('state', '=', 'todo')]"/>
                <filter name="rejected" string="Rejected"
                        domain="[('state', '=', 'rejected')]"/>
                <group>
                    <filter name="group_branch" string="Site"
                            context="{'group_by': 'branch_id'}"/>
                    <filter name="group_supplier" string="Supplier"
                            context="{'group_by': 'supplier_id'}"/>
                    <filter name="group_state" string="Status"
                            context="{'group_by': 'state'}"/>
                    <filter name="group_date" string="Date"
                            context="{'group_by': 'date'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_qc_receiving" model="ir.actions.act_window">
        <field name="name">Receiving Inspections</field>
        <field name="res_model">qc.receiving.inspection</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_qc_receiving_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Inspect a delivery</p>
            <p>Check every incoming delivery (truck temperature, packaging,
               documents, expiry) and accept or reject it. Rejections and
               critical failures raise corrective actions.</p>
        </field>
    </record>

</odoo>
