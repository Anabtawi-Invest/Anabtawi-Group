<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_qc_corrective_action_form" model="ir.ui.view">
        <field name="name">qc.corrective.action.form</field>
        <field name="model">qc.corrective.action</field>
        <field name="arch" type="xml">
            <form string="Corrective Action">
                <header>
                    <button name="action_start" string="Start" type="object"
                            class="oe_highlight" invisible="state != 'new'"/>
                    <button name="action_done" string="Mark Done" type="object"
                            class="oe_highlight" invisible="state != 'in_progress'"/>
                    <button name="action_verify" string="Verify" type="object"
                            class="oe_highlight" invisible="state != 'done'"/>
                    <button name="action_cancel" string="Cancel" type="object"
                            invisible="state in ('verified', 'cancel')"/>
                    <button name="action_reset" string="Reset to New" type="object"
                            invisible="state == 'new'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="new,in_progress,done,verified"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Overdue" bg_color="text-bg-danger"
                            invisible="not is_overdue"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="branch_id"/>
                            <field name="inspection_id" invisible="not inspection_id"/>
                            <field name="factor_id" invisible="not factor_id"/>
                            <field name="management_review_id" invisible="not management_review_id" readonly="1"/>
                            <field name="sanitation_log_id" invisible="not sanitation_log_id" readonly="1"/>
                            <field name="environmental_monitoring_id" invisible="not environmental_monitoring_id" readonly="1"/>
                            <field name="complaint_id" invisible="not complaint_id" readonly="1"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="responsible_id"/>
                            <field name="due_date"/>
                            <field name="priority" widget="priority"/>
                            <field name="is_overdue" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Analysis" name="analysis">
                            <group>
                                <field name="problem"/>
                                <field name="root_cause"/>
                                <field name="immediate_action"/>
                                <field name="corrective_action"/>
                            </group>
                        </page>
                        <page string="Evidence &amp; Verification" name="evidence">
                            <group>
                                <group string="Evidence">
                                    <field name="evidence_before" widget="image"/>
                                    <field name="evidence_after" widget="image"/>
                                </group>
                                <group string="Verification">
                                    <field name="verification_result"/>
                                    <field name="verified_by_id" readonly="1"/>
                                    <field name="verification_date" readonly="1"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_qc_corrective_action_list" model="ir.ui.view">
        <field name="name">qc.corrective.action.list</field>
        <field name="model">qc.corrective.action</field>
        <field name="arch" type="xml">
            <list string="Corrective Actions" decoration-danger="is_overdue">
                <field name="name"/>
                <field name="branch_id"/>
                <field name="inspection_id" optional="show"/>
                <field name="responsible_id"/>
                <field name="due_date"/>
                <field name="priority" widget="priority"/>
                <field name="state" widget="badge"/>
                <field name="is_overdue" optional="show"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_qc_corrective_action_search" model="ir.ui.view">
        <field name="name">qc.corrective.action.search</field>
        <field name="model">qc.corrective.action</field>
        <field name="arch" type="xml">
            <search string="Corrective Actions">
                <field name="name"/>
                <field name="branch_id"/>
                <field name="responsible_id"/>
                <filter name="my_actions" string="My Actions"
                        domain="[('responsible_id', '=', uid)]"/>
                <filter name="overdue" string="Overdue"
                        domain="[('is_overdue', '=', True)]"/>
                <filter name="open" string="Open"
                        domain="[('state', 'not in', ('done', 'verified', 'cancel'))]"/>
                <group>
                    <filter name="group_branch" string="Site"
                            context="{'group_by': 'branch_id'}"/>
                    <filter name="group_state" string="Status"
                            context="{'group_by': 'state'}"/>
                    <filter name="group_priority" string="Priority"
                            context="{'group_by': 'priority'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_qc_corrective_action" model="ir.actions.act_window">
        <field name="name">Corrective Actions</field>
        <field name="res_model">qc.corrective.action</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_qc_corrective_action_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No corrective actions yet</p>
            <p>Corrective actions are created from failed inspection factors.</p>
        </field>
    </record>

</odoo>
