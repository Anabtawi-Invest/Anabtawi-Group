<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_qc_instrument_list" model="ir.ui.view">
        <field name="name">qc.instrument.list</field>
        <field name="model">qc.instrument</field>
        <field name="arch" type="xml">
            <list string="Instruments"
                  decoration-danger="calibration_state == 'overdue'"
                  decoration-warning="calibration_state in ('due_soon', 'never')">
                <field name="name"/>
                <field name="code" optional="show"/>
                <field name="instrument_type"/>
                <field name="branch_id"/>
                <field name="serial_number" optional="hide"/>
                <field name="last_calibration_date"/>
                <field name="next_calibration_date"/>
                <field name="calibration_state" widget="badge"
                       decoration-success="calibration_state == 'valid'"
                       decoration-warning="calibration_state in ('due_soon', 'never')"
                       decoration-danger="calibration_state == 'overdue'"/>
                <field name="company_id" groups="base.group_multi_company"
                       optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_qc_instrument_form" model="ir.ui.view">
        <field name="name">qc.instrument.form</field>
        <field name="model">qc.instrument</field>
        <field name="arch" type="xml">
            <form string="Instrument">
                <sheet>
                    <widget name="web_ribbon" title="Overdue"
                            bg_color="text-bg-danger"
                            invisible="calibration_state != 'overdue'"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Fridge thermometer #1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="instrument_type"/>
                            <field name="serial_number"/>
                            <field name="branch_id"/>
                        </group>
                        <group>
                            <field name="calibration_interval"/>
                            <field name="last_calibration_date"/>
                            <field name="next_calibration_date"/>
                            <field name="calibration_state" widget="badge"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Calibration History" name="calibrations">
                            <field name="calibration_ids">
                                <list editable="bottom">
                                    <field name="date"/>
                                    <field name="performed_by"/>
                                    <field name="result"/>
                                    <field name="certificate" widget="binary"
                                           filename="certificate_name"/>
                                    <field name="certificate_name"
                                           column_invisible="1"/>
                                    <field name="note" optional="show"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="note" placeholder="Notes..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_qc_instrument_search" model="ir.ui.view">
        <field name="name">qc.instrument.search</field>
        <field name="model">qc.instrument</field>
        <field name="arch" type="xml">
            <search string="Instruments">
                <field name="name"/>
                <field name="code"/>
                <field name="branch_id"/>
                <field name="serial_number"/>
                <filter name="overdue" string="Calibration Overdue"
                        domain="[('calibration_state', '=', 'overdue')]"/>
                <filter name="due_soon" string="Due Soon"
                        domain="[('calibration_state', '=', 'due_soon')]"/>
                <group>
                    <filter name="group_branch" string="Site"
                            context="{'group_by': 'branch_id'}"/>
                    <filter name="group_type" string="Type"
                            context="{'group_by': 'instrument_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_qc_instrument" model="ir.actions.act_window">
        <field name="name">Instruments</field>
        <field name="res_model">qc.instrument</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_qc_instrument_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Register your instruments</p>
            <p>Track thermometers and other measuring devices with their
               calibration schedule. Measures recorded with an overdue
               instrument are rejected.</p>
        </field>
    </record>

</odoo>
