<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Spreadsheet Dashboard Group for Quality Control -->
    <record id="spreadsheet_dashboard_group_quality" model="spreadsheet.dashboard.group">
        <field name="name">Quality &amp; Site Audits</field>
        <field name="sequence">100</field>
    </record>

    <!-- Unified Quality Spreadsheet Dashboard -->
    <record id="spreadsheet_dashboard_quality_combined" model="spreadsheet.dashboard">
        <field name="name">Quality &amp; Audit Performance</field>
        <field name="dashboard_group_id" ref="spreadsheet_dashboard_group_quality"/>
        <field name="data" type="base64" file="site_quality_control/data/dashboards/quality_combined_dashboard.json"/>
        <field name="sequence">10</field>
    </record>
</odoo>
