<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!-- CCP register seeds (HACCP). Wording provisional — QA team to -->
    <!-- validate against the site hazard analysis before production. -->
    <!-- ============================================================ -->
    <data noupdate="1">

        <record id="ccp_cold_storage" model="qc.ccp">
            <field name="code">CCP-01</field>
            <field name="name">التخزين المبرد</field>
            <field name="sequence">10</field>
            <field name="process_step">التخزين والعرض المبرد</field>
            <field name="hazard_type">biological</field>
            <field name="hazard_description">نمو البكتيريا الممرضة عند ارتفاع درجة حرارة التبريد فوق الحد الحرج</field>
            <field name="critical_limit">0 - 5 °C</field>
            <field name="monitoring_frequency">per_round</field>
            <field name="corrective_guidance">نقل المنتجات فوراً إلى براد بديل، فحص المعدة، إبلاغ مدير الفرع، تقييم سلامة المنتجات المعرضة</field>
        </record>

        <record id="ccp_freezing" model="qc.ccp">
            <field name="code">CCP-02</field>
            <field name="name">التجميد</field>
            <field name="sequence">20</field>
            <field name="process_step">التخزين المجمد</field>
            <field name="hazard_type">biological</field>
            <field name="hazard_description">فساد المنتجات المجمدة عند ارتفاع درجة حرارة الفريزر</field>
            <field name="critical_limit">أقل من أو يساوي -15 °C</field>
            <field name="monitoring_frequency">per_round</field>
            <field name="corrective_guidance">نقل المنتجات إلى فريزر بديل، عدم إعادة تجميد المنتجات الذائبة، إبلاغ مدير الفرع</field>
        </record>

        <record id="ccp_expiry" model="qc.ccp">
            <field name="code">CCP-03</field>
            <field name="name">الصلاحية والتتبع</field>
            <field name="sequence">30</field>
            <field name="process_step">العرض والبيع</field>
            <field name="hazard_type">biological</field>
            <field name="hazard_description">بيع منتجات منتهية الصلاحية أو غير قابلة للتتبع</field>
            <field name="critical_limit">لا منتجات منتهية الصلاحية معروضة</field>
            <field name="monitoring_frequency">daily</field>
            <field name="corrective_guidance">سحب المنتج فوراً، توثيق الكمية والمصدر، إبلاغ إدارة الجودة</field>
        </record>

        <record id="ccp_receiving_temp" model="qc.ccp">
            <field name="code">CCP-04</field>
            <field name="name">حرارة الاستلام</field>
            <field name="sequence">40</field>
            <field name="process_step">استلام البضائع</field>
            <field name="hazard_type">biological</field>
            <field name="hazard_description">استلام مواد مبردة/مجمدة بدرجة حرارة غير مطابقة</field>
            <field name="critical_limit">مبرد 0-5 °C، مجمد ≤ -15 °C</field>
            <field name="monitoring_frequency">per_batch</field>
            <field name="corrective_guidance">رفض الاستلام وتوثيقه وإبلاغ المورد وإدارة الجودة</field>
        </record>

    </data>

    <!-- Link existing checklist questions to their CCPs. Kept outside
         noupdate so upgrades keep the links aligned. -->
    <data noupdate="0">
        <record id="daily_q_temp_fridge1" model="qc.question.template">
            <field name="ccp_id" ref="ccp_cold_storage"/>
        </record>
        <record id="daily_q_temp_fridge2" model="qc.question.template">
            <field name="ccp_id" ref="ccp_cold_storage"/>
        </record>
        <record id="daily_q_temp_freezer" model="qc.question.template">
            <field name="ccp_id" ref="ccp_freezing"/>
        </record>
        <record id="daily_q_open_4" model="qc.question.template">
            <field name="ccp_id" ref="ccp_expiry"/>
        </record>
        <record id="q_exp_1" model="qc.question.template">
            <field name="ccp_id" ref="ccp_expiry"/>
        </record>
        <record id="q_stor_1" model="qc.question.template">
            <field name="ccp_id" ref="ccp_cold_storage"/>
        </record>
    </data>

</odoo>
