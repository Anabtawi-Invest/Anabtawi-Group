<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="cron_generate_scheduled_inspections" model="ir.cron">
        <field name="name">Branch QC: Generate Scheduled Inspections</field>
        <field name="model_id" ref="model_qc_inspection"/>
        <field name="state">code</field>
        <field name="code">model._cron_generate_scheduled_inspections()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>

    <record id="cron_generate_daily_checklists" model="ir.cron">
        <field name="name">Branch QC: Generate Daily Checklists</field>
        <field name="model_id" ref="model_qc_daily_checklist"/>
        <field name="state">code</field>
        <field name="code">model._cron_generate_daily_checklists()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>

    <record id="cron_calibration_reminders" model="ir.cron">
        <field name="name">Branch QC: Instrument Calibration Reminders</field>
        <field name="model_id" ref="model_qc_instrument"/>
        <field name="state">code</field>
        <field name="code">model._cron_calibration_reminders()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>

    <record id="cron_send_due_reminders" model="ir.cron">
        <field name="name">Branch QC: Inspection Reminders</field>
        <field name="model_id" ref="model_qc_inspection"/>
        <field name="state">code</field>
        <field name="code">model._cron_send_due_reminders()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>

    <record id="cron_escalate_overdue_corrective" model="ir.cron">
        <field name="name">Branch QC: Escalate Overdue Corrective Actions</field>
        <field name="model_id" ref="model_qc_corrective_action"/>
        <field name="state">code</field>
        <field name="code">model._cron_escalate_overdue()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>

    <record id="cron_generate_sanitation_logs" model="ir.cron">
        <field name="name">Branch QC: Generate Sanitation Logs (GMP)</field>
        <field name="model_id" ref="model_qc_sanitation_task"/>
        <field name="state">code</field>
        <field name="code">model._cron_generate_sanitation_logs()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>

</odoo>
