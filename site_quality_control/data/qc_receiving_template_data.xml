<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!-- ============================================================ -->
    <!-- Receiving inspection template. Wording provisional — QA team -->
    <!-- to approve before production use.                            -->
    <!-- ============================================================ -->
    <record id="template_receiving" model="qc.checklist.template">
        <field name="name">فحص استلام البضائع / Receiving Inspection</field>
        <field name="checklist_type">receiving</field>
    </record>

    <record id="recv_factor_vehicle" model="qc.factor.template">
        <field name="name">مركبة النقل والحرارة</field>
        <field name="template_id" ref="template_receiving"/>
        <field name="sequence">10</field>
    </record>
    <record id="recv_q_truck_clean" model="qc.question.template">
        <field name="name">نظافة مركبة النقل وخلوها من الروائح</field>
        <field name="factor_id" ref="recv_factor_vehicle"/>
        <field name="sequence">10</field>
        <field name="answer_type">check</field>
    </record>
    <record id="recv_q_truck_temp_chilled" model="qc.question.template">
        <field name="name">درجة حرارة صندوق التبريد عند الاستلام</field>
        <field name="factor_id" ref="recv_factor_vehicle"/>
        <field name="sequence">20</field>
        <field name="answer_type">measure</field>
        <field name="is_critical" eval="True"/>
        <field name="target_value">4.0</field>
        <field name="tolerance_min">0.0</field>
        <field name="tolerance_max">5.0</field>
        <field name="uom_name">°C</field>
        <field name="ccp_id" ref="ccp_receiving_temp"/>
    </record>
    <record id="recv_q_product_temp_frozen" model="qc.question.template">
        <field name="name">درجة حرارة المنتجات المجمدة عند الاستلام</field>
        <field name="factor_id" ref="recv_factor_vehicle"/>
        <field name="sequence">30</field>
        <field name="answer_type">measure</field>
        <field name="is_critical" eval="True"/>
        <field name="target_value">-18.0</field>
        <field name="tolerance_min">-25.0</field>
        <field name="tolerance_max">-15.0</field>
        <field name="uom_name">°C</field>
        <field name="ccp_id" ref="ccp_receiving_temp"/>
    </record>

    <record id="recv_factor_goods" model="qc.factor.template">
        <field name="name">حالة البضاعة والوثائق</field>
        <field name="template_id" ref="template_receiving"/>
        <field name="sequence">20</field>
    </record>
    <record id="recv_q_packaging" model="qc.question.template">
        <field name="name">سلامة العبوات والتغليف</field>
        <field name="factor_id" ref="recv_factor_goods"/>
        <field name="sequence">10</field>
        <field name="answer_type">check</field>
    </record>
    <record id="recv_q_expiry" model="qc.question.template">
        <field name="name">تواريخ الصلاحية مطابقة ومقبولة</field>
        <field name="factor_id" ref="recv_factor_goods"/>
        <field name="sequence">20</field>
        <field name="answer_type">check</field>
        <field name="is_critical" eval="True"/>
        <field name="ccp_id" ref="ccp_expiry"/>
    </record>
    <record id="recv_q_pests" model="qc.question.template">
        <field name="name">خلو البضاعة من علامات الآفات</field>
        <field name="factor_id" ref="recv_factor_goods"/>
        <field name="sequence">30</field>
        <field name="answer_type">check</field>
        <field name="is_critical" eval="True"/>
    </record>
    <record id="recv_q_documents" model="qc.question.template">
        <field name="name">اكتمال وثائق التسليم والفواتير وشهادات المنشأ</field>
        <field name="factor_id" ref="recv_factor_goods"/>
        <field name="sequence">40</field>
        <field name="answer_type">check</field>
    </record>
    <record id="recv_q_labels" model="qc.question.template">
        <field name="name">مطابقة بيانات الملصقات (المنتج، الوزن، رقم التشغيلة)</field>
        <field name="factor_id" ref="recv_factor_goods"/>
        <field name="sequence">50</field>
        <field name="answer_type">check</field>
    </record>
    <record id="recv_q_notes" model="qc.question.template">
        <field name="name">ملاحظات الاستلام</field>
        <field name="factor_id" ref="recv_factor_goods"/>
        <field name="sequence">60</field>
        <field name="answer_type">comment</field>
    </record>

</odoo>
