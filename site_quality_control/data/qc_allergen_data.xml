<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!-- Major allergen register (BRCGS 5.3). Arabic wording provisional. -->
    <record id="allergen_gluten" model="qc.allergen">
        <field name="name">الغلوتين (القمح)</field>
        <field name="code">AL01</field>
        <field name="sequence">10</field>
    </record>
    <record id="allergen_milk" model="qc.allergen">
        <field name="name">الحليب ومشتقاته</field>
        <field name="code">AL02</field>
        <field name="sequence">20</field>
    </record>
    <record id="allergen_eggs" model="qc.allergen">
        <field name="name">البيض</field>
        <field name="code">AL03</field>
        <field name="sequence">30</field>
    </record>
    <record id="allergen_tree_nuts" model="qc.allergen">
        <field name="name">المكسرات (جوز، لوز، فستق)</field>
        <field name="code">AL04</field>
        <field name="sequence">40</field>
    </record>
    <record id="allergen_peanuts" model="qc.allergen">
        <field name="name">الفول السوداني</field>
        <field name="code">AL05</field>
        <field name="sequence">50</field>
    </record>
    <record id="allergen_sesame" model="qc.allergen">
        <field name="name">السمسم</field>
        <field name="code">AL06</field>
        <field name="sequence">60</field>
    </record>
    <record id="allergen_soy" model="qc.allergen">
        <field name="name">الصويا</field>
        <field name="code">AL07</field>
        <field name="sequence">70</field>
    </record>
    <record id="allergen_sulphites" model="qc.allergen">
        <field name="name">الكبريتيت</field>
        <field name="code">AL08</field>
        <field name="sequence">80</field>
    </record>
    <record id="allergen_lupin" model="qc.allergen">
        <field name="name">الترمس</field>
        <field name="code">AL09</field>
        <field name="sequence">90</field>
    </record>

    <!-- Allergen-control questions appended to the receiving factor -->
    <record id="recv_q_allergen_segregation" model="qc.question.template">
        <field name="name">فصل المواد المسببة للحساسية أثناء الاستلام والتخزين</field>
        <field name="factor_id" ref="recv_factor_goods"/>
        <field name="sequence">45</field>
        <field name="answer_type">check</field>
        <field name="is_critical" eval="True"/>
        <field name="allergen_ids"
               eval="[Command.set([ref('allergen_tree_nuts'), ref('allergen_peanuts'), ref('allergen_sesame'), ref('allergen_gluten'), ref('allergen_milk')])]"/>
    </record>
    <record id="recv_q_allergen_labelling" model="qc.question.template">
        <field name="name">وضوح بيانات مسببات الحساسية على ملصقات المنتجات المستلمة</field>
        <field name="factor_id" ref="recv_factor_goods"/>
        <field name="sequence">46</field>
        <field name="answer_type">check</field>
        <field name="allergen_ids"
               eval="[Command.set([ref('allergen_gluten'), ref('allergen_milk'), ref('allergen_eggs')])]"/>
    </record>

</odoo>
