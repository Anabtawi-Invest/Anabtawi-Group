<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Wizard Form View -->
    <record id="view_tax_audit_report_wizard_form" model="ir.ui.view">
        <field name="name">tax.audit.report.wizard.form</field>
        <field name="model">tax.audit.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Tax Audit &amp; Declaration Report">
                <sheet>
                    <div class="oe_title">
                        <h1>Tax Audit &amp; Declaration Report</h1>
                        <p class="text-muted">Generate consolidated Output vs Input tax returns for audit compliance in Excel or PDF format.</p>
                    </div>
                    <group>
                        <group string="Reporting Period">
                            <field name="date_from"/>
                            <field name="date_to"/>
                            <field name="target_state"/>
                        </group>
                        <group string="Tax &amp; Currency Settings">
                            <field name="tax_jurisdiction"/>
                            <field name="tax_rate"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="currency_id"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button name="action_generate_excel" string="Export Excel Report (.xlsx)" type="object" class="btn-primary" icon="fa-file-excel-o"/>
                    <button name="action_generate_pdf" string="Generate PDF Report" type="object" class="btn-secondary" icon="fa-file-pdf-o"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Wizard Action -->
    <record id="action_tax_audit_report_wizard" model="ir.actions.act_window">
        <field name="name">Tax Audit &amp; Declaration Report</field>
        <field name="res_model">tax.audit.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- Menuitem under Accounting -> Reporting -->
    <menuitem id="menu_tax_audit_report_wizard"
              name="Tax Audit &amp; Declaration Report"
              action="action_tax_audit_report_wizard"
              parent="account.menu_finance_reports"
              sequence="25"/>
</odoo>
