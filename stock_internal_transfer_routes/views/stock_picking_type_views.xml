<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_type_form_apply_routes" model="ir.ui.view">
        <field name="name">stock.picking.type.form.apply.routes</field>
        <field name="model">stock.picking.type</field>
        <field name="inherit_id" ref="stock.view_picking_type_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='create_backorder']" position="after">
                <field name="apply_routes_on_confirm"
                         invisible="code != 'internal'"/>
            </xpath>
        </field>
    </record>
</odoo>
