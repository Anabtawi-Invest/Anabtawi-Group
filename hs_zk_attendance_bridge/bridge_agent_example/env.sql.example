# Example environment for SQL Server mode.
# Copy values into the shell or a local .env loader. Do not commit real secrets.

SOURCE_TYPE=sql
ODOO_URL=https://your-db.odoo.com
BRIDGE_TOKEN=paste-bridge-token-here
DEVICE_IDENTIFIER=sql_attendance
DEVICE_TIMEZONE=Asia/Amman
SYNC_INTERVAL=60
RUN_ONCE=0

SQL_HOST=192.168.1.10
SQL_PORT=1433
SQL_DATABASE=your_database_name
SQL_USER=readonly_user
SQL_PASSWORD=secret
SQL_TABLE=attenendad
SQL_DRIVER=ODBC Driver 18 for SQL Server
SQL_ENCRYPT=yes
SQL_TRUST_SERVER_CERTIFICATE=yes

STATE_FILE=state.json
BATCH_SIZE=500
SQL_START_LOG_ID=0
MACHINE_MAP={"2":"SQL-ZK-02","3":"SQL-ZK-03"}
