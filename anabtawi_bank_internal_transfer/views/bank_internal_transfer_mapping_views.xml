<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_bank_internal_transfer_mapping_list" model="ir.ui.view">
        <field name="name">bank.internal.transfer.mapping.list</field>
        <field name="model">bank.internal.transfer.mapping</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="bank_id"/>
                <field name="internal_transfer"/>
            </list>
        </field>
    </record>

    <record id="view_bank_internal_transfer_mapping_form" model="ir.ui.view">
        <field name="name">bank.internal.transfer.mapping.form</field>
        <field name="model">bank.internal.transfer.mapping</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="bank_id"/>
                        <field name="internal_transfer"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_bank_internal_transfer_mapping" model="ir.actions.act_window">
        <field name="name">Bank Internal Transfer Mapping</field>
        <field name="res_model">bank.internal.transfer.mapping</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a bank internal transfer mapping
            </p>
            <p>
                Map each bank to an internal transfer value. Banks without a mapping
                use the default value <strong>confirmed</strong> on bank accounts.
            </p>
        </field>
    </record>
</odoo>
