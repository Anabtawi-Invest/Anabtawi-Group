<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_print_job_tree" model="ir.ui.view">
        <field name="name">print.job.tree</field>
        <field name="model">print.job</field>
        <field name="arch" type="xml">
            <list string="Print Jobs" decoration-info="state=='draft'" decoration-warning="state=='printing'" decoration-success="state=='done'" decoration-danger="state=='error'">
                <field name="create_date"/>
                <field name="name"/>
                <field name="printer_name"/>
                <field name="print_engine_client_id"/>
                <field name="print_type"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_print_job_form" model="ir.ui.view">
        <field name="name">print.job.form</field>
        <field name="model">print.job</field>
        <field name="arch" type="xml">
            <form string="Print Job">
                <header>
                    <button name="action_reprint" string="Reprint Job" type="object" class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,printing,done,error"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="printer_id"/>
                            <field name="printer_name"/>
                            <field name="print_engine_client_id"/>
                            <field name="print_type"/>
                        </group>
                        <group>
                            <field name="create_date"/>
                            <field name="report_id"/>
                            <field name="error_message" invisible="not error_message"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_print_job" model="ir.actions.act_window">
        <field name="name">Print Job Queue</field>
        <field name="res_model">print.job</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_print_job_sub"
              name="Print Job Queue"
              parent="menu_direct_printing_root"
              action="action_print_job"
              sequence="5"/>
</odoo>
