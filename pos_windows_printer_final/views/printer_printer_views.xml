<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_printer_printer_tree" model="ir.ui.view">
        <field name="name">printer.printer.tree</field>
        <field name="model">printer.printer</field>
        <field name="arch" type="xml">
            <list string="Printers">
                <field name="name"/>
                <field name="printer_type"/>
                <field name="print_engine_client_id"/>
                <field name="ip"/>
                <field name="port"/>
            </list>
        </field>
    </record>

    <record id="view_printer_printer_form" model="ir.ui.view">
        <field name="name">printer.printer.form</field>
        <field name="model">printer.printer</field>
        <field name="arch" type="xml">
            <form string="Printer">
                <header>
                    <button name="action_test_printer" string="Send Test Page" type="object" class="btn-primary"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1>
                            <field name="name" placeholder="Receipt / Thermal / Label Printer"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="printer_type"/>
                            <field name="print_engine_client_id" invisible="printer_type not in ['image', 'raw']"/>
                        </group>
                        <group>
                            <field name="ip" invisible="printer_type != 'network'" required="printer_type == 'network'"/>
                            <field name="port" invisible="printer_type != 'network'"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_printer_printer" model="ir.actions.act_window">
        <field name="name">Printers</field>
        <field name="res_model">printer.printer</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_direct_printing_root"
              name="Printing"
              web_icon="point_of_sale,static/description/icon.png"
              sequence="45"/>

    <menuitem id="menu_printer_printer_sub"
              name="Printers"
              parent="menu_direct_printing_root"
              action="action_printer_printer"
              sequence="10"/>

    <menuitem id="menu_print_engine_client_sub"
              name="Windows Agent Hosts"
              parent="menu_direct_printing_root"
              action="action_print_engine_client"
              sequence="20"/>

    <menuitem id="menu_printer_pos_config"
              name="POS Printers"
              parent="point_of_sale.menu_point_config_product"
              action="action_printer_printer"
              sequence="99"/>
</odoo>
