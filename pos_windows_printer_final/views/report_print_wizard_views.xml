<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_report_print_wizard_form" model="ir.ui.view">
        <field name="name">report.print.wizard.form</field>
        <field name="model">report.print.wizard</field>
        <field name="arch" type="xml">
            <form string="Print Options">
                <group>
                    <field name="report_id"/>
                    <field name="docids_json" invisible="1"/>
                    <field name="data_json" invisible="1"/>
                    <field name="original_context_json" invisible="1"/>
                    <div class="text-muted">
                        Send directly to the configured Windows printer, or use the normal Odoo download.
                    </div>
                </group>
                <footer>
                    <button name="action_direct_print" string="Direct Print" type="object" class="btn-primary"/>
                    <button name="action_download" string="Download" type="object" class="btn-secondary"/>
                    <button string="Cancel" special="cancel" class="btn-link"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
