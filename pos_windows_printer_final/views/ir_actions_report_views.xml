<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="act_report_xml_view_form_inherit_direct_print" model="ir.ui.view">
        <field name="name">ir.actions.report.form.inherit.direct.print</field>
        <field name="model">ir.actions.report</field>
        <field name="inherit_id" ref="base.act_report_xml_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='report_type']" position="after">
                <field name="property_printer_id"/>
                <field name="auto_print"/>
            </xpath>
        </field>
    </record>
</odoo>
