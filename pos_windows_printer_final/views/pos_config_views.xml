<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- View 1: Individual POS Register Form -->
    <record id="pos_direct_config_view_form" model="ir.ui.view">
        <field name="name">pos.direct.config.form.view</field>
        <field name="model">pos.config</field>
        <field name="inherit_id" ref="point_of_sale.pos_config_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Direct Branch Receipt Printer">
                    <field name="direct_printer_id" string="Assigned Thermal Printer" placeholder="Select Branch Printer (e.g. عين الباشا)..."/>
                </group>
            </xpath>
        </field>
    </record>

    <!-- View 2: Global POS Settings Page -->
    <record id="res_config_settings_view_form_pos_direct" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.pos.direct</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="95"/>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='point_of_sale']" position="inside">
                <block title="Direct Branch Receipt Printer" id="pos_direct_printer_res_block">
                    <setting id="pos_direct_custom_printer_setting" string="Branch Thermal Printer" help="Select local network, USB, or Bluetooth printer created for this branch">
                        <field name="pos_direct_printer_id" placeholder="Select Branch Printer (e.g. عين الباشا)..."/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
