<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_print_engine_client_tree" model="ir.ui.view">
        <field name="name">print.engine.client.tree</field>
        <field name="model">print.engine.client</field>
        <field name="arch" type="xml">
            <list string="Windows Print Agent Hosts">
                <field name="name"/>
                <field name="print_engine_key"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_print_engine_client_form" model="ir.ui.view">
        <field name="name">print.engine.client.form</field>
        <field name="model">print.engine.client</field>
        <field name="arch" type="xml">
            <form string="Windows Print Agent Host">
                <header>
                    <button name="generate_print_engine_key" string="Regenerate API Key" type="object" class="btn-primary" confirm="Regenerating the API key will disconnect existing agent sessions. Continue?"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box"/>
                    <widget name="web_ribbon" title="Archived" bg_color="bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1>
                            <field name="name" placeholder="Host Computer (e.g. Branch-1-PC)"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="print_engine_key"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Installed Windows Printers" name="printers">
                            <field name="printer_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="printer_type"/>
                                </list>
                            </field>
                        </page>
                        <page string="Print Job History" name="jobs">
                            <field name="print_job_ids" readonly="1">
                                <list decoration-info="state=='draft'" decoration-success="state=='done'" decoration-danger="state=='error'">
                                    <field name="name"/>
                                    <field name="printer_name"/>
                                    <field name="create_date"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_print_engine_client" model="ir.actions.act_window">
        <field name="name">Windows Agent Hosts</field>
        <field name="res_model">print.engine.client</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
