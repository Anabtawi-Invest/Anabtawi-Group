<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pos_config_view_form_inherit_branch_printer" model="ir.ui.view">
        <field name="name">pos.config.form.view.inherit.branch.printer</field>
        <field name="model">pos.config</field>
        <field name="inherit_id" ref="point_of_sale.pos_config_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Branch Thermal Printer" class="mt-4">
                    <field name="branch_printer_id" options="{'no_create': True}" placeholder="Select Branch Thermal Printer..."/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
