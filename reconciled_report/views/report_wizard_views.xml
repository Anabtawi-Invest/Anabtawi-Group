<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_reconciled_report_wizard" model="ir.ui.view">
        <field name="name">reconciled.report.wizard.form</field>
        <field name="model">reconciled.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Reconciled Report">
                <div class="alert alert-info" role="alert">
                    Export overtime, lateness and the three settlement steps.
                    Green: extra hours and positive balances. Red: lateness and deductions.
                    Only payslips fully inside the selected period are included.
                </div>
                <group>
                    <group>
                        <field name="company_id" options="{'no_create': True}"/>
                        <field name="date_from"/>
                        <field name="date_to"/>
                        <field name="payrun_id" options="{'no_create': True}"/>
                    </group>
                    <group>
                        <field name="department_id" domain="[('company_id', 'in', [False, company_id])]" options="{'no_create': True}"/>
                        <field name="employee_ids" widget="many2many_tags" domain="[('company_id', '=', company_id)]" options="{'no_create': True}"/>
                        <field name="reconciliation_filter"/>
                    </group>
                </group>
                <p>Compute Reconciliation runs Compute Sheet on matching Draft / Waiting payslips, updating their salary lines using the existing payroll engine. Confirmed payslips use saved results. Leave settlements follow normal payslip confirmation.</p>
                <group invisible="not file_data">
                    <field name="filename" invisible="1"/>
                    <field name="file_data" filename="filename" string="Download Excel"/>
                </group>
                <footer>
                    <button name="action_compute_export" type="object" string="Compute Reconciliation &amp; Export" class="btn-primary"/>
                    <button name="action_export" type="object" string="Export Saved Results" class="btn-secondary"/>
                    <button string="Close" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_reconciled_report" model="ir.actions.act_window">
        <field name="name">Reconciled Report</field>
        <field name="res_model">reconciled.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
    <menuitem id="menu_reconciled_report" name="Reconciled Report" action="action_reconciled_report" sequence="65" groups="hr_payroll.group_hr_payroll_user"/>
    <function model="reconciled.report.wizard" name="_attach_reporting_menu"/>
</odoo>
