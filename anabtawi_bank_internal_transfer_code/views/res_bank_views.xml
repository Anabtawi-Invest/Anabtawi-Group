<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_res_bank_form_inherit_internal_transfer" model="ir.ui.view">
        <field name="name">res.bank.form.inherit.internal.transfer</field>
        <field name="model">res.bank</field>
        <field name="inherit_id" ref="base.view_res_bank_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='bic']" position="after">
                <field name="internal_transfer"/>
            </xpath>
        </field>
    </record>

    <record id="view_res_bank_tree_inherit_internal_transfer" model="ir.ui.view">
        <field name="name">res.bank.list.inherit.internal.transfer</field>
        <field name="model">res.bank</field>
        <field name="inherit_id" ref="base.view_res_bank_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='bic']" position="after">
                <field name="internal_transfer" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>
