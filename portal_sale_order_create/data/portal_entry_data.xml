<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="portal_entry_create_sale_order" model="portal.entry">
        <field name="name">Create Sale Order</field>
        <field name="description">Create a sale order and invoice for a customer</field>
        <field name="url">/my/sales/create</field>
        <field name="image" type="bytes" file="sale/static/src/img/bag.svg"/>
        <field name="category">client_category</field>
        <field name="sequence">10</field>
        <field name="is_config_card" eval="True"/>
        <field name="required_group_xmlid">portal_sale_order_create.group_sales_portal</field>
    </record>

    <record id="portal_entry_my_sale_orders" model="portal.entry">
        <field name="name">My Sale Orders</field>
        <field name="description">View and cancel sale orders you created</field>
        <field name="url">/my/sales/orders</field>
        <field name="image" type="bytes" file="sale/static/src/img/bag.svg"/>
        <field name="category">client_category</field>
        <field name="sequence">11</field>
        <field name="is_config_card" eval="True"/>
        <field name="required_group_xmlid">portal_sale_order_create.group_sales_portal</field>
    </record>
</odoo>
