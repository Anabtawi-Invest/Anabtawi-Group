<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_sales_portal" model="ir.module.category">
        <field name="name">Sales Portal</field>
        <field name="description">Portal sale order creation</field>
        <field name="sequence">36</field>
    </record>

    <record id="privilege_sales_portal" model="res.groups.privilege">
        <field name="name">Sales Portal</field>
        <field name="category_id" ref="module_category_sales_portal"/>
