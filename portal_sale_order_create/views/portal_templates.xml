<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="portal_breadcrumbs_sale" inherit_id="portal.portal_breadcrumbs">
        <xpath expr="//ol" position="inside">
            <li t-if="page_name == 'portal_sale_create'" class="breadcrumb-item">
                <a href="/my/sales/create">Create Sale Order</a>
            </li>
            <li t-if="page_name == 'portal_sale_orders'" class="breadcrumb-item">
                <a href="/my/sales/orders">My Sale Orders</a>
            </li>
            <li t-if="page_name == 'portal_sale_order_detail'" class="breadcrumb-item">
                <a href="/my/sales/orders">My Sale Orders</a>
            </li>
            <li t-if="page_name == 'portal_sale_order_detail' and order" class="breadcrumb-item active">
                <t t-esc="order.name"/>
            </li>
        </xpath>
    </template>

    <!-- Create Sale Order -->
    <template id="portal_sale_create" name="Create Sale Order">
        <t t-call="portal.portal_layout">
            <div class="container o_portal_sale_create py-4">
                <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
                    <h3 class="mb-0">Create Sale Order</h3>
                    <a href="/my/sales/orders" class="btn btn-secondary">My Sale Orders</a>
                </div>

                <!-- Customer -->
                <div class="card mb-3 o_portal_sale_section">
                    <div class="card-header fw-bold">1. Customer</div>
                    <div class="card-body">
                        <div class="row g-2 align-items-end">
                            <div class="col-md-6">
                                <label class="form-label">Search customer</label>
                                <input type="text" class="form-control" id="partner_search"
                                       placeholder="Name, phone or email"/>
                                <div id="partner_results" class="list-group mt-2"></div>
                            </div>
                            <div class="col-md-6">
                                <button type="button" class="btn btn-outline-primary" id="btn_new_partner">
                                    Create new customer
                                </button>
                            </div>
                        </div>
                        <div id="selected_partner" class="alert alert-success mt-3 d-none mb-0">
                            <strong>Selected:</strong>
                            <span id="selected_partner_label"/>
                            <button type="button" class="btn btn-sm btn-link" id="btn_clear_partner">Change</button>
                        </div>
                        <div id="new_partner_form" class="border rounded p-3 mt-3 d-none">
                            <div class="row g-2">
                                <div class="col-md-4">
                                    <label class="form-label">Name *</label>
                                    <input type="text" class="form-control" id="new_partner_name"/>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">Phone</label>
                                    <input type="text" class="form-control" id="new_partner_phone"/>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">Email</label>
                                    <input type="email" class="form-control" id="new_partner_email"/>
                                </div>
                            </div>
                            <button type="button" class="btn btn-primary mt-2" id="btn_save_partner">Save customer</button>
                        </div>
                    </div>
                </div>

                <!-- Products -->
                <div class="card mb-3 o_portal_sale_section">
                    <div class="card-header fw-bold d-flex justify-content-between align-items-center">
                        <span>2. Products</span>
                        <button type="button" class="btn btn-primary btn-sm" id="btn_open_products">
                            Choose products
                        </button>
                    </div>
                    <div class="card-body">
                        <div id="cart_empty" class="text-muted">No products added yet.</div>
                        <div class="table-responsive d-none" id="cart_table_wrap">
                            <table class="table table-sm align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th>Product</th>
                                        <th class="text-end">Price</th>
                                        <th class="text-center" style="width:120px">Qty</th>
                                        <th class="text-end">Subtotal</th>
                                        <th/>
                                    </tr>
                                </thead>
                                <tbody id="cart_body"/>
                                <tfoot>
                                    <tr>
                                        <th colspan="3" class="text-end">Total</th>
                                        <th class="text-end" id="cart_total">0.00</th>
                                        <th/>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </div>
                </div>

                <!-- Confirm -->
                <div class="card mb-3 o_portal_sale_section">
                    <div class="card-header fw-bold">3. Confirm</div>
                    <div class="card-body">
                        <p class="text-muted mb-3">
                            Confirming will create the sale order, confirm it, and post the invoice automatically.
                        </p>
                        <button type="button" class="btn btn-success btn-lg" id="btn_confirm_order">
                            Confirm &amp; Invoice
                        </button>
                        <div id="confirm_error" class="alert alert-danger mt-3 d-none mb-0"/>
                    </div>
                </div>
            </div>

            <!-- Product dialog -->
            <div class="modal fade" id="productModal" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog modal-xl modal-dialog-scrollable">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title">Choose products</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal"/>
                        </div>
                        <div class="modal-body">
                            <input type="text" class="form-control mb-3" id="product_search"
                                   placeholder="Search products..."/>
                            <div id="product_grid" class="o_portal_product_grid"/>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Done</button>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- My orders list -->
    <template id="portal_sale_orders" name="My Sale Orders">
        <t t-call="portal.portal_layout">
            <div class="container py-4">
                <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
                    <h3 class="mb-0">My Sale Orders</h3>
                    <a href="/my/sales/create" class="btn btn-primary">Create Sale Order</a>
                </div>
                <t t-if="not orders">
                    <div class="alert alert-info">You have not created any sale orders yet.</div>
                </t>
                <t t-else="">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle">
                            <thead>
                                <tr>
                                    <th>Order</th>
                                    <th>Customer</th>
                                    <th>Date</th>
                                    <th>Status</th>
                                    <th class="text-end">Total</th>
                                    <th/>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="orders" t-as="order">
                                    <td>
                                        <a t-att-href="'/my/sales/orders/%s' % order.id">
                                            <t t-esc="order.name"/>
                                        </a>
                                    </td>
                                    <td><t t-esc="order.partner_id.name"/></td>
                                    <td><span t-field="order.date_order" t-options='{"widget": "date"}'/></td>
                                    <td>
                                        <span t-attf-class="badge #{'text-bg-success' if order.state == 'sale' else 'text-bg-secondary' if order.state == 'cancel' else 'text-bg-warning'}">
                                            <t t-esc="dict(order._fields['state'].selection).get(order.state)"/>
                                        </span>
                                    </td>
                                    <td class="text-end">
                                        <span t-field="order.amount_total" t-options='{"widget": "monetary", "display_currency": order.currency_id}'/>
                                    </td>
                                    <td class="text-end">
                                        <a t-att-href="'/my/sales/orders/%s' % order.id" class="btn btn-sm btn-outline-primary">View</a>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                    <div t-if="pager" class="o_portal_pager d-flex justify-content-center my-3">
                        <t t-call="portal.pager"/>
                    </div>
                </t>
            </div>
        </t>
    </template>

    <!-- Order detail / success -->
    <template id="portal_sale_order_detail" name="Sale Order Detail">
        <t t-call="portal.portal_layout">
            <div class="container py-4">
                <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
                    <h3 class="mb-0">
                        Order <t t-esc="order.name"/>
                    </h3>
                    <a href="/my/sales/orders" class="btn btn-secondary">Back to list</a>
                </div>

                <div t-if="order.state == 'cancel'" class="alert alert-warning">This order is cancelled.</div>
                <div t-elif="invoice" class="alert alert-success">
                    Invoice <strong t-esc="invoice.name"/> created and posted.
                </div>

                <div class="card mb-3">
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-6">
                                <p class="mb-1"><strong>Customer:</strong> <t t-esc="order.partner_id.name"/></p>
                                <p class="mb-1"><strong>Phone:</strong> <t t-esc="order.partner_id.phone or order.partner_id.mobile or '-'"/></p>
                                <p class="mb-0"><strong>Email:</strong> <t t-esc="order.partner_id.email or '-'"/></p>
                            </div>
                            <div class="col-md-6">
                                <p class="mb-1"><strong>Date:</strong>
                                    <span t-field="order.date_order" t-options='{"widget": "datetime"}'/>
                                </p>
                                <p class="mb-1"><strong>Status:</strong>
                                    <t t-esc="dict(order._fields['state'].selection).get(order.state)"/>
                                </p>
                                <p class="mb-0"><strong>Total:</strong>
                                    <span t-field="order.amount_total" t-options='{"widget": "monetary", "display_currency": order.currency_id}'/>
                                </p>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="table-responsive mb-3">
                    <table class="table table-sm">
                        <thead>
                            <tr>
                                <th>Product</th>
                                <th class="text-end">Qty</th>
                                <th class="text-end">Unit Price</th>
                                <th class="text-end">Subtotal</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="order.order_line.filtered(lambda l: not l.display_type)" t-as="line">
                                <td><t t-esc="line.product_id.display_name"/></td>
                                <td class="text-end"><t t-esc="line.product_uom_qty"/></td>
                                <td class="text-end">
                                    <span t-field="line.price_unit" t-options='{"widget": "monetary", "display_currency": order.currency_id}'/>
                                </td>
                                <td class="text-end">
                                    <span t-field="line.price_subtotal" t-options='{"widget": "monetary", "display_currency": order.currency_id}'/>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <div class="d-flex flex-wrap gap-2" t-if="invoice and order.state != 'cancel'">
                    <a t-if="print_url" t-att-href="print_url" class="btn btn-primary" target="_blank">
                        Print Invoice
                    </a>
                    <button type="button" class="btn btn-outline-primary" id="btn_send_email"
                            t-att-data-order-id="order.id">
                        Send by Email
                    </button>
                    <a t-if="whatsapp_url" t-att-href="whatsapp_url" class="btn btn-success" target="_blank" rel="noopener">
                        Send via WhatsApp
                    </a>
                    <a t-else="" class="btn btn-success disabled" title="Customer has no phone number">
                        Send via WhatsApp
                    </a>
                </div>

                <div class="mt-3" t-if="order.state != 'cancel'">
                    <button type="button" class="btn btn-outline-danger" id="btn_cancel_order"
                            t-att-data-order-id="order.id">
                        Cancel Order
                    </button>
                </div>

                <div id="detail_message" class="alert mt-3 d-none mb-0"/>
            </div>
        </t>
    </template>
</odoo>
