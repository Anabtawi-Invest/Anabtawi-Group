<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="paperformat_action_print_report" model="report.paperformat">
        <field name="name">AR3</field>
        <field name="default" eval="False"/>
        <field name="disable_shrinking" eval="True"/>
        <field name="dpi">96</field>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">0</field>
        <field name="margin_bottom">0</field>
        <field name="margin_left">0</field>
        <field name="margin_right">0</field>
    </record>

    <record id="action_print_report" model="ir.actions.report">
        <field name="name">AR/3 Report</field>
        <field name="model">payroll.report.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">l10n_jo_ar3_report.template_pwts_report</field>
        <field name="report_file">l10n_jo_ar3_report.template_pwts_report</field>
        <field name="binding_model_id" ref="model_payroll_report_wizard"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="l10n_jo_ar3_report.paperformat_action_print_report"/>
    </record>
</odoo>
