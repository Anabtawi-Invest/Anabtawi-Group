<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_payroll_report_wizard_form" model="ir.ui.view">
        <field name="name">payroll.report.wizard.form</field>
        <field name="model">payroll.report.wizard</field>
        <field name="arch" type="xml">
            <form string="AR/3 Report">
                <group>
                    <field name="employee_id"/>
                    <field name="year"/>
                </group>
                <footer>
                    <button name="action_print_report" type="object" string="Print PDF Report" class="btn-primary"/>
                    <button name="print_excel_report" type="object" string="Print Excel Report" class="btn-primary" icon="fa-download"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
