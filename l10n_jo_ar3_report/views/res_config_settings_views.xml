<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_ar3" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.ar3</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="hr_payroll.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='hr_payroll_settings']" position="after">
                <field name="company_country_code" invisible="True"/>
                <block title="AR/3 Related" id="ar3_related_settings_block" invisible="company_country_code != 'JO'">
                    <setting string="Gross Salary Rules" help="Salary rules used to calculate gross salary on the AR/3 report" id="gross_salary_setting">
                        <field name="gross_salary_rule_ids" widget="many2many_tags" options="{'no_create': True}"/>
                    </setting>
                    <setting string="Income Tax Salary Rules" help="Salary rules used to calculate income tax on the AR/3 report" id="income_tax_setting">
                        <field name="income_tax_rule_ids" widget="many2many_tags" options="{'no_create': True}"/>
                    </setting>
                    <setting string="Employer Name" help="Employer name printed on AR/3 reports (falls back to company name)" id="employer_name_setting">
                        <field name="employer_display_name" placeholder="Employer Name"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
