<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="s_anabtawi_hero" model="ir.ui.view">
        <field name="name">Anabtawi Hero</field>
        <field name="type">qweb</field>
        <field name="website_id" ref="website.default_website"/>
        <field name="key">anabtawi_sweets_website.s_anabtawi_hero</field>
        <field name="arch" type="xml">
            <t t-name="anabtawi_sweets_website.s_anabtawi_hero">
                <section class="s_anabtawi_hero anabtawi-hero py-5" data-name="Anabtawi Hero" data-snippet="s_anabtawi_hero">
                    <div class="container py-4 py-lg-5">
                        <div class="row align-items-center g-5">
                            <div class="col-lg-7">
                                <span class="anabtawi-eyebrow">Anabtawi Sweets · Since 1983</span>
                                <h1 class="display-3 mt-3 mb-4">Authentic taste, made for memorable moments</h1>
                                <p class="lead mb-4">
                                    Fine Arabic and international sweets prepared with craftsmanship, trusted ingredients, and four decades of experience.
                                </p>
                                <div class="d-flex flex-wrap gap-3">
                                    <a href="/our-catalog" class="btn btn-primary btn-lg">Explore our catalog</a>
                                    <a href="/branches" class="btn btn-outline-secondary btn-lg">Find a branch</a>
                                </div>
                            </div>
                            <div class="col-lg-5 text-center">
                                <div class="anabtawi-hero-visual">
                                    <img src="/anabtawi_sweets_website/static/src/img/content/category-kunafeh.png" alt="Anabtawi kunafeh and warbat" class="img-fluid" loading="eager"/>
                                    <img src="/anabtawi_sweets_website/static/src/img/content/logo.png" alt="Anabtawi Sweets" class="anabtawi-hero-logo"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </t>
        </field>
    </record>

    <record id="s_anabtawi_categories" model="ir.ui.view">
        <field name="name">Anabtawi Product Categories</field>
        <field name="type">qweb</field>
        <field name="website_id" ref="website.default_website"/>
        <field name="key">anabtawi_sweets_website.s_anabtawi_categories</field>
        <field name="arch" type="xml">
            <t t-name="anabtawi_sweets_website.s_anabtawi_categories">
                <section class="s_anabtawi_categories anabtawi-section py-5" id="anabtawi_categories" data-name="Anabtawi Product Categories" data-snippet="s_anabtawi_categories">
                    <div class="container py-4">
                        <div class="text-center mb-5">
                            <span class="anabtawi-eyebrow">Our specialties</span>
                            <h2 class="display-5 mt-2">A world of Anabtawi flavors</h2>
                        </div>
                        <div class="row g-4">
                            <t t-foreach="[
                                ('category-kunafeh.png', 'Kunafeh and Warbat', 'كنافة ووربات', '/shop/category/1'),
                                ('category-assorted.png', 'Assorted Sweets', 'بقلاوة وحلويات شرقية', '/shop/category/2'),
                                ('category-cakes.png', 'Cakes and Western Sweets', 'كيك وحلويات غربية', '/shop/category/4'),
                                ('category-mediterranean.png', 'Mediterranean Sweets', 'حلويات فاخرة', '/shop/category/2'),
                                ('category-chocolate.png', 'Chocolates and Gifts', 'شوكولاتة وهدايا فاخرة', '/shop/category/5'),
                                ('category-coffee.png', 'Coffee', 'قهوة عنبتاوي ومشروبات', '/shop/category/6'),
                                ('category-honey.png', 'Tryaq Honey', 'عسل ومنتجات طبيعية', '/shop/category/7'),
                                ('category-maamoul.png', 'Maamoul and Cookies', 'كعك ومعمول وبرازق', '/shop/category/3')
                            ]" t-as="category">
                                <div class="col-6 col-md-4 col-lg-3">
                                    <a t-att-href="category[3]" class="anabtawi-category-card d-block h-100 text-decoration-none" t-att-title="category[1] + ' | ' + category[2]">
                                        <div class="anabtawi-category-card-img-wrap">
                                            <img t-att-src="'/anabtawi_sweets_website/static/src/img/content/%s' % category[0]" t-att-alt="category[1]" class="img-fluid" loading="lazy"/>
                                        </div>
                                    </a>
                                </div>
                            </t>
                        </div>
                    </div>
                </section>
            </t>
        </field>
    </record>

    <record id="snippets" model="ir.ui.view">
        <field name="name">Anabtawi Sweets - Snippets</field>
        <field name="type">qweb</field>
        <field name="inherit_id" ref="website.snippets"/>
        <field name="website_id" ref="website.default_website"/>
        <field name="key">anabtawi_sweets_website.snippets</field>
        <field name="arch" type="xml">
            <xpath expr="//snippets[@id='snippet_groups']/*[1]" position="before">
                <t snippet-group="anabtawi" t-snippet="website.s_snippet_group" string="Anabtawi Sweets" t-thumbnail="/anabtawi_sweets_website/static/src/img/content/logo.png"/>
            </xpath>
            <xpath expr="//snippets[@id='snippet_structure']/*[1]" position="before">
                <t t-snippet="anabtawi_sweets_website.s_anabtawi_hero" string="Anabtawi Hero" group="anabtawi" t-thumbnail="/anabtawi_sweets_website/static/src/img/content/category-kunafeh.png">
                    <keywords>Hero Anabtawi sweets intro banner</keywords>
                </t>
                <t t-snippet="anabtawi_sweets_website.s_anabtawi_categories" string="Anabtawi Categories" group="anabtawi" t-thumbnail="/anabtawi_sweets_website/static/src/img/content/category-assorted.png">
                    <keywords>Products sweets categories catalog</keywords>
                </t>
            </xpath>
        </field>
    </record>
</odoo>
