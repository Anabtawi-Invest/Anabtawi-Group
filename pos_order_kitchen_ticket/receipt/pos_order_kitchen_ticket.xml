<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template id="pos_order_kitchen_ticket.pos_order_kitchen_ticket">
        <html id="pos-receipt">
            <head>
                <meta charset="UTF-8"></meta>
                <t t-call="point_of_sale.pos_order_receipt_style" />
            </head>
            <body>
                <div class="pos-receipt m-0 p-0">
                    <div class="text-center">
                        <div class="text-normal" t-out="config_name"/>
                        <div class="text-insane text-bold" t-out="order_number"/>
                        <div class="text-small" t-out="pos_reference"/>
                        <div class="text-small" t-out="date"/>
                    </div>
                    <hr style="border: none; border-top: 4px dashed black;"/>
                    <div t-foreach="lines" t-as="line" class="text-large">
                        <span class="text-bold" t-out="line['qty']"/> x <span t-out="line['name']"/>
                    </div>
                    <hr style="border: none; border-top: 4px dashed black;"/>
                </div>
            </body>
        </html>
    </template>
</odoo>
