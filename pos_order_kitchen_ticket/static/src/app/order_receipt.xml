<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="pos_order_kitchen_ticket.OrderReceipt" t-inherit="point_of_sale.OrderReceipt" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('pos-receipt')]" position="inside">
            <div t-if="withOrderKitchenTicket" class="o_kitchen_ticket_page">
                <div class="o_kitchen_ticket_cut my-3"/>
                <OrderKitchenTicket order="order"/>
            </div>
        </xpath>
    </t>
</templates>
