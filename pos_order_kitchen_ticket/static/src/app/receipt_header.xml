<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="pos_order_kitchen_ticket.ReceiptHeader" t-inherit="point_of_sale.ReceiptHeader" t-inherit-mode="extension">
        <xpath expr="//img[hasclass('pos-receipt-logo')]" position="before">
            <div t-if="order.config.print_order_kitchen_ticket and order.tracking_number" class="text-center fw-bolder pb-2" style="font-size: 2.5em; line-height: 1.2;">
                <t t-esc="order.tracking_number"/>
            </div>
        </xpath>
    </t>
</templates>
