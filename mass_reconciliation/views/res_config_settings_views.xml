<odoo>
  <record id="res_config_settings_view_form_lateness_coverage" model="ir.ui.view">
    <field name="name">res.config.settings.view.form.lateness.coverage</field>
    <field name="model">res.config.settings</field>
    <field name="inherit_id" ref="hr_payroll.res_config_settings_view_form"/>
    <field name="priority" eval="60"/>
    <field name="arch" type="xml">
      <xpath expr="//app[@name='hr_payroll']/block[@id='hr_payroll_settings']" position="inside">
        <setting string="Annual Leave Type for Lateness (Hours)"
                 help="Hour-based leave type used to cover remaining lateness after consuming OT buckets.">
          <field name="annual_leave_type_id" options="{'no_create': True}"/>
        </setting>
      </xpath>
    </field>
  </record>
</odoo>
