<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_tree_inherit_inventory_backdate" model="ir.ui.view">
        <field name="name">stock.move.list.inherit.inventory.backdate</field>
        <field name="model">stock.move</field>
        <field name="inherit_id" ref="stock.view_move_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='date']" position="attributes">
                <attribute name="decoration-info">is_backdated</attribute>
            </xpath>
            <xpath expr="//field[@name='date']" position="after">
                <field name="is_backdated" optional="show" readonly="1"/>
            </xpath>
        </field>
    </record>

    <record id="view_move_form_inherit_inventory_backdate" model="ir.ui.view">
        <field name="name">stock.move.form.inherit.inventory.backdate</field>
        <field name="model">stock.move</field>
        <field name="inherit_id" ref="stock.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='date_deadline']" position="before">
                <field name="is_backdated" invisible="not is_backdated"/>
            </xpath>
        </field>
    </record>

    <record id="view_move_search_inherit_inventory_backdate" model="ir.ui.view">
        <field name="name">stock.move.search.inherit.inventory.backdate</field>
        <field name="model">stock.move</field>
        <field name="inherit_id" ref="stock.view_move_search"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <separator/>
                <filter name="is_backdated" string="Backdated" domain="[('is_backdated', '=', True)]"/>
            </xpath>
        </field>
    </record>
</odoo>
