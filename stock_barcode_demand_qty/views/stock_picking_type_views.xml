<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="stock_barcode_view_picking_type_form" model="ir.ui.view">
        <field name="name">stock.picking.type.form.demand.qty</field>
        <field name="model">stock.picking.type</field>
        <field name="inherit_id" ref="stock_barcode.stock_barcode_view_picking_type_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='barcode_options']" position="inside">
                <field name="barcode_show_demand_qty"/>
            </xpath>
        </field>
    </record>

</odoo>
