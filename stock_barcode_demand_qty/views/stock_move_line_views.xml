<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="stock_move_line_product_selector" model="ir.ui.view">
        <field name="name">stock.product.selector.demand.qty</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock_barcode.stock_move_line_product_selector"/>
        <field name="arch" type="xml">
            <field name="picking_id" position="after">
                <field name="show_barcode_demand_qty" invisible="1"/>
            </field>
            <xpath expr="//div[@name='quantity']" position="before">
                <div name="demand_quantity" class="row my-2" invisible="not show_barcode_demand_qty">
                    <div class="col">
                        <div class="text-black-50 mb-1 fs-5">
                            <label for="demand_qty" string="الكية المطلوبة من المصنع" class="p-0"/>
                        </div>
                        <field name="demand_qty" class="text-end"
                            options="{'type': 'number'}" placeholder="الكية المطلوبة من المصنع"/>
                    </div>
                </div>
            </xpath>
            <xpath expr="//div[@name='quantity']/div[@class='col']/field[@name='qty_done']" position="before">
                <div class="text-black-50 mb-1 fs-5">
                    <label for="qty_done" string="Quantity Done" class="p-0"/>
                </div>
            </xpath>
            <xpath expr="//widget[@name='digipad']" position="replace">
                <widget name="digipad" field_to_edit="qty_done" fulfilled_at="demand_qty"
                    invisible="not show_barcode_demand_qty or (tracking == 'serial' and (not hide_lot_name or not hide_lot))"/>
                <widget name="digipad" field_to_edit="qty_done" fulfilled_at="quantity"
                    invisible="show_barcode_demand_qty or (tracking == 'serial' and (not hide_lot_name or not hide_lot))"/>
            </xpath>
            <xpath expr="//div[@name='quantity']/div[hasclass('col-3')]" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>

</odoo>
