<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="privilege_barcode_demand" model="res.groups.privilege">
        <field name="name">Barcode Demand Quantity</field>
        <field name="category_id" ref="base.module_category_supply_chain"/>
        <field name="sequence">40</field>
    </record>

    <record id="group_barcode_demand_confirm" model="res.groups">
        <field name="name">Confirm</field>
        <field name="sequence">10</field>
        <field name="comment">Can confirm or reopen the factory demand quantity on a barcode transfer.</field>
        <field name="privilege_id" ref="privilege_barcode_demand"/>
        <field name="implied_ids" eval="[(4, ref('stock.group_stock_user'))]"/>
    </record>
</odoo>
