<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="stock_print_next_transfer_wizard_view_form" model="ir.ui.view">
        <field name="name">stock.print.next.transfer.wizard.form</field>
        <field name="model">stock.print.next.transfer.wizard</field>
        <field name="arch" type="xml">
            <form string="Print Next Transfer">
                <p>
                    This transfer created more than one next transfer.
                    Choose which Picking Operations report to print.
                </p>
                <field name="picking_id" invisible="1"/>
                <field name="line_ids" nolabel="1">
                    <list create="0" delete="0">
                        <field name="picking_id"/>
                        <field name="picking_type_id"/>
                        <field name="state" widget="badge"/>
                        <field name="scheduled_date"/>
                        <button name="action_print" type="object" string="Print" icon="fa-print"/>
                    </list>
                </field>
                <footer>
                    <button string="Close" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
