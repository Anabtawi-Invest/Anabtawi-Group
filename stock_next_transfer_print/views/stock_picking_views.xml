<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_form_print_next_transfer" model="ir.ui.view">
        <field name="name">stock.picking.form.print.next.transfer</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='%(stock.action_report_delivery)d']" position="after">
                <button
                    name="action_print_next_transfer_operations"
                    string="Print Next Transfer"
                    type="object"
                    groups="stock.group_stock_user"
                    invisible="not show_next_pickings"/>
            </xpath>
        </field>
    </record>
</odoo>
