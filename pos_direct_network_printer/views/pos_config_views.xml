<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pos_direct_config_view_form" model="ir.ui.view">
        <field name="name">pos.direct.config.form.view</field>
        <field name="model">pos.config</field>
        <field name="inherit_id" ref="point_of_sale.pos_config_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='iface_print_auto']" position="after">
                <div class="mt16">
                    <label for="direct_printer_id" string="Direct Branch Receipt Printer" style="font-weight: bold; margin-top: 10px; display: block;"/>
                    <field name="direct_printer_id" placeholder="Select Branch Printer (e.g. عين الباشا)..."/>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
