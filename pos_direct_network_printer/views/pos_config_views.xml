<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pos_direct_config_view_form" model="ir.ui.view">
        <field name="name">pos.direct.config.form.view</field>
        <field name="model">pos.config</field>
        <field name="inherit_id" ref="point_of_sale.pos_config_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='iface_print_auto']" position="after">
                <setting id="pos_direct_custom_printer" string="Direct Branch Receipt Printer" help="Select local network or USB printer created for this branch">
                    <field name="direct_printer_id" placeholder="Select Branch Printer (e.g. عين الباشا)..."/>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
