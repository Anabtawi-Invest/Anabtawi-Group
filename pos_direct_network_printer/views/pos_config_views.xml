<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pos_iot_config_view_form" model="ir.ui.view">
        <field name="name">pos.iot.config.form.view</field>
        <field name="model">pos.config</field>
        <field name="inherit_id" ref="point_of_sale.pos_config_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='other_devices']" position="after">
                <setting id="direct_branch_printer_setting" string="Direct Branch Printer" help="Select local network or USB printer for this branch">
                    <field name="other_devices" string="Enable Direct Printer"/>
                    <div class="content-group" invisible="not other_devices">
                        <div class="mt16">
                            <label for="direct_printer_id" string="Assigned Thermal Printer"/>
                            <field name="direct_printer_id" placeholder="Select Branch Printer..."/>
                        </div>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
