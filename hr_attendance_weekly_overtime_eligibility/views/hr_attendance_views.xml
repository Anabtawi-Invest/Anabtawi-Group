<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_attendance_view_form_inherit_weekly_overtime" model="ir.ui.view">
        <field name="name">hr.attendance.form.inherit.weekly.overtime</field>
        <field name="model">hr.attendance</field>
        <field name="inherit_id" ref="hr_attendance.hr_attendance_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='validated_overtime_hours']" position="after">
                <field name="eligible_overtime" invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='linked_overtime_ids']/list" position="inside">
                <field name="eligible_overtime" column_invisible="1"/>
            </xpath>
        </field>
    </record>

    <record id="view_attendance_tree_management_inherit_weekly_overtime" model="ir.ui.view">
        <field name="name">hr.attendance.tree.management.inherit.weekly.overtime</field>
        <field name="model">hr.attendance</field>
        <field name="inherit_id" ref="hr_attendance.view_attendance_tree_management"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="inside">
                <field name="eligible_overtime" column_invisible="1"/>
            </xpath>
        </field>
    </record>
</odoo>
