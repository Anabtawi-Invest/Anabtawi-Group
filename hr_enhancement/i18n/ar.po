#. module: hr_enhancement
#: model_terms:ir.ui.view,arch_db:hr_enhancement.res_config_settings_view_form_daily_leave_conversion
msgid "Daily Leave to Annual"
msgstr "مغادرة يومية"

#. module: hr_enhancement
#: model:ir.model.fields,field_description:hr_enhancement.field_res_company__daily_leave_type_id
#: model:ir.model.fields,field_description:hr_enhancement.field_res_config_settings__daily_leave_type_id
#: model_terms:ir.ui.view,arch_db:hr_enhancement.res_config_settings_view_form_daily_leave_conversion
msgid "Daily Time Off Type"
msgstr "نوع المغادرة اليومية"

#. module: hr_enhancement
#: model_terms:ir.ui.view,arch_db:hr_enhancement.res_config_settings_view_form_daily_leave_conversion
msgid "Hours from approved leaves of this type increase the employee counter."
msgstr "الساعات من طلبات هذا النوع المعتمدة تُضاف إلى عداد الموظف."

#. module: hr_enhancement
#: model_terms:ir.ui.view,arch_db:hr_enhancement.res_config_settings_view_form_daily_leave_conversion
msgid "Annual Leave Type"
msgstr "نوع الإجازة السنوية"

#. module: hr_enhancement
#: model:ir.model.fields,field_description:hr_enhancement.field_res_company__daily_conversion_annual_leave_type_id
msgid "Annual Leave Type for Daily Conversion"
msgstr "نوع الإجازة السنوية للمغادرة اليومية"

#. module: hr_enhancement
#: model_terms:ir.ui.view,arch_db:hr_enhancement.res_config_settings_view_form_daily_leave_conversion
msgid "When the counter reaches 8 hours, the system creates 1 day of this leave type."
msgstr "عند وصول العداد إلى 8 ساعات، ينشئ النظام يوماً واحداً من هذا النوع."

#. module: hr_enhancement
#: model:ir.model.fields,help:hr_enhancement.field_res_company__daily_leave_type_id
#: model:ir.model.fields,help:hr_enhancement.field_res_config_settings__daily_leave_type_id
msgid "Hours taken from this leave type are accumulated per employee. Every 8 hours create 1 day of the annual leave type below."
msgstr "الساعات المأخوذة من هذا النوع تُجمَّع لكل موظف. كل 8 ساعات تُحوَّل إلى يوم واحد من نوع الإجازة السنوية أدناه."

#. module: hr_enhancement
#: model:ir.model.fields,help:hr_enhancement.field_res_company__daily_conversion_annual_leave_type_id
#: model:ir.model.fields,help:hr_enhancement.field_res_config_settings__daily_conversion_annual_leave_type_id
msgid "Leave type used when 8 hours of the daily time off type are converted into 1 annual leave day."
msgstr "نوع الإجازة المستخدم عند تحويل 8 ساعات من المغادرة اليومية إلى يوم إجازة سنوية واحد."

#. module: hr_enhancement
#: model:ir.model.fields,field_description:hr_enhancement.field_hr_employee__daily_leave_hours_counter
msgid "Daily Leave Hours Counter"
msgstr "عداد ساعات المغادرة اليومية"

#. module: hr_enhancement
#: model:ir.model.fields,help:hr_enhancement.field_hr_employee__daily_leave_hours_counter
msgid "Accumulated hours from the company daily leave type. Every 8 hours are converted into 1 annual leave day."
msgstr "الساعات المتراكمة من نوع المغادرة اليومية للشركة. كل 8 ساعات تُحوَّل إلى يوم إجازة سنوية واحد."

#. module: hr_enhancement
#: model:ir.model.fields,field_description:hr_enhancement.field_hr_leave__daily_conversion_hours_applied
msgid "Daily Conversion Hours Applied"
msgstr "ساعات التحويل اليومي المطبقة"

#. module: hr_enhancement
#: model:ir.model.fields,help:hr_enhancement.field_hr_leave__daily_conversion_hours_applied
msgid "Hours from this leave that were already added to the employee daily leave counter."
msgstr "الساعات من هذه المغادرة التي أُضيفت مسبقاً إلى عداد المغادرة اليومية للموظف."

