<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_report_qc_inspection" model="ir.actions.report">
        <field name="name">Inspection Report</field>
        <field name="model">qc.inspection</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">anabtawi_branch_qc.report_qc_inspection_document</field>
        <field name="report_file">anabtawi_branch_qc.report_qc_inspection_document</field>
        <field name="print_report_name">'Inspection - %s' % (object.name)</field>
        <field name="binding_model_id" ref="model_qc_inspection"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_qc_inspection_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2 class="text-center">
                            Branch Quality Inspection
                        </h2>
                        <h4 class="text-center" t-esc="doc.name"/>

                        <div class="row mt-4">
                            <div class="col-6">
                                <strong>Branch:</strong>
                                <span t-field="doc.branch_id"/><br/>
                                <strong>Inspection Date:</strong>
                                <span t-field="doc.inspection_date"/><br/>
                                <strong>Inspector:</strong>
                                <span t-field="doc.inspector_id"/><br/>
                                <strong>Reviewer:</strong>
                                <span t-field="doc.reviewer_id"/>
                            </div>
                            <div class="col-6 text-end">
                                <strong>Total Score:</strong>
                                <span t-esc="'%.2f' % doc.total_score"/> /
                                <span t-esc="'%.0f' % doc.max_score"/><br/>
                                <strong>Percentage:</strong>
                                <span t-esc="'%.2f' % doc.percentage"/>%<br/>
                                <strong>Grade:</strong>
                                <span t-field="doc.grade_id"/><br/>
                                <strong>Result:</strong>
                                <span t-field="doc.result"/>
                            </div>
                        </div>

                        <div t-if="doc.has_critical"
                             class="alert alert-danger mt-3" role="alert">
                            <strong>Critical failure detected.</strong>
                            This inspection is marked as Failed regardless of the
                            numeric score.
                        </div>

                        <t t-foreach="doc.factor_ids" t-as="factor">
                            <h5 class="mt-4"
                                t-attf-class="{{'text-danger' if factor.has_critical_failure else ''}}">
                                <span t-field="factor.name"/>
                                <span class="float-end">
                                    <span t-esc="'%.2f' % factor.score"/> /
                                    <span t-esc="'%.0f' % factor.max_score"/>
                                </span>
                            </h5>
                            <table class="table table-sm table-bordered">
                                <thead>
                                    <tr>
                                        <th>Question</th>
                                        <th class="text-center">Type</th>
                                        <th class="text-center">Answer</th>
                                        <th class="text-center">Critical</th>
                                        <th>Comment</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="factor.answer_ids" t-as="ans">
                                        <td t-field="ans.name"/>
                                        <td class="text-center"
                                            t-field="ans.answer_type"/>
                                        <td class="text-center">
                                            <t t-if="ans.not_applicable">N/A</t>
                                            <t t-elif="ans.answer_type == 'pass_fail'"
                                               t-esc="ans.val_pass"/>
                                            <t t-elif="ans.answer_type == 'comment'">-</t>
                                            <t t-else="" t-esc="'%.1f' % ans.val_score"/>
                                        </td>
                                        <td class="text-center">
                                            <span t-if="ans.critical_failed"
                                                  class="text-danger">FAIL</span>
                                            <span t-elif="ans.is_critical">Yes</span>
                                        </td>
                                        <td t-field="ans.comment"/>
                                    </tr>
                                </tbody>
                            </table>
                        </t>

                        <t t-if="doc.corrective_action_ids">
                            <h5 class="mt-4">Corrective Actions</h5>
                            <table class="table table-sm table-bordered">
                                <thead>
                                    <tr>
                                        <th>Reference</th>
                                        <th>Problem</th>
                                        <th>Responsible</th>
                                        <th>Due Date</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="doc.corrective_action_ids" t-as="ca">
                                        <td t-field="ca.name"/>
                                        <td t-field="ca.problem"/>
                                        <td t-field="ca.responsible_id"/>
                                        <td t-field="ca.due_date"/>
                                        <td t-field="ca.state"/>
                                    </tr>
                                </tbody>
                            </table>
                        </t>

                        <div t-if="doc.note" class="mt-3">
                            <strong>General Comments:</strong>
                            <p t-field="doc.note"/>
                        </div>

                        <div class="row mt-5">
                            <div class="col-6">
                                <p>_____________________________</p>
                                <strong>Inspector</strong>:
                                <span t-field="doc.inspector_id"/>
                            </div>
                            <div class="col-6 text-end">
                                <p>_____________________________</p>
                                <strong>Reviewer</strong>:
                                <span t-field="doc.reviewer_id"/>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>
