<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Question template (used inline under factor) -->
    <record id="view_qc_question_template_list" model="ir.ui.view">
        <field name="name">qc.question.template.list</field>
        <field name="model">qc.question.template</field>
        <field name="arch" type="xml">
            <list string="Questions" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="answer_type"/>
                <field name="weight"/>
                <field name="is_critical"/>
                <field name="allow_na" optional="hide"/>
                <field name="allow_photo" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- Factor template -->
    <record id="view_qc_factor_template_form" model="ir.ui.view">
        <field name="name">qc.factor.template.form</field>
        <field name="model">qc.factor.template</field>
        <field name="arch" type="xml">
            <form string="Evaluation Factor">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Factor name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="template_id"/>
                            <field name="max_score"/>
                        </group>
                        <group>
                            <field name="sequence"/>
                            <field name="is_critical_factor"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Questions" name="questions">
                            <field name="question_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="answer_type"/>
                                    <field name="weight"/>
                                    <field name="is_critical"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_qc_factor_template_list" model="ir.ui.view">
        <field name="name">qc.factor.template.list</field>
        <field name="model">qc.factor.template</field>
        <field name="arch" type="xml">
            <list string="Factors">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="template_id"/>
                <field name="max_score"/>
                <field name="question_count"/>
                <field name="is_critical_factor"/>
            </list>
        </field>
    </record>

    <!-- Checklist template -->
    <record id="view_qc_checklist_template_form" model="ir.ui.view">
        <field name="name">qc.checklist.template.form</field>
        <field name="model">qc.checklist.template</field>
        <field name="arch" type="xml">
            <form string="Checklist Template">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger"
                            invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Template name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="total_score"/>
                            <field name="factor_count"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Evaluation Factors" name="factors">
                            <field name="factor_ids">
                                <list>
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="max_score"/>
                                    <field name="question_count"/>
                                    <field name="is_critical_factor"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="note" placeholder="Internal notes..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_qc_checklist_template_list" model="ir.ui.view">
        <field name="name">qc.checklist.template.list</field>
        <field name="model">qc.checklist.template</field>
        <field name="arch" type="xml">
            <list string="Checklist Templates">
                <field name="name"/>
                <field name="factor_count"/>
                <field name="total_score"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="action_qc_checklist_template" model="ir.actions.act_window">
        <field name="name">Checklists</field>
        <field name="res_model">qc.checklist.template</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a checklist template</p>
            <p>Define the evaluation factors and questions used during inspections.</p>
        </field>
    </record>

</odoo>
