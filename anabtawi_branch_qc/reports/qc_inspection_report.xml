<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_report_qc_inspection" model="ir.actions.report">
        <field name="name">Inspection Report</field>
        <field name="model">qc.inspection</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">anabtawi_branch_qc.report_qc_inspection_document</field>
        <field name="report_file">anabtawi_branch_qc.report_qc_inspection_document</field>
        <field name="print_report_name">'Inspection - %s' % (object.name)</field>
        <field name="binding_model_id" ref="model_qc_inspection"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_qc_inspection_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2 class="text-center">
                            Branch Quality Inspection
                        </h2>
                        <h4 class="text-center" t-esc="doc.name"/>

                        <div class="row mt-4">
                            <div class="col-6">
                                <strong>Branch:</strong>
                                <span t-field="doc.branch_id"/><br/>
                                <strong>Inspection Date:</strong>
                                <span t-field="doc.inspection_date"/><br/>
                                <strong>Inspector:</strong>
                                <span t-field="doc.inspector_id"/><br/>
                                <strong>Reviewer:</strong>
                                <span t-field="doc.reviewer_id"/>
                            </div>
                            <div class="col-6 text-end">
                                <strong>Total Score:</strong>
                                <span t-esc="'%.2f' % doc.total_score"/> /
                                <span t-esc="'%.0f' % doc.max_score"/><br/>
                                <strong>Percentage:</strong>
                                <span t-esc="'%.2f' % doc.percentage"/>%<br/>
                                <strong>Grade:</strong>
                                <span t-field="doc.grade_id"/><br/>
                                <strong>Result:</strong>
                                <span t-field="doc.result"/>
                            </div>
                        </div>

                        <div t-if="doc.has_critical"
                             class="alert alert-danger mt-3" role="alert">
                            <strong>Critical failure detected.</strong>
                            This inspection is marked as Failed regardless of the
                            numeric score.
                        </div>

                        <t t-foreach="doc.factor_ids" t-as="factor">
                            <h5 class="mt-4"
                                t-attf-class="{{'text-danger' if factor.has_critical_failure else ''}}">
                                <span t-field="factor.name"/>
                                <span class="float-end">
                                    <span t-esc="'%.2f' % factor.score"/> /
                                    <span t-esc="'%.0f' % factor.max_score"/>
                                </span>
                            </h5>
                            <table class="table table-sm table-bordered">
                                <thead>
                                    <tr>
                                        <th>Question</th>
                                        <th class="text-center">Type</th>
                                        <th class="text-center">Answer</th>
                                        <th class="text-center">Critical</th>
                                        <th>Comment</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="factor.answer_ids" t-as="ans">
                                        <td t-field="ans.name"/>
                                        <td class="text-center"
                                            t-field="ans.answer_type"/>
                                        <td class="text-center">
                                            <t t-if="ans.not_applicable">N/A</t>
                                            <t t-elif="ans.answer_type == 'pass_fail'"
                                               t-esc="ans.val_pass"/>
                                            <t t-elif="ans.answer_type == 'comment'">-</t>
                                            <t t-else="" t-esc="'%.1f' % ans.val_score"/>
                                        </td>
                                        <td class="text-center">
                                            <span t-if="ans.critical_failed"
                                                  class="text-danger">FAIL</span>
                                            <span t-elif="ans.is_critical">Yes</span>
                                        </td>
                                        <td t-field="ans.comment"/>
                                    </tr>
                                </tbody>
                            </table>
                        </t>

                        <t t-if="doc.corrective_action_ids">
                            <h5 class="mt-4">Corrective Actions</h5>
                            <table class="table table-sm table-bordered">
                                <thead>
                                    <tr>
                                        <th>Reference</th>
                                        <th>Problem</th>
                                        <th>Responsible</th>
                                        <th>Due Date</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="doc.corrective_action_ids" t-as="ca">
                                        <td t-field="ca.name"/>
                                        <td t-field="ca.problem"/>
                                        <td t-field="ca.responsible_id"/>
                                        <td t-field="ca.due_date"/>
                                        <td t-field="ca.state"/>
                                    </tr>
                                </tbody>
                            </table>
                        </t>

                        <div t-if="doc.note" class="mt-3">
                            <strong>General Comments:</strong>
                            <p t-field="doc.note"/>
                        </div>

                        <div class="row mt-5">
                            <div class="col-6">
                                <p>_____________________________</p>
                                <strong>Inspector</strong>:
                                <span t-field="doc.inspector_id"/>
                            </div>
                            <div class="col-6 text-end">
                                <p>_____________________________</p>
                                <strong>Reviewer</strong>:
                                <span t-field="doc.reviewer_id"/>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <record id="action_report_qc_inspection_consolidated" model="ir.actions.report">
        <field name="name">Consolidated Daily Report</field>
        <field name="model">qc.inspection</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">anabtawi_branch_qc.report_qc_inspection_consolidated_document</field>
        <field name="report_file">anabtawi_branch_qc.report_qc_inspection_consolidated_document</field>
        <field name="print_report_name">'Consolidated - %s' % (object.branch_id.name)</field>
        <field name="binding_model_id" ref="model_qc_inspection"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_qc_inspection_consolidated_document">
        <t t-call="web.html_container">
            <t t-set="grouped_keys" t-value="list(set((d.branch_id, d.inspection_date) for d in docs))"/>
            <t t-foreach="grouped_keys" t-as="key">
                <t t-set="branch" t-value="key[0]"/>
                <t t-set="date" t-value="key[1]"/>
                <t t-set="group_inspections" t-value="docs.filtered(lambda d: d.branch_id == branch and d.inspection_date == date)"/>
                
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2 class="text-center">Consolidated Quality Report</h2>
                        <h4 class="text-center"><span t-esc="branch.name"/> - <span t-esc="date"/></h4>
                        
                        <h5 class="mt-4">Summary of Graded Checklists</h5>
                        <table class="table table-bordered">
                            <thead>
                                <tr style="background-color: #f2f2f2;">
                                    <th>Checklist Template</th>
                                    <th class="text-center">Inspector</th>
                                    <th class="text-center">Score</th>
                                    <th class="text-center">Grade</th>
                                    <th class="text-center">Result</th>
                                    <th class="text-center">Critical Failures</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="group_inspections" t-as="insp">
                                    <td><span t-field="insp.template_id"/></td>
                                    <td class="text-center"><span t-field="insp.inspector_id.name"/></td>
                                    <td class="text-center">
                                        <span t-esc="'%.2f' % insp.percentage"/>% 
                                        (<span t-esc="'%.1f' % insp.total_score"/> / <span t-esc="'%.0f' % insp.max_score"/>)
                                    </td>
                                    <td class="text-center"><span t-field="insp.grade_id"/></td>
                                    <td class="text-center">
                                        <span t-if="insp.result == 'pass'" class="badge bg-success" style="color: white; font-weight: bold; padding: 5px 10px;">PASSED</span>
                                        <span t-elif="insp.result == 'fail'" class="badge bg-danger" style="color: white; font-weight: bold; padding: 5px 10px;">FAILED</span>
                                        <span t-else="" class="badge bg-secondary" style="color: white; font-weight: bold; padding: 5px 10px;">PENDING</span>
                                    </td>
                                    <td class="text-center">
                                        <span t-if="insp.has_critical" class="text-danger">Yes</span>
                                        <span t-else="">No</span>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                        
                        <p style="page-break-after: always;"/>
                        
                        <t t-foreach="group_inspections" t-as="doc">
                            <h3 class="mt-4 text-primary" style="border-bottom: 2px solid #0056b3; padding-bottom: 5px;">
                                Detail: <span t-field="doc.template_id.name"/>
                            </h3>
                            <div class="row">
                                <div class="col-6">
                                    <strong>Inspection Reference:</strong> <span t-field="doc.name"/><br/>
                                    <strong>Inspector:</strong> <span t-field="doc.inspector_id"/>
                                </div>
                                <div class="col-6 text-end">
                                    <strong>Score:</strong> <span t-esc="'%.2f' % doc.percentage"/>% 
                                    (<span t-esc="'%.1f' % doc.total_score"/>/<span t-esc="'%.0f' % doc.max_score"/>)<br/>
                                    <strong>Result:</strong> <span t-field="doc.result"/>
                                </div>
                            </div>
                            
                            <t t-foreach="doc.factor_ids" t-as="factor">
                                <h5 class="mt-4" t-attf-class="{{'text-danger' if factor.has_critical_failure else ''}}">
                                    <span t-field="factor.name"/>
                                    <span class="float-end">
                                        <span t-esc="'%.2f' % factor.score"/> /
                                        <span t-esc="'%.0f' % factor.max_score"/>
                                    </span>
                                </h5>
                                <table class="table table-sm table-bordered">
                                    <thead>
                                        <tr>
                                            <th>Question</th>
                                            <th class="text-center">Answer</th>
                                            <th class="text-center">Critical</th>
                                            <th>Comment</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr t-foreach="factor.answer_ids" t-as="ans">
                                            <td t-field="ans.name"/>
                                            <td class="text-center">
                                                <t t-if="ans.not_applicable">N/A</t>
                                                <t t-elif="ans.answer_type == 'pass_fail'" t-esc="ans.val_pass"/>
                                                <t t-elif="ans.answer_type == 'comment'">-</t>
                                                <t t-else="" t-esc="'%.1f' % ans.val_score"/>
                                            </td>
                                            <td class="text-center">
                                                <span t-if="ans.critical_failed" class="text-danger">FAIL</span>
                                                <span t-elif="ans.is_critical">Yes</span>
                                            </td>
                                            <td t-field="ans.comment"/>
                                        </tr>
                                    </tbody>
                                </table>
                            </t>
                            
                            <t t-if="doc.corrective_action_ids">
                                <h6 class="mt-3">Corrective Actions Required:</h6>
                                <table class="table table-sm table-bordered">
                                    <tbody>
                                        <tr t-foreach="doc.corrective_action_ids" t-as="ca">
                                            <td><strong><span t-field="ca.name"/></strong></td>
                                            <td><span t-field="ca.problem"/></td>
                                            <td>Responsible: <span t-field="ca.responsible_id"/></td>
                                            <td>Due: <span t-field="ca.due_date"/></td>
                                        </tr>
                                    </tbody>
                                </table>
                            </t>
                            
                            <div t-if="doc.note" class="mt-2 mb-4 p-2 bg-light border">
                                <strong>Inspector Comments:</strong> <span t-field="doc.note"/>
                            </div>
                            
                            <t t-if="not doc_last">
                                <p style="page-break-after: always;"/>
                            </t>
                        </t>
                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>
