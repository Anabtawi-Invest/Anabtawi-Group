<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_product_last_bill_price_wizard_form" model="ir.ui.view">
        <field name="name">product.last.bill.price.wizard.form</field>
        <field name="model">product.last.bill.price.wizard</field>
        <field name="arch" type="xml">
            <form string="Export Last Vendor Bill Price">
                <group>
                    <field name="company_id" groups="base.group_multi_company"/>
                    <field name="only_with_bill"/>
                    <field name="include_archived"/>
                </group>
                <footer>
                    <button name="action_export_xlsx"
                            type="object"
                            string="Download Excel"
                            class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_product_last_bill_price_wizard" model="ir.actions.act_window">
        <field name="name">Last Vendor Bill Price (Excel)</field>
        <field name="res_model">product.last.bill.price.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_product_last_bill_price_export"
              name="Last Vendor Bill Price (Excel)"
              parent="purchase.menu_procurement_management"
              action="action_product_last_bill_price_wizard"
              sequence="90"
              groups="purchase.group_purchase_user"/>
</odoo>
