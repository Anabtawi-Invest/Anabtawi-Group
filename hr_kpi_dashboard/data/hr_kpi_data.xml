<odoo noupdate="1">
  <record id="cat_compliance" model="anabtawi.hr.kpi.category">
    <field name="name">Compliance &amp; Ethics</field><field name="code">COMPLIANCE</field><field name="sequence">10</field>
  </record>
  <record id="cat_costs" model="anabtawi.hr.kpi.category">
    <field name="name">Costs</field><field name="code">COSTS</field><field name="sequence">20</field>
  </record>
  <record id="cat_diversity" model="anabtawi.hr.kpi.category">
    <field name="name">Diversity</field><field name="code">DIVERSITY</field><field name="sequence">30</field>
  </record>
  <record id="cat_leadership" model="anabtawi.hr.kpi.category">
    <field name="name">Leadership</field><field name="code">LEADERSHIP</field><field name="sequence">40</field>
  </record>
  <record id="cat_culture" model="anabtawi.hr.kpi.category">
    <field name="name">Organizational Culture</field><field name="code">CULTURE</field><field name="sequence">50</field>
  </record>
  <record id="cat_ohs" model="anabtawi.hr.kpi.category">
    <field name="name">Health, Safety &amp; Well-being</field><field name="code">OHS</field><field name="sequence">60</field>
  </record>
  <record id="cat_productivity" model="anabtawi.hr.kpi.category">
    <field name="name">Productivity</field><field name="code">PRODUCTIVITY</field><field name="sequence">70</field>
  </record>
  <record id="cat_recruitment" model="anabtawi.hr.kpi.category">
    <field name="name">Recruitment, Mobility &amp; Turnover</field><field name="code">RECRUITMENT</field><field name="sequence">80</field>
  </record>
  <record id="cat_skills" model="anabtawi.hr.kpi.category">
    <field name="name">Skills &amp; Capabilities</field><field name="code">SKILLS</field><field name="sequence">90</field>
  </record>
  <record id="cat_succession" model="anabtawi.hr.kpi.category">
    <field name="name">Succession Planning</field><field name="code">SUCCESSION</field><field name="sequence">100</field>
  </record>
  <record id="cat_availability" model="anabtawi.hr.kpi.category">
    <field name="name">Workforce Availability</field><field name="code">AVAILABILITY</field><field name="sequence">110</field>
  </record>
  <record id="kpi_workforce_headcount" model="anabtawi.hr.kpi.definition">
    <field name="name">Number of Employees</field><field name="code">WORKFORCE_HEADCOUNT</field>
    <field name="category_id" ref="cat_availability"/><field name="sequence">1</field>
    <field name="unit">number</field><field name="direction">neutral</field>
    <field name="formula">Total active employees in the period.</field><field name="iso_area">Availability</field>
  </record>
  <record id="kpi_active_contracts" model="anabtawi.hr.kpi.definition">
    <field name="name">Active Contracts</field><field name="code">ACTIVE_CONTRACTS</field>
    <field name="category_id" ref="cat_availability"/><field name="sequence">2</field>
    <field name="unit">number</field><field name="direction">neutral</field>
    <field name="formula">Contracts active during the period.</field><field name="iso_area">Availability</field>
  </record>
  <record id="kpi_fte" model="anabtawi.hr.kpi.definition">
    <field name="name">Full Time Equivalents (FTE)</field><field name="code">FTE</field>
    <field name="category_id" ref="cat_availability"/><field name="sequence">3</field>
    <field name="unit">number</field><field name="direction">neutral</field>
    <field name="formula">Default equals active employees; manually adjust if part-time schedules are configured.</field><field name="iso_area">Availability</field>
  </record>
  <record id="kpi_absenteeism_rate" model="anabtawi.hr.kpi.definition">
    <field name="name">Absenteeism Rate</field><field name="code">ABSENTEEISM_RATE</field>
    <field name="category_id" ref="cat_availability"/><field name="sequence">4</field>
    <field name="unit">percent</field><field name="direction">lower</field>
    <field name="formula">Unplanned absent days / available work days x 100.</field><field name="iso_area">Availability</field>
  </record>
  <record id="kpi_absent_days" model="anabtawi.hr.kpi.definition">
    <field name="name">Absent Days</field><field name="code">ABSENT_DAYS</field>
    <field name="category_id" ref="cat_availability"/><field name="sequence">5</field>
    <field name="unit">days</field><field name="direction">lower</field>
    <field name="formula">Validated sick/absence leave days in the period.</field><field name="iso_area">Availability</field>
  </record>
  <record id="kpi_total_workforce_cost" model="anabtawi.hr.kpi.definition">
    <field name="name">Total Workforce Costs</field><field name="code">TOTAL_WORKFORCE_COST</field>
    <field name="category_id" ref="cat_costs"/><field name="sequence">6</field>
    <field name="unit">currency</field><field name="direction">lower</field>
    <field name="formula">Employee compensation + benefits + external workforce costs.</field><field name="iso_area">Costs</field>
  </record>
  <record id="kpi_total_employment_cost" model="anabtawi.hr.kpi.definition">
    <field name="name">Total Costs of Employment</field><field name="code">TOTAL_EMPLOYMENT_COST</field>
    <field name="category_id" ref="cat_costs"/><field name="sequence">7</field>
    <field name="unit">currency</field><field name="direction">lower</field>
    <field name="formula">Compensation + benefits + HR development costs.</field><field name="iso_area">Costs</field>
  </record>
  <record id="kpi_avg_salary" model="anabtawi.hr.kpi.definition">
    <field name="name">Average Salary</field><field name="code">AVG_SALARY</field>
    <field name="category_id" ref="cat_costs"/><field name="sequence">8</field>
    <field name="unit">currency</field><field name="direction">neutral</field>
    <field name="formula">Average wage across active contracts.</field><field name="iso_area">Costs</field>
  </record>
  <record id="kpi_revenue_per_employee" model="anabtawi.hr.kpi.definition">
    <field name="name">Revenue per Employee</field><field name="code">REVENUE_PER_EMPLOYEE</field>
    <field name="category_id" ref="cat_productivity"/><field name="sequence">9</field>
    <field name="unit">currency</field><field name="direction">higher</field>
    <field name="formula">Posted invoice revenue divided by active headcount.</field><field name="iso_area">Productivity</field>
  </record>
  <record id="kpi_human_capital_roi" model="anabtawi.hr.kpi.definition">
    <field name="name">Human Capital ROI</field><field name="code">HUMAN_CAPITAL_ROI</field>
    <field name="category_id" ref="cat_productivity"/><field name="sequence">10</field>
    <field name="unit">ratio</field><field name="direction">higher</field>
    <field name="formula">(Revenue - workforce cost) / workforce cost.</field><field name="iso_area">Productivity</field>
  </record>
  <record id="kpi_turnover_rate" model="anabtawi.hr.kpi.definition">
    <field name="name">Turnover Rate</field><field name="code">TURNOVER_RATE</field>
    <field name="category_id" ref="cat_recruitment"/><field name="sequence">11</field>
    <field name="unit">percent</field><field name="direction">lower</field>
    <field name="formula">Departures during period / active headcount x 100.</field><field name="iso_area">Recruitment</field>
  </record>
  <record id="kpi_departures" model="anabtawi.hr.kpi.definition">
    <field name="name">Departures</field><field name="code">DEPARTURES</field>
    <field name="category_id" ref="cat_recruitment"/><field name="sequence">12</field>
    <field name="unit">number</field><field name="direction">lower</field>
    <field name="formula">Employees archived during the period; refine manually if needed.</field><field name="iso_area">Recruitment</field>
  </record>
  <record id="kpi_recruitment_candidates" model="anabtawi.hr.kpi.definition">
    <field name="name">Qualified Candidates / Applications</field><field name="code">RECRUITMENT_CANDIDATES</field>
    <field name="category_id" ref="cat_recruitment"/><field name="sequence">13</field>
    <field name="unit">number</field><field name="direction">higher</field>
    <field name="formula">Recruitment applications created in the period.</field><field name="iso_area">Recruitment</field>
  </record>
  <record id="kpi_internal_mobility_rate" model="anabtawi.hr.kpi.definition">
    <field name="name">Internal Mobility Rate</field><field name="code">INTERNAL_MOBILITY_RATE</field>
    <field name="category_id" ref="cat_recruitment"/><field name="sequence">14</field>
    <field name="unit">percent</field><field name="direction">higher</field>
    <field name="formula">Manual/extension field for internal moves.</field><field name="iso_area">Recruitment</field>
  </record>
  <record id="kpi_span_of_control" model="anabtawi.hr.kpi.definition">
    <field name="name">Span of Control</field><field name="code">SPAN_OF_CONTROL</field>
    <field name="category_id" ref="cat_leadership"/><field name="sequence">15</field>
    <field name="unit">ratio</field><field name="direction">neutral</field>
    <field name="formula">Average direct reports per manager.</field><field name="iso_area">Leadership</field>
  </record>
  <record id="kpi_training_participation_rate" model="anabtawi.hr.kpi.definition">
    <field name="name">Training Participation Rate</field><field name="code">TRAINING_PARTICIPATION_RATE</field>
    <field name="category_id" ref="cat_skills"/><field name="sequence">16</field>
    <field name="unit">percent</field><field name="direction">higher</field>
    <field name="formula">Manual/extension field for completed training participation.</field><field name="iso_area">Skills</field>
  </record>
  <record id="kpi_grievances" model="anabtawi.hr.kpi.definition">
    <field name="name">Number and Type of Grievance Filed</field><field name="code">GRIEVANCES</field>
    <field name="category_id" ref="cat_compliance"/><field name="sequence">17</field>
    <field name="unit">number</field><field name="direction">lower</field>
    <field name="formula">Manual HR/compliance input.</field><field name="iso_area">Compliance</field>
  </record>
  <record id="kpi_disciplinary_actions" model="anabtawi.hr.kpi.definition">
    <field name="name">Concluded Disciplinary Actions</field><field name="code">DISCIPLINARY_ACTIONS</field>
    <field name="category_id" ref="cat_compliance"/><field name="sequence">18</field>
    <field name="unit">number</field><field name="direction">lower</field>
    <field name="formula">Manual HR/compliance input.</field><field name="iso_area">Compliance</field>
  </record>
  <record id="kpi_occupational_accidents" model="anabtawi.hr.kpi.definition">
    <field name="name">Occupational Accidents</field><field name="code">OCCUPATIONAL_ACCIDENTS</field>
    <field name="category_id" ref="cat_ohs"/><field name="sequence">19</field>
    <field name="unit">number</field><field name="direction">lower</field>
    <field name="formula">Manual safety input.</field><field name="iso_area">Ohs</field>
  </record>
  <record id="kpi_fatality_rate" model="anabtawi.hr.kpi.definition">
    <field name="name">Fatality Rate</field><field name="code">FATALITY_RATE</field>
    <field name="category_id" ref="cat_ohs"/><field name="sequence">20</field>
    <field name="unit">percent</field><field name="direction">lower</field>
    <field name="formula">Fatal occupational injuries / total employees x 100.</field><field name="iso_area">Ohs</field>
  </record>
</odoo>