<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-inherit="point_of_sale.ClosePosPopup" t-inherit-mode="extension" owl="1">
        <xpath expr="//PaymentMethodBreakdown[@title.translate='Cash In / Out']" position="after">
            <PaymentMethodBreakdown
                t-if="shouldShowCashDeliveryLine()"
                title.translate="Cash Delivery"
                total_amount="deliveryMoveData.total"
                transactions="deliveryMoveData.moves"/>
        </xpath>
    </t>
</templates>
