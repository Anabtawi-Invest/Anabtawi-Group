<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-inherit="point_of_sale.ControlButtons" t-inherit-mode="extension" owl="1">
        <!-- Cash Delivery: visible in Actions; configured check happens on click -->
        <xpath expr="//t[@t-if='props.showRemainingButtons']/div/button[contains(@t-on-click, 'onCancelOrder')]" position="before">
            <button
                t-att-class="deliveryAmountButtonClass()"
                t-on-click="onClickDeliveryAmount"
                type="button">
                <i class="fa fa-money me-2" role="img" t-att-aria-label="deliveryAmountButtonLabel" t-att-title="deliveryAmountButtonLabel"/>
                <span t-esc="deliveryAmountButtonLabel"/>
            </button>
        </xpath>
    </t>
</templates>
