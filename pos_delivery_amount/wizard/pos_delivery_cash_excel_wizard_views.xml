<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pos_delivery_cash_excel_wizard_form" model="ir.ui.view">
        <field name="name">pos.delivery.cash.excel.wizard.form</field>
        <field name="model">pos.delivery.cash.excel.wizard</field>
        <field name="arch" type="xml">
            <form string="Export Cash vs Closing Delivery">
                <group>
                    <group>
                        <field name="date_from"/>
                        <field name="date_to"/>
                    </group>
                    <group>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="pos_config_ids" widget="many2many_tags" options="{'no_create': True}"/>
                    </group>
                </group>
                <footer>
                    <button name="action_export_xlsx"
                            type="object"
                            string="Download Excel"
                            class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_pos_delivery_cash_excel_wizard" model="ir.actions.act_window">
        <field name="name">Cash vs Closing Delivery (Excel)</field>
        <field name="res_model">pos.delivery.cash.excel.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_pos_delivery_cash_excel_wizard"
              name="Cash vs Closing Delivery (Excel)"
              parent="point_of_sale.menu_point_rep"
              action="action_pos_delivery_cash_excel_wizard"
              groups="point_of_sale.group_pos_manager,account.group_account_readonly,account.group_account_invoice,account.group_account_manager"
              sequence="50"/>
</odoo>
