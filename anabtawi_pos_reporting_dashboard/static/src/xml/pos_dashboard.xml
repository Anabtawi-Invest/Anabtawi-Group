<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="anabtawi_pos_reporting_dashboard.PosReportingDashboard" owl="1">
        <div class="o_pos_dashboard_wrapper">
            <!-- Header & Filter Toolbar -->
            <div class="o_pos_dashboard_header">
                <div class="o_dashboard_title">
                    <h2><i class="fa fa-dashboard text-primary"/> POS Executive Dashboard</h2>
                    <span class="subtitle">
                        Unified real-time branch performance &amp; operations analysis 
                        <t t-if="data.date_from and data.date_to">
                            (<t t-esc="data.date_from"/> to <t t-esc="data.date_to"/>)
                        </t>
                    </span>
                </div>
                <div class="o_dashboard_filters">
                    <!-- Quick Date Range Buttons -->
                    <div class="btn-group btn-group-period" role="group">
                        <button type="button" class="btn btn-outline-primary" t-att-class="{'active': state.period === 'today'}" t-on-click="() => this.setPeriod('today')">Today</button>
                        <button type="button" class="btn btn-outline-primary" t-att-class="{'active': state.period === 'yesterday'}" t-on-click="() => this.setPeriod('yesterday')">Yesterday</button>
                        <button type="button" class="btn btn-outline-primary" t-att-class="{'active': state.period === 'this_week'}" t-on-click="() => this.setPeriod('this_week')">This Week</button>
                        <button type="button" class="btn btn-outline-primary" t-att-class="{'active': state.period === 'this_month'}" t-on-click="() => this.setPeriod('this_month')">This Month</button>
                    </div>

                    <div class="d-flex align-items-center gap-2">
                        <input type="datetime-local" class="form-control filter_input" t-model="state.date_from"/>
                        <span class="text-muted">to</span>
                        <input type="datetime-local" class="form-control filter_input" t-model="state.date_to"/>
                        <button class="btn btn-primary" t-on-click="fetchDashboardData" icon="fa-refresh">
                            <i class="fa fa-refresh me-1"/> Apply
                        </button>
                        <button class="btn btn-success ms-2" t-on-click="exportExcel">
                            <i class="fa fa-file-excel-o me-1"/> Export Excel
                        </button>
                    </div>
                </div>
            </div>

            <!-- Branch Selector Tabs -->
            <div class="o_branch_selector_bar mb-4">
                <ul class="nav nav-pills branch_pills">
                    <li class="nav-item">
                        <button type="button" class="nav-link" t-att-class="{'active': isBranchSelected('all')}" t-on-click="() => this.selectBranch('all')">
                            <i class="fa fa-cubes me-1"/> All Branches
                        </button>
                    </li>
                    <t t-foreach="data.all_branches" t-as="branch_item" t-key="branch_item.id">
                        <li class="nav-item">
                            <button type="button" class="nav-link" t-att-class="{'active': isBranchSelected(branch_item.id)}" t-on-click="() => this.selectBranch(branch_item.id)">
                                <i class="fa fa-building-o me-1"/> <t t-esc="branch_item.name"/>
                            </button>
                        </li>
                    </t>
                </ul>
            </div>

            <!-- Loader -->
            <t t-if="state.loading">
                <div class="text-center p-5">
                    <div class="spinner-border text-primary" role="status" style="width: 3rem; height: 3rem;">
                        <span class="visually-hidden">Loading POS Data...</span>
                    </div>
                    <p class="mt-3 text-muted">Calculating POS branch analytics...</p>
                </div>
            </t>

            <!-- Main Dashboard Body -->
            <t t-else="">
                <!-- KPI Summary Row -->
                <div class="o_kpi_grid">
                    <!-- Total Sales -->
                    <div class="o_kpi_card card-sales clickable_kpi" t-on-click="() => this.onKpiClick('sales')" title="Click to view detailed transactions &amp; export Excel">
                        <div class="kpi_icon"><i class="fa fa-shopping-cart text-primary"/></div>
                        <div class="kpi_title">Total POS Sales (Gross)</div>
                        <div class="kpi_value"><t t-esc="formatCurrency(data.kpis.total_sales)"/></div>
                        <div class="kpi_subtext d-flex justify-content-between align-items-center">
                            <span><t t-esc="data.kpis.order_count"/> Total Orders</span>
                            <span class="drill_badge"><i class="fa fa-search-plus me-1"/>Drill Down</span>
                        </div>
                    </div>

                    <!-- Average Orders Per Minute -->
                    <div class="o_kpi_card card-opm">
                        <div class="kpi_icon"><i class="fa fa-tachometer text-warning"/></div>
                        <div class="kpi_title">Average Orders / Min</div>
                        <div class="kpi_value"><t t-esc="formatDecimal(data.kpis.orders_per_min, 2)"/> <span class="fs-6 fw-normal text-muted">Orders/Min</span></div>
                        <div class="kpi_subtext d-flex justify-content-between align-items-center">
                            <span class="badge bg-warning text-dark badge_sub">Average Speed</span>
                            <span class="text-muted fw-bold"><t t-esc="data.kpis.order_count"/> Orders</span>
                        </div>
                    </div>

                    <!-- Sales Without Tax -->
                    <div class="o_kpi_card card-untaxed clickable_kpi" t-on-click="() => this.onKpiClick('untaxed_sales')" title="Click to view detailed transactions &amp; export Excel">
                        <div class="kpi_icon"><i class="fa fa-file-text-o text-success"/></div>
                        <div class="kpi_title">Sales Without Tax (Net)</div>
                        <div class="kpi_value"><t t-esc="formatCurrency(data.kpis.untaxed_sales)"/></div>
                        <div class="kpi_subtext d-flex justify-content-between align-items-center">
                            <span class="badge bg-success badge_sub">Net Sales</span>
                            <span class="drill_badge"><i class="fa fa-search-plus me-1"/>Drill Down</span>
                        </div>
                    </div>

                    <!-- Total Sales Tax -->
                    <div class="o_kpi_card card-tax clickable_kpi" t-on-click="() => this.onKpiClick('tax_amount')" title="Click to view detailed transactions &amp; export Excel">
                        <div class="kpi_icon"><i class="fa fa-percent text-info"/></div>
                        <div class="kpi_title">Total Sales Tax (VAT)</div>
                        <div class="kpi_value"><t t-esc="formatCurrency(data.kpis.tax_amount)"/></div>
                        <div class="kpi_subtext d-flex justify-content-between align-items-center">
                            <span class="badge bg-info badge_sub">VAT Taxes</span>
                            <span class="drill_badge"><i class="fa fa-search-plus me-1"/>Drill Down</span>
                        </div>
                    </div>

                    <!-- Total Discounts -->
                    <div class="o_kpi_card card-discount clickable_kpi" t-on-click="() => this.onKpiClick('discount_amount')" title="Click to view detailed transactions &amp; export Excel">
                        <div class="kpi_icon"><i class="fa fa-tag text-warning"/></div>
                        <div class="kpi_title">Total Discounts</div>
                        <div class="kpi_value"><t t-esc="formatCurrency(data.kpis.discount_amount)"/></div>
                        <div class="kpi_subtext d-flex justify-content-between align-items-center">
                            <span class="badge bg-warning text-dark badge_sub">Discounts</span>
                            <span class="drill_badge"><i class="fa fa-search-plus me-1"/>Drill Down</span>
                        </div>
                    </div>

                    <!-- Cash Sales -->
                    <div class="o_kpi_card card-cash clickable_kpi" t-on-click="() => this.onKpiClick('cash_sales')" title="Click to view detailed transactions &amp; export Excel">
                        <div class="kpi_icon"><i class="fa fa-money text-success"/></div>
                        <div class="kpi_title">Cash Sales</div>
                        <div class="kpi_value"><t t-esc="formatCurrency(data.kpis.cash_sales)"/></div>
                        <div class="kpi_subtext d-flex justify-content-between align-items-center">
                            <span class="badge bg-success badge_sub"><t t-esc="getPercent(data.kpis.cash_sales, data.kpis.total_sales)"/>% of Sales</span>
                            <span class="drill_badge"><i class="fa fa-search-plus me-1"/>Drill Down</span>
                        </div>
                    </div>

                    <!-- Visa / Card Sales -->
                    <div class="o_kpi_card card-visa clickable_kpi" t-on-click="() => this.onKpiClick('visa_sales')" title="Click to view detailed transactions &amp; export Excel">
                        <div class="kpi_icon"><i class="fa fa-credit-card text-info"/></div>
                        <div class="kpi_title">Visa &amp; Card Sales</div>
                        <div class="kpi_value"><t t-esc="formatCurrency(data.kpis.visa_sales)"/></div>
                        <div class="kpi_subtext d-flex justify-content-between align-items-center">
                            <span class="badge bg-info badge_sub"><t t-esc="getPercent(data.kpis.visa_sales, data.kpis.total_sales)"/>% of Sales</span>
                            <span class="drill_badge"><i class="fa fa-search-plus me-1"/>Drill Down</span>
                        </div>
                    </div>

                    <!-- Debt Sales (مبيعات الذمم) -->
                    <div class="o_kpi_card card-employee-debt clickable_kpi" t-on-click="() => this.onKpiClick('employee_debt')" title="Click to view detailed transactions &amp; export Excel">
                        <div class="kpi_icon"><i class="fa fa-id-card-o text-purple"/></div>
                        <div class="kpi_title">Debt Sales (مبيعات الذمم)</div>
                        <div class="kpi_value"><t t-esc="formatCurrency(data.kpis.employee_debt)"/></div>
                        <div class="kpi_subtext d-flex justify-content-between align-items-center">
                            <span class="badge bg-purple text-white badge_sub">Debt Sales</span>
                            <span class="drill_badge"><i class="fa fa-search-plus me-1"/>Drill Down</span>
                        </div>
                    </div>

                    <!-- Net Cash Moves (In / Out) -->
                    <div class="o_kpi_card card-cashmoves clickable_kpi" t-on-click="() => this.onKpiClick('net_cash_moves')" title="Click to view detailed transactions &amp; export Excel">
                        <div class="kpi_icon"><i class="fa fa-exchange text-warning"/></div>
                        <div class="kpi_title">Net Cash Moves</div>
                        <div class="kpi_value"><t t-esc="formatCurrency(data.kpis.net_cash_moves)"/></div>
                        <div class="kpi_subtext d-flex justify-content-between align-items-center">
                            <div>
                                <span class="text-success"><i class="fa fa-arrow-down"/> In: <t t-esc="formatCurrency(data.kpis.cash_in)"/></span> | 
                                <span class="text-danger"><i class="fa fa-arrow-up"/> Out: <t t-esc="formatCurrency(data.kpis.cash_out)"/></span>
                            </div>
                            <span class="drill_badge"><i class="fa fa-search-plus me-1"/>Drill Down</span>
                        </div>
                    </div>

                    <!-- Pledges (Rahen In / Out) -->
                    <div class="o_kpi_card card-pledges clickable_kpi" t-on-click="() => this.onKpiClick('net_pledges')" title="Click to view detailed transactions &amp; export Excel">
                        <div class="kpi_icon"><i class="fa fa-handshake-o text-danger"/></div>
                        <div class="kpi_title">Net Pledges (Rahen)</div>
                        <div class="kpi_value"><t t-esc="formatCurrency(data.kpis.net_pledges)"/></div>
                        <div class="kpi_subtext d-flex justify-content-between align-items-center">
                            <div>
                                <span>Rec: <t t-esc="formatCurrency(data.kpis.rahen_in)"/></span> | 
                                <span>Ret: <t t-esc="formatCurrency(data.kpis.rahen_out)"/></span>
                            </div>
                            <span class="drill_badge"><i class="fa fa-search-plus me-1"/>Drill Down</span>
                        </div>
                    </div>

                    <!-- Advance Payments Deposited -->
                    <div class="o_kpi_card card-advances clickable_kpi" t-on-click="() => this.onKpiClick('advance_deposits')" title="Click to view detailed transactions &amp; export Excel">
                        <div class="kpi_icon"><i class="fa fa-clock-o text-cyan"/></div>
                        <div class="kpi_title">Advance Deposits (Origin)</div>
                        <div class="kpi_value"><t t-esc="formatCurrency(data.kpis.advance_deposits)"/></div>
                        <div class="kpi_subtext d-flex justify-content-between align-items-center">
                            <span><t t-esc="data.kpis.advance_order_count"/> Advance Orders</span>
                            <span class="drill_badge"><i class="fa fa-search-plus me-1"/>Drill Down</span>
                        </div>
                    </div>

                    <!-- Delivery Amount -->
                    <div class="o_kpi_card card-delivery clickable_kpi" t-on-click="() => this.onKpiClick('delivery_amount')" title="Click to view detailed transactions &amp; export Excel">
                        <div class="kpi_icon"><i class="fa fa-truck text-primary"/></div>
                        <div class="kpi_title">Delivery Amount</div>
                        <div class="kpi_value"><t t-esc="formatCurrency(data.kpis.delivery_amount)"/></div>
                        <div class="kpi_subtext d-flex justify-content-between align-items-center">
                            <span class="badge bg-primary text-white badge_sub">Session Delivery</span>
                            <span class="drill_badge"><i class="fa fa-search-plus me-1"/>Drill Down</span>
                        </div>
                    </div>
                </div>

                <!-- Channels & Daily Trend Summary -->
                <div class="row">
                    <!-- Channel Breakdown Progress Cards -->
                    <div class="col-lg-5 mb-4">
                        <div class="o_dashboard_section h-100">
                            <div class="section_header">
                                <h4><i class="fa fa-pie-chart text-primary"/> Sales Payment Channels</h4>
                            </div>
                            <div class="channel_list mt-3">
                                <t t-foreach="data.channels" t-as="channel" t-key="channel.name">
                                    <div class="channel_progress_item">
                                        <div class="channel_info">
                                            <span><t t-esc="channel.name"/></span>
                                            <span><t t-esc="formatCurrency(channel.value)"/> (<t t-esc="getPercent(channel.value, data.kpis.total_sales)"/>%)</span>
                                        </div>
                                        <div class="progress">
                                            <div class="progress-bar" role="progressbar" 
                                                 t-attf-style="width: {{getPercent(channel.value, data.kpis.total_sales)}}%; background-color: {{channel.color}};"
                                                 t-att-aria-valuenow="getPercent(channel.value, data.kpis.total_sales)" 
                                                 aria-valuemin="0" aria-valuemax="100"/>
                                        </div>
                                    </div>
                                </t>
                            </div>
                        </div>
                    </div>

                    <!-- Executive Metrics Overview -->
                    <div class="col-lg-7 mb-4">
                        <div class="o_dashboard_section h-100">
                            <div class="section_header">
                                <h4><i class="fa fa-line-chart text-success"/> Executive Operational Highlights</h4>
                            </div>
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <div class="p-3 border rounded bg-light clickable_kpi" t-on-click="() => this.onKpiClick('untaxed_sales')" title="Click to view detailed transactions &amp; export Excel">
                                        <h6 class="text-muted mb-1">Sales Without Tax (Net)</h6>
                                        <h4 class="fw-bold text-success mb-0"><t t-esc="formatCurrency(data.kpis.untaxed_sales)"/></h4>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="p-3 border rounded bg-light clickable_kpi" t-on-click="() => this.onKpiClick('tax_amount')" title="Click to view detailed transactions &amp; export Excel">
                                        <h6 class="text-muted mb-1">Total Sales Tax (VAT)</h6>
                                        <h4 class="fw-bold text-info mb-0"><t t-esc="formatCurrency(data.kpis.tax_amount)"/></h4>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="p-3 border rounded bg-light clickable_kpi" t-on-click="() => this.onKpiClick('employee_debt')" title="Click to view detailed transactions &amp; export Excel">
                                        <h6 class="text-muted mb-1">Debt Sales (مبيعات الذمم)</h6>
                                        <h4 class="fw-bold text-purple mb-0"><t t-esc="formatCurrency(data.kpis.employee_debt)"/></h4>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="p-3 border rounded bg-light clickable_kpi" t-on-click="() => this.onKpiClick('discount_amount')" title="Click to view detailed transactions &amp; export Excel">
                                        <h6 class="text-muted mb-1">Total Order Discounts</h6>
                                        <h4 class="fw-bold text-warning mb-0"><t t-esc="formatCurrency(data.kpis.discount_amount)"/></h4>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Per-Branch Detailed Comparison Grid -->
                <div class="o_dashboard_section">
                    <div class="section_header d-flex justify-content-between align-items-center flex-wrap gap-2">
                        <h4><i class="fa fa-building text-info"/> Branch Performance Matrix (<t t-esc="data.branches.length"/> Active Branches)</h4>
                        <span class="text-muted small"><i class="fa fa-info-circle me-1"/>Click any column header to sort high-to-low or low-to-high</span>
                    </div>

                    <div class="table-responsive">
                        <table class="table table_branch_data align-middle">
                            <thead>
                                <tr>
                                    <th class="sortable_th" t-on-click="() => this.sortBy('branch_name')">
                                        Branch Name
                                        <i class="fa fa-sort-alpha-asc text-primary ms-1" t-if="state.sortKey === 'branch_name' &amp;&amp; state.sortOrder === 'asc'"/>
                                        <i class="fa fa-sort-alpha-desc text-primary ms-1" t-if="state.sortKey === 'branch_name' &amp;&amp; state.sortOrder === 'desc'"/>
                                        <i class="fa fa-sort text-muted ms-1 opacity-50" t-if="state.sortKey !== 'branch_name'"/>
                                    </th>
                                    <th class="text-end sortable_th" t-on-click="() => this.sortBy('sales')">
                                        Total Sales
                                        <i class="fa fa-sort-amount-desc text-primary ms-1" t-if="state.sortKey === 'sales' &amp;&amp; state.sortOrder === 'desc'"/>
                                        <i class="fa fa-sort-amount-asc text-primary ms-1" t-if="state.sortKey === 'sales' &amp;&amp; state.sortOrder === 'asc'"/>
                                        <i class="fa fa-sort text-muted ms-1 opacity-50" t-if="state.sortKey !== 'sales'"/>
                                    </th>
                                    <th class="text-end sortable_th" t-on-click="() => this.sortBy('orders_per_min')">
                                        Orders / Min
                                        <i class="fa fa-sort-amount-desc text-primary ms-1" t-if="state.sortKey === 'orders_per_min' &amp;&amp; state.sortOrder === 'desc'"/>
                                        <i class="fa fa-sort-amount-asc text-primary ms-1" t-if="state.sortKey === 'orders_per_min' &amp;&amp; state.sortOrder === 'asc'"/>
                                        <i class="fa fa-sort text-muted ms-1 opacity-50" t-if="state.sortKey !== 'orders_per_min'"/>
                                    </th>
                                    <th class="text-end sortable_th" t-on-click="() => this.sortBy('untaxed_sales')">
                                        Sales Without Tax
                                        <i class="fa fa-sort-amount-desc text-primary ms-1" t-if="state.sortKey === 'untaxed_sales' &amp;&amp; state.sortOrder === 'desc'"/>
                                        <i class="fa fa-sort-amount-asc text-primary ms-1" t-if="state.sortKey === 'untaxed_sales' &amp;&amp; state.sortOrder === 'asc'"/>
                                        <i class="fa fa-sort text-muted ms-1 opacity-50" t-if="state.sortKey !== 'untaxed_sales'"/>
                                    </th>
                                    <th class="text-end sortable_th" t-on-click="() => this.sortBy('tax_amount')">
                                        Tax Amount
                                        <i class="fa fa-sort-amount-desc text-primary ms-1" t-if="state.sortKey === 'tax_amount' &amp;&amp; state.sortOrder === 'desc'"/>
                                        <i class="fa fa-sort-amount-asc text-primary ms-1" t-if="state.sortKey === 'tax_amount' &amp;&amp; state.sortOrder === 'asc'"/>
                                        <i class="fa fa-sort text-muted ms-1 opacity-50" t-if="state.sortKey !== 'tax_amount'"/>
                                    </th>
                                    <th class="text-end sortable_th" t-on-click="() => this.sortBy('discount_amount')">
                                        Total Discounts
                                        <i class="fa fa-sort-amount-desc text-primary ms-1" t-if="state.sortKey === 'discount_amount' &amp;&amp; state.sortOrder === 'desc'"/>
                                        <i class="fa fa-sort-amount-asc text-primary ms-1" t-if="state.sortKey === 'discount_amount' &amp;&amp; state.sortOrder === 'asc'"/>
                                        <i class="fa fa-sort text-muted ms-1 opacity-50" t-if="state.sortKey !== 'discount_amount'"/>
                                    </th>
                                    <th class="text-end sortable_th" t-on-click="() => this.sortBy('cash')">
                                        Cash Sales
                                        <i class="fa fa-sort-amount-desc text-primary ms-1" t-if="state.sortKey === 'cash' &amp;&amp; state.sortOrder === 'desc'"/>
                                        <i class="fa fa-sort-amount-asc text-primary ms-1" t-if="state.sortKey === 'cash' &amp;&amp; state.sortOrder === 'asc'"/>
                                        <i class="fa fa-sort text-muted ms-1 opacity-50" t-if="state.sortKey !== 'cash'"/>
                                    </th>
                                    <th class="text-end sortable_th" t-on-click="() => this.sortBy('visa')">
                                        Visa / Card
                                        <i class="fa fa-sort-amount-desc text-primary ms-1" t-if="state.sortKey === 'visa' &amp;&amp; state.sortOrder === 'desc'"/>
                                        <i class="fa fa-sort-amount-asc text-primary ms-1" t-if="state.sortKey === 'visa' &amp;&amp; state.sortOrder === 'asc'"/>
                                        <i class="fa fa-sort text-muted ms-1 opacity-50" t-if="state.sortKey !== 'visa'"/>
                                    </th>
                                    <th class="text-end sortable_th" t-on-click="() => this.sortBy('employee_debt')">
                                        Debt Sales (مبيعات الذمم)
                                        <i class="fa fa-sort-amount-desc text-primary ms-1" t-if="state.sortKey === 'employee_debt' &amp;&amp; state.sortOrder === 'desc'"/>
                                        <i class="fa fa-sort-amount-asc text-primary ms-1" t-if="state.sortKey === 'employee_debt' &amp;&amp; state.sortOrder === 'asc'"/>
                                        <i class="fa fa-sort text-muted ms-1 opacity-50" t-if="state.sortKey !== 'employee_debt'"/>
                                    </th>
                                    <th class="text-end sortable_th" t-on-click="() => this.sortBy('hospitality')">
                                        Hospitality
                                        <i class="fa fa-sort-amount-desc text-primary ms-1" t-if="state.sortKey === 'hospitality' &amp;&amp; state.sortOrder === 'desc'"/>
                                        <i class="fa fa-sort-amount-asc text-primary ms-1" t-if="state.sortKey === 'hospitality' &amp;&amp; state.sortOrder === 'asc'"/>
                                        <i class="fa fa-sort text-muted ms-1 opacity-50" t-if="state.sortKey !== 'hospitality'"/>
                                    </th>
                                    <th class="text-end sortable_th" t-on-click="() => this.sortBy('talabat')">
                                        Talabat
                                        <i class="fa fa-sort-amount-desc text-primary ms-1" t-if="state.sortKey === 'talabat' &amp;&amp; state.sortOrder === 'desc'"/>
                                        <i class="fa fa-sort-amount-asc text-primary ms-1" t-if="state.sortKey === 'talabat' &amp;&amp; state.sortOrder === 'asc'"/>
                                        <i class="fa fa-sort text-muted ms-1 opacity-50" t-if="state.sortKey !== 'talabat'"/>
                                    </th>
                                    <th class="text-end sortable_th" t-on-click="() => this.sortBy('careem')">
                                        Careem
                                        <i class="fa fa-sort-amount-desc text-primary ms-1" t-if="state.sortKey === 'careem' &amp;&amp; state.sortOrder === 'desc'"/>
                                        <i class="fa fa-sort-amount-asc text-primary ms-1" t-if="state.sortKey === 'careem' &amp;&amp; state.sortOrder === 'asc'"/>
                                        <i class="fa fa-sort text-muted ms-1 opacity-50" t-if="state.sortKey !== 'careem'"/>
                                    </th>
                                    <th class="text-end sortable_th" t-on-click="() => this.sortBy('cash_in')">
                                        Cash In
                                        <i class="fa fa-sort-amount-desc text-primary ms-1" t-if="state.sortKey === 'cash_in' &amp;&amp; state.sortOrder === 'desc'"/>
                                        <i class="fa fa-sort-amount-asc text-primary ms-1" t-if="state.sortKey === 'cash_in' &amp;&amp; state.sortOrder === 'asc'"/>
                                        <i class="fa fa-sort text-muted ms-1 opacity-50" t-if="state.sortKey !== 'cash_in'"/>
                                    </th>
                                    <th class="text-end sortable_th" t-on-click="() => this.sortBy('cash_out')">
                                        Cash Out
                                        <i class="fa fa-sort-amount-desc text-primary ms-1" t-if="state.sortKey === 'cash_out' &amp;&amp; state.sortOrder === 'desc'"/>
                                        <i class="fa fa-sort-amount-asc text-primary ms-1" t-if="state.sortKey === 'cash_out' &amp;&amp; state.sortOrder === 'asc'"/>
                                        <i class="fa fa-sort text-muted ms-1 opacity-50" t-if="state.sortKey !== 'cash_out'"/>
                                    </th>
                                    <th class="text-end sortable_th" t-on-click="() => this.sortBy('net_cash_moves')">
                                        Net Cash Moves
                                        <i class="fa fa-sort-amount-desc text-primary ms-1" t-if="state.sortKey === 'net_cash_moves' &amp;&amp; state.sortOrder === 'desc'"/>
                                        <i class="fa fa-sort-amount-asc text-primary ms-1" t-if="state.sortKey === 'net_cash_moves' &amp;&amp; state.sortOrder === 'asc'"/>
                                        <i class="fa fa-sort text-muted ms-1 opacity-50" t-if="state.sortKey !== 'net_cash_moves'"/>
                                    </th>
                                    <th class="text-end sortable_th" t-on-click="() => this.sortBy('rahen_in')">
                                        Rahen In
                                        <i class="fa fa-sort-amount-desc text-primary ms-1" t-if="state.sortKey === 'rahen_in' &amp;&amp; state.sortOrder === 'desc'"/>
                                        <i class="fa fa-sort-amount-asc text-primary ms-1" t-if="state.sortKey === 'rahen_in' &amp;&amp; state.sortOrder === 'asc'"/>
                                        <i class="fa fa-sort text-muted ms-1 opacity-50" t-if="state.sortKey !== 'rahen_in'"/>
                                    </th>
                                    <th class="text-end sortable_th" t-on-click="() => this.sortBy('rahen_out')">
                                        Rahen Out
                                        <i class="fa fa-sort-amount-desc text-primary ms-1" t-if="state.sortKey === 'rahen_out' &amp;&amp; state.sortOrder === 'desc'"/>
                                        <i class="fa fa-sort-amount-asc text-primary ms-1" t-if="state.sortKey === 'rahen_out' &amp;&amp; state.sortOrder === 'asc'"/>
                                        <i class="fa fa-sort text-muted ms-1 opacity-50" t-if="state.sortKey !== 'rahen_out'"/>
                                    </th>
                                    <th class="text-end sortable_th" t-on-click="() => this.sortBy('advance_deposits')">
                                        Advance Deposits (Origin)
                                        <i class="fa fa-sort-amount-desc text-primary ms-1" t-if="state.sortKey === 'advance_deposits' &amp;&amp; state.sortOrder === 'desc'"/>
                                        <i class="fa fa-sort-amount-asc text-primary ms-1" t-if="state.sortKey === 'advance_deposits' &amp;&amp; state.sortOrder === 'asc'"/>
                                        <i class="fa fa-sort text-muted ms-1 opacity-50" t-if="state.sortKey !== 'advance_deposits'"/>
                                    </th>
                                    <th class="text-end sortable_th" t-on-click="() => this.sortBy('advance_pickup_value')">
                                        Scheduled Pickup Value
                                        <i class="fa fa-sort-amount-desc text-primary ms-1" t-if="state.sortKey === 'advance_pickup_value' &amp;&amp; state.sortOrder === 'desc'"/>
                                        <i class="fa fa-sort-amount-asc text-primary ms-1" t-if="state.sortKey === 'advance_pickup_value' &amp;&amp; state.sortOrder === 'asc'"/>
                                        <i class="fa fa-sort text-muted ms-1 opacity-50" t-if="state.sortKey !== 'advance_pickup_value'"/>
                                    </th>
                                    <th class="text-end sortable_th" t-on-click="() => this.sortBy('advance_pending_count')">
                                        Pending Pickups
                                        <i class="fa fa-sort-amount-desc text-primary ms-1" t-if="state.sortKey === 'advance_pending_count' &amp;&amp; state.sortOrder === 'desc'"/>
                                        <i class="fa fa-sort-amount-asc text-primary ms-1" t-if="state.sortKey === 'advance_pending_count' &amp;&amp; state.sortOrder === 'asc'"/>
                                        <i class="fa fa-sort text-muted ms-1 opacity-50" t-if="state.sortKey !== 'advance_pending_count'"/>
                                    </th>
                                    <th class="text-end sortable_th" t-on-click="() => this.sortBy('delivery_amount')">
                                        Delivery Fees
                                        <i class="fa fa-sort-amount-desc text-primary ms-1" t-if="state.sortKey === 'delivery_amount' &amp;&amp; state.sortOrder === 'desc'"/>
                                        <i class="fa fa-sort-amount-asc text-primary ms-1" t-if="state.sortKey === 'delivery_amount' &amp;&amp; state.sortOrder === 'asc'"/>
                                        <i class="fa fa-sort text-muted ms-1 opacity-50" t-if="state.sortKey !== 'delivery_amount'"/>
                                    </th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="sortedBranches" t-as="branch" t-key="branch.config_id">
                                    <tr>
                                        <td class="branch_title"><t t-esc="branch.branch_name"/></td>
                                        <td class="val_num fw-bold text-primary"><t t-esc="formatCurrency(branch.sales)"/></td>
                                        <td class="val_num fw-bold text-warning"><t t-esc="formatDecimal(branch.orders_per_min, 2)"/></td>
                                        <td class="val_num"><t t-esc="formatCurrency(branch.untaxed_sales)"/></td>
                                        <td class="val_num"><t t-esc="formatCurrency(branch.tax_amount)"/></td>
                                        <td class="val_num text-warning"><t t-esc="formatCurrency(branch.discount_amount)"/></td>
                                        <td class="val_num text-success"><t t-esc="formatCurrency(branch.cash)"/></td>
                                        <td class="val_num text-info"><t t-esc="formatCurrency(branch.visa)"/></td>
                                        <td class="val_num text-purple"><t t-esc="formatCurrency(branch.employee_debt)"/></td>
                                        <td class="val_num"><t t-esc="formatCurrency(branch.hospitality)"/></td>
                                        <td class="val_num"><t t-esc="formatCurrency(branch.talabat)"/></td>
                                        <td class="val_num"><t t-esc="formatCurrency(branch.careem)"/></td>
                                        <td class="val_num text-success">+<t t-esc="formatCurrency(branch.cash_in)"/></td>
                                        <td class="val_num text-danger">-<t t-esc="formatCurrency(branch.cash_out)"/></td>
                                        <td class="val_num fw-bold"><t t-esc="formatCurrency(branch.net_cash_moves)"/></td>
                                        <td class="val_num"><t t-esc="formatCurrency(branch.rahen_in)"/></td>
                                        <td class="val_num"><t t-esc="formatCurrency(branch.rahen_out)"/></td>
                                        <td class="val_num"><t t-esc="formatCurrency(branch.advance_deposits)"/></td>
                                        <td class="val_num text-info"><t t-esc="formatCurrency(branch.advance_pickup_value)"/></td>
                                        <td class="val_num fw-bold"><t t-esc="branch.advance_pending_count"/></td>
                                        <td class="val_num"><t t-esc="formatCurrency(branch.delivery_amount)"/></td>
                                    </tr>
                                </t>
                                <!-- Total Row -->
                                <tr class="row_total">
                                    <td class="branch_title">TOTALS</td>
                                    <td class="val_num"><t t-esc="formatCurrency(data.global_totals.sales)"/></td>
                                    <td class="val_num text-warning"><t t-esc="formatDecimal(data.global_totals.orders_per_min, 2)"/></td>
                                    <td class="val_num"><t t-esc="formatCurrency(data.global_totals.untaxed_sales)"/></td>
                                    <td class="val_num"><t t-esc="formatCurrency(data.global_totals.tax_amount)"/></td>
                                    <td class="val_num text-warning"><t t-esc="formatCurrency(data.global_totals.discount_amount)"/></td>
                                    <td class="val_num"><t t-esc="formatCurrency(data.global_totals.cash)"/></td>
                                    <td class="val_num"><t t-esc="formatCurrency(data.global_totals.visa)"/></td>
                                    <td class="val_num text-purple"><t t-esc="formatCurrency(data.global_totals.employee_debt)"/></td>
                                    <td class="val_num"><t t-esc="formatCurrency(data.global_totals.hospitality)"/></td>
                                    <td class="val_num"><t t-esc="formatCurrency(data.global_totals.talabat)"/></td>
                                    <td class="val_num"><t t-esc="formatCurrency(data.global_totals.careem)"/></td>
                                    <td class="val_num">+<t t-esc="formatCurrency(data.global_totals.cash_in)"/></td>
                                    <td class="val_num">-<t t-esc="formatCurrency(data.global_totals.cash_out)"/></td>
                                    <td class="val_num"><t t-esc="formatCurrency(data.global_totals.net_cash_moves)"/></td>
                                    <td class="val_num"><t t-esc="formatCurrency(data.global_totals.rahen_in)"/></td>
                                    <td class="val_num"><t t-esc="formatCurrency(data.global_totals.rahen_out)"/></td>
                                    <td class="val_num"><t t-esc="formatCurrency(data.global_totals.advance_deposits)"/></td>
                                    <td class="val_num text-info"><t t-esc="formatCurrency(data.global_totals.advance_pickup_value)"/></td>
                                    <td class="val_num fw-bold"><t t-esc="data.global_totals.advance_pending_count"/></td>
                                    <td class="val_num"><t t-esc="formatCurrency(data.global_totals.delivery_amount)"/></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </t>
        </div>
    </t>
</templates>
