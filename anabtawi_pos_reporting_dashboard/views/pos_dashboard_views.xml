<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Client Action for Interactive Dashboard -->
    <record id="action_pos_reporting_dashboard" model="ir.actions.client">
        <field name="name">POS Executive Dashboard</field>
        <field name="tag">pos_reporting_dashboard_main</field>
    </record>

    <!-- Views for pos.unified.report -->
    <record id="view_pos_unified_report_pivot" model="ir.ui.view">
        <field name="name">pos.unified.report.pivot</field>
        <field name="model">pos.unified.report</field>
        <field name="arch" type="xml">
            <pivot string="POS Unified Analysis" sample="1">
                <field name="config_id" type="row"/>
                <field name="report_type" type="col"/>
                <field name="amount" type="measure"/>
                <field name="cash_amount" type="measure"/>
                <field name="visa_amount" type="measure"/>
                <field name="employee_debt_amount" string="Debt Sales" type="measure"/>
                <field name="cash_in_amount" type="measure"/>
                <field name="cash_out_amount" type="measure"/>
                <field name="rahen_in_amount" type="measure"/>
                <field name="rahen_out_amount" type="measure"/>
                <field name="advance_amount" type="measure"/>
                <field name="delivery_amount" type="measure"/>
                <field name="attendant_employee_count" type="measure"/>
                <field name="labor_cost_amount" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_pos_unified_report_graph" model="ir.ui.view">
        <field name="name">pos.unified.report.graph</field>
        <field name="model">pos.unified.report</field>
        <field name="arch" type="xml">
            <graph string="POS Unified Analysis" type="bar" sample="1">
                <field name="config_id"/>
                <field name="amount" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_pos_unified_report_tree" model="ir.ui.view">
        <field name="name">pos.unified.report.list</field>
        <field name="model">pos.unified.report</field>
        <field name="arch" type="xml">
            <list string="POS Unified Operations">
                <header>
                    <button name="action_export_excel" string="Export Excel Report (.xlsx)" type="object" class="btn-success" icon="fa-file-excel-o"/>
                </header>
                <field name="date"/>
                <field name="config_id"/>
                <field name="employee_code" string="Employee ID / Code"/>
                <field name="employee_id" string="Employee Name"/>
                <field name="check_in" string="Check In"/>
                <field name="check_out" string="Check Out"/>
                <field name="session_id" optional="hide"/>
                <field name="pos_order_id" string="Order Reference" widget="many2one" optional="hide"/>
                <button name="action_open_pos_order" string="Open Order" type="object" icon="fa-arrow-circle-right" invisible="not pos_order_id"/>
                <field name="name"/>
                <field name="partner_id" optional="hide"/>
                <field name="report_type"/>
                <field name="payment_method_id" optional="hide"/>
                <field name="untaxed_amount" string="Amount w/o Tax" sum="Total Untaxed" optional="hide"/>
                <field name="tax_amount" string="Tax Amount" sum="Total Tax" optional="hide"/>
                <field name="discount_amount" string="Discount Amount" sum="Total Discount" optional="hide"/>
                <field name="gift_amount" sum="Total Gifts" optional="show"/>
                <field name="expense_amount" sum="Total Expenses" optional="show"/>
                <field name="cash_amount" sum="Total Cash" optional="hide"/>
                <field name="visa_amount" sum="Total Visa" optional="hide"/>
                <field name="employee_debt_amount" string="Debt Sales (مبيعات الذمم)" sum="Total Debt Sales" optional="hide"/>
                <field name="cash_in_amount" sum="Total Cash In" optional="hide"/>
                <field name="cash_out_amount" sum="Total Cash Out" optional="hide"/>
                <field name="rahen_in_amount" sum="Total Pledge (Rahen) In" optional="hide"/>
                <field name="rahen_out_amount" sum="Total Pledge (Rahen) Out" optional="hide"/>
                <field name="advance_amount" sum="Total Advance" optional="hide"/>
                <field name="monthly_wage" string="Monthly Wage" sum="Total Monthly Wage" optional="show"/>
                <field name="labor_cost_amount" string="Daily Wage / Cost" sum="Total Daily Cost" optional="show"/>
                <field name="extra_hours" string="Extra Hours (hrs)" sum="Total Extra Hours" optional="show"/>
                <field name="amount" string="Full Amount" sum="Total Amount"/>
            </list>
        </field>
    </record>

    <!-- Specialized List View: Attendant Employees -->
    <record id="view_pos_unified_report_attendance_tree" model="ir.ui.view">
        <field name="name">pos.unified.report.attendance.list</field>
        <field name="model">pos.unified.report</field>
        <field name="arch" type="xml">
            <list string="Attendant Employees Breakdown">
                <header>
                    <button name="action_export_excel" string="Export Excel Report (.xlsx)" type="object" class="btn-success" icon="fa-file-excel-o"/>
                </header>
                <field name="employee_code" string="Employee ID / Code"/>
                <field name="employee_id" string="Employee Name"/>
                <field name="config_id" string="POS Branch"/>
                <field name="date" string="Attendance Date"/>
                <field name="check_in" string="Check In Date &amp; Time"/>
                <field name="check_out" string="Check Out Date &amp; Time"/>
                <field name="check_in_location_id"/>
                <field name="check_in_map_url" widget="url" text="Map"/>
                <field name="name" string="Status / Description"/>
            </list>
        </field>
    </record>

    <!-- Specialized List View: Daily Employee Labor Cost -->
    <record id="view_pos_unified_report_labor_cost_tree" model="ir.ui.view">
        <field name="name">pos.unified.report.labor_cost.list</field>
        <field name="model">pos.unified.report</field>
        <field name="arch" type="xml">
            <list string="Daily Employee Wage &amp; Labor Cost Breakdown">
                <header>
                    <button name="action_export_excel" string="Export Excel Report (.xlsx)" type="object" class="btn-success" icon="fa-file-excel-o"/>
                </header>
                <field name="employee_code" string="Employee ID / Code"/>
                <field name="employee_id" string="Employee Name"/>
                <field name="config_id" string="POS Branch"/>
                <field name="date" string="Shift Date"/>
                <field name="check_in_location_id" optional="show"/>
                <field name="monthly_wage" string="Monthly Salary / Wage (JOD)" sum="Total Monthly Wage"/>
                <field name="labor_cost_amount" string="Daily Wage Cost (JOD)" sum="Total Daily Wage Cost"/>
                <field name="name" string="Details"/>
            </list>
        </field>
    </record>

    <!-- Specialized List View: Extra Hours (Overtime) -->
    <record id="view_pos_unified_report_extra_hours_tree" model="ir.ui.view">
        <field name="name">pos.unified.report.extra_hours.list</field>
        <field name="model">pos.unified.report</field>
        <field name="arch" type="xml">
            <list string="Extra Hours (Overtime) Breakdown">
                <header>
                    <button name="action_export_excel" string="Export Excel Report (.xlsx)" type="object" class="btn-success" icon="fa-file-excel-o"/>
                </header>
                <field name="employee_code" string="Employee ID / Code"/>
                <field name="employee_id" string="Employee Name"/>
                <field name="config_id" string="POS Branch"/>
                <field name="date" string="Shift Date"/>
                <field name="check_in" string="Check In"/>
                <field name="check_out" string="Check Out"/>
                <field name="check_in_location_id" optional="show"/>
                <field name="extra_hours" string="Extra Hours (hrs)" sum="Total Extra Hours"/>
                <field name="amount" string="Extra Hours Amount (JOD)" sum="Total Extra Hours Amount"/>
                <field name="name" string="Details"/>
            </list>
        </field>
    </record>

    <record id="view_pos_unified_report_search" model="ir.ui.view">
        <field name="name">pos.unified.report.search</field>
        <field name="model">pos.unified.report</field>
        <field name="arch" type="xml">
            <search string="Search POS Operations">
                <field name="name"/>
                <field name="date"/>
                <field name="config_id"/>
                <field name="session_id"/>
                <field name="employee_id"/>
                <field name="payment_method_id"/>
                <filter string="POS Sales" name="filter_sales" domain="[('report_type', '=', 'pos_sales')]"/>
                <filter string="Cash In" name="filter_cash_in" domain="[('report_type', '=', 'cash_in')]"/>
                <filter string="Cash Out" name="filter_cash_out" domain="[('report_type', '=', 'cash_out')]"/>
                <filter string="POS Expense" name="filter_expense" domain="[('report_type', '=', 'expense')]"/>
                <filter string="Pledge (Rahen) In" name="filter_rahen_in" domain="[('report_type', '=', 'rahen_in')]"/>
                <filter string="Pledge (Rahen) Out" name="filter_rahen_out" domain="[('report_type', '=', 'rahen_out')]"/>
                <filter string="Advance Deposits" name="filter_advance" domain="[('report_type', '=', 'advance_deposit')]"/>
                <filter string="Attendant Employees" name="filter_attendants" domain="[('report_type', '=', 'attendant_employees')]"/>
                <filter string="Daily Labor Cost" name="filter_labor_cost" domain="[('report_type', '=', 'labor_cost')]"/>
                <filter string="Extra Hours" name="filter_extra_hours" domain="[('report_type', '=', 'extra_hours')]"/>
                <separator/>
                <filter string="POS Branch" name="group_config" context="{'group_by': 'config_id'}"/>
                <filter string="Report Type" name="group_type" context="{'group_by': 'report_type'}"/>
                <filter string="Employee" name="group_employee" context="{'group_by': 'employee_id'}"/>
                <filter string="Date" name="group_date" context="{'group_by': 'date'}"/>
                <filter string="Payment Method" name="group_payment_method" context="{'group_by': 'payment_method_id'}"/>
            </search>
        </field>
    </record>

    <!-- Menu Items with Security Group Permissions -->
    <menuitem id="menu_pos_dashboard_root"
              name="POS Executive Dashboard"
              parent="point_of_sale.menu_point_rep"
              action="action_pos_reporting_dashboard"
              groups="anabtawi_pos_reporting_dashboard.group_pos_reporting_dashboard_user"
              sequence="1"/>

    <menuitem id="menu_pos_unified_report_wizard"
              name="Unified POS Operations &amp; Excel"
              parent="point_of_sale.menu_point_rep"
              action="action_pos_unified_report_wizard"
              groups="anabtawi_pos_reporting_dashboard.group_pos_reporting_dashboard_user"
              sequence="2"/>

    <record id="view_pos_category_profit_rate_list" model="ir.ui.view">
        <field name="name">pos.category.profit.rate.list</field>
        <field name="model">pos.category.profit.rate</field>
        <field name="arch" type="xml">
            <list string="POS Category Percentages" editable="bottom">
                <field name="pos_categ_id"/>
                <field name="percentage"/>
            </list>
        </field>
    </record>

    <record id="view_pos_category_profit_rate_form" model="ir.ui.view">
        <field name="name">pos.category.profit.rate.form</field>
        <field name="model">pos.category.profit.rate</field>
        <field name="arch" type="xml">
            <form string="POS Category Percentage">
                <sheet>
                    <group>
                        <field name="pos_categ_id"/>
                        <field name="percentage"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_pos_category_profit_rate" model="ir.actions.act_window">
        <field name="name">POS Category Percentages</field>
        <field name="res_model">pos.category.profit.rate</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Assign a percentage to a POS category.</p>
            <p>150 means the cost is multiplied by 1.50. Category profit is untaxed sales minus that loaded cost.</p>
        </field>
    </record>

    <menuitem id="menu_pos_category_profit_rate"
              name="POS Category Percentages"
              parent="point_of_sale.menu_point_rep"
              action="action_pos_category_profit_rate"
              groups="anabtawi_pos_reporting_dashboard.group_pos_dashboard_products"
              sequence="3"/>

    <record id="view_pos_dashboard_transfer_location_list" model="ir.ui.view">
        <field name="name">pos.dashboard.transfer.location.list</field>
        <field name="model">pos.dashboard.transfer.location</field>
        <field name="arch" type="xml">
            <list string="POS Transfer Locations" editable="bottom">
                <field name="config_id"/>
                <field name="location_id"/>
                <field name="company_id" optional="hide" groups="base.group_multi_company"/>
                <field name="active" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_pos_dashboard_transfer_location_form" model="ir.ui.view">
        <field name="name">pos.dashboard.transfer.location.form</field>
        <field name="model">pos.dashboard.transfer.location</field>
        <field name="arch" type="xml">
            <form string="POS Transfer Location">
                <sheet>
                    <group>
                        <field name="config_id"/>
                        <field name="location_id"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_pos_dashboard_transfer_location" model="ir.actions.act_window">
        <field name="name">POS Transfer Locations</field>
        <field name="res_model">pos.dashboard.transfer.location</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Link each POS branch to its transfer stock location.</p>
            <p>Choose the destination location used when the branch receives from تسليم الطلبيات. This is used only by the Transfers tab on the POS Executive Dashboard.</p>
        </field>
    </record>

    <menuitem id="menu_pos_dashboard_transfer_location"
              name="POS Transfer Locations"
              parent="point_of_sale.menu_point_rep"
              action="action_pos_dashboard_transfer_location"
              groups="anabtawi_pos_reporting_dashboard.group_pos_reporting_dashboard_user"
              sequence="4"/>
</odoo>
