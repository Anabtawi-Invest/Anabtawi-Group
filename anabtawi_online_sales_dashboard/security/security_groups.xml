<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="group_online_sales_dashboard_user" model="res.groups">
            <field name="name">Online Sales Dashboard / User</field>
            <field name="category_id" ref="base.module_category_point_of_sale"/>
            <field name="implied_ids" eval="[(4, ref('point_of_sale.group_pos_user'))]"/>
        </record>

        <record id="group_online_sales_dashboard_manager" model="res.groups">
            <field name="name">Online Sales Dashboard / Manager</field>
            <field name="category_id" ref="base.module_category_point_of_sale"/>
            <field name="implied_ids" eval="[(4, ref('group_online_sales_dashboard_user')), (4, ref('point_of_sale.group_pos_manager'))]"/>
        </record>
    </data>
</odoo>
