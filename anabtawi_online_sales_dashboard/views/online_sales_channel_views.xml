<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_online_sales_channel_tree" model="ir.ui.view">
            <field name="name">online.sales.channel.list</field>
            <field name="model">online.sales.channel</field>
            <field name="arch" type="xml">
                <list string="Online &amp; Delivery Channels" editable="bottom">
                    <field name="sequence" widget="handle"/>
                    <field name="name"/>
                    <field name="code"/>
                    <field name="color" widget="color"/>
                    <field name="commission_rate"/>
                    <field name="keywords"/>
                    <field name="payment_method_ids" widget="many2many_tags"/>
                    <field name="active"/>
                </list>
            </field>
        </record>

        <record id="action_online_sales_channel_config" model="ir.actions.act_window">
            <field name="name">Online Delivery Channels</field>
            <field name="res_model">online.sales.channel</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Configure Online Sales &amp; Delivery Channels (Talabat, Careem, Website, etc.)
                </p>
            </field>
        </record>
    </data>
</odoo>
