<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pos_cash_movement_wizard" model="ir.ui.view">
        <field name="name">pos.cash.movement.wizard.form</field>
        <field name="model">pos.cash.movement.wizard</field>
        <field name="arch" type="xml">
            <form string="Cash Movement Report">
                <group>
                    <field name="date_from"/>
                    <field name="date_to"/>
                </group>
                <footer>
                    <button name="action_export_excel"
                            type="object"
                            string="Export Excel"
                            class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_pos_cash_movement_wizard" model="ir.actions.act_window">
        <field name="name">Cash Movement Report</field>
        <field name="res_model">pos.cash.movement.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_pos_cash_movement_report"
              name="Cash Movement Report"
              parent="point_of_sale.menu_point_rep"
              action="action_pos_cash_movement_wizard"
              sequence="7"/>
</odoo>
