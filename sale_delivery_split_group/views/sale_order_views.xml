<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_delivery_split" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.delivery.split</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="use_delivery_group" invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='order_line']/list/field[@name='product_template_id']" position="after">
                <field name="product_type" column_invisible="1"/>
                <field name="delivery_group_id"
                       column_invisible="not parent.use_delivery_group"
                       required="parent.use_delivery_group and not display_type and product_type == 'consu'"
                       options="{'no_create': True}"/>
            </xpath>
        </field>
    </record>
</odoo>
