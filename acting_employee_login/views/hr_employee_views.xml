<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_employee_form_acting_login_password" model="ir.ui.view">
        <field name="name">hr.employee.form.acting.login.password</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='identification_group']" position="inside">
                <field name="acting_login_user_id"
                       widget="many2one_avatar_user"
                       options="{'no_create': True}"/>
                <field name="acting_login_password"
                       widget="password"
                       placeholder="Enter a new acting login password"/>
                <field name="acting_login_password_is_set" invisible="1"/>
                <div invisible="not acting_login_password_is_set" class="text-muted fst-italic">
                    Password is set. Leave empty to keep it.
                </div>
            </xpath>
        </field>
    </record>
</odoo>
