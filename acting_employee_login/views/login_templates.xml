<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="login_acting_employee" inherit_id="web.login">
        <xpath expr="//div[hasclass('o_caps_lock_warning')]" position="after">
            <div class="mb-3 field-acting-employee-number">
                <label for="acting_employee_number" class="form-label">Employee Number / Branch Name</label>
                <input type="text"
                       placeholder="Enter employee number or branch name"
                       name="acting_employee_number"
                       t-att-value="acting_employee_number"
                       id="acting_employee_number"
                       class="form-control"
                       required="required"
                       autocomplete="off"/>
            </div>
            <div class="mb-3 field-acting-employee-password">
                <label for="acting_employee_password" class="form-label">Employee / Branch Password</label>
                <div class="input-group mb-1">
                    <input type="password"
                           placeholder="Enter employee or branch password"
                           name="acting_employee_password"
                           id="acting_employee_password"
                           class="form-control"
                           required="required"
                           autocomplete="off"
                           maxlength="4096"/>
                    <button type="button" class="btn btn-sm border border-start-0 o_show_password">
                        <i class="fa fa-eye"/>
                    </button>
                </div>
            </div>
        </xpath>
    </template>
</odoo>
