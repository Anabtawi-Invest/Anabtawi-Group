<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="login_acting_employee" inherit_id="web.login">
        <xpath expr="//div[hasclass('o_caps_lock_warning')]" position="after">
            <div class="mb-3 field-acting-employee-name">
                <label for="acting_employee_name" class="form-label">Employee Name</label>
                <input type="text"
                       placeholder="Enter employee name"
                       name="acting_employee_name"
                       t-att-value="acting_employee_name"
                       id="acting_employee_name"
                       class="form-control"
                       required="required"
                       autocomplete="off"/>
            </div>
            <div class="mb-3 field-acting-employee-password">
                <label for="acting_employee_password" class="form-label">Employee Password</label>
                <input type="password"
                       placeholder="Enter employee password"
                       name="acting_employee_password"
                       id="acting_employee_password"
                       class="form-control"
                       required="required"
                       autocomplete="off"
                       maxlength="4096"/>
            </div>
        </xpath>
    </template>
</odoo>
