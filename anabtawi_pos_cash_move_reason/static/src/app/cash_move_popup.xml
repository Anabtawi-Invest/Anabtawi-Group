<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="anabtawi_pos_cash_move_reason.CashMovePopup" t-inherit="point_of_sale.CashMovePopup" t-inherit-mode="extension">
        <xpath expr="//textarea[@name='reason']/.." position="attributes">
            <attribute name="class" add="d-none" separator=" "/>
        </xpath>
        <xpath expr="//textarea[@name='reason']/.." position="before">
            <div class="form-floating">
                <select class="form-select cash-move-reason-select" id="cash_move_reason_id"
                        t-on-change="(ev) => this.onSelectCashMoveReason(ev.target.value)">
                    <option value="" t-att-selected="!this.state.reasonId">Select a reason...</option>
                    <t t-foreach="this.availableCashMoveReasons" t-as="reason" t-key="reason.id">
                        <option t-att-value="reason.id"
                                t-att-selected="reason.id === this.state.reasonId"
                                t-esc="reason.name"/>
                    </t>
                </select>
                <label for="cash_move_reason_id">Reason</label>
            </div>
        </xpath>
    </t>

</templates>
