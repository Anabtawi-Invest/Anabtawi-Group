<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_pos_cash_move_reason_list" model="ir.ui.view">
        <field name="name">pos.cash.move.reason.list</field>
        <field name="model">pos.cash.move.reason</field>
        <field name="arch" type="xml">
            <list string="Cash In/Out Reasons" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="move_type"/>
                <field name="pos_config_ids" widget="many2many_tags" placeholder="All"/>
                <field name="company_id" groups="base.group_multi_company" placeholder="All"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="view_pos_cash_move_reason_search" model="ir.ui.view">
        <field name="name">pos.cash.move.reason.search</field>
        <field name="model">pos.cash.move.reason</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="pos_config_ids"/>
                <filter name="filter_in" string="Cash In" domain="[('move_type', 'in', ('in', 'both'))]"/>
                <filter name="filter_out" string="Cash Out" domain="[('move_type', 'in', ('out', 'both'))]"/>
                <separator/>
                <filter name="inactive" string="Archived" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_pos_cash_move_reason" model="ir.actions.act_window">
        <field name="name">Cash In/Out Reasons</field>
        <field name="res_model">pos.cash.move.reason</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a Cash In/Out reason
            </p><p>
                Reasons defined here can be selected in the POS Cash In/Out popup.
            </p>
        </field>
    </record>

    <menuitem id="menu_pos_cash_move_reason"
              parent="point_of_sale.menu_point_config_product"
              action="action_pos_cash_move_reason"
              groups="point_of_sale.group_pos_manager"
              sequence="12"/>

</odoo>
