<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_inventory_backdate" model="ir.module.category">
        <field name="name">Inventory Backdate</field>
        <field name="description">Controls who can mass-backdate validated stock transfers.</field>
        <field name="sequence">20</field>
    </record>

    <record id="privilege_inventory_backdate" model="res.groups.privilege">
        <field name="name">Inventory Backdate</field>
        <field name="category_id" ref="module_category_inventory_backdate"/>
        <field name="sequence">20</field>
    </record>

    <record id="group_inventory_backdate_manager" model="res.groups">
        <field name="name">Inventory Backdate Manager</field>
        <field name="privilege_id" ref="privilege_inventory_backdate"/>
        <field name="implied_ids" eval="[(4, ref('stock.group_stock_manager'))]"/>
        <field name="comment">Users who can mass-backdate validated (Done) stock transfers and, optionally, their linked accounting entries.</field>
    </record>
</odoo>
