<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_stock_backdate_wizard_form" model="ir.ui.view">
        <field name="name">stock.backdate.wizard.form</field>
        <field name="model">stock.backdate.wizard</field>
        <field name="arch" type="xml">
            <form string="Mass Backdate">
                <group>
                    <field name="new_date"/>
                    <field name="reason" placeholder="Why are these transfers being backdated?"/>
                    <field name="recalculate_valuation"/>
                    <field name="filter_domain"/>
                    <field name="matched_count"/>
                </group>
                <div class="alert alert-warning" role="alert"
                     invisible="matched_count">
                    No 'Done' transfers match this filter. Nothing will be backdated.
                </div>
                <footer>
                    <button name="action_apply_backdate" type="object"
                            string="Apply Mass Backdate" class="btn-primary"
                            invisible="not matched_count"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_stock_backdate_wizard" model="ir.actions.act_window">
        <field name="name">Mass Backdate</field>
        <field name="res_model">stock.backdate.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_stock_backdate_wizard"
              name="Mass Backdate"
              parent="stock.menu_stock_config_settings"
              action="action_stock_backdate_wizard"
              groups="group_inventory_backdate_manager"
              sequence="99"/>

    <record id="action_stock_backdate_selected" model="ir.actions.server">
        <field name="name">Backdate Selected Transfers</field>
        <field name="model_id" ref="stock.model_stock_picking"/>
        <field name="binding_model_id" ref="stock.model_stock_picking"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">action = records.action_open_backdate_wizard()</field>
        <field name="group_ids" eval="[(4, ref('group_inventory_backdate_manager'))]"/>
    </record>
</odoo>
