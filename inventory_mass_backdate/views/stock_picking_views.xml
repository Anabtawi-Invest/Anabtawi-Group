<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_form_backdate" model="ir.ui.view">
        <field name="name">stock.picking.form.backdate</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="groups_id" eval="[(4, ref('group_inventory_backdate_manager'))]"/>
        <field name="arch" type="xml">
            <field name="date_done" position="after">
                <field name="original_date_done" invisible="not original_date_done"/>
                <field name="backdated_by" invisible="not backdated_by"/>
                <field name="backdate_reason" invisible="not backdate_reason"/>
            </field>
        </field>
    </record>
</odoo>
