<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pos_category_form_view_hidden" model="ir.ui.view">
        <field name="name">pos.category.form.hidden</field>
        <field name="model">pos.category</field>
        <field name="inherit_id">point_of_sale.product_pos_category_form_view</field>
        <field name="arch" type="xml">
            <field name="parent_id" position="after">
                <field name="hide_in_pos_ui"/>
            </field>
        </field>
    </record>

    <record id="pos_category_list_view_hidden" model="ir.ui.view">
        <field name="name">pos.category.list.hidden</field>
        <field name="model">pos.category</field>
        <field name="inherit_id">point_of_sale.product_pos_category_tree_view</field>
        <field name="arch" type="xml">
            <field name="color" position="after">
                <field name="hide_in_pos_ui" optional="show"/>
            </field>
        </field>
    </record>
</odoo>
