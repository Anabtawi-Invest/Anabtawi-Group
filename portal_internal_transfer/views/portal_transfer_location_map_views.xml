<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_portal_transfer_location_map_list" model="ir.ui.view">
        <field name="name">portal.transfer.location.map.list</field>
        <field name="model">portal.transfer.location.map</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="user_id"/>
                <field name="location_id"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
                <field name="active" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_portal_transfer_location_map_form" model="ir.ui.view">
        <field name="name">portal.transfer.location.map.form</field>
        <field name="model">portal.transfer.location.map</field>
        <field name="arch" type="xml">
            <form string="Portal Source Location Mapping">
                <sheet>
                    <group>
                        <field name="user_id"/>
                        <field name="location_id"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_portal_transfer_location_map" model="ir.actions.act_window">
        <field name="name">Portal Source Locations</field>
        <field name="res_model">portal.transfer.location.map</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Map each portal user to a fixed source location.
            </p>
            <p>
                When a portal user creates an internal transfer, the source location is taken from this mapping.
            </p>
        </field>
    </record>

    <menuitem id="menu_portal_transfer_location_map"
              name="Portal Source Locations"
              parent="stock.menu_warehouse_config"
              action="action_portal_transfer_location_map"
              groups="stock.group_stock_manager"
              sequence="90"/>
</odoo>
