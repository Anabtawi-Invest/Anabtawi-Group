<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_pfr_alloc_rate_wizard_form" model="ir.ui.view">
        <field name="name">pfr.alloc.rate.wizard.form</field>
        <field name="model">pfr.alloc.rate.wizard</field>
        <field name="arch" type="xml">
            <form string="Repair Allocation Rates">
                <div class="alert alert-info" role="alert">
                    Updates Extra Hours and Paid Time Off reconciliation allocations for confirmed
                    payslips in the date range.
                    Extra Hours = Remaining Extra Hours Balance x 1.25.
                    Paid Time Off = Remaining Paid Time Off Available x 1.5.
                    Payslips are not cancelled, set to draft, or recomputed. Work runs in batches in the background.
                </div>
                <group>
                    <group>
                        <field name="date_from"/>
                        <field name="date_to"/>
                    </group>
                    <group>
                        <field name="batch_size"/>
                        <field name="payslip_count" readonly="1"/>
                    </group>
                </group>
                <footer>
                    <button name="action_start" type="object" string="Start in background" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_pfr_alloc_rate_line_list" model="ir.ui.view">
        <field name="name">pfr.alloc.rate.line.list</field>
        <field name="model">pfr.alloc.rate.line</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0"
                  decoration-danger="state == 'error'"
                  decoration-muted="state == 'pending'"
                  decoration-warning="state == 'skipped'"
                  decoration-success="state == 'done'">
                <field name="state"/>
                <field name="company_id"/>
                <field name="employee_id"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="payslip_name"/>
                <field name="payslip_id"/>
                <field name="error"/>
            </list>
        </field>
    </record>

    <record id="view_pfr_alloc_rate_batch_list" model="ir.ui.view">
        <field name="name">pfr.alloc.rate.batch.list</field>
        <field name="model">pfr.alloc.rate.batch</field>
        <field name="arch" type="xml">
            <list create="0">
                <field name="name"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="state"/>
                <field name="done_count"/>
                <field name="error_count"/>
                <field name="skipped_count"/>
                <field name="pending_count"/>
            </list>
        </field>
    </record>

    <record id="view_pfr_alloc_rate_batch_form" model="ir.ui.view">
        <field name="name">pfr.alloc.rate.batch.form</field>
        <field name="model">pfr.alloc.rate.batch</field>
        <field name="arch" type="xml">
            <form string="Allocation Rate Repair" create="0">
                <header>
                    <button name="action_refresh" type="object" string="Refresh" class="btn-primary"
                            invisible="state != 'running'"/>
                    <button name="action_cancel" type="object" string="Cancel remaining"
                            invisible="state != 'running'"/>
                    <field name="state" widget="statusbar" statusbar_visible="running,done"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_errors" type="object" class="oe_stat_button" icon="fa-exclamation-triangle">
                            <field name="error_count" widget="statinfo" string="Errors"/>
                        </button>
                        <button name="action_view_pending" type="object" class="oe_stat_button" icon="fa-clock-o">
                            <field name="pending_count" widget="statinfo" string="Pending"/>
                        </button>
                        <button name="action_view_skipped" type="object" class="oe_stat_button" icon="fa-ban">
                            <field name="skipped_count" widget="statinfo" string="Skipped"/>
                        </button>
                        <button class="oe_stat_button" icon="fa-check" disabled="1">
                            <field name="done_count" widget="statinfo" string="Done"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="date_from" readonly="1"/>
                            <field name="date_to" readonly="1"/>
                        </group>
                        <group>
                            <field name="batch_size" readonly="1"/>
                            <field name="payslip_count" readonly="1"/>
                        </group>
                    </group>
                    <field name="line_ids" readonly="1">
                        <list decoration-danger="state == 'error'"
                              decoration-muted="state == 'pending'"
                              decoration-warning="state == 'skipped'"
                              decoration-success="state == 'done'">
                            <field name="state"/>
                            <field name="company_id"/>
                            <field name="employee_id"/>
                            <field name="date_from"/>
                            <field name="date_to"/>
                            <field name="payslip_name"/>
                            <field name="payslip_id"/>
                            <field name="error"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_pfr_alloc_rate_wizard" model="ir.actions.act_window">
        <field name="name">Repair Allocation Rates</field>
        <field name="res_model">pfr.alloc.rate.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="action_pfr_alloc_rate_batch" model="ir.actions.act_window">
        <field name="name">Allocation Rate Batches</field>
        <field name="res_model">pfr.alloc.rate.batch</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_pfr_alloc_rate"
              name="Repair Allocation Rates"
              parent="hr_payroll.menu_hr_payroll_payslips"
              action="action_pfr_alloc_rate_wizard"
              groups="hr_payroll.group_hr_payroll_manager"
              sequence="92"/>

    <menuitem id="menu_pfr_alloc_rate_batch"
              name="Allocation Rate Batches"
              parent="hr_payroll.menu_hr_payroll_payslips"
              action="action_pfr_alloc_rate_batch"
              groups="hr_payroll.group_hr_payroll_manager"
              sequence="93"/>

</odoo>
