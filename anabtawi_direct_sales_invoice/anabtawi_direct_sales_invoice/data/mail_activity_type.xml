<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="mail_activity_direct_warehouse_approval" model="mail.activity.type">
        <field name="name">Direct Sales Warehouse Approval</field>
        <field name="summary">Review and approve the warehouse request</field>
        <field name="res_model">direct.sales.invoice</field>
        <field name="icon">fa-check-square-o</field>
        <field name="delay_count">0</field>
        <field name="delay_unit">days</field>
    </record>
    <record id="mail_activity_direct_stock_preparation" model="mail.activity.type">
        <field name="name">Direct Sales Stock Preparation</field>
        <field name="summary">Prepare approved goods for pickup</field>
        <field name="res_model">direct.sales.invoice</field>
        <field name="icon">fa-cubes</field>
        <field name="delay_count">0</field>
        <field name="delay_unit">days</field>
    </record>
    <record id="mail_activity_direct_accounting_review" model="mail.activity.type">
        <field name="name">Direct Sales Accounting Review</field>
        <field name="summary">Review and post the customer invoice</field>
        <field name="res_model">direct.sales.invoice</field>
        <field name="icon">fa-calculator</field>
        <field name="delay_count">0</field>
        <field name="delay_unit">days</field>
    </record>
    <record id="mail_activity_direct_payment_collection" model="mail.activity.type">
        <field name="name">Direct Sales Payment Collection</field>
        <field name="summary">Collect or follow up the customer payment</field>
        <field name="res_model">direct.sales.invoice</field>
        <field name="icon">fa-money</field>
        <field name="delay_count">0</field>
        <field name="delay_unit">days</field>
    </record>
</odoo>
