<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_users_form_direct_sales" model="ir.ui.view">
        <field name="name">res.users.form.direct.sales</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Direct Sales &amp; Cash Custodian" name="direct_sales_page">
                    <group>
                        <group string="Channel Configuration">
                            <field name="direct_sales_channel_type"/>
                            <field name="direct_sales_warehouse_ids" widget="many2many_tags"/>
                        </group>
                        <group string="Cash Custodian Wallet">
                            <field name="salesperson_cash_journal_id"/>
                            <field name="cash_wallet_balance" widget="monetary"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
