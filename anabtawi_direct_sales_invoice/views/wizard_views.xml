<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_direct_sales_warehouse_approval_wizard" model="ir.ui.view">
        <field name="name">direct.sales.warehouse.approval.wizard.form</field>
        <field name="model">direct.sales.warehouse.approval.wizard</field>
        <field name="arch" type="xml">
            <form string="Approve Warehouse Request">
                <group>
                    <field name="direct_invoice_id"/>
                    <field name="warehouse_comment" placeholder="Optional warehouse comment..."/>
                </group>
                <footer>
                    <button name="action_approve" type="object" string="Approve All" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_direct_sales_partial_approval_wizard" model="ir.ui.view">
        <field name="name">direct.sales.partial.approval.wizard.form</field>
        <field name="model">direct.sales.partial.approval.wizard</field>
        <field name="arch" type="xml">
            <form string="Partial Warehouse Approval">
                <group>
                    <field name="direct_invoice_id"/>
                </group>
                <field name="line_ids">
                    <list editable="bottom" create="0" delete="0">
                        <field name="product_id"/>
                        <field name="requested_quantity"/>
                        <field name="free_quantity"/>
                        <field name="forecast_quantity"/>
                        <field name="approved_quantity"/>
                        <field name="shortage_quantity" readonly="True"/>
                        <field name="product_uom_id"/>
                    </list>
                </field>
                <group>
                    <field name="warehouse_comment" placeholder="Explain shortages or partial quantities..."/>
                </group>
                <footer>
                    <button name="action_apply" type="object" string="Apply Partial Approval" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_direct_sales_rejection_wizard" model="ir.ui.view">
        <field name="name">direct.sales.rejection.wizard.form</field>
        <field name="model">direct.sales.rejection.wizard</field>
        <field name="arch" type="xml">
            <form string="Reject Warehouse Request">
                <group>
                    <field name="direct_invoice_id"/>
                    <field name="rejection_reason" placeholder="Required reason visible in the internal audit trail..."/>
                </group>
                <footer>
                    <button name="action_reject" type="object" string="Reject Request" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_direct_sales_goods_release_wizard" model="ir.ui.view">
        <field name="name">direct.sales.goods.release.wizard.form</field>
        <field name="model">direct.sales.goods.release.wizard</field>
        <field name="arch" type="xml">
            <form string="Confirm Goods Release">
                <group>
                    <field name="direct_invoice_id"/>
                    <field name="customer_receiver_name" placeholder="Name of the person collecting the goods"/>
                    <field name="payment_clearance_required"/>
                    <field name="payment_state" widget="badge"/>
                </group>
                <div class="alert alert-warning" role="alert" invisible="not payment_clearance_required or payment_state == 'paid'">
                    Full reconciled payment is required before this cash sale can be released.
                </div>
                <footer>
                    <button name="action_release" type="object" string="Validate Release" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
