<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_direct_sales_invoice_list" model="ir.ui.view">
        <field name="name">direct.sales.invoice.list</field>
        <field name="model">direct.sales.invoice</field>
        <field name="arch" type="xml">
            <list
                string="Direct Invoices"
                decoration-warning="state == 'warehouse_pending'"
                decoration-success="state in ('warehouse_approved', 'ready', 'released', 'completed')"
                decoration-danger="state in ('rejected', 'cancelled')"
                decoration-info="state == 'partially_approved'"
                multi_edit="0">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="user_id" widget="many2one_avatar_user"/>
                <field name="warehouse_id"/>
                <field name="amount_total" sum="Total"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="payment_term_id" optional="show"/>
                <field name="state" widget="badge"/>
                <field name="invoice_id" optional="show"/>
                <field name="payment_state" widget="badge" optional="show"/>
                <field name="requested_date"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_direct_sales_invoice_warehouse_list" model="ir.ui.view">
        <field name="name">direct.sales.invoice.warehouse.list</field>
        <field name="model">direct.sales.invoice</field>
        <field name="arch" type="xml">
            <list
                string="Warehouse Requests"
                decoration-warning="state == 'warehouse_pending'"
                decoration-info="state == 'partially_approved'"
                decoration-success="state in ('warehouse_approved', 'ready')"
                decoration-danger="state == 'rejected'">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="warehouse_id"/>
                <field name="requested_date"/>
                <field name="product_count"/>
                <field name="requested_quantity" sum="Requested"/>
                <field name="approved_quantity" sum="Approved"/>
                <field name="available_status" widget="badge"/>
                <field name="state" widget="badge"/>
                <field name="user_id" widget="many2one_avatar_user"/>
            </list>
        </field>
    </record>

    <record id="view_direct_sales_invoice_ready_list" model="ir.ui.view">
        <field name="name">direct.sales.invoice.ready.list</field>
        <field name="model">direct.sales.invoice</field>
        <field name="arch" type="xml">
            <list string="Ready for Pickup" decoration-success="state == 'ready'">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="warehouse_id"/>
                <field name="picking_count"/>
                <field name="invoice_id"/>
                <field name="payment_clearance_required"/>
                <field name="payment_state" widget="badge"/>
                <field name="ready_date"/>
                <field name="user_id" widget="many2one_avatar_user"/>
            </list>
        </field>
    </record>

    <record id="view_direct_sales_invoice_search" model="ir.ui.view">
        <field name="name">direct.sales.invoice.search</field>
        <field name="model">direct.sales.invoice</field>
        <field name="arch" type="xml">
            <search string="Search Direct Invoices">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="warehouse_id"/>
                <field name="user_id"/>
                <field name="team_id"/>
                <field name="pricelist_id"/>
                <field name="payment_term_id"/>
                <field name="invoice_id"/>
                <separator/>
                <filter name="my_documents" string="My Documents" domain="[('user_id', '=', uid)]"/>
                <filter name="my_team" string="My Sales Team" domain="['|', ('team_id.user_id', '=', uid), ('team_id.member_ids', 'in', [uid])]"/>
                <separator/>
                <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="warehouse_pending" string="Waiting Warehouse Approval" domain="[('state', '=', 'warehouse_pending')]"/>
                <filter name="partially_approved" string="Partially Approved" domain="[('state', '=', 'partially_approved')]"/>
                <filter name="warehouse_approved" string="Approved" domain="[('state', '=', 'warehouse_approved')]"/>
                <filter name="ready" string="Ready for Pickup" domain="[('state', '=', 'ready')]"/>
                <filter name="released" string="Released" domain="[('state', '=', 'released')]"/>
                <filter name="completed" string="Completed" domain="[('state', '=', 'completed')]"/>
                <filter name="rejected" string="Rejected" domain="[('state', '=', 'rejected')]"/>
                <separator/>
                <filter name="paid" string="Paid" domain="[('payment_state', '=', 'paid')]"/>
                <filter name="unpaid" string="Unpaid" domain="[('invoice_id', '!=', False), ('payment_state', 'not in', ('paid', 'reversed'))]"/>
                <filter name="overdue" string="Overdue" domain="[('due_date', '&lt;', context_today()), ('amount_residual', '&gt;', 0)]"/>
                <filter name="cash_sale" string="Cash Sales" domain="[('is_cash_sale', '=', True)]"/>
                <filter name="credit_sale" string="Credit Sales" domain="[('is_cash_sale', '=', False)]"/>
                <filter name="price_override" string="Manual Price Overrides" domain="[('manual_price_override', '=', True)]"/>
                <separator/>
                <filter name="invoice_date" string="Invoice Date" date="invoice_date"/>
                <filter name="requested_date" string="Requested Date" date="requested_date"/>
                <group>
                    <filter name="group_customer" string="Customer" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_warehouse" string="Warehouse" context="{'group_by': 'warehouse_id'}"/>
                    <filter name="group_salesperson" string="Salesperson" context="{'group_by': 'user_id'}"/>
                    <filter name="group_team" string="Sales Team" context="{'group_by': 'team_id'}"/>
                    <filter name="group_pricelist" string="Pricelist" context="{'group_by': 'pricelist_id'}"/>
                    <filter name="group_state" string="State" context="{'group_by': 'state'}"/>
                    <filter name="group_payment_term" string="Payment Terms" context="{'group_by': 'payment_term_id'}"/>
                    <filter name="group_payment_state" string="Payment Status" context="{'group_by': 'payment_state'}"/>
                    <filter name="group_month" string="Requested Month" context="{'group_by': 'requested_date:month'}"/>
                    <filter name="group_company" string="Company" context="{'group_by': 'company_id'}" groups="base.group_multi_company"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_direct_sales_invoice_line_form" model="ir.ui.view">
        <field name="name">direct.sales.invoice.line.form</field>
        <field name="model">direct.sales.invoice.line</field>
        <field name="arch" type="xml">
            <form string="Direct Invoice Product">
                <sheet>
                    <group>
                        <group>
                            <field name="direct_invoice_id" readonly="True"/>
                            <field name="product_id" readonly="state != 'draft'"/>
                            <field name="name" readonly="state != 'draft'"/>
                            <field name="product_uom_id" readonly="state != 'draft'"/>
                            <field name="quantity" readonly="state != 'draft'"/>
                            <field name="approved_quantity" readonly="True"/>
                            <field name="released_quantity" readonly="True"/>
                            <field name="warehouse_status" readonly="True"/>
                        </group>
                        <group>
                            <field name="original_pricelist_price" readonly="True"/>
                            <field name="price_unit" readonly="state != 'draft'"/>
                            <field name="discount" readonly="state != 'draft'"/>
                            <field name="tax_ids" widget="many2many_tags" readonly="state != 'draft'"/>
                            <field name="price_override_reason" readonly="state != 'draft' or not price_overridden"/>
                            <field name="price_override_state" readonly="True"/>
                            <field name="price_override_approved_by" readonly="True"/>
                            <field name="analytic_distribution" widget="analytic_distribution" readonly="state != 'draft'"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Stock Availability">
                            <group>
                                <field name="on_hand_quantity"/>
                                <field name="free_quantity"/>
                                <field name="reserved_quantity"/>
                                <field name="forecast_quantity"/>
                                <field name="incoming_quantity"/>
                                <field name="outgoing_quantity"/>
                                <field name="shortage_quantity"/>
                                <field name="availability_state" widget="badge"/>
                            </group>
                        </page>
                        <page string="Warehouse Allocations">
                            <field name="allocation_ids" readonly="state != 'draft'">
                                <list editable="bottom">
                                    <field name="warehouse_id"/>
                                    <field name="source_location_id"/>
                                    <field name="requested_quantity"/>
                                    <field name="available_quantity" readonly="True"/>
                                    <field name="approved_quantity" readonly="True"/>
                                    <field name="released_quantity" readonly="True"/>
                                    <field name="state" readonly="True" widget="badge"/>
                                </list>
                            </field>
                        </page>
                        <page string="Traceability">
                            <field name="lot_ids" widget="many2many_tags" readonly="True"/>
                            <field name="stock_move_ids" readonly="True">
                                <list>
                                    <field name="reference"/>
                                    <field name="picking_id"/>
                                    <field name="location_id"/>
                                    <field name="location_dest_id"/>
                                    <field name="quantity"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_direct_sales_invoice_form" model="ir.ui.view">
        <field name="name">direct.sales.invoice.form</field>
        <field name="model">direct.sales.invoice</field>
        <field name="arch" type="xml">
            <form string="Direct Sales Invoice">
                <header>
                    <button
                        name="action_submit_to_warehouse"
                        type="object"
                        string="Submit to Warehouse"
                        class="btn-primary"
                        groups="anabtawi_direct_sales_invoice.group_direct_invoice_user"
                        invisible="state != 'draft'"/>
                    <button
                        name="action_approve_sales_manager"
                        type="object"
                        string="Approve Order"
                        class="btn-success"
                        groups="anabtawi_direct_sales_invoice.group_direct_invoice_sales_manager"
                        invisible="state != 'sales_manager_pending'"/>
                    <button
                        name="action_open_rejection_wizard"
                        type="object"
                        string="Reject Order"
                        class="btn-danger"
                        groups="anabtawi_direct_sales_invoice.group_direct_invoice_sales_manager"
                        invisible="state != 'sales_manager_pending'"/>
                    <button
                        name="action_confirm_receiving"
                        type="object"
                        string="Confirm Receiving"
                        class="btn-primary"
                        groups="anabtawi_direct_sales_invoice.group_direct_invoice_user"
                        invisible="state not in ('warehouse_approved', 'partially_approved')"/>
                    <button
                        name="action_send_email"
                        type="object"
                        string="Send Email"
                        icon="fa-envelope"
                        invisible="is_warehouse_request"/>
                    <button
                        name="action_print_pdf"
                        type="object"
                        string="Print PDF"
                        icon="fa-print"
                        invisible="is_warehouse_request"/>
                    <button
                        name="action_open_approval_wizard"
                        type="object"
                        string="Approve"
                        class="btn-primary"
                        groups="anabtawi_direct_sales_invoice.group_direct_invoice_warehouse_manager"
                        invisible="state != 'warehouse_pending'"/>
                    <button
                        name="action_open_partial_approval_wizard"
                        type="object"
                        string="Partially Approve"
                        groups="anabtawi_direct_sales_invoice.group_direct_invoice_warehouse_manager"
                        invisible="state != 'warehouse_pending'"/>
                    <button
                        name="action_open_rejection_wizard"
                        type="object"
                        string="Reject"
                        groups="anabtawi_direct_sales_invoice.group_direct_invoice_warehouse_manager"
                        invisible="state != 'warehouse_pending'"/>
                    <button
                        name="action_prepare_goods"
                        type="object"
                        string="Prepare Goods"
                        class="btn-primary"
                        groups="anabtawi_direct_sales_invoice.group_direct_invoice_warehouse_user"
                        invisible="state not in ('warehouse_approved', 'partially_approved')"/>
                    <button
                        name="action_open_goods_release_wizard"
                        type="object"
                        string="Confirm Goods Release"
                        class="btn-primary"
                        groups="anabtawi_direct_sales_invoice.group_direct_invoice_warehouse_user"
                        invisible="state != 'ready'"/>
                    <button
                        name="action_approve_price_overrides"
                        type="object"
                        string="Approve Price Overrides"
                        groups="anabtawi_direct_sales_invoice.group_direct_invoice_sales_manager"
                        invisible="state != 'draft' or not manual_price_override"/>
                    <button
                        name="action_create_invoice"
                        type="object"
                        string="Create Invoice"
                        groups="anabtawi_direct_sales_invoice.group_direct_invoice_accounting_user"
                        invisible="invoice_id or state not in ('warehouse_approved', 'partially_approved', 'ready', 'released')"/>
                    <button
                        name="action_register_payment"
                        type="object"
                        string="Register Payment"
                        groups="anabtawi_direct_sales_invoice.group_direct_invoice_accounting_user"
                        invisible="not invoice_id or invoice_status != 'posted' or payment_state in ('paid', 'reversed')"/>
                    <button
                        name="action_reset_to_draft"
                        type="object"
                        string="Reset to Draft"
                        groups="anabtawi_direct_sales_invoice.group_direct_invoice_sales_manager"
                        invisible="state not in ('rejected', 'cancelled')"/>
                    <button
                        name="action_create_return"
                        type="object"
                        string="Create Return"
                        groups="anabtawi_direct_sales_invoice.group_direct_invoice_warehouse_manager"
                        invisible="state not in ('released', 'completed')"/>
                    <button
                        name="action_create_credit_note"
                        type="object"
                        string="Create Credit Note"
                        groups="anabtawi_direct_sales_invoice.group_direct_invoice_accounting_user"
                        invisible="not invoice_id or invoice_status != 'posted'"/>
                    <button
                        name="action_cancel"
                        type="object"
                        string="Cancel"
                        invisible="state in ('cancelled', 'released', 'completed')"/>
                    <field
                        name="state"
                        widget="statusbar"
                        statusbar_visible="draft,sales_manager_pending,warehouse_pending,ready,released,completed"/>
                </header>
                <sheet>
                    <div class="alert alert-danger mb-3" role="alert" invisible="state != 'rejected'">
                        <strong>Order Rejected:</strong> <field name="rejection_reason" readonly="1" class="d-inline"/>
                    </div>
                    <field name="company_id" invisible="True"/>
                    <field name="currency_id" invisible="True"/>
                    <field name="allowed_warehouse_ids" invisible="True"/>
                    <field name="invoice_status" invisible="True"/>
                    <field name="manual_price_override" invisible="True"/>
                    <field name="is_warehouse_request" invisible="True"/>
                    <div class="oe_button_box" name="button_box">
                        <button
                            name="action_view_invoice"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-file-text-o"
                            invisible="invoice_count == 0">
                            <field name="invoice_count" widget="statinfo" string="Customer Invoice"/>
                        </button>
                        <button
                            name="action_view_pickings"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-truck"
                            invisible="picking_count == 0">
                            <field name="picking_count" widget="statinfo" string="Pickings"/>
                        </button>
                        <button
                            name="action_view_stock_moves"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-exchange"
                            invisible="stock_move_count == 0">
                            <field name="stock_move_count" widget="statinfo" string="Stock Moves"/>
                        </button>
                        <button
                            name="action_view_payments"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-money"
                            invisible="payment_count == 0">
                            <field name="payment_count" widget="statinfo" string="Payments"/>
                        </button>
                        <button
                            name="action_view_approvals"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-check-square-o"
                            invisible="approval_count == 0">
                            <field name="approval_count" widget="statinfo" string="Approvals"/>
                        </button>
                        <button
                            name="action_view_attachments"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-paperclip">
                            <field name="attachment_count" widget="statinfo" string="Attachments"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name" string="Warehouse Replenishment Request" invisible="not is_warehouse_request"/>
                        <label for="name" string="Direct Invoice" invisible="is_warehouse_request"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group string="Warehouse Request Info" invisible="not is_warehouse_request">
                            <field name="user_id" string="Requested By" widget="many2one_avatar_user" readonly="state != 'draft'"/>
                            <field name="warehouse_id" string="Destination Warehouse / Van" readonly="state != 'draft'"/>
                            <field name="source_location_id" string="Source Stock Location" readonly="state != 'draft'"/>
                            <field name="requested_date"/>
                        </group>
                        <group string="Customer &amp; Sales Info" invisible="is_warehouse_request">
                            <field name="partner_id" required="not is_warehouse_request" readonly="state != 'draft'"/>
                            <field name="commercial_partner_id" invisible="True"/>
                            <field name="user_id" widget="many2one_avatar_user" readonly="state != 'draft'"/>
                            <field name="warehouse_id" string="Pickup Warehouse / Van" readonly="state != 'draft'"/>
                        </group>
                        <group string="Payment &amp; Terms" invisible="is_warehouse_request">
                            <field name="pricelist_id" invisible="True"/>
                            <field name="is_cash_sale" invisible="True"/>
                            <field name="payment_term_id" string="Payment Terms" readonly="state != 'draft'"/>
                            <field name="invoice_date" readonly="state != 'draft'"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Products" name="products">
                            <field name="line_ids" mode="list,form" readonly="state != 'draft'">
                                <list
                                    editable="bottom"
                                    decoration-success="availability_state == 'available'"
                                    decoration-warning="availability_state == 'partial'"
                                    decoration-danger="availability_state == 'unavailable'">
                                    <field name="sequence" widget="handle"/>
                                    <field name="product_id"/>
                                    <field name="name" optional="hide"/>
                                    <field name="quantity"/>
                                    <field name="approved_quantity" readonly="True"/>
                                    <field name="released_quantity" readonly="True"/>
                                    <field name="product_uom_id"/>
                                    <field name="free_quantity" readonly="True"/>
                                    <field name="forecast_quantity" readonly="True" optional="show"/>
                                    <field name="shortage_quantity" readonly="True" optional="show"/>
                                    <field name="availability_state" readonly="True" widget="badge"/>
                                    <field name="price_unit" readonly="True" column_invisible="parent.is_warehouse_request"/>
                                    <field name="discount" column_invisible="parent.is_warehouse_request"/>
                                    <field name="tax_ids" widget="many2many_tags" optional="show" column_invisible="parent.is_warehouse_request"/>
                                    <field name="price_subtotal" readonly="True" sum="Untaxed" column_invisible="parent.is_warehouse_request"/>
                                    <field name="currency_id" column_invisible="True"/>
                                    <field name="price_overridden" readonly="True" optional="show" column_invisible="parent.is_warehouse_request"/>
                                    <field name="price_override_reason" optional="hide" column_invisible="parent.is_warehouse_request"/>
                                    <field name="price_override_state" readonly="True" widget="badge" optional="show" column_invisible="parent.is_warehouse_request"/>
                                    <field name="warehouse_status" readonly="True" widget="badge"/>
                                </list>
                            </field>
                            <group class="oe_subtotal_footer oe_right" invisible="is_warehouse_request">
                                <field name="amount_untaxed" widget="monetary"/>
                                <field name="amount_tax" widget="monetary"/>
                                <field name="amount_total" widget="monetary" class="oe_subtotal_footer_separator"/>
                            </group>
                        </page>
                        <page string="Warehouse" name="warehouse" groups="anabtawi_direct_sales_invoice.group_direct_invoice_admin">
                            <group>
                                <group>
                                    <field name="warehouse_id" readonly="True"/>
                                    <field name="source_location_id" readonly="True"/>
                                    <field name="dispatch_location_id" readonly="True"/>
                                    <field name="stock_flow" readonly="True"/>
                                    <field name="warehouse_approved_by" widget="many2one_avatar_user"/>
                                    <field name="warehouse_approved_at"/>
                                </group>
                                <group>
                                    <field name="ready_date"/>
                                    <field name="released_by" widget="many2one_avatar_user"/>
                                    <field name="released_at"/>
                                    <field name="customer_receiver_name"/>
                                    <field name="warehouse_comment" readonly="state not in ('warehouse_pending', 'partially_approved', 'warehouse_approved')"/>
                                    <field name="rejection_reason" invisible="not rejection_reason"/>
                                </group>
                            </group>
                            <field name="picking_ids" readonly="True">
                                <list>
                                    <field name="name"/>
                                    <field name="direct_sales_stage" widget="badge"/>
                                    <field name="direct_sales_warehouse_id"/>
                                    <field name="location_id"/>
                                    <field name="location_dest_id"/>
                                    <field name="state" widget="badge"/>
                                    <field name="scheduled_date"/>
                                </list>
                            </field>
                        </page>
                        <page string="Accounting" name="accounting" groups="anabtawi_direct_sales_invoice.group_direct_invoice_admin">
                            <group>
                                <group>
                                    <field name="invoice_id"/>
                                    <field name="invoice_status" widget="badge"/>
                                    <field name="payment_state" widget="badge"/>
                                    <field name="payment_term_id" readonly="True"/>
                                    <field name="due_date"/>
                                </group>
                                <group>
                                    <field name="amount_residual"/>
                                    <field name="amount_paid"/>
                                    <field name="is_cash_sale" readonly="True"/>
                                    <field name="payment_clearance_required"/>
                                    <field name="payment_cleared"/>
                                    <field name="fiscal_position_id" readonly="True"/>
                                </group>
                            </group>
                        </page>
                        <page string="Traceability" name="traceability" groups="anabtawi_direct_sales_invoice.group_direct_invoice_admin">
                            <group>
                                <group>
                                    <field name="pricelist_id" readonly="True"/>
                                    <field name="manual_price_override"/>
                                    <field name="price_override_count"/>
                                    <field name="approval_count"/>
                                </group>
                                <group>
                                    <field name="warehouse_approved_by"/>
                                    <field name="warehouse_approved_at"/>
                                    <field name="released_by"/>
                                    <field name="released_at"/>
                                </group>
                            </group>
                            <field name="allocation_ids" readonly="True">
                                <list>
                                    <field name="product_id"/>
                                    <field name="warehouse_id"/>
                                    <field name="source_location_id"/>
                                    <field name="requested_quantity"/>
                                    <field name="approved_quantity"/>
                                    <field name="released_quantity"/>
                                    <field name="picking_id"/>
                                    <field name="stock_move_id"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                        <page string="Warehouse &amp; Technical" name="technical" groups="anabtawi_direct_sales_invoice.group_direct_invoice_admin">
                            <group>
                                <group string="Stock Details">
                                    <field name="source_location_id" readonly="state != 'draft'"/>
                                    <field name="dispatch_location_id" readonly="state != 'draft' or stock_flow == 'direct_delivery'"/>
                                    <field name="stock_flow" readonly="state != 'draft'"/>
                                    <field name="requested_date"/>
                                </group>
                                <group string="Organization">
                                    <field name="team_id" readonly="state != 'draft'"/>
                                    <field name="company_id" groups="base.group_multi_company" readonly="state != 'draft'"/>
                                </group>
                            </group>
                        </page>
                        <page string="Internal Notes" name="notes">
                            <group>
                                <field name="notes" placeholder="Internal sales and accounting notes..."/>
                                <field name="customer_note" placeholder="Note copied to the standard customer invoice..."/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_direct_sales_invoice_approval_list" model="ir.ui.view">
        <field name="name">direct.sales.invoice.approval.list</field>
        <field name="model">direct.sales.invoice.approval</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="event_date"/>
                <field name="direct_invoice_id"/>
                <field name="event" widget="badge"/>
                <field name="user_id" widget="many2one_avatar_user"/>
                <field name="state_from"/>
                <field name="state_to"/>
                <field name="note"/>
            </list>
        </field>
