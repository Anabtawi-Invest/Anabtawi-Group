                        <field name="user_id" widget="many2one_avatar_user"/>
                        <field name="event_date"/>
                        <field name="state_from"/>
                        <field name="state_to"/>
                    </group>
                    <group>
                        <field name="note"/>
                        <field name="quantity_snapshot"/>
                    </group>
                </sheet>
            </form>
        </field>
