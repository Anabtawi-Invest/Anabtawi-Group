<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_warehouse_form_direct_sales" model="ir.ui.view">
        <field name="name">stock.warehouse.form.direct.sales</field>
        <field name="model">stock.warehouse</field>
        <field name="inherit_id" ref="stock.view_warehouse"/>
        <field name="arch" type="xml">
            <xpath expr="//form/sheet/notebook" position="after">
                <notebook groups="anabtawi_direct_sales_invoice.group_direct_invoice_admin">
                    <page string="Direct Sales" name="direct_sales_configuration">
                        <group>
                            <group>
                                <field name="direct_sales_enabled"/>
                                <field name="direct_sales_stock_flow" required="direct_sales_enabled"/>
                                <field
                                    name="direct_sales_dispatch_location_id"
                                    required="direct_sales_enabled and direct_sales_stock_flow == 'dispatch_then_customer'"/>
                                <field
                                    name="direct_sales_operation_type_id"
                                    required="direct_sales_enabled and direct_sales_stock_flow == 'dispatch_then_customer'"/>
                            </group>
                            <group>
                                <field name="direct_sales_user_ids" widget="many2many_tags"/>
                                <field name="direct_sales_approval_user_ids" widget="many2many_tags" required="direct_sales_enabled"/>
                                <button
                                    name="action_initialize_direct_sales"
                                    type="object"
                                    string="Initialize Direct Sales Setup"
                                    class="btn-primary"
                                    invisible="direct_sales_enabled and direct_sales_dispatch_location_id and direct_sales_operation_type_id"/>
                            </group>
                        </group>
                        <div class="alert alert-info" role="alert">
                            Initialization creates a warehouse-local Sales Dispatch location and an internal preparation operation type when missing.
                        </div>
                    </page>
                </notebook>
            </xpath>
        </field>
    </record>

    <record id="view_warehouse_list_direct_sales" model="ir.ui.view">
        <field name="name">stock.warehouse.list.direct.sales</field>
        <field name="model">stock.warehouse</field>
        <field name="inherit_id" ref="stock.view_warehouse_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="direct_sales_enabled" optional="show"/>
                <field name="direct_sales_stock_flow" optional="hide"/>
                <field name="direct_sales_dispatch_location_id" optional="hide"/>
            </xpath>
        </field>
    </record>
</odoo>

