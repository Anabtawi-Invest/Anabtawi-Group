<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <record id="module_category_direct_sales" model="ir.module.category">
            <field name="name">Direct Sales</field>
            <field name="description">Warehouse-approved direct sales invoices</field>
            <field name="sequence">35</field>
        </record>
        <record id="privilege_direct_sales_commercial" model="res.groups.privilege">
            <field name="name">Direct Sales Commercial</field>
            <field name="category_id" ref="module_category_direct_sales"/>
            <field name="sequence">10</field>
        </record>
        <record id="privilege_direct_sales_warehouse" model="res.groups.privilege">
            <field name="name">Direct Sales Warehouse</field>
            <field name="category_id" ref="module_category_direct_sales"/>
            <field name="sequence">20</field>
        </record>
        <record id="privilege_direct_sales_accounting" model="res.groups.privilege">
            <field name="name">Direct Sales Accounting</field>
            <field name="category_id" ref="module_category_direct_sales"/>
            <field name="sequence">30</field>
        </record>
        <record id="privilege_direct_sales_administration" model="res.groups.privilege">
            <field name="name">Direct Sales Administration</field>
            <field name="category_id" ref="module_category_direct_sales"/>
            <field name="sequence">40</field>
        </record>

        <record id="group_direct_invoice_user" model="res.groups">
            <field name="name">Salesperson</field>
            <field name="sequence">10</field>
            <field name="privilege_id" ref="privilege_direct_sales_commercial"/>
            <field name="implied_ids" eval="[Command.link(ref('sales_team.group_sale_salesman'))]"/>
        </record>
        <record id="group_direct_invoice_salesperson" model="res.groups">
            <field name="name">Salesperson (Pre-Order Rep)</field>
            <field name="sequence">11</field>
            <field name="privilege_id" ref="privilege_direct_sales_commercial"/>
            <field name="implied_ids" eval="[Command.link(ref('group_direct_invoice_user'))]"/>
        </record>
        <record id="group_direct_invoice_cash_van" model="res.groups">
            <field name="name">Cash Van Driver</field>
            <field name="sequence">12</field>
            <field name="privilege_id" ref="privilege_direct_sales_commercial"/>
            <field name="implied_ids" eval="[Command.link(ref('group_direct_invoice_user'))]"/>
        </record>
        <record id="group_direct_invoice_sales_manager" model="res.groups">
            <field name="name">Sales Manager</field>
            <field name="sequence">20</field>
            <field name="privilege_id" ref="privilege_direct_sales_commercial"/>
            <field name="implied_ids" eval="[
                Command.link(ref('group_direct_invoice_user')),
                Command.link(ref('sales_team.group_sale_manager'))
            ]"/>
        </record>
        <record id="group_direct_invoice_price_override" model="res.groups">
            <field name="name">Allow Direct Invoice Price Override</field>
            <field name="implied_ids" eval="[Command.link(ref('group_direct_invoice_user'))]"/>
            <field name="implied_by_ids" eval="[Command.link(ref('group_direct_invoice_sales_manager'))]"/>
        </record>
        <record id="group_direct_invoice_warehouse_user" model="res.groups">
            <field name="name">User</field>
            <field name="sequence">10</field>
            <field name="privilege_id" ref="privilege_direct_sales_warehouse"/>
            <field name="implied_ids" eval="[Command.link(ref('stock.group_stock_user'))]"/>
        </record>
        <record id="group_direct_invoice_warehouse_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="sequence">20</field>
            <field name="privilege_id" ref="privilege_direct_sales_warehouse"/>
            <field name="implied_ids" eval="[
                Command.link(ref('group_direct_invoice_warehouse_user')),
                Command.link(ref('stock.group_stock_manager'))
            ]"/>
        </record>
        <record id="group_direct_invoice_accounting_user" model="res.groups">
            <field name="name">Accounting User</field>
            <field name="sequence">10</field>
            <field name="privilege_id" ref="privilege_direct_sales_accounting"/>
            <field name="implied_ids" eval="[Command.link(ref('account.group_account_invoice'))]"/>
        </record>
        <record id="group_direct_invoice_admin" model="res.groups">
            <field name="name">Administrator</field>
            <field name="sequence">10</field>
            <field name="privilege_id" ref="privilege_direct_sales_administration"/>
            <field name="implied_ids" eval="[
                Command.link(ref('group_direct_invoice_sales_manager')),
                Command.link(ref('group_direct_invoice_warehouse_manager')),
                Command.link(ref('group_direct_invoice_accounting_user')),
                Command.link(ref('group_direct_invoice_price_override')),
                Command.link(ref('account.group_account_manager'))
            ]"/>
            <field name="user_ids" eval="[
                Command.link(ref('base.user_root')),
                Command.link(ref('base.user_admin'))
            ]"/>
        </record>
    </data>

    <data noupdate="1">
        <record id="rule_direct_invoice_company" model="ir.rule">
            <field name="name">Direct Invoice: company</field>
            <field name="model_id" ref="model_direct_sales_invoice"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="rule_direct_invoice_line_company" model="ir.rule">
            <field name="name">Direct Invoice Line: company</field>
            <field name="model_id" ref="model_direct_sales_invoice_line"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="rule_direct_invoice_allocation_company" model="ir.rule">
            <field name="name">Direct Invoice Allocation: company</field>
            <field name="model_id" ref="model_direct_sales_invoice_allocation"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="rule_direct_invoice_approval_company" model="ir.rule">
            <field name="name">Direct Invoice Approval: company</field>
            <field name="model_id" ref="model_direct_sales_invoice_approval"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="rule_direct_invoice_sales_own" model="ir.rule">
            <field name="name">Direct Invoice: own sales documents</field>
            <field name="model_id" ref="model_direct_sales_invoice"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[Command.link(ref('group_direct_invoice_user'))]"/>
        </record>
        <record id="rule_direct_invoice_sales_manager" model="ir.rule">
            <field name="name">Direct Invoice: sales team documents</field>
            <field name="model_id" ref="model_direct_sales_invoice"/>
            <field name="domain_force">['|', '|', ('user_id', '=', user.id), ('team_id.user_id', '=', user.id), ('team_id.member_ids', 'in', [user.id])]</field>
            <field name="groups" eval="[Command.link(ref('group_direct_invoice_sales_manager'))]"/>
        </record>
        <record id="rule_direct_invoice_warehouse" model="ir.rule">
            <field name="name">Direct Invoice: assigned warehouses</field>
            <field name="model_id" ref="model_direct_sales_invoice"/>
            <field name="domain_force">['|', '|', '|',
                ('warehouse_id.direct_sales_user_ids', 'in', [user.id]),
                ('warehouse_id.direct_sales_approval_user_ids', 'in', [user.id]),
                ('allocation_ids.warehouse_id.direct_sales_user_ids', 'in', [user.id]),
                ('allocation_ids.warehouse_id.direct_sales_approval_user_ids', 'in', [user.id])
            ]</field>
            <field name="groups" eval="[
                Command.link(ref('group_direct_invoice_warehouse_user')),
                Command.link(ref('group_direct_invoice_warehouse_manager'))
            ]"/>
        </record>
        <record id="rule_direct_invoice_accounting_all" model="ir.rule">
            <field name="name">Direct Invoice: accounting company documents</field>
            <field name="model_id" ref="model_direct_sales_invoice"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[Command.link(ref('group_direct_invoice_accounting_user'))]"/>
        </record>
        <record id="rule_direct_invoice_admin_all" model="ir.rule">
            <field name="name">Direct Invoice: administrator</field>
            <field name="model_id" ref="model_direct_sales_invoice"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[Command.link(ref('group_direct_invoice_admin'))]"/>
        </record>

        <record id="rule_direct_invoice_line_sales_own" model="ir.rule">
            <field name="name">Direct Invoice Line: own sales documents</field>
            <field name="model_id" ref="model_direct_sales_invoice_line"/>
            <field name="domain_force">[('direct_invoice_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[Command.link(ref('group_direct_invoice_user'))]"/>
        </record>
        <record id="rule_direct_invoice_line_sales_manager" model="ir.rule">
            <field name="name">Direct Invoice Line: sales team</field>
            <field name="model_id" ref="model_direct_sales_invoice_line"/>
            <field name="domain_force">['|', '|', ('direct_invoice_id.user_id', '=', user.id), ('direct_invoice_id.team_id.user_id', '=', user.id), ('direct_invoice_id.team_id.member_ids', 'in', [user.id])]</field>
            <field name="groups" eval="[Command.link(ref('group_direct_invoice_sales_manager'))]"/>
        </record>
        <record id="rule_direct_invoice_line_warehouse" model="ir.rule">
            <field name="name">Direct Invoice Line: assigned warehouses</field>
            <field name="model_id" ref="model_direct_sales_invoice_line"/>
            <field name="domain_force">['|', '|', '|',
                ('direct_invoice_id.warehouse_id.direct_sales_user_ids', 'in', [user.id]),
                ('direct_invoice_id.warehouse_id.direct_sales_approval_user_ids', 'in', [user.id]),
                ('allocation_ids.warehouse_id.direct_sales_user_ids', 'in', [user.id]),
                ('allocation_ids.warehouse_id.direct_sales_approval_user_ids', 'in', [user.id])
            ]</field>
            <field name="groups" eval="[
                Command.link(ref('group_direct_invoice_warehouse_user')),
                Command.link(ref('group_direct_invoice_warehouse_manager'))
            ]"/>
        </record>
        <record id="rule_direct_invoice_line_accounting" model="ir.rule">
            <field name="name">Direct Invoice Line: accounting</field>
            <field name="model_id" ref="model_direct_sales_invoice_line"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[Command.link(ref('group_direct_invoice_accounting_user'))]"/>
        </record>
        <record id="rule_direct_invoice_line_admin" model="ir.rule">
            <field name="name">Direct Invoice Line: administrator</field>
            <field name="model_id" ref="model_direct_sales_invoice_line"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[Command.link(ref('group_direct_invoice_admin'))]"/>
        </record>

        <record id="rule_direct_invoice_allocation_sales" model="ir.rule">
            <field name="name">Direct Invoice Allocation: own sales documents</field>
            <field name="model_id" ref="model_direct_sales_invoice_allocation"/>
            <field name="domain_force">[('direct_invoice_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[Command.link(ref('group_direct_invoice_user'))]"/>
        </record>
        <record id="rule_direct_invoice_allocation_manager" model="ir.rule">
            <field name="name">Direct Invoice Allocation: sales team</field>
            <field name="model_id" ref="model_direct_sales_invoice_allocation"/>
            <field name="domain_force">['|', '|', ('direct_invoice_id.user_id', '=', user.id), ('direct_invoice_id.team_id.user_id', '=', user.id), ('direct_invoice_id.team_id.member_ids', 'in', [user.id])]</field>
            <field name="groups" eval="[Command.link(ref('group_direct_invoice_sales_manager'))]"/>
        </record>
        <record id="rule_direct_invoice_allocation_warehouse" model="ir.rule">
            <field name="name">Direct Invoice Allocation: assigned warehouses</field>
            <field name="model_id" ref="model_direct_sales_invoice_allocation"/>
            <field name="domain_force">['|', ('warehouse_id.direct_sales_user_ids', 'in', [user.id]), ('warehouse_id.direct_sales_approval_user_ids', 'in', [user.id])]</field>
            <field name="groups" eval="[
                Command.link(ref('group_direct_invoice_warehouse_user')),
                Command.link(ref('group_direct_invoice_warehouse_manager'))
            ]"/>
        </record>
        <record id="rule_direct_invoice_allocation_accounting_admin" model="ir.rule">
            <field name="name">Direct Invoice Allocation: accounting and administration</field>
            <field name="model_id" ref="model_direct_sales_invoice_allocation"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[
                Command.link(ref('group_direct_invoice_accounting_user')),
                Command.link(ref('group_direct_invoice_admin'))
            ]"/>
        </record>

        <record id="rule_direct_invoice_approval_sales" model="ir.rule">
            <field name="name">Direct Invoice Approval: own sales documents</field>
            <field name="model_id" ref="model_direct_sales_invoice_approval"/>
            <field name="domain_force">[('direct_invoice_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[Command.link(ref('group_direct_invoice_user'))]"/>
        </record>
        <record id="rule_direct_invoice_approval_manager" model="ir.rule">
            <field name="name">Direct Invoice Approval: sales team</field>
            <field name="model_id" ref="model_direct_sales_invoice_approval"/>
            <field name="domain_force">['|', '|', ('direct_invoice_id.user_id', '=', user.id), ('direct_invoice_id.team_id.user_id', '=', user.id), ('direct_invoice_id.team_id.member_ids', 'in', [user.id])]</field>
            <field name="groups" eval="[Command.link(ref('group_direct_invoice_sales_manager'))]"/>
        </record>
        <record id="rule_direct_invoice_approval_warehouse" model="ir.rule">
            <field name="name">Direct Invoice Approval: assigned warehouses</field>
            <field name="model_id" ref="model_direct_sales_invoice_approval"/>
            <field name="domain_force">['|', '|', '|',
                ('direct_invoice_id.warehouse_id.direct_sales_user_ids', 'in', [user.id]),
                ('direct_invoice_id.warehouse_id.direct_sales_approval_user_ids', 'in', [user.id]),
                ('direct_invoice_id.allocation_ids.warehouse_id.direct_sales_user_ids', 'in', [user.id]),
                ('direct_invoice_id.allocation_ids.warehouse_id.direct_sales_approval_user_ids', 'in', [user.id])
            ]</field>
            <field name="groups" eval="[
                Command.link(ref('group_direct_invoice_warehouse_user')),
                Command.link(ref('group_direct_invoice_warehouse_manager'))
            ]"/>
        </record>
        <record id="rule_direct_invoice_approval_accounting_admin" model="ir.rule">
            <field name="name">Direct Invoice Approval: accounting and administration</field>
            <field name="model_id" ref="model_direct_sales_invoice_approval"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[
                Command.link(ref('group_direct_invoice_accounting_user')),
                Command.link(ref('group_direct_invoice_admin'))
            ]"/>
        </record>
    </data>
</odoo>
