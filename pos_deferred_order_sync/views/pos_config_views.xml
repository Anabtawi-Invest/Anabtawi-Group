<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pos_config_form_deferred_order_sync" model="ir.ui.view">
        <field name="name">pos.config.form.deferred.order.sync</field>
        <field name="model">pos.config</field>
        <field name="inherit_id" ref="point_of_sale.pos_config_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Order Synchronization" name="pos_deferred_order_sync">
                    <group>
                        <field name="deferred_order_sync"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
