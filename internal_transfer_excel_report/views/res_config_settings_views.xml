<odoo>

    <record id="res_config_settings_view_form_internal_transfer_report" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.internal.transfer.report</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="stock.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='stock']" position="inside">
                <block title="Internal Transfer Report" name="internal_transfer_report_setting_container">
                    <setting string="Purchase Receipts"
                             help="Include receipts matching these values in the Internal Transfer Report.">
                        <div class="content-group">
                            <div class="row mt8">
                                <label for="itr_receipt_company_id" class="col-lg-4 o_light_label"/>
                                <field name="itr_receipt_company_id"
                                       options="{'no_create': True, 'no_create_edit': True}"/>
                            </div>
                            <div class="row">
                                <label for="itr_receipt_vendor_id" class="col-lg-4 o_light_label"/>
                                <field name="itr_receipt_vendor_id"
                                       options="{'no_create': True, 'no_create_edit': True}"/>
                            </div>
                            <div class="row">
                                <label for="itr_receipt_location_id" class="col-lg-4 o_light_label"/>
                                <field name="itr_receipt_location_id"
                                       options="{'no_create': True, 'no_create_edit': True}"/>
                            </div>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>

</odoo>
