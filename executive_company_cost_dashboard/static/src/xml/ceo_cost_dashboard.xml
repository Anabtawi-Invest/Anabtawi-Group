<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">
    <t t-name="executive_company_cost_dashboard.ExecutiveCompanyCostDashboard">
        <div class="cmd_container">
            <!-- Top Navbar (Matching CEO Main Dashboard) -->
            <header class="cmd_navbar">
                <div class="cmd_brand">
                    <i class="fa fa-tachometer me-2"/>
                    <span>ANABTAWI GROUP</span>
                    <span class="cmd_company_badge">Executive Cost &amp; P&amp;L</span>
                </div>

                <div class="cmd_tabs">
                    <button class="cmd_tab"
                            t-att-class="{ 'cmd_tab_active': state.activeTab === 'overview' }"
                            t-on-click="() => this.setActiveTab('overview')">
                        <i class="fa fa-th-large me-1"/> Executive Overview
                    </button>
                    <button class="cmd_tab"
                            t-att-class="{ 'cmd_tab_active': state.activeTab === 'sister_companies' }"
                            t-on-click="() => this.setActiveTab('sister_companies')">
                        <i class="fa fa-building-o me-1"/> Sister Companies P&amp;L
                    </button>
                    <button class="cmd_tab"
                            t-att-class="{ 'cmd_tab_active': state.activeTab === 'departments' }"
                            t-on-click="() => this.setActiveTab('departments')">
                        <i class="fa fa-sitemap me-1"/> Department Spend (IT/HR/CCTV)
                    </button>
                    <button class="cmd_tab"
                            t-att-class="{ 'cmd_tab_active': state.activeTab === 'branches' }"
                            t-on-click="() => this.setActiveTab('branches')">
                        <i class="fa fa-map-marker me-1"/> 21-Branch Matrix &amp; Rent
                    </button>
                </div>

                <div class="cmd_nav_actions">
                    <button class="cmd_btn cmd_btn_primary"
                            t-on-click="actionRunSmartScan"
                            title="Auto-scan accounts with Arabic &amp; English keyword intelligence">
                        <i class="fa fa-magic me-1"/> Smart Auto-Scan
                    </button>
                    <button class="cmd_btn"
                            t-on-click="() => this.loadDashboardData()"
                            title="Refresh live data">
                        <i class="fa fa-refresh me-1" t-att-class="{ 'fa-spin': state.loading }"/> Refresh
                    </button>
                </div>
            </header>

            <!-- Date & Company Filter Ribbon -->
            <section class="cmd_filter_bar">
                <div class="cmd_pills">
                    <button class="cmd_pill" t-att-class="{ 'cmd_pill_active': state.period_mode === 'this_month' }"
                            t-on-click="() => this.setPeriod('this_month')">This Month</button>
                    <button class="cmd_pill" t-att-class="{ 'cmd_pill_active': state.period_mode === 'last_month' }"
                            t-on-click="() => this.setPeriod('last_month')">Last Month</button>
                    <button class="cmd_pill" t-att-class="{ 'cmd_pill_active': state.period_mode === 'qtd' }"
                            t-on-click="() => this.setPeriod('qtd')">This Quarter</button>
                    <button class="cmd_pill" t-att-class="{ 'cmd_pill_active': state.period_mode === 'ytd' }"
                            t-on-click="() => this.setPeriod('ytd')">This Year</button>
                    <button class="cmd_pill" t-att-class="{ 'cmd_pill_active': state.period_mode === 'year_2026' }"
                            t-on-click="() => this.setPeriod('year_2026')">2026 Year</button>
                </div>

                <div class="d-flex align-items-center gap-2">
                    <span class="cmd_muted cmd_small">Entity</span>
                    <select class="cmd_select"
                            t-att-value="state.company_id"
                            t-on-change="onCompanyChange">
                        <option value="0">🏢 Consolidated Group (All Companies)</option>
                        <t t-foreach="data.all_companies" t-as="c" t-key="c.id">
                            <option t-att-value="c.id" t-esc="c.name"/>
                        </t>
                    </select>
                </div>

                <div class="cmd_currency" t-if="data.currency">
                    <span class="cmd_muted cmd_small">Currency</span>
                    <span class="cmd_currency_val" t-esc="data.currency.name || 'JOD'"/>
                </div>
            </section>

            <!-- Loading Spinner -->
            <div t-if="state.loading" class="cmd_loading">
                <i class="fa fa-circle-o-notch fa-spin me-2"/> Loading financial &amp; cost intelligence…
            </div>

            <!-- Dashboard Body -->
            <main class="cmd_body" t-if="!state.loading">
                <!-- TAB 1: EXECUTIVE OVERVIEW -->
                <t t-if="state.activeTab === 'overview'">
                    <!-- Row 1: KPI Cards -->
                    <div class="cmd_grid cmd_grid_4">
                        <!-- Revenue -->
                        <div class="cmd_card cmd_border_green">
                            <div class="cmd_card_label">
                                <span>Total Revenue</span>
                                <i class="fa fa-arrow-up text-profit"/>
                            </div>
                            <div class="cmd_card_value text-profit" t-esc="formatCurrency(data.kpis.total_revenue)"/>
                            <div class="cmd_card_sub">
                                <span>Gross Margin: <strong t-esc="(data.kpis.gross_margin_pct || 0) + '%'"/></span>
                                <span class="cmd_badge cmd_badge_profit">Sales</span>
                            </div>
                        </div>

                        <!-- Total OpEx -->
                        <div class="cmd_card cmd_border_amber">
                            <div class="cmd_card_label">
                                <span>Total Operating OpEx</span>
                                <i class="fa fa-pie-chart text-warning"/>
                            </div>
                            <div class="cmd_card_value text-warning" t-esc="formatCurrency(data.kpis.total_opex)"/>
                            <div class="cmd_card_sub">
                                <span>Rent, Power, Tech, Payroll</span>
                                <span class="cmd_badge cmd_badge_warn">Overhead</span>
                            </div>
                        </div>

                        <!-- Net Operating Profit -->
                        <div class="cmd_card cmd_border_teal">
                            <div class="cmd_card_label">
                                <span>Net Operating Profit</span>
                                <span t-att-class="'cmd_badge ' + (data.kpis.net_profit >= 0 ? 'cmd_badge_profit' : 'cmd_badge_loss')"
                                      t-esc="(data.kpis.net_margin_pct || 0) + '%'"/>
                            </div>
                            <div t-att-class="'cmd_card_value ' + (data.kpis.net_profit >= 0 ? 'text-profit' : 'text-loss')"
                                 t-esc="formatCurrency(data.kpis.net_profit)"/>
                            <div class="cmd_card_sub">
                                <t t-if="data.kpis.net_profit >= 0">
                                    <span class="text-profit">🟢 Healthy Operating Margin</span>
                                </t>
                                <t t-else="">
                                    <span class="text-loss">🔴 Operating at Net Deficit</span>
                                </t>
                            </div>
                        </div>

                        <!-- Branch Health -->
                        <div class="cmd_card cmd_border_blue">
                            <div class="cmd_card_label">
                                <span>Branch Health Status</span>
                                <span class="cmd_badge cmd_badge_profit" t-esc="data.kpis.active_branches_count + ' Active'"/>
                            </div>
                            <div class="cmd_card_value">
                                <span class="text-profit" t-esc="data.kpis.profitable_branches_count"/> <span class="cmd_muted fs-6">/</span>
                                <span class="text-loss" t-esc="data.kpis.loss_branches_count"/>
                            </div>
                            <div class="cmd_card_sub">
                                <span>Profitable vs Loss Branches</span>
                            </div>
                        </div>
                    </div>

                    <!-- Row 2: Operational Focus Metrics -->
                    <div class="cmd_grid cmd_grid_4">
                        <!-- Rent -->
                        <div class="cmd_card cmd_border_purple">
                            <div class="cmd_card_label">
                                <span>Rent &amp; Leases (إيجارات)</span>
                                <span class="cmd_badge" t-esc="(data.kpis.rent_pct || 0) + '% of Sales'"/>
                            </div>
                            <div class="cmd_card_value" t-esc="formatCurrency(data.kpis.rent_amount)"/>
                            <div class="cmd_card_sub"><span>Shops &amp; Facilities</span></div>
                        </div>

                        <!-- Utilities -->
                        <div class="cmd_card cmd_border_cyan">
                            <div class="cmd_card_label">
                                <span>Utilities (كهرباء ومياه)</span>
                                <span class="cmd_badge" t-esc="(data.kpis.utilities_pct || 0) + '% of Sales'"/>
                            </div>
                            <div class="cmd_card_value" t-esc="formatCurrency(data.kpis.utilities_amount)"/>
                            <div class="cmd_card_sub"><span>Power, Water &amp; Fuel</span></div>
                        </div>

                        <!-- Tech & Telecom -->
                        <div class="cmd_card cmd_border_rose">
                            <div class="cmd_card_label">
                                <span>IT &amp; Telecom (اتصالات وبرامج)</span>
                                <span class="cmd_badge" t-esc="(data.kpis.tech_pct || 0) + '% of Sales'"/>
                            </div>
                            <div class="cmd_card_value" t-esc="formatCurrency(data.kpis.tech_amount)"/>
                            <div class="cmd_card_sub"><span>Internet, SaaS &amp; Systems</span></div>
                        </div>

                        <!-- Delivery Apps -->
                        <div class="cmd_card cmd_border_amber">
                            <div class="cmd_card_label">
                                <span>Delivery Apps (تطبيقات)</span>
                                <span class="cmd_badge" t-esc="(data.kpis.delivery_pct || 0) + '% of Sales'"/>
                            </div>
                            <div class="cmd_card_value" t-esc="formatCurrency(data.kpis.delivery_amount)"/>
                            <div class="cmd_card_sub"><span>Talabat, Careem, etc.</span></div>
                        </div>
                    </div>

                    <!-- Sister Companies Summary -->
                    <div class="cmd_section">
                        <div class="cmd_section_header">
                            <h3><i class="fa fa-cubes text-teal"/>Sister Companies Performance (الشركات الشقيقة)</h3>
                            <button class="cmd_btn cmd_small" t-on-click="() => this.setActiveTab('sister_companies')">View Detailed P&amp;L →</button>
                        </div>
                        <div class="cmd_sister_grid">
                            <t t-foreach="data.sister_companies" t-as="sc" t-key="sc.company_id">
                                <div class="cmd_sister_box">
                                    <div class="cmd_sister_head">
                                        <span t-esc="sc.company_name"/>
                                        <span t-att-class="'cmd_badge ' + (sc.status === 'profitable' ? 'cmd_badge_profit' : (sc.status === 'break_even' ? 'cmd_badge_warn' : 'cmd_badge_loss'))">
                                            <t t-if="sc.status === 'profitable'">🟢 Strong</t>
                                            <t t-elif="sc.status === 'break_even'">🟡 Break-Even</t>
                                            <t t-else="">🔴 Net Loss</t>
                                        </span>
                                    </div>
                                    <div class="cmd_row">
                                        <span class="cmd_lbl">Revenue (المبيعات)</span>
                                        <span class="cmd_val text-profit" t-esc="formatCurrency(sc.revenue)"/>
                                    </div>
                                    <div class="cmd_row">
                                        <span class="cmd_lbl">Cost of Sales (COGS)</span>
                                        <span class="cmd_val text-loss" t-esc="formatCurrency(sc.cogs)"/>
                                    </div>
                                    <div class="cmd_row">
                                        <span class="cmd_lbl">Operating OpEx</span>
                                        <span class="cmd_val" t-esc="formatCurrency(sc.opex)"/>
                                    </div>
                                    <div class="cmd_row">
                                        <span class="cmd_lbl">Net Profit (صافي الربح)</span>
                                        <span t-att-class="'cmd_val fw-bold ' + (sc.net_profit >= 0 ? 'text-profit' : 'text-loss')"
                                              t-esc="formatCurrency(sc.net_profit)"/>
                                    </div>
                                    <div class="cmd_row">
                                        <span class="cmd_lbl">Net Margin %</span>
                                        <span class="cmd_val" t-esc="sc.net_margin_pct + '%'"/>
                                    </div>
                                </div>
                            </t>
                        </div>
                    </div>

                    <!-- Visual Charts -->
                    <div class="cmd_grid cmd_grid_2">
                        <div class="cmd_section">
                            <div class="cmd_section_header">
                                <h3><i class="fa fa-line-chart text-teal"/>12-Month Run-Rate Trajectory (Monthly Trend)</h3>
                            </div>
                            <div style="height: 260px; position: relative;">
                                <canvas t-ref="trendCanvas"/>
                            </div>
                        </div>
                        <div class="cmd_section">
                            <div class="cmd_section_header">
                                <h3><i class="fa fa-pie-chart text-teal"/>Operating Expense Composition by Bucket</h3>
                            </div>
                            <div style="height: 260px; position: relative;">
                                <canvas t-ref="donutCanvas"/>
                            </div>
                        </div>
                    </div>
                </t>

                <!-- TAB 2: SISTER COMPANIES P&L -->
                <t t-if="state.activeTab === 'sister_companies'">
                    <div class="cmd_section">
                        <div class="cmd_section_header">
                            <h3><i class="fa fa-building-o text-teal"/>Holding &amp; Sister Companies Consolidated Income Statement</h3>
                        </div>
                        <div class="table-responsive">
                            <table class="cmd_table">
                                <thead>
                                    <tr>
                                        <th>Company / Business Entity</th>
                                        <th>Revenue (المبيعات)</th>
                                        <th>Cost of Revenue (COGS)</th>
                                        <th>Gross Profit</th>
                                        <th>Operating OpEx</th>
                                        <th>Net Profit (EBITDA)</th>
                                        <th>Net Margin %</th>
                                        <th>Financial Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="data.sister_companies" t-as="sc" t-key="sc.company_id">
                                        <tr>
                                            <td>
                                                <i class="fa fa-building text-muted me-2"/>
                                                <span t-esc="sc.company_name"/>
                                            </td>
                                            <td class="text-profit fw-bold" t-esc="formatCurrency(sc.revenue)"/>
                                            <td class="text-loss" t-esc="formatCurrency(sc.cogs)"/>
                                            <td class="fw-semibold" t-esc="formatCurrency(sc.gross_profit)"/>
                                            <td class="cmd_muted" t-esc="formatCurrency(sc.opex)"/>
                                            <td t-att-class="'fw-bold ' + (sc.net_profit >= 0 ? 'text-profit' : 'text-loss')"
                                                t-esc="formatCurrency(sc.net_profit)"/>
                                            <td class="fw-semibold" t-esc="sc.net_margin_pct + '%'"/>
                                            <td>
                                                <span t-att-class="'cmd_badge ' + (sc.status === 'profitable' ? 'cmd_badge_profit' : (sc.status === 'break_even' ? 'cmd_badge_warn' : 'cmd_badge_loss'))">
                                                    <t t-if="sc.status === 'profitable'">🟢 Healthy Profit</t>
                                                    <t t-elif="sc.status === 'break_even'">🟡 Break-Even</t>
                                                    <t t-else="">🔴 Net Deficit</t>
                                                </span>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </t>

                <!-- TAB 3: DEPARTMENTS BREAKDOWN -->
                <t t-if="state.activeTab === 'departments'">
                    <div class="cmd_section">
                        <div class="cmd_section_header">
                            <h3><i class="fa fa-sitemap text-teal"/>Departmental Operating Costs (IT, HR, Operations, Maintenance, CCTV Room)</h3>
                        </div>
                        <div class="table-responsive">
                            <table class="cmd_table">
                                <thead>
                                    <tr>
                                        <th>Department / Analytic Business Unit</th>
                                        <th>Total Operational Expenditure (JOD)</th>
                                        <th>Operational Share %</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="data.departments" t-as="d" t-key="d.name">
                                        <tr>
                                            <td>
                                                <i class="fa fa-folder-open-o text-teal me-2"/>
                                                <span t-esc="d.name"/>
                                            </td>
                                            <td class="fw-bold" t-esc="formatCurrency(d.amount)"/>
                                            <td class="cmd_muted">
                                                <span t-esc="data.kpis.total_opex > 0 ? ((d.amount / data.kpis.total_opex * 100).toFixed(1) + '%') : '0.0%'"/>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </t>

                <!-- TAB 4: 21-BRANCH MASTER MATRIX -->
                <t t-if="state.activeTab === 'branches'">
                    <div class="cmd_section">
                        <div class="cmd_section_header">
                            <div>
                                <h3><i class="fa fa-map-marker text-danger me-2"/>21-Branch Profitability &amp; Cost Intelligence Matrix</h3>
                                <p class="cmd_muted cmd_small mb-0">Ranks each retail shop with individual Rent, Utilities, Delivery apps, and Net Margin.</p>
                            </div>
                            <div class="w-auto">
                                <input type="text"
                                       class="cmd_select"
                                       placeholder="🔍 Search Branch Name..."
                                       t-model="state.searchBranch"/>
                            </div>
                        </div>

                        <div class="table-responsive">
                            <table class="cmd_table">
                                <thead>
                                    <tr>
                                        <th t-on-click="() => this.sortBy('branch_name')" style="cursor: pointer;">
                                            Branch / Location <i class="fa fa-sort"/>
                                        </th>
                                        <th t-on-click="() => this.sortBy('revenue')" style="cursor: pointer;">
                                            Revenue (المبيعات) <i class="fa fa-sort"/>
                                        </th>
                                        <th t-on-click="() => this.sortBy('rent')" style="cursor: pointer;">
                                            Shop Rent (إيجار) <i class="fa fa-sort"/>
                                        </th>
                                        <th>Rent %</th>
                                        <th t-on-click="() => this.sortBy('utilities')" style="cursor: pointer;">
                                            Utilities (كهرباء/مياه) <i class="fa fa-sort"/>
                                        </th>
                                        <th t-on-click="() => this.sortBy('delivery_comm')" style="cursor: pointer;">
                                            Delivery Apps <i class="fa fa-sort"/>
                                        </th>
                                        <th t-on-click="() => this.sortBy('payroll')" style="cursor: pointer;">
                                            Payroll (الرواتب) <i class="fa fa-sort"/>
                                        </th>
                                        <th t-on-click="() => this.sortBy('tech')" style="cursor: pointer;">
                                            Tech &amp; Telecom <i class="fa fa-sort"/>
                                        </th>
                                        <th t-on-click="() => this.sortBy('total_opex')" style="cursor: pointer;">
                                            Total OpEx <i class="fa fa-sort"/>
                                        </th>
                                        <th t-on-click="() => this.sortBy('net_profit')" style="cursor: pointer;">
                                            Net Profit <i class="fa fa-sort"/>
                                        </th>
                                        <th>Net Margin %</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="filteredBranches" t-as="b" t-key="b.branch_id">
                                        <tr>
                                            <td>
                                                <i class="fa fa-store text-teal me-2"/>
                                                <span t-esc="b.branch_name"/>
                                            </td>
                                            <td class="text-profit fw-bold" t-esc="formatCurrency(b.revenue)"/>
                                            <td class="fw-semibold" t-esc="formatCurrency(b.rent)"/>
                                            <td>
                                                <span t-att-class="b.rent_pct > 25 ? 'cmd_badge cmd_badge_loss' : (b.rent_pct > 15 ? 'cmd_badge cmd_badge_warn' : 'cmd_muted')"
                                                      t-esc="b.rent_pct + '%'"/>
                                            </td>
                                            <td t-esc="formatCurrency(b.utilities)"/>
                                            <td t-esc="formatCurrency(b.delivery_comm)"/>
                                            <td t-esc="formatCurrency(b.payroll)"/>
                                            <td t-esc="formatCurrency(b.tech)"/>
                                            <td class="text-loss fw-semibold" t-esc="formatCurrency(b.total_opex)"/>
                                            <td t-att-class="'fw-bold ' + (b.net_profit >= 0 ? 'text-profit' : 'text-loss')"
                                                t-esc="formatCurrency(b.net_profit)"/>
                                            <td class="fw-semibold" t-esc="b.net_margin_pct + '%'"/>
                                            <td>
                                                <span t-att-class="'cmd_badge ' + (b.status === 'profitable' ? 'cmd_badge_profit' : (b.status === 'warning' ? 'cmd_badge_warn' : 'cmd_badge_loss'))">
                                                    <t t-if="b.status === 'profitable'">🟢 Profitable</t>
                                                    <t t-elif="b.status === 'warning'">🟡 Watch</t>
                                                    <t t-else="">🔴 Net Loss</t>
                                                </span>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </t>
            </main>
        </div>
    </t>
</templates>
