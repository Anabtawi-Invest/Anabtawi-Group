<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- ============================================================ shared bits -->
    <t t-name="executive_company_cost_dashboard.Delta">
        <span t-if="delta !== null and delta !== undefined" t-attf-class="ecd_delta ecd_{{ this.tone(delta, higher) }}">
            <i t-attf-class="fa {{ this.arrow(delta) }}"/>
            <t t-if="points"><t t-out="(delta &gt; 0 ? '+' : '') + delta.toFixed(1) + ' pp'"/></t>
            <t t-else=""><t t-out="this.signedPct(delta)"/></t>
        </span>
        <span t-else="" class="ecd_delta ecd_flat">–</span>
    </t>

    <t t-name="executive_company_cost_dashboard.Spark">
        <t t-set="sp" t-value="this.sparkPaths(values, sw, sh)"/>
        <svg t-if="sp" class="ecd_spark" t-att-viewBox="'0 0 ' + sp.w + ' ' + sp.h" preserveAspectRatio="none" t-att-width="sw" t-att-height="sh">
            <path t-att-d="sp.area" t-att-fill="color" fill-opacity="0.13"/>
            <path t-att-d="sp.line" fill="none" t-att-stroke="color" stroke-width="1.6" stroke-linejoin="round" stroke-linecap="round"/>
        </svg>
    </t>

    <t t-name="executive_company_cost_dashboard.Chip">
        <span t-attf-class="ecd_chip ecd_chip_{{ status }}" t-out="this.statusLabel(status)"/>
    </t>

    <t t-name="executive_company_cost_dashboard.Empty">
        <div class="ecd_empty">
            <i t-attf-class="fa {{ icon || 'fa-inbox' }}"/>
            <div class="ecd_empty_title" t-out="title"/>
            <div class="ecd_empty_text" t-out="text"/>
        </div>
    </t>

    <!-- ============================================================ main -->
    <t t-name="executive_company_cost_dashboard.Dashboard">
        <div class="ecd" t-att-class="{ 'ecd_busy': state.busy }">

            <!-- Header -->
            <header class="ecd_header">
                <div class="ecd_brand">
                    <div class="ecd_mark"><i class="fa fa-bar-chart"/></div>
                    <div class="ecd_brand_text">
                        <div class="ecd_kicker">Executive Cockpit</div>
                        <h1 class="ecd_title">Group Financial Overview</h1>
                        <div class="ecd_sub" t-if="state.data">
                            <i class="fa fa-calendar-o"/> <t t-out="this.periodLabel"/>
                            <span class="ecd_dot"/>
                            <i class="fa fa-building-o"/> <t t-out="this.companyLabel"/>
                            <span class="ecd_dot"/>
                            <t t-out="state.data.currency.name"/>
                        </div>
                    </div>
                </div>
                <div class="ecd_actions">
                    <button class="ecd_btn" t-if="state.data and state.data.meta.purchasing_action_id" t-on-click="this.openPurchasing">
                        <i class="fa fa-shopping-cart"/> <span>Purchasing Dashboard</span>
                    </button>
                    <button class="ecd_btn" t-if="state.data and state.data.meta.is_manager" t-on-click="this.runScan" title="Re-classify accounts and branches">
                        <i class="fa fa-magic"/> <span>Smart Scan</span>
                    </button>
                    <button class="ecd_btn" t-on-click="this.printPage"><i class="fa fa-print"/> <span>Print</span></button>
                    <button class="ecd_btn ecd_btn_primary" t-on-click="this.refresh">
                        <i t-attf-class="fa fa-refresh {{ state.busy ? 'fa-spin' : '' }}"/> <span>Refresh</span>
                    </button>
                </div>
            </header>

            <!-- Toolbar: tabs + filters -->
            <section class="ecd_toolbar">
                <nav class="ecd_tabs">
                    <button t-foreach="this.tabs" t-as="tab" t-key="tab.key"
                            t-attf-class="ecd_tab {{ state.tab === tab.key ? 'ecd_tab_active' : '' }}"
                            t-on-click="() => this.setTab(tab.key)">
                        <i t-attf-class="fa {{ tab.icon }}"/> <span t-out="tab.label"/>
                    </button>
                </nav>
                <div class="ecd_filters">
                    <div class="ecd_pills">
                        <button t-foreach="this.periods" t-as="p" t-key="p.key"
                                t-attf-class="ecd_pill {{ state.periodMode === p.key ? 'ecd_pill_active' : '' }}"
                                t-on-click="() => this.setPeriod(p.key)" t-out="p.label"/>
                    </div>
                    <select class="ecd_select" t-if="state.data and state.data.period.years.length"
                            t-on-change="this.onYear" title="Full calendar year">
                        <option t-foreach="state.data.period.years" t-as="y" t-key="y" t-att-value="y"
                                t-att-selected="state.periodMode === 'year' and state.year === y" t-out="y"/>
                    </select>
                    <div class="ecd_range" t-if="state.periodMode === 'custom'">
                        <input type="date" class="ecd_date" t-att-value="state.dateFrom" t-on-change="(ev) => this.onDate('dateFrom', ev)"/>
                        <span>→</span>
                        <input type="date" class="ecd_date" t-att-value="state.dateTo" t-on-change="(ev) => this.onDate('dateTo', ev)"/>
                    </div>
                    <select class="ecd_select" t-if="state.data and state.data.companies_available.length &gt; 1" t-on-change="this.onCompany">
                        <option value="0" t-att-selected="!state.companyId">All companies</option>
                        <option t-foreach="state.data.companies_available" t-as="c" t-key="c.id" t-att-value="c.id"
                                t-att-selected="state.companyId === c.id" t-out="c.name"/>
                    </select>
                </div>
            </section>

            <!-- Body -->
            <main class="ecd_body">
                <div t-if="state.loading" class="ecd_loading">
                    <div class="ecd_skel_row">
                        <div class="ecd_skel" t-foreach="[1,2,3,4,5,6]" t-as="i" t-key="i"/>
                    </div>
                    <div class="ecd_skel ecd_skel_wide"/>
                </div>
                <div t-elif="state.error" class="ecd_error">
                    <i class="fa fa-exclamation-triangle"/>
                    <div>
                        <strong>The dashboard could not be loaded</strong>
                        <div t-out="state.error"/>
                        <button class="ecd_btn" t-on-click="this.refresh">Try again</button>
                    </div>
                </div>
                <t t-elif="state.data">
                    <t t-if="state.tab === 'overview'" t-call="executive_company_cost_dashboard.Overview"/>
                    <t t-elif="state.tab === 'companies'" t-call="executive_company_cost_dashboard.Companies"/>
                    <t t-elif="state.tab === 'explorer'" t-call="executive_company_cost_dashboard.Explorer"/>
                    <t t-elif="state.tab === 'finder'" t-call="executive_company_cost_dashboard.Finder"/>

                    <footer class="ecd_footer">
                        <span><i class="fa fa-lock"/> Read-only · posted journal entries only · reconciles with Odoo's Profit &amp; Loss</span>
                        <span><t t-out="state.data.meta.lines"/> ledger lines analysed</span>
                        <span>Compared with <t t-out="this.prevLabel"/></span>
                        <span>Updated <t t-out="this.updatedAt"/></span>
                    </footer>
                </t>
            </main>
        </div>
    </t>

    <!-- ============================================================ OVERVIEW -->
    <t t-name="executive_company_cost_dashboard.Overview">
        <div t-if="!this.hasData">
            <t t-call="executive_company_cost_dashboard.Empty">
                <t t-set="icon" t-value="'fa-calendar-times-o'"/>
                <t t-set="title">No posted entries in this period</t>
                <t t-set="text">Pick another period or company. Only posted journal entries are counted.</t>
            </t>
        </div>
        <t t-else="">
            <!-- KPI strip -->
            <section class="ecd_kpis">
                <article t-foreach="this.kpis" t-as="k" t-key="k.key"
                         t-attf-class="ecd_card ecd_kpi {{ k.hero ? 'ecd_kpi_hero' : '' }} {{ k.value &lt; 0 ? 'ecd_kpi_neg' : '' }}">
                    <div class="ecd_kpi_top">
                        <span class="ecd_kpi_icon" t-attf-style="color: {{ k.color }}"><i t-attf-class="fa {{ k.icon }}"/></span>
                        <span class="ecd_kpi_label" t-out="k.label"/>
                    </div>
                    <div class="ecd_kpi_value">
                        <t t-if="k.isRatio"><t t-out="this.money(k.value, 3)"/></t>
                        <t t-else=""><t t-out="this.money(k.value)"/><small class="ecd_unit" t-out="state.data.currency.name"/></t>
                    </div>
                    <div class="ecd_kpi_foot">
                        <t t-call="executive_company_cost_dashboard.Delta">
                            <t t-set="delta" t-value="k.delta"/>
                            <t t-set="higher" t-value="k.higher"/>
                            <t t-set="points" t-value="k.deltaIsPoints"/>
                        </t>
                        <span class="ecd_muted" t-out="k.sub"/>
                    </div>
                    <div class="ecd_kpi_spark" t-if="k.spark">
                        <t t-call="executive_company_cost_dashboard.Spark">
                            <t t-set="values" t-value="k.spark"/>
                            <t t-set="color" t-value="k.color"/>
                            <t t-set="sw" t-value="220"/>
                            <t t-set="sh" t-value="34"/>
                        </t>
                    </div>
                </article>
            </section>

            <!-- Trend + alerts -->
            <section class="ecd_grid ecd_grid_main">
                <article class="ecd_card">
                    <header class="ecd_card_head">
                        <h3>Monthly performance</h3>
                        <div class="ecd_legend">
                            <span><i class="ecd_sw ecd_sw_rev"/>Revenue</span>
                            <span><i class="ecd_sw ecd_sw_cost"/>Costs</span>
                            <span><i class="ecd_sw ecd_sw_net"/>Net profit</span>
                        </div>
                    </header>
                    <t t-set="tc" t-value="this.trendChart"/>
                    <div class="ecd_chart" t-if="tc">
                        <svg class="ecd_svg" t-att-viewBox="'0 0 ' + tc.w + ' ' + tc.h" preserveAspectRatio="xMidYMid meet">
                            <g t-foreach="tc.grid" t-as="g" t-key="g_index">
                                <line t-att-x1="tc.l" t-att-x2="tc.r" t-att-y1="g.y" t-att-y2="g.y" t-attf-class="ecd_gridline {{ g.zero ? 'ecd_zero' : '' }}"/>
                                <text t-att-x="tc.l - 8" t-att-y="g.y + 3.5" class="ecd_axis" text-anchor="end" t-out="g.label"/>
                            </g>
                            <rect t-foreach="tc.bars" t-as="bar" t-key="bar.key" t-attf-class="ecd_bar ecd_bar_{{ bar.cls }}"
                                  t-att-x="bar.x" t-att-y="bar.y" t-att-width="bar.w" t-att-height="bar.h" rx="2"/>
                            <path t-if="tc.line" t-att-d="tc.line" class="ecd_netline"/>
                            <circle t-foreach="tc.dots" t-as="dot" t-key="dot.key" t-attf-class="ecd_netdot {{ dot.neg ? 'ecd_neg' : '' }}"
                                    t-att-cx="dot.x" t-att-cy="dot.y" r="3.4"/>
                            <text t-foreach="tc.labels" t-as="lb" t-key="lb.key" class="ecd_axis" text-anchor="middle"
                                  t-att-x="lb.x" t-att-y="tc.labelY" t-out="lb.text"/>
                            <rect t-foreach="state.data.monthly" t-as="m" t-key="m.month" class="ecd_hit"
                                  t-att-x="tc.l + tc.slot * m_index" t-att-y="tc.t" t-att-width="tc.slot" t-att-height="tc.innerH"
                                  t-on-mouseenter="() => this.setHover(m_index)" t-on-mouseleave="() => this.setHover(null)"/>
                        </svg>
                    </div>
                    <t t-set="fm" t-value="this.hoveredMonth or state.data.monthly[state.data.monthly.length - 1]"/>
                    <div class="ecd_chart_foot" t-if="fm">
                        <strong t-out="this.monthLabel(fm.month, true)"/>
                        <span>Revenue <b t-out="this.money(fm.revenue)"/></span>
                        <span>Costs <b t-out="this.money(fm.cost)"/></span>
                        <span t-attf-class="{{ fm.net_profit &lt; 0 ? 'ecd_text_bad' : 'ecd_text_good' }}">Net <b t-out="this.money(fm.net_profit)"/></span>
                    </div>
                </article>

                <article class="ecd_card ecd_alerts">
                    <header class="ecd_card_head"><h3><i class="fa fa-bell-o"/> Needs your attention</h3></header>
                    <div class="ecd_alert_list">
                        <div t-foreach="state.data.alerts" t-as="al" t-key="al_index"
                             t-attf-class="ecd_alert ecd_alert_{{ al.level }} {{ al.tab ? 'ecd_clickable' : '' }}"
                             t-on-click="() => this.openAlert(al)">
                            <span class="ecd_alert_icon"><i t-attf-class="fa {{ al.icon }}"/></span>
                            <div>
                                <div class="ecd_alert_title" t-out="al.title"/>
                                <div class="ecd_alert_text" t-out="al.text"/>
                            </div>
                            <i t-if="al.tab" class="fa fa-angle-right ecd_alert_go"/>
                        </div>
                        <div t-if="!state.data.alerts.length" class="ecd_muted ecd_pad">Nothing unusual detected for this period.</div>
                    </div>
                </article>
            </section>

            <!-- Allocation + waterfall -->
            <section class="ecd_grid ecd_grid_two">
                <article class="ecd_card">
                    <header class="ecd_card_head">
                        <h3>Where every 1.00 of sales goes</h3>
                        <span class="ecd_muted ecd_small">share of revenue</span>
                    </header>
                    <t t-set="al" t-value="this.allocation"/>
                    <t t-if="al">
                        <div class="ecd_stack">
                            <div t-foreach="al.segs" t-as="sg" t-key="sg.key" class="ecd_stack_seg ecd_clickable"
                                 t-attf-style="width: {{ sg.pct }}%; background: {{ sg.color }}"
                                 t-att-title="sg.name + ': ' + this.pct(sg.ofRevenue)"
                                 t-on-click="() => this.goBucket(sg)"/>
                        </div>
                        <div class="ecd_loss_note" t-if="al.loss"><i class="fa fa-exclamation-triangle"/> Costs exceed revenue by <b t-out="this.money(al.loss)"/></div>
                        <ul class="ecd_alloc_list">
                            <li t-foreach="al.segs.slice(0, 9)" t-as="sg" t-key="sg.key" t-attf-class="{{ sg.profit ? '' : 'ecd_clickable' }}"
                                t-on-click="() => this.goBucket(sg)">
                                <i class="ecd_dotc" t-attf-style="background: {{ sg.color }}"/>
                                <span class="ecd_alloc_name" t-out="sg.name"/>
                                <span class="ecd_alloc_amt" t-out="this.money(sg.amount)"/>
                                <b class="ecd_alloc_pct" t-out="this.pct(sg.ofRevenue)"/>
                            </li>
                        </ul>
                    </t>
                </article>

                <article class="ecd_card">
                    <header class="ecd_card_head"><h3>Profit waterfall</h3><span class="ecd_muted ecd_small">revenue → net profit</span></header>
                    <t t-set="wf" t-value="this.waterfall"/>
                    <div class="ecd_chart" t-if="wf">
                        <svg class="ecd_svg" t-att-viewBox="'0 0 ' + wf.w + ' ' + wf.h" preserveAspectRatio="xMidYMid meet">
                            <line t-att-x1="wf.l" t-att-x2="wf.r" t-att-y1="wf.zero" t-att-y2="wf.zero" class="ecd_gridline ecd_zero"/>
                            <g t-foreach="wf.bars" t-as="b" t-key="b.key">
                                <line t-if="b.connector !== null" t-att-x1="b.x2" t-att-x2="b.nextX" t-att-y1="b.connector" t-att-y2="b.connector" class="ecd_connector"/>
                                <rect t-attf-class="ecd_bar ecd_wf_{{ b.cls }}" t-att-x="b.x" t-att-y="b.y" t-att-width="b.w" t-att-height="b.h" rx="2">
                                    <title><t t-out="b.label + ': ' + this.money(b.value)"/></title>
                                </rect>
                                <text class="ecd_wf_value" text-anchor="middle" t-att-x="b.cx" t-att-y="b.valueY" t-out="this.compact(b.value)"/>
                                <text class="ecd_axis" text-anchor="middle" t-att-x="b.cx" t-att-y="b.labelY" t-out="b.label"/>
                            </g>
                        </svg>
                    </div>
                </article>
            </section>

            <!-- Focus cards -->
            <section>
                <div class="ecd_section_title">
                    <h2>CEO focus areas</h2>
                    <span class="ecd_muted">Tap a card for the account-level detail</span>
                </div>
                <div class="ecd_focus">
                    <article t-foreach="this.focusCards" t-as="f" t-key="f.code" t-attf-class="ecd_card ecd_focus_card ecd_clickable ecd_tone_{{ f.tone }}"
                             t-on-click="() => this.setTab('costs', f.code)">
                        <div class="ecd_focus_top">
                            <span class="ecd_focus_icon" t-attf-style="background: {{ f.color }}"><i t-attf-class="fa {{ this.icon(f.code) }}"/></span>
                            <span class="ecd_focus_name" t-out="f.name"/>
                        </div>
                        <div class="ecd_focus_value"><t t-out="this.money(f.amount)"/></div>
                        <div class="ecd_focus_foot">
                            <b t-out="this.pct(f.pct_revenue)"/> <span class="ecd_muted">of revenue</span>
                            <t t-call="executive_company_cost_dashboard.Delta">
                                <t t-set="delta" t-value="f.delta_pct"/>
                                <t t-set="higher" t-value="false"/>
                                <t t-set="points" t-value="false"/>
                            </t>
                        </div>
                    </article>
                </div>
            </section>

            <!-- Revenue streams / companies / branches -->
            <section class="ecd_grid ecd_grid_three">
                <article class="ecd_card">
                    <header class="ecd_card_head"><h3>Revenue streams</h3></header>
                    <div class="ecd_bars">
                        <div class="ecd_bar_row" t-foreach="this.revenueStreams" t-as="r" t-key="r.code">
                            <div class="ecd_bar_label"><i class="ecd_dotc" t-attf-style="background: {{ r.color }}"/><span t-out="r.name"/></div>
                            <div class="ecd_bar_track"><div class="ecd_bar_fill" t-attf-style="width: {{ Math.min(Math.abs(r.share), 100) }}%; background: {{ r.color }}"/></div>
                            <div class="ecd_bar_val"><b t-out="this.money(r.amount)"/><span class="ecd_muted" t-out="this.pct(r.share)"/></div>
                        </div>
                        <div t-if="!this.revenueStreams.length" class="ecd_muted ecd_pad">No revenue recorded.</div>
                    </div>
                </article>

                <article class="ecd_card">
                    <header class="ecd_card_head">
                        <h3>Sister companies</h3>
                        <a class="ecd_link" t-on-click="() => this.setTab('companies')">All <i class="fa fa-angle-right"/></a>
                    </header>
                    <table class="ecd_mini_table">
                        <tbody>
                            <tr t-foreach="state.data.companies" t-as="co" t-key="co.id">
                                <td class="ecd_cell_name" t-out="co.name"/>
                                <td class="ecd_num" t-out="this.compact(co.revenue)"/>
                                <td t-attf-class="ecd_num {{ co.net_profit &lt; 0 ? 'ecd_text_bad' : 'ecd_text_good' }}" t-out="this.compact(co.net_profit)"/>
                                <td class="ecd_cell_chip"><t t-call="executive_company_cost_dashboard.Chip"><t t-set="status" t-value="co.status"/></t></td>
                            </tr>
                        </tbody>
                    </table>
                </article>

                <article class="ecd_card">
                    <header class="ecd_card_head">
                        <h3>Branches</h3>
                        <a class="ecd_link" t-on-click="() => this.setTab('branches')">All <i class="fa fa-angle-right"/></a>
                    </header>
                    <t t-if="this.rankedBranches.length">
                        <div class="ecd_rank_title">Top performers</div>
                        <div class="ecd_rank_row" t-foreach="this.topBranches" t-as="br" t-key="br.id">
                            <span class="ecd_rank_name" t-out="br.name"/>
                            <span t-attf-class="ecd_rank_val {{ br.net_profit &lt; 0 ? 'ecd_text_bad' : 'ecd_text_good' }}" t-out="this.compact(br.net_profit)"/>
                            <span class="ecd_muted" t-out="this.pct(br.net_margin)"/>
                        </div>
                        <t t-if="this.bottomBranches.length">
                            <div class="ecd_rank_title ecd_rank_title_bad">Needs attention</div>
                            <div class="ecd_rank_row" t-foreach="this.bottomBranches" t-as="br" t-key="br.id">
                                <span class="ecd_rank_name" t-out="br.name"/>
                                <span t-attf-class="ecd_rank_val {{ br.net_profit &lt; 0 ? 'ecd_text_bad' : 'ecd_text_good' }}" t-out="this.compact(br.net_profit)"/>
                                <span class="ecd_muted" t-out="this.pct(br.net_margin)"/>
                            </div>
                        </t>
                    </t>
                    <div t-else="" class="ecd_muted ecd_pad">No branch-level entries yet. Tag journal items with the branch analytic account.</div>
                </article>
            </section>
        </t>
    </t>

    <!-- ============================================================ COMPANIES -->
    <t t-name="executive_company_cost_dashboard.Companies">
        <div class="ecd_section_title">
            <h2>Sister companies, side by side</h2>
            <button class="ecd_btn ecd_btn_sm" t-on-click="this.exportCompanies"><i class="fa fa-download"/> Export CSV</button>
        </div>
        <section class="ecd_company_cards">
            <article t-foreach="this.companyRows" t-as="co" t-key="co.id" t-attf-class="ecd_card ecd_company ecd_border_{{ co.status }}">
                <header class="ecd_company_head">
                    <div>
                        <div class="ecd_company_name" t-out="co.name"/>
                        <div class="ecd_muted ecd_small"><t t-out="this.pct(co.revenue_share)"/> of group revenue</div>
                    </div>
                    <t t-call="executive_company_cost_dashboard.Chip"><t t-set="status" t-value="co.status"/></t>
                </header>
                <div class="ecd_company_main">
                    <div>
                        <div class="ecd_label">Revenue</div>
                        <div class="ecd_big" t-out="this.money(co.revenue)"/>
                        <t t-call="executive_company_cost_dashboard.Delta"><t t-set="delta" t-value="co.revenue_delta"/><t t-set="higher" t-value="true"/><t t-set="points" t-value="false"/></t>
                    </div>
                    <div>
                        <div class="ecd_label">Net profit</div>
                        <div t-attf-class="ecd_big {{ co.net_profit &lt; 0 ? 'ecd_text_bad' : '' }}" t-out="this.money(co.net_profit)"/>
                        <span class="ecd_muted" t-out="this.pct(co.net_margin) + ' margin'"/>
                    </div>
                </div>
                <div class="ecd_share_track"><div class="ecd_share_fill" t-attf-style="width: {{ Math.min(co.revenue_share, 100) }}%"/></div>
                <dl class="ecd_dl">
                    <div><dt>Cost of revenue</dt><dd t-out="this.money(co.cogs)"/></div>
                    <div><dt>Gross profit</dt><dd><t t-out="this.money(co.gross_profit)"/> <span class="ecd_muted" t-out="this.pct(co.gross_margin)"/></dd></div>
                    <div><dt>Operating expenses</dt><dd t-out="this.money(co.opex)"/></div>
                    <div><dt>Operating profit</dt><dd t-out="this.money(co.operating_profit)"/></div>
                    <div t-if="co.other_income"><dt>Other income</dt><dd t-out="this.money(co.other_income)"/></div>
                </dl>
            </article>
        </section>

        <t t-set="bm" t-value="this.benchmark"/>
        <article class="ecd_card" t-if="bm.cols.length">
            <header class="ecd_card_head">
                <h3>Cost benchmark between companies</h3>
                <span class="ecd_muted ecd_small">each cost as % of that company's revenue · <span class="ecd_text_good">lowest</span> / <span class="ecd_text_bad">highest</span></span>
            </header>
            <div class="ecd_table_wrap">
                <table class="ecd_table">
                    <thead>
                        <tr>
                            <th class="ecd_left">Company</th>
                            <th>Gross margin</th>
                            <th t-foreach="bm.cols" t-as="c" t-key="c.code" t-out="c.name"/>
                            <th>Net margin</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="bm.rows" t-as="row" t-key="row.id">
                            <td class="ecd_left ecd_strong" t-out="row.name"/>
                            <td class="ecd_num" t-out="this.pct(row.gross_margin)"/>
                            <td t-foreach="bm.cols" t-as="c" t-key="c.code"
                                t-attf-class="ecd_num ecd_cell_{{ this.cellTone(c, row.cells[c_index]) }}"
                                t-out="row.cells[c_index] === null ? '–' : this.pct(row.cells[c_index])"/>
                            <td t-attf-class="ecd_num ecd_strong {{ row.net_margin &lt; 0 ? 'ecd_text_bad' : '' }}" t-out="this.pct(row.net_margin)"/>
                        </tr>
                    </tbody>
                </table>
            </div>
            <p class="ecd_note"><i class="fa fa-info-circle"/> Figures are shown before inter-company eliminations. Sales between sister companies appear in both revenue and cost.</p>
        </article>
    </t>



    <!-- ============================================================ EXPLORER -->
    <t t-name="executive_company_cost_dashboard.Explorer">
        <t t-set="ev" t-value="this.entityView"/>
        <div t-if="!ev">
            <t t-call="executive_company_cost_dashboard.Empty">
                <t t-set="icon" t-value="'fa-search-plus'"/>
                <t t-set="title">No branches or departments yet</t>
                <t t-set="text">Run the Smart Scan so analytic accounts are recognised as branches and departments.</t>
            </t>
        </div>
        <section class="ecd_costs" t-else="">
            <aside class="ecd_card ecd_bucket_list">
                <div class="ecd_pick_tools">
                    <input class="ecd_input" type="search" placeholder="Search branch or department…" t-model="state.explorerSearch"/>
                    <div class="ecd_pills">
                        <button t-foreach="this.entityKinds" t-as="kd" t-key="kd.key"
                                t-attf-class="ecd_pill {{ state.explorerKind === kd.key ? 'ecd_pill_active' : '' }}"
                                t-on-click="() => state.explorerKind = kd.key" t-out="kd.label"/>
                    </div>
                </div>
                <div class="ecd_list_title">
                    <span><t t-out="this.explorerList.length"/> listed · total cost</span>
                    <b t-out="this.money(this.explorerTotal)"/>
                </div>
                <div t-foreach="this.explorerList" t-as="en" t-key="en.id"
                     t-attf-class="ecd_bucket_item ecd_clickable {{ ev.e.id === en.id ? 'ecd_bucket_active' : '' }}"
                     t-on-click="() => this.selectEntity(en.id)">
                    <div class="ecd_bucket_main">
                        <div class="ecd_bucket_name"><t t-out="en.name"/> <span class="ecd_kind" t-out="this.kindLabel(en.kind)"/></div>
                        <div class="ecd_bucket_sub">
                            <b t-out="this.money(en.cost)"/>
                            <t t-call="executive_company_cost_dashboard.Delta"><t t-set="delta" t-value="en.delta_pct"/><t t-set="higher" t-value="false"/><t t-set="points" t-value="false"/></t>
                        </div>
                    </div>
                </div>
                <div t-if="!this.explorerList.length" class="ecd_muted ecd_pad">Nothing matches.</div>
            </aside>

            <div class="ecd_bucket_detail">
                <article class="ecd_card">
                    <header class="ecd_bucket_head">
                        <div class="ecd_bucket_head_text">
                            <h3><t t-out="ev.e.name"/> <span class="ecd_kind" t-out="this.kindLabel(ev.e.kind)"/></h3>
                            <div class="ecd_muted ecd_small"><t t-out="ev.e.full_name"/> · <t t-out="this.periodLabel"/> · <t t-out="this.companyLabel"/></div>
                        </div>
                        <button class="ecd_btn ecd_btn_sm" t-on-click="this.exportEntity"><i class="fa fa-download"/> CSV</button>
                        <button class="ecd_btn ecd_btn_sm" t-on-click="() => this.drillEntity(ev.e)"><i class="fa fa-list"/> Journal items</button>
                    </header>
                    <div class="ecd_bucket_stats">
                        <div><div class="ecd_label">Total cost</div><div class="ecd_big" t-out="this.money(ev.e.cost)"/>
                            <t t-call="executive_company_cost_dashboard.Delta"><t t-set="delta" t-value="ev.e.delta_pct"/><t t-set="higher" t-value="false"/><t t-set="points" t-value="false"/></t>
                        </div>
                        <div><div class="ecd_label">Previous period</div><div class="ecd_big ecd_big_muted" t-out="this.money(ev.e.prev_cost)"/></div>
                        <div t-if="ev.e.kind === 'branch'"><div class="ecd_label">Revenue</div><div class="ecd_big" t-out="this.money(ev.e.revenue)"/><span t-if="ev.e.source === 'pos'" class="ecd_pos_tag">POS</span></div>
                        <div t-if="ev.e.kind === 'branch'"><div class="ecd_label">Net result</div><div t-attf-class="ecd_big {{ ev.e.net_profit &lt; 0 ? 'ecd_text_bad' : '' }}" t-out="this.money(ev.e.net_profit)"/><span class="ecd_muted" t-out="ev.e.revenue ? this.pct(ev.e.net_margin) + ' margin' : ''"/></div>
                        <div><div class="ecd_label">Share of group cost</div><div class="ecd_big" t-out="this.pct(ev.e.pct_group_cost)"/></div>
                    </div>
                    <div class="ecd_focus ecd_focus_three">
                        <article t-foreach="ev.cards" t-as="cd" t-key="cd.code" class="ecd_card ecd_focus_card">
                            <div class="ecd_focus_top">
                                <span class="ecd_focus_icon" t-attf-style="background: {{ cd.color }}"><i t-attf-class="fa {{ cd.icon }}"/></span>
                                <span class="ecd_focus_name" t-out="cd.label"/>
                            </div>
                            <div class="ecd_focus_value" t-out="this.money(cd.amount)"/>
                            <div class="ecd_focus_foot">
                                <b t-out="this.pct(cd.pct)"/> <span class="ecd_muted">of its cost</span>
                                <t t-call="executive_company_cost_dashboard.Delta"><t t-set="delta" t-value="cd.delta"/><t t-set="higher" t-value="false"/><t t-set="points" t-value="false"/></t>
                            </div>
                        </article>
                    </div>
                </article>

                <article class="ecd_card">
                    <header class="ecd_card_head"><h3>Every cost, by type</h3><span class="ecd_muted ecd_small">amount · share of this cost · vs previous period</span></header>
                    <div t-if="!ev.buckets.length" class="ecd_muted ecd_pad">No cost is tagged to this branch or department in the period.</div>
                    <div class="ecd_table_wrap" t-else="">
                        <table class="ecd_table ecd_table_compact">
                            <thead><tr><th class="ecd_left">Cost</th><th>Amount</th><th>Share</th><th>Previous</th><th>Change</th></tr></thead>
                            <tbody>
                                <tr t-foreach="ev.buckets" t-as="b" t-key="b.code">
                                    <td class="ecd_left"><i class="ecd_dotc" t-attf-style="background: {{ b.color }}"/> <t t-out="b.name"/></td>
                                    <td class="ecd_num ecd_strong" t-out="this.money(b.amount)"/>
                                    <td class="ecd_num ecd_share_cell">
                                        <div class="ecd_bar_track ecd_bar_mini"><div class="ecd_bar_fill" t-attf-style="width: {{ Math.min(b.pct, 100) }}%; background: {{ b.color }}"/></div>
                                        <span t-out="this.pct(b.pct, 0)"/>
                                    </td>
                                    <td class="ecd_num ecd_muted" t-out="this.money(b.prev)"/>
                                    <td class="ecd_num"><t t-call="executive_company_cost_dashboard.Delta"><t t-set="delta" t-value="b.delta"/><t t-set="higher" t-value="false"/><t t-set="points" t-value="false"/></t></td>
                                </tr>
                            </tbody>
                            <tfoot><tr class="ecd_row_total"><td class="ecd_left">Total</td><td class="ecd_num" t-out="this.money(ev.e.cost)"/><td/><td class="ecd_num" t-out="this.money(ev.e.prev_cost)"/><td/></tr></tfoot>
                        </table>
                    </div>
                </article>

                <section class="ecd_grid ecd_grid_three" t-if="ev.hr.length or ev.utilities.length or ev.rent.length">
                    <article class="ecd_card" t-foreach="[['hr', 'People cost detail'], ['utilities', 'Utilities detail'], ['rent', 'Rent detail']]" t-as="tp" t-key="tp[0]" t-if="ev[tp[0]].length">
                        <header class="ecd_card_head"><h3 t-out="tp[1]"/></header>
                        <div class="ecd_bars">
                            <div class="ecd_bar_row" t-foreach="ev[tp[0]]" t-as="sb" t-key="sb.key">
                                <div class="ecd_bar_label"><span t-out="sb.name"/></div>
                                <div class="ecd_bar_track"><div class="ecd_bar_fill" t-attf-style="width: {{ sb.pct }}%; background: #3b6fe0"/></div>
                                <div class="ecd_bar_val"><b t-out="this.money(sb.amount)"/><span class="ecd_muted" t-out="this.pct(sb.pct, 0)"/></div>
                            </div>
                        </div>
                    </article>
                </section>

                <article class="ecd_card" t-if="ev.bars">
                    <header class="ecd_card_head"><h3>Monthly cost</h3><span class="ecd_muted ecd_small">last 12 months</span></header>
                    <t t-call="executive_company_cost_dashboard.MiniBars"><t t-set="mb" t-value="ev.bars"/></t>
                </article>

                <article class="ecd_card" t-if="ev.e.companies.length &gt; 1">
                    <header class="ecd_card_head"><h3>Cost by company</h3></header>
                    <div class="ecd_bars">
                        <div class="ecd_bar_row" t-foreach="ev.e.companies" t-as="co" t-key="co.id">
                            <div class="ecd_bar_label"><span t-out="co.name"/></div>
                            <div class="ecd_bar_track"><div class="ecd_bar_fill" t-attf-style="width: {{ ev.e.cost ? co.cost / ev.e.cost * 100 : 0 }}%; background: var(--ecd-gold)"/></div>
                            <div class="ecd_bar_val"><b t-out="this.money(co.cost)"/></div>
                        </div>
                    </div>
                </article>
            </div>
        </section>
    </t>

    <t t-name="executive_company_cost_dashboard.MiniBars">
        <div class="ecd_chart">
            <svg class="ecd_svg" t-att-viewBox="'0 0 ' + mb.w + ' ' + mb.h" preserveAspectRatio="xMidYMid meet">
                <line x1="0" t-att-x2="mb.w" t-att-y1="mb.base" t-att-y2="mb.base" class="ecd_gridline ecd_zero"/>
                <g t-foreach="mb.bars" t-as="bar" t-key="bar.key">
                    <rect t-att-x="bar.x" t-att-y="bar.y" t-att-width="bar.w" t-att-height="bar.h" rx="2" t-att-fill="mb.color"><title t-out="bar.tip"/></rect>
                    <text class="ecd_axis" text-anchor="middle" t-att-x="bar.cx" t-att-y="mb.h - 6" t-out="bar.label"/>
                </g>
            </svg>
        </div>
    </t>

    <!-- ============================================================ EXPENSE FINDER -->
    <t t-name="executive_company_cost_dashboard.Finder">
        <t t-set="fv" t-value="this.finderView"/>
        <div class="ecd_section_title">
            <h2>Expense finder</h2>
            <button class="ecd_btn ecd_btn_sm" t-on-click="this.exportFinder"><i class="fa fa-download"/> Export CSV</button>
        </div>
        <article class="ecd_card ecd_finder_search">
            <div class="ecd_search_box">
                <i class="fa fa-search"/>
                <input type="search" class="ecd_search_input" placeholder="Search any expense: internet, Odoo, electricity, rent, salaries…"
                       t-att-value="state.finderQuery" t-on-input="(ev) => this.setFinder(ev.target.value)"/>
            </div>
            <div class="ecd_chips">
                <button t-foreach="this.finderChips" t-as="ch" t-key="ch.q" t-attf-class="ecd_qchip {{ state.finderQuery === ch.q ? 'ecd_qchip_active' : '' }}"
                        t-on-click="() => this.setFinder(ch.q)" t-out="ch.label"/>
                <button class="ecd_qchip" t-if="state.finderQuery or state.finderGroup" t-on-click="() => this.setFinder('')"><i class="fa fa-times"/> Clear</button>
            </div>
            <div class="ecd_group_row">
                <span class="ecd_muted">Group</span>
                <select class="ecd_select" t-on-change="this.onFinderGroup">
                    <option value="" t-att-selected="!state.finderGroup">All groups</option>
                    <option t-foreach="this.finderGroups" t-as="gr" t-key="gr.code" t-att-value="gr.code"
                            t-att-selected="state.finderGroup === gr.code" t-out="gr.name + ' · ' + this.money(gr.amount)"/>
                </select>
            </div>
        </article>
        <section class="ecd_costs">
            <aside class="ecd_card ecd_bucket_list">
                <div class="ecd_list_title">
                    <span><t t-out="this.finderMatches.length"/> expenses</span>
                    <b t-out="this.money(fv.total)"/>
                </div>
                <div t-foreach="this.finderMatches" t-as="ac" t-key="ac.id"
                     t-attf-class="ecd_bucket_item ecd_clickable {{ state.finderSelected === ac.id ? 'ecd_bucket_active' : '' }}"
                     t-on-click="() => this.selectExpense(ac.id)">
                    <i class="ecd_dotc" t-attf-style="background: {{ ac.color }}"/>
                    <div class="ecd_bucket_main">
                        <div class="ecd_bucket_name"><span class="ecd_code" t-out="ac.code"/> <t t-out="ac.name"/></div>
                        <div class="ecd_bucket_sub ecd_muted ecd_small"><t t-out="ac.bucket_name"/></div>
                    </div>
                    <div class="ecd_expense_amt">
                        <b t-out="this.money(ac.amount)"/>
                        <t t-call="executive_company_cost_dashboard.Delta"><t t-set="delta" t-value="ac.delta_pct"/><t t-set="higher" t-value="false"/><t t-set="points" t-value="false"/></t>
                    </div>
                </div>
                <div t-if="!this.finderMatches.length" class="ecd_muted ecd_pad">No expense matches “<t t-out="state.finderQuery"/>”.</div>
            </aside>

            <div class="ecd_bucket_detail" t-if="fv.count">
                <article class="ecd_card">
                    <header class="ecd_bucket_head">
                        <div class="ecd_bucket_head_text">
                            <h3 t-out="fv.title"/>
                            <div class="ecd_muted ecd_small"><t t-out="fv.subtitle"/> · <t t-out="this.periodLabel"/> · <t t-out="this.companyLabel"/></div>
                        </div>
                        <button class="ecd_btn ecd_btn_sm" t-on-click="() => this.drillExpenses(fv)"><i class="fa fa-list"/> Journal items</button>
                    </header>
                    <div class="ecd_bucket_stats">
                        <div><div class="ecd_label">This period</div><div class="ecd_big" t-out="this.money(fv.amount)"/></div>
                        <div><div class="ecd_label">Previous period</div><div class="ecd_big ecd_big_muted" t-out="this.money(fv.prev)"/>
                            <t t-call="executive_company_cost_dashboard.Delta"><t t-set="delta" t-value="fv.delta"/><t t-set="higher" t-value="false"/><t t-set="points" t-value="false"/></t>
                        </div>
                        <div><div class="ecd_label">% of revenue</div><div class="ecd_big" t-out="this.pct(fv.pctRevenue, 2)"/></div>
                        <div><div class="ecd_label">Monthly average</div><div class="ecd_big" t-out="this.money(fv.amount / Math.max(1, state.data.monthly.length))"/></div>
                    </div>
                    <div class="ecd_note ecd_picked_note" t-if="!fv.picked and fv.count &gt; 1">Showing the combined total of all <t t-out="fv.count"/> listed expenses. Tap one on the left to see only that expense.</div>
                    <t t-if="fv.bars"><div class="ecd_label ecd_gap_top">By month</div><t t-call="executive_company_cost_dashboard.MiniBars"><t t-set="mb" t-value="fv.bars"/></t></t>
                </article>

                <article class="ecd_card">
                    <header class="ecd_card_head"><h3>Who is it charged to?</h3><span class="ecd_muted ecd_small">branches &amp; departments</span></header>
                    <div class="ecd_bars">
                        <div class="ecd_bar_row ecd_clickable" t-foreach="fv.entities" t-as="en" t-key="en.id" t-on-click="() => this.openEntity(en.id)">
                            <div class="ecd_bar_label"><span t-out="en.name"/> <span class="ecd_kind" t-out="this.kindLabel(en.kind)"/></div>
                            <div class="ecd_bar_track"><div class="ecd_bar_fill" t-attf-style="width: {{ en.amount / fv.entityMax * 100 }}%; background: #3b6fe0"/></div>
                            <div class="ecd_bar_val"><b t-out="this.money(en.amount)"/><span class="ecd_muted" t-out="this.pct(fv.amount ? en.amount / fv.amount * 100 : 0, 0)"/></div>
                        </div>
                        <div class="ecd_bar_row" t-if="fv.unallocated">
                            <div class="ecd_bar_label"><i class="fa fa-question-circle-o"/> <span>Not allocated</span></div>
                            <div class="ecd_bar_track"><div class="ecd_bar_fill" t-attf-style="width: {{ fv.unallocated / fv.entityMax * 100 }}%; background: #d9822b"/></div>
                            <div class="ecd_bar_val"><b t-out="this.money(fv.unallocated)"/><span class="ecd_muted" t-out="this.pct(fv.amount ? fv.unallocated / fv.amount * 100 : 0, 0)"/></div>
                        </div>
                        <div t-if="!fv.entities.length and !fv.unallocated" class="ecd_muted ecd_pad">No split available.</div>
                    </div>
                </article>

                <article class="ecd_card" t-if="fv.companies.length &gt; 1">
                    <header class="ecd_card_head"><h3>By company</h3></header>
                    <div class="ecd_bars">
                        <div class="ecd_bar_row" t-foreach="fv.companies" t-as="co" t-key="co.id">
                            <div class="ecd_bar_label"><span t-out="co.name"/></div>
                            <div class="ecd_bar_track"><div class="ecd_bar_fill" t-attf-style="width: {{ fv.amount ? co.amount / fv.amount * 100 : 0 }}%; background: var(--ecd-gold)"/></div>
                            <div class="ecd_bar_val"><b t-out="this.money(co.amount)"/></div>
                        </div>
                    </div>
                </article>
            </div>
        </section>
    </t>


</templates>
