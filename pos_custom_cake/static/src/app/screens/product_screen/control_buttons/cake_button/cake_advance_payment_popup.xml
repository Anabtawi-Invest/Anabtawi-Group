<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="pos_custom_cake.CakeAdvancePaymentPopup" owl="1">
        <Dialog size="'md'" title="dialogTitle">
            <div class="cake-advance-payment-popup p-2">
                <div class="rounded-top px-3 py-2 mb-3 text-white"
                     style="background: linear-gradient(135deg, #6f42c1 0%, #9b59b6 100%);">
                    <span class="fw-bold" t-esc="dialogTitle"/>
                    <small class="d-block opacity-75" t-if="props.partnerName">
                        <t t-esc="labels.customer"/>: <t t-esc="props.partnerName"/>
                    </small>
                </div>

                <div class="alert alert-light border mb-3 py-2">
                    <div class="d-flex justify-content-between">
                        <span t-esc="labels.cakeTotal"/>
                        <strong t-esc="formatAmount(cakeTotal)"/>
                    </div>
                </div>

                <div class="form-group mb-3">
                    <label>
                        <strong><t t-esc="labels.advanceAmount"/> <span class="text-danger">*</span></strong>
                    </label>
                    <input type="text" inputmode="decimal" class="form-control" autocomplete="off"
                           placeholder="0.00"
                           t-att-value="state.advance_amount_str"
                           t-on-input="onAdvanceAmountInput"
                           t-on-blur="onAdvanceAmountBlur"/>
                </div>

                <div class="form-group mb-3">
                    <label>
                        <strong><t t-esc="labels.amountTendered"/> <span class="text-danger">*</span></strong>
                    </label>
                    <input type="text" inputmode="decimal" class="form-control" autocomplete="off"
                           placeholder="0.00"
                           t-att-value="state.amount_tendered_str"
                           t-on-input="onAmountTenderedInput"
                           t-on-blur="onAmountTenderedBlur"/>
                    <small class="form-text text-muted" t-esc="labels.amountTenderedHint"/>
                </div>

                <div t-if="changeDue > 0" class="alert alert-info py-2 mb-3" role="status">
                    <strong t-esc="labels.changeReturned"/>:
                    <span class="ms-1" t-esc="formatAmount(changeDue)"/>
                </div>

                <div t-if="advanceAmount > 0" class="alert alert-secondary py-2 mb-3" role="status">
                    <strong t-esc="labels.remaining"/>:
                    <span class="ms-1" t-esc="formatAmount(remainingAfterAdvance)"/>
                </div>

                <div class="form-group mb-2">
                    <label><strong t-esc="labels.paymentMethod"/></label>
                    <div t-if="!state.payment_methods.length" class="alert alert-warning mb-0">
                        <span t-esc="noEligiblePaymentMethodsText"/>
                    </div>
                    <div t-else="" class="paymentmethods d-flex flex-column gap-2">
                        <t t-foreach="state.payment_methods" t-as="pm" t-key="pm.id">
                            <div role="button"
                                 t-att-class="paymentMethodRowClass(pm)"
                                 t-on-click="() => this.selectPaymentMethod(pm)">
                                <div class="payment-method-display d-flex align-items-center gap-2 text-wrap lh-sm">
                                    <img class="payment-method-icon"
                                         t-att-src="paymentMethodIconSrc(pm)"
                                         alt=""/>
                                    <span class="payment-name" t-esc="pm.name"/>
                                </div>
                                <div class="text-end text-muted small">
                                    <span t-esc="formatAmount(advanceAmount)"/>
                                </div>
                            </div>
                        </t>
                    </div>
                </div>
            </div>

            <t t-set-slot="footer">
                <button class="btn btn-secondary" t-on-click="cancel" type="button">
                    <t t-esc="labels.cancel"/>
                </button>
                <button class="btn btn-primary" t-on-click="confirm" type="button">
                    💰 <t t-esc="labels.confirm"/>
                </button>
            </t>
        </Dialog>
    </t>
</templates>
