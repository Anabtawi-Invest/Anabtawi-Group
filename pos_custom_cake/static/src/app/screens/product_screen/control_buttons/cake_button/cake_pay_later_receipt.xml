<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="pos_custom_cake.CakePayLaterReceipt">
        <div class="pos-receipt p-2">
            <div class="text-center">
                <div class="fw-bolder" t-esc="props.receipt.companyName"/>
                <div t-esc="props.receipt.posName"/>
                <div class="pt-1">🎂 <t t-esc="labels.customCakeOrder"/></div>
            </div>

            <div class="pt-3">
                <div>
                    <strong t-esc="labels.orderNumber"/>:
                    <span t-esc="props.receipt.reference"/>
                </div>
                <div>
                    <strong t-esc="labels.date"/>:
                    <span t-esc="props.receipt.date"/>
                </div>
                <div>
                    <strong t-esc="labels.customer"/>:
                    <span t-esc="props.receipt.customerName"/>
                </div>
                <div>
                    <strong t-esc="labels.status"/>:
                    <span t-esc="statusLabel"/>
                </div>
            </div>

            <div class="pt-3 border-top mt-2">
                <div class="d-flex fw-bolder">
                    <span class="w-75" t-esc="props.receipt.productName"/>
                    <span class="w-25 text-end" t-esc="formatCurrency(props.receipt.finalPrice)"/>
                </div>
                <div class="text-muted small">
                    <t t-esc="props.receipt.pieces"/> <t t-esc="labels.pieces"/>
                </div>
            </div>

            <div class="pt-3 border-top mt-2">
                <div class="d-flex fw-bolder fs-5">
                    <span t-esc="labels.total"/>
                    <span class="ms-auto" t-esc="formatCurrency(props.receipt.finalPrice)"/>
                </div>
            </div>

            <div class="text-center pt-3">
                <span t-esc="labels.payAtCounter"/>
            </div>
        </div>
    </t>
</templates>
