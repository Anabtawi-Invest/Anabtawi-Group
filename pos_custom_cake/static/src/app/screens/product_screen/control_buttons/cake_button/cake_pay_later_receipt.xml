<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="pos_custom_cake.CakePayLaterReceipt">
        <div class="pos-receipt p-2">
            <div class="text-center">
                <div class="fw-bolder" t-esc="props.receipt.companyName"/>
                <div t-esc="props.receipt.posName"/>
                <div class="pt-1">🎂 <t t-esc="props.receipt.title"/></div>
            </div>

            <div class="pt-3">
                <div>
                    <strong t-esc="props.receipt.orderNumberLabel"/>:
                    <span t-esc="props.receipt.reference"/>
                </div>
                <div>
                    <strong t-esc="props.receipt.dateLabel"/>:
                    <span t-esc="props.receipt.date"/>
                </div>
                <div>
                    <strong t-esc="props.receipt.customerLabel"/>:
                    <span t-esc="props.receipt.customerName"/>
                </div>
                <div>
                    <strong t-esc="props.receipt.statusLabel"/>:
                    <span t-esc="props.receipt.statusText"/>
                </div>
            </div>

            <div class="pt-3 border-top mt-2">
                <div class="d-flex fw-bolder">
                    <span class="w-75" t-esc="props.receipt.productName"/>
                    <span class="w-25 text-end" t-esc="props.receipt.finalPriceFormatted"/>
                </div>
                <div class="text-muted small">
                    <t t-esc="props.receipt.pieces"/> <t t-esc="props.receipt.piecesLabel"/>
                </div>
                <div t-if="props.receipt.note" class="text-muted small pt-1">
                    <strong t-esc="props.receipt.noteLabel"/>:
                    <span t-esc="props.receipt.note"/>
                </div>
            </div>

            <div class="pt-3 border-top mt-2">
                <div class="d-flex fw-bolder fs-5">
                    <span t-esc="props.receipt.totalLabel"/>
                    <span class="ms-auto" t-esc="props.receipt.finalPriceFormatted"/>
                </div>
            </div>

            <div class="text-center pt-3">
                <span t-esc="props.receipt.footerText"/>
            </div>
        </div>
    </t>
</templates>
