<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pos_config_form_custom_cake" model="ir.ui.view">
        <field name="name">pos.config.form.custom.cake</field>
        <field name="model">pos.config</field>
        <field name="inherit_id" ref="point_of_sale.pos_config_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Custom Cake" name="pos_custom_cake_config">
                    <field name="enable_custom_cake"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
