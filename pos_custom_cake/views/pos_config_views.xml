<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pos_config_form_custom_cake" model="ir.ui.view">
        <field name="name">pos.config.form.custom.cake</field>
        <field name="model">pos.config</field>
        <field name="inherit_id" ref="point_of_sale.pos_config_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='other_devices']" position="after">
                <setting string="Custom Cake" help="Enable custom cake ordering in this Point of Sale.">
                    <field name="enable_custom_cake"/>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
