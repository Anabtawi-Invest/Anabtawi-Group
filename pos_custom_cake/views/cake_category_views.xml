<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_cake_category_form" model="ir.ui.view">
        <field name="name">cake.category.form</field>
        <field name="model">cake.category</field>
        <field name="arch" type="xml">
            <form string="Cake Category">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Category Name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Products" name="products">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="product_id"/>
                                    <field name="quantity"/>
                                    <field name="cost"/>
                                    <field name="active" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_cake_category_list" model="ir.ui.view">
        <field name="name">cake.category.list</field>
        <field name="model">cake.category</field>
        <field name="arch" type="xml">
            <list string="Cake Categories">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="action_cake_category" model="ir.actions.act_window">
        <field name="name">Cake Categories</field>
        <field name="res_model">cake.category</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
