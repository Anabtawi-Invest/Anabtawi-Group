<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_cake_size_form" model="ir.ui.view">
        <field name="name">cake.size.form</field>
        <field name="model">cake.size</field>
        <field name="arch" type="xml">
            <form string="Cake Size">
                <sheet>
                    <group>
                        <field name="pieces"/>
                        <field name="product_id"/>
                        <field name="cake_base_cost"/>
                        <field name="name" readonly="1"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_cake_size_list" model="ir.ui.view">
        <field name="name">cake.size.list</field>
        <field name="model">cake.size</field>
        <field name="arch" type="xml">
            <list string="Cake Sizes">
                <field name="pieces"/>
                <field name="product_id"/>
                <field name="cake_base_cost"/>
                <field name="name"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="action_cake_size" model="ir.actions.act_window">
        <field name="name">Cake Sizes</field>
        <field name="res_model">cake.size</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
