<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-inherit="point_of_sale.ControlButtons" t-inherit-mode="extension" owl="1">
        <xpath expr="//div[contains(@class, 'control-buttons')]" position="inside">
            <button class="btn btn-primary btn-lg lh-lg text-start flex-grow-1 border fw-bold d-flex align-items-center me-2"
                    t-on-click="onClickScheduledOrdersList">
                <i class="fa fa-list-alt fs-3 me-2"/>
                <span class="ms-2 fs-6">قائمة طلبيات التواصي - List of Scheduled Orders</span>
            </button>
        </xpath>
    </t>
</templates>
