<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-inherit="point_of_sale.ControlButtons" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('control-buttons')]" position="inside">
            <t t-if="pos.config.enable_fulfillment_schedule">
                <button type="button" 
                        t-att-class="cateringButtonClass()" 
                        t-on-click="onClickCatering">
                    <i class="fa fa-cutlery me-2"/>
                    <t t-esc="cateringButtonLabel"/>
                </button>
            </t>
        </xpath>
    </t>
</templates>
