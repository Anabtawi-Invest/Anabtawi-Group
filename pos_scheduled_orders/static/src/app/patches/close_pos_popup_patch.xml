<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-inherit="point_of_sale.ClosePosPopup" t-inherit-mode="extension" owl="1">
        <xpath expr="//t[@t-slot='footer']" position="before">
            <div class="card p-3 my-2 bg-light border text-end" dir="rtl" style="font-size: 14px;">
                <div class="fw-bold text-primary mb-2">
                    <i class="fa fa-calculator me-1"/> إدخال وتصفير الفروقات / إدخال المبلغ المقبوض (Counted Cash &amp; Settlement)
                </div>
                <t t-if="props.default_cash_details">
                    <div class="d-flex justify-content-between align-items-center mb-2 pb-2 border-bottom">
                        <span class="fw-bold text-dark"><t t-esc="props.default_cash_details.name"/> (النقدية)</span>
                        <div class="input-group style-input-group w-50">
                            <button type="button" class="btn btn-sm btn-success fw-bold" 
                                    t-on-click="() => this.setCountedToExpected(props.default_cash_details.id, props.default_cash_details.amount)">
                                <i class="fa fa-check me-1"/> مطابقة (<t t-esc="env.utils.formatCurrency(props.default_cash_details.amount)"/>)
                            </button>
                            <input type="number" step="0.001" class="form-control form-control-sm text-center fw-bold text-success fs-6" 
                                   t-att-value="state.payments[props.default_cash_details.id] ? state.payments[props.default_cash_details.id].counted : 0" 
                                   t-on-input="(ev) => this.onCountedAmountInput(props.default_cash_details.id, ev)"/>
                        </div>
                    </div>
                </t>
                <t t-foreach="props.non_cash_payment_methods" t-as="pm" t-key="pm.id">
                    <div class="d-flex justify-content-between align-items-center mb-2 pb-2 border-bottom">
                        <span class="fw-bold text-dark"><t t-esc="pm.name"/></span>
                        <div class="input-group style-input-group w-50">
                            <button type="button" class="btn btn-sm btn-success fw-bold" 
                                    t-on-click="() => this.setCountedToExpected(pm.id, pm.amount)">
                                <i class="fa fa-check me-1"/> مطابقة (<t t-esc="env.utils.formatCurrency(pm.amount)"/>)
                            </button>
                            <input type="number" step="0.001" class="form-control form-control-sm text-center fw-bold text-success fs-6" 
                                   t-att-value="state.payments[pm.id] ? state.payments[pm.id].counted : 0" 
                                   t-on-input="(ev) => this.onCountedAmountInput(pm.id, ev)"/>
                        </div>
                    </div>
                </t>
            </div>
        </xpath>
    </t>
</templates>
