<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-inherit="point_of_sale.OrderReceipt" t-inherit-mode="extension" owl="1">
        <xpath expr="//div[contains(@class, 'pos-receipt-order-data')]" position="before">
            <t t-if="fulfillmentInfo">
                <div class="scheduled-order-receipt-section border-top border-bottom py-2 my-2 text-center" dir="rtl" style="font-size: 13px;">
                    <div class="fw-bold fs-6 text-uppercase border-bottom pb-1 mb-2 text-primary">
                        <t t-esc="fulfillmentInfo.typeLabel"/>
                    </div>
                    <t t-if="fulfillmentInfo.contactName">
                        <div class="d-flex justify-content-between my-1">
                            <span>العميل:</span>
                            <span class="fw-bold"><t t-esc="fulfillmentInfo.contactName"/></span>
                        </div>
                    </t>
                    <t t-if="fulfillmentInfo.contactPhone">
                        <div class="d-flex justify-content-between my-1">
                            <span>رقم الهاتف:</span>
                            <span class="fw-bold"><t t-esc="fulfillmentInfo.contactPhone"/></span>
                        </div>
                    </t>
                    <t t-if="fulfillmentInfo.scheduledTime">
                        <div class="d-flex justify-content-between my-1">
                            <span>موعد التسليم:</span>
                            <span class="fw-bold"><t t-esc="fulfillmentInfo.scheduledTime"/></span>
                        </div>
                    </t>
                    <t t-if="fulfillmentInfo.address">
                        <div class="d-flex justify-content-between my-1">
                            <span>العنوان:</span>
                            <span class="fw-bold"><t t-esc="fulfillmentInfo.address"/></span>
                        </div>
                    </t>

                    <div class="border-top pt-2 mt-2">
                        <div class="d-flex justify-content-between my-1 fw-bold">
                            <span>إجمالي قيمة الطلب:</span>
                            <span><t t-esc="env.utils.formatCurrency(fulfillmentInfo.totalAmount)"/></span>
                        </div>
                        <t t-if="fulfillmentInfo.advanceDepositPaid">
                            <div class="d-flex justify-content-between my-1 text-primary">
                                <span>العربون المدفوع سابقاً:</span>
                                <span class="fw-bold"><t t-esc="env.utils.formatCurrency(fulfillmentInfo.advanceDepositPaid)"/></span>
                            </div>
                        </t>
                        <t t-if="fulfillmentInfo.settledPaymentNow">
                            <div class="d-flex justify-content-between my-1 text-success">
                                <span>المبلغ المسدد الآن:</span>
                                <span class="fw-bold"><t t-esc="env.utils.formatCurrency(fulfillmentInfo.settledPaymentNow)"/></span>
                            </div>
                        </t>
                        <div class="d-flex justify-content-between my-1 fw-bold">
                            <span>المتبقي المطلوب:</span>
                            <span class="text-danger"><t t-esc="env.utils.formatCurrency(fulfillmentInfo.balanceDue)"/></span>
                        </div>
                    </div>
                </div>
            </t>
        </xpath>
    </t>
</templates>
