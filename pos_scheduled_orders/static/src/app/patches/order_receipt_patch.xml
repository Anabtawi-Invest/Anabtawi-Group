<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-inherit="point_of_sale.OrderReceipt" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('pos-receipt')]" position="after">
            <!-- JoFotara ISTD Dual-Mode POS Receipt Banner in Arabic & English -->
            <t t-if="fulfillmentInfo">
                <div class="pos-receipt-fulfillment-header mb-3 p-2 text-center" 
                     style="border: 2px dashed #000; border-radius: 6px; background-color: #f9f9f9;" dir="rtl">
                    
                    <!-- Day 1 Partial Deposit Header Banner -->
                    <t t-if="fulfillmentInfo.isAdvanceDeposit">
                        <div style="font-size: 15px; font-weight: bold; text-transform: uppercase; color: #d9534f; border-bottom: 2px solid #d9534f; padding-bottom: 4px; margin-bottom: 6px;">
                            *** سند عربون مقدم - ليس فاتورة ضريبية ***<br/>
                            <span style="font-size: 11px; font-weight: normal; color: #333;">(ADVANCE DEPOSIT VOUCHER - NO JOFOTARA QR)</span>
                        </div>
                    </t>

                    <!-- Day 2 Final Tax Invoice Banner -->
                    <t t-else="">
                        <div style="font-size: 15px; font-weight: bold; text-transform: uppercase; color: #28a745; border-bottom: 2px solid #28a745; padding-bottom: 4px; margin-bottom: 6px;">
                            *** فاتورة ضريبية قانونية (ممتثل لجوفوتارا ISTD) ***
                        </div>
                    </t>

                    <div style="font-size: 14px; font-weight: bold; text-transform: uppercase; margin-bottom: 3px;">
                        نوع الطلب: <t t-esc="fulfillmentInfo.typeLabel"/>
                        <t t-if="fulfillmentInfo.isCatering"> (طلب ضيافة - CATERING)</t>
                    </div>
                    <div style="font-size: 13px; font-weight: bold; margin-bottom: 2px;">
                        موعد وتاريخ التسليم: <t t-esc="fulfillmentInfo.scheduledTime"/>
                    </div>
                    <div style="font-size: 12px; margin-bottom: 2px;">
                        بيانات العميل: <t t-esc="fulfillmentInfo.contactName"/> - <t t-esc="fulfillmentInfo.contactPhone"/>
                    </div>
                    <t t-if="fulfillmentInfo.isDelivery &amp;&amp; fulfillmentInfo.address">
                        <div style="font-size: 12px; font-weight: bold; border-top: 1px dotted #ccc; padding-top: 2px; margin-top: 2px;">
                            عنوان التوصيل: <t t-esc="fulfillmentInfo.address"/>
                        </div>
                    </t>

                    <!-- Deposit Summary on Day 1 Receipts -->
                    <t t-if="fulfillmentInfo.isAdvanceDeposit">
                        <div style="border-top: 1px dashed #000; margin-top: 5px; padding-top: 4px; font-size: 12px;">
                            <div><strong>العربون المدفوع اليوم:</strong> <t t-esc="props.formatCurrency(fulfillmentInfo.depositPaidAmount)"/></div>
                            <div style="font-weight: bold; color: #d9534f;"><strong>المبلغ المتبقي غير المدفوع:</strong> <t t-esc="props.formatCurrency(fulfillmentInfo.outstandingBalanceDue)"/></div>
                        </div>
                    </t>
                </div>
            </t>
        </xpath>
    </t>
</templates>
