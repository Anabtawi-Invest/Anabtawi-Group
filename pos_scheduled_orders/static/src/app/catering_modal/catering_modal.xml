<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="pos_scheduled_orders.CateringModal">
        <Dialog title="'رسوم خدمة الضيافة والكترنج (CATERING_FEE)'">
            <div class="pos-catering-modal container-fluid p-2" dir="rtl">
                <t t-if="state.error_message">
                    <div class="alert alert-danger fw-bold mb-3">
                        <i class="fa fa-exclamation-circle me-1"/> <t t-esc="state.error_message"/>
                    </div>
                </t>

                <div class="card p-3 bg-light border mb-3">
                    <label class="form-label fw-bold text-success fs-5 mb-2">
                        <i class="fa fa-cutlery me-2"/> رسوم خدمة الضيافة والكثرنج (Catering Service Fee)
                    </label>
                    <div class="input-group input-group-lg">
                        <input type="number" step="0.01" min="0" class="form-control text-start" 
                               t-att-value="state.catering_fee" t-on-change="onFeeInput" placeholder="أدخل مبلغ الرسوم"/>
                        <span class="input-group-text"><i class="fa fa-money-bill"/></span>
                    </div>
                    <small class="text-muted mt-2">
                        يضيف/يحدّث سطر منتج رسوم الضيافة `CATERING_FEE` على السلة.
                    </small>
                </div>
            </div>

            <t t-slot="footer">
                <button type="button" class="btn btn-success btn-lg fw-bold me-2 px-4" t-on-click="confirm">
                    <i class="fa fa-check me-1"/> إضافة رسوم الضيافة (Add Fee)
                </button>
                <button type="button" class="btn btn-secondary btn-lg px-4" t-on-click="cancel">
                    إلغاء (Cancel)
                </button>
            </t>
        </Dialog>
    </t>
</templates>
