<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="pos_scheduled_orders.CompleteScheduleModal">
        <Dialog title="'استكمال طلبات التواصي - Settlement'">
            <div class="pos-complete-schedule-modal container-fluid p-2" dir="rtl">
                <t t-if="state.error_message">
                    <div class="alert alert-danger fw-bold d-flex align-items-center mb-3" role="alert">
                        <i class="fa fa-exclamation-triangle fs-4 me-2"/>
                        <div><t t-esc="state.error_message"/></div>
                    </div>
                </t>

                <div class="input-group input-group-lg mb-3">
                    <span class="input-group-text"><i class="fa fa-search"/></span>
                    <input type="text" class="form-control text-end" 
                           t-model="state.searchQuery" 
                           t-on-input="onSearchInput" 
                           placeholder="بحث باسم العميل، رقم الهاتف، أو رقم الطلب..."/>
                </div>

                <div class="row g-3">
                    <div class="col-md-7">
                        <div class="card shadow-sm border">
                            <div class="card-header bg-primary text-white fw-bold d-flex justify-content-between align-items-center">
                                <span><i class="fa fa-list me-1"/> طلبات التواصي المعلقة للفرع</span>
                                <span class="badge bg-light text-dark"><t t-esc="state.orders.length"/> طلب</span>
                            </div>
                            <div class="card-body p-0" style="max-height: 340px; overflow-y: auto;">
                                <t t-if="state.loading">
                                    <div class="text-center p-4">
                                        <i class="fa fa-spinner fa-spin fs-2 text-primary mb-2"/>
                                        <div class="fw-bold">جاري تحميل الطلبات المعلقة...</div>
                                    </div>
                                </t>
                                <t t-elif="!state.orders.length">
                                    <div class="text-center p-4 text-muted">
                                        <i class="fa fa-info-circle fs-2 mb-2"/>
                                        <div class="fw-bold">لا توجد طلبات تواصي معلقة حالياً لهذا الفرع.</div>
                                    </div>
                                </t>
                                <t t-else="">
                                    <div class="list-group list-group-flush">
                                        <t t-foreach="state.orders" t-as="order" t-key="order.id">
                                            <button type="button" 
                                                    t-attf-class="list-group-item list-group-item-action text-end p-3 {{state.selectedOrderId === order.id ? 'active bg-primary text-white' : ''}}"
                                                    t-on-click="() => this.selectOrder(order)">
                                                <div class="d-flex justify-content-between align-items-center mb-1">
                                                    <span class="fw-bold fs-6"><t t-esc="order.customer_name"/></span>
                                                    <span class="badge bg-warning text-dark"><t t-esc="order.name"/></span>
                                                </div>
                                                <div class="d-flex justify-content-between align-items-center fs-6">
                                                    <span><i class="fa fa-phone me-1"/> <t t-esc="order.customer_phone"/></span>
                                                    <span><i class="fa fa-clock-o me-1"/> <t t-esc="order.scheduled_datetime"/></span>
                                                </div>
                                                <div class="d-flex justify-content-between align-items-center mt-2 pt-2 border-top">
                                                    <span class="small opacity-75">الإجمالي: <t t-esc="order.amount_total.toFixed(3)"/> JOD</span>
                                                    <span class="small opacity-75">العربون: <t t-esc="order.amount_paid.toFixed(3)"/> JOD</span>
                                                    <span class="fw-bold fs-6 text-danger">المتبقي: <t t-esc="order.amount_due.toFixed(3)"/> JOD</span>
                                                </div>
                                            </button>
                                        </t>
                                    </div>
                                </t>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-5">
                        <div class="card shadow-sm border bg-light">
                            <div class="card-header bg-dark text-white fw-bold">
                                <i class="fa fa-calculator me-1"/> تفاصيل سداد وتأكيد الاستلام
                            </div>
                            <div class="card-body">
                                <t t-if="selectedOrder">
                                    <div class="mb-3 text-center p-2 bg-white rounded border">
                                        <small class="text-muted d-block">العميل المحدد</small>
                                        <div class="fw-bold fs-5 text-primary"><t t-esc="selectedOrder.customer_name"/></div>
                                        <small class="text-muted"><t t-esc="selectedOrder.customer_phone"/></small>
                                    </div>

                                    <div class="mb-3">
                                        <label class="form-label fw-bold">طريقة دفع المتبقي (Payment Method)</label>
                                        <div class="d-grid gap-2">
                                            <t t-foreach="state.payment_methods" t-as="pm" t-key="pm.id">
                                                <button type="button" 
                                                        t-attf-class="btn btn-lg fw-bold {{state.selectedPaymentMethodId === pm.id ? 'btn-primary' : 'btn-outline-secondary'}}"
                                                        t-on-click="() => this.selectPaymentMethod(pm.id)">
                                                    <i class="fa fa-credit-card me-1"/> <t t-esc="pm.name"/>
                                                </button>
                                            </t>
                                        </div>
                                    </div>

                                    <div class="mb-3">
                                        <label class="form-label fw-bold">المبلغ المتبقي المطلوب (Amount Due)</label>
                                        <div class="input-group input-group-lg">
                                            <input type="number" step="0.001" class="form-control text-center fw-bold text-danger fs-4" 
                                                   t-model="state.amountTendered"/>
                                            <span class="input-group-text fw-bold">JOD</span>
                                        </div>
                                    </div>
                                </t>
                                <t t-else="">
                                    <div class="text-center p-4 text-muted">
                                        اختر طلباً من القائمة لعرض تفاصيل السداد.
                                    </div>
                                </t>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <t t-slot="footer">
                <button type="button" class="btn btn-success btn-lg fw-bold me-2 px-4" 
                        t-att-disabled="!selectedOrder || state.loading"
                        t-on-click="confirmSettlement">
                    <i class="fa fa-check-circle me-1"/> سداد واستلام وترحيل المخزون (Settle &amp; Deliver)
                </button>
                <button type="button" class="btn btn-secondary btn-lg px-4" t-on-click="cancel">
                    إلغاء (Cancel)
                </button>
            </t>
        </Dialog>
    </t>
</templates>
