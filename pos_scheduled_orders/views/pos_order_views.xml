<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pos_pos_form_inherit_scheduled_orders" model="ir.ui.view">
        <field name="name">pos.order.form.inherit.scheduled.orders</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_pos_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_finalize_deposit_and_validate_stock" 
                        type="object" 
                        string="اعتماد السداد وترحيل المخزون (Day 2)" 
                        class="oe_highlight" 
                        invisible="not is_advance_deposit"/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="طلبيات تواصي وجوفوتارا (Scheduled Orders)" name="fulfillment_scheduled_orders_compliance">
                    <group>
                        <group string="تفاصيل طلب التواصي">
                            <field name="fulfillment_type"/>
                            <field name="scheduled_datetime"/>
                            <field name="is_catering"/>
                        </group>
                        <group string="حالة العربون والامتثال لجوفوتارا">
                            <field name="is_advance_deposit"/>
                            <field name="jofotara_status"/>
                        </group>
                        <group string="بيانات التواصل مع العميل">
                            <field name="delivery_address_name"/>
                            <field name="delivery_address_phone"/>
                            <field name="delivery_address_id"/>
                        </group>
                        <group string="عنوان التوصيل التفصيلي" invisible="fulfillment_type != 'delivery'">
                            <field name="delivery_street"/>
                            <field name="delivery_city"/>
                            <field name="delivery_building_apt"/>
                            <field name="delivery_zip"/>
                        </group>
                        <group string="الرسوم الإضافية">
                            <field name="delivery_fee"/>
                            <field name="catering_fee"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
