<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pos_config_view_form_inherit_scheduled_orders" model="ir.ui.view">
        <field name="name">pos.config.form.inherit.scheduled.orders</field>
        <field name="model">pos.config</field>
        <field name="inherit_id" ref="point_of_sale.pos_config_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <div class="mt-4">
                    <h2>إعدادات طلبيات التواصي وجوفوتارا (Scheduled Orders &amp; JoFotara Settings)</h2>
                    <div class="row mt16 o_settings_container">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane">
                                <field name="enable_fulfillment_schedule"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="enable_fulfillment_schedule"/>
                                <div class="text-muted">
                                    تفعيل جدولة طلبيات التواصي والاستلام والتوصيل في نقطة البيع.
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box" invisible="not enable_fulfillment_schedule">
                            <div class="o_setting_right_pane">
                                <label for="advance_deposit_account_id"/>
                                <field name="advance_deposit_account_id"/>
                                <div class="text-muted">
                                    حساب التزامات العربون المقدم (Customer Advance Deposits liability account).
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box" invisible="not enable_fulfillment_schedule">
                            <div class="o_setting_right_pane">
                                <label for="delivery_fee_product_id"/>
                                <field name="delivery_fee_product_id"/>
                                <div class="text-muted">
                                    منتج رسوم التوصيل الآلي (`DELIVERY_FEE`).
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box" invisible="not enable_fulfillment_schedule">
                            <div class="o_setting_right_pane">
                                <label for="catering_fee_product_id"/>
                                <field name="catering_fee_product_id"/>
                                <div class="text-muted">
                                    منتج رسوم خدمة الضيافة الكترنج (`CATERING_FEE`).
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
