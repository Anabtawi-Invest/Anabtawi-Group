#. module: pos_scheduled_orders
msgid "Scheduled Orders"
msgstr "طلبيات تواصي / خيارات التسليم"

#. module: pos_scheduled_orders
msgid "Fulfillment: Store Pickup"
msgstr "طلب تواصي: استلام من الفرع"

#. module: pos_scheduled_orders
msgid "Fulfillment: Home Delivery"
msgstr "طلب تواصي: توصيل منزلي"

#. module: pos_scheduled_orders
msgid "Add Catering Service"
msgstr "إضافة خدمة ضيافة (كثرنج)"

#. module: pos_scheduled_orders
msgid "Catering Service Added"
msgstr "تمت إضافة رسوم الضيافة"

#. module: pos_scheduled_orders
msgid "Store Pickup"
msgstr "استلام من الفرع"

#. module: pos_scheduled_orders
msgid "Home Delivery"
msgstr "توصيل منزلي"

#. module: pos_scheduled_orders
msgid "Customer Name is required."
msgstr "اسم العميل مطلوب ولا يمكن ترك الحقل فارغاً."

#. module: pos_scheduled_orders
msgid "Customer Mobile Number is required."
msgstr "رقم هاتف العميل مطلوب لإكمال طلب التواصي."

#. module: pos_scheduled_orders
msgid "Scheduled Pickup / Delivery Date & Time Slot is required."
msgstr "يرجى تحديد موعد وتاريخ التسليم / الاستلام."

#. module: pos_scheduled_orders
msgid "Full Delivery Address (Street & City) is required for Home Delivery."
msgstr "عنوان التوصيل التفصيلي (الشارع والمدينة) مطلوب لطلبات التوصيل المنزلي."

#. module: pos_scheduled_orders
msgid "Delivery fee cannot be negative."
msgstr "رسوم التوصيل لا يمكن أن تكون بقيمة سالبة."

#. module: pos_scheduled_orders
msgid "Delivery fee applied successfully."
msgstr "تم تطبيق رسوم التوصيل بنجاح إضافة المنتج."

#. module: pos_scheduled_orders
msgid "Catering fee added to order."
msgstr "تمت إضافة رسوم الضيافة للطلب بنجاح."

#. module: pos_scheduled_orders
msgid "Validation Error: Customer Name Required"
msgstr "خطأ إدخال: اسم العميل مطلوب"

#. module: pos_scheduled_orders
msgid "Validation Error: Customer Mobile Required"
msgstr "خطأ إدخال: رقم هاتف العميل مطلوب"

#. module: pos_scheduled_orders
msgid "Validation Error: Scheduled Date & Time Required"
msgstr "خطأ إدخال: تاريخ ووقت الاستلام مطلوب"

#. module: pos_scheduled_orders
msgid "Validation Error: Delivery Address Required"
msgstr "خطأ إدخال: عنوان التوصيل مطلوب"
