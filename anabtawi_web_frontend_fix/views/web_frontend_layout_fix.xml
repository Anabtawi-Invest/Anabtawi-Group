<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="web_frontend_brand_promotion_fix"
              inherit_id="web.frontend_layout"
              name="Ensure Brand Promotion Footer Slot">
        <xpath expr="//div[@id='wrapwrap']" position="inside">
            <t t-call="web.brand_promotion" t-if="False"/>
        </xpath>
    </template>
</odoo>
