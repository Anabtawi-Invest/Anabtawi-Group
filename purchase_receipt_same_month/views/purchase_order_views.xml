<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="purchase_order_form_receipt_same_month" model="ir.ui.view">
        <field name="name">purchase.order.form.receipt.same.month</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <field name="date_order" position="after">
                <field name="receipt_same_month_enabled" invisible="1"/>
                <field name="allow_receipt_other_month"
                       invisible="not receipt_same_month_enabled"
                       groups="purchase_receipt_same_month.group_purchase_receipt_other_month"/>
            </field>
        </field>
    </record>
</odoo>
