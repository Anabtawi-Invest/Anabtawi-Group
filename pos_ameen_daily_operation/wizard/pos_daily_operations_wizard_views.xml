<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pos_daily_operations_wizard" model="ir.ui.view">
        <field name="name">pos.daily.operations.wizard.form</field>
        <field name="model">pos.daily.operations.wizard</field>
        <field name="arch" type="xml">
            <form string="Daily Operations Summary">
                <group>
                    <field name="business_date"/>
                </group>
                <footer>
                    <button name="action_export_excel"
                            type="object"
                            string="Export Excel"
                            class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_pos_daily_operations_wizard" model="ir.actions.act_window">
        <field name="name">Daily Operations Summary</field>
        <field name="res_model">pos.daily.operations.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_pos_daily_operations_report"
              name="Daily Operations Summary"
              parent="point_of_sale.menu_point_rep"
              action="action_pos_daily_operations_wizard"
              sequence="7"/>
</odoo>
