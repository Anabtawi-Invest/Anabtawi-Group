<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pos_payment_method_form_daily_ops_report_type" model="ir.ui.view">
        <field name="name">pos.payment.method.form.daily.ops.report.type</field>
        <field name="model">pos.payment.method</field>
        <field name="inherit_id" ref="point_of_sale.pos_payment_method_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='Payment methods']" position="after">
                <group string="Daily Operations Report">
                    <field name="daily_ops_report_type" widget="radio"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
