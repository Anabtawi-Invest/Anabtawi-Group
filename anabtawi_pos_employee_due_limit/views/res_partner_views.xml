<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_property_form_employee_due_limit" model="ir.ui.view">
        <field name="name">res.partner.property.form.employee.due.limit</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="account.view_partner_property_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='credit_limits']" position="inside">
                <field name="pos_customer_account_due" invisible="not employee"/>
            </xpath>
        </field>
    </record>
</odoo>
