<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_employee_due_limit" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.employee.due.limit</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='pos_payment_section']" position="after">
                <block title="Employee Due Limit" id="pos_employee_due_limit_section">
                    <setting id="employee_due_limit"
                             help="Fill the Partner Limit of each employee's work contact from the wage, and block Customer Account orders that exceed it.">
                        <field name="employee_due_limit_enabled"/>
                        <div class="content-group mt-2" invisible="not employee_due_limit_enabled">
                            <div class="row">
                                <label for="employee_due_deduction_percent" class="col-lg-5 o_light_label"/>
                                <field name="employee_due_deduction_percent" class="oe_inline"/>
                            </div>
                            <div class="row">
                                <label for="employee_due_max_percent" class="col-lg-5 o_light_label"/>
                                <field name="employee_due_max_percent" class="oe_inline"/>
                            </div>
                            <div class="text-muted mt-1">
                                Limit = (Wage - Wage x Deduction %) x Max Due %
                            </div>
                            <button name="action_recompute_employee_due_limits" type="object"
                                    string="Recompute Credit Limits" icon="oi-arrow-right"
                                    class="btn-link mt-2"/>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
