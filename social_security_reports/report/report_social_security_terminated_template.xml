<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_social_security_terminated_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <div class="article" style="direction: rtl; font-family: Arial, sans-serif; color: #000; font-size: 8pt; margin: 0; padding: 0;">
                    
                    <style type="text/css">
                        .boxes-table {
                            border-collapse: collapse;
                            display: inline-table;
                            vertical-align: middle;
                        }
                        .box-cell {
                            border: 1px solid #000;
                            width: 30px;
                            height: 18px;
                            text-align: center;
                            vertical-align: middle;
                            font-size: 8pt;
                            font-weight: bold;
                            font-family: Arial, sans-serif;
                            padding: 0;
                        }
                        .box-cell-deduct {
                            border: 1px solid #000;
                            width: 34px;
                            height: 18px;
                            text-align: center;
                            vertical-align: middle;
                            font-size: 10.5pt;
                            font-family: Arial, sans-serif;
                            padding: 0;
                        }
                        .main-table-term {
                            width: 100%;
                            border-collapse: collapse;
                            border: 2px solid #000;
                            font-family: Arial, sans-serif;
                            text-align: center;
                            table-layout: fixed;
                        }
                        .main-table-term th, .main-table-term td {
                            border: 1px solid #000;
                            padding: 1px 2px;
                            vertical-align: middle;
                            overflow: hidden;
                        }
                        .main-table-term th {
                            font-size: 8.6pt;
                            font-weight: bold;
                            background: #fff;
                        }
                        .main-table-term td {
                            font-size: 7.6pt;
                        }
                        .rot-col-seq {
                            -webkit-transform: rotate(90deg);
                            transform: rotate(90deg);
                            white-space: nowrap;
                            display: inline-block;
                            font-weight: bold;
                            font-size: 8.6pt;
                            width: 65px;
                            text-align: center;
                            margin-left: -24px;
                            margin-right: -24px;
                        }
                        .rot-col-reason {
                            -webkit-transform: rotate(90deg);
                            transform: rotate(90deg);
                            white-space: nowrap;
                            display: inline-block;
                            font-weight: bold;
                            font-size: 8.6pt;
                            width: 65px;
                            text-align: center;
                        }
                        .vth-term {
                            padding: 0 !important;
                            text-align: center;
                            vertical-align: middle;
                            height: 65px;
                        }
                        .total-table {
                            width: 100%;
                            border-collapse: collapse;
                            margin-top: -1px;
                            font-family: Arial, sans-serif;
                            text-align: center;
                            table-layout: fixed;
                        }
                        .total-table td {
                            padding: 2px;
                            vertical-align: middle;
                        }
                        .total-box {
                            border: 2px solid #000;
                            border-top: 1px solid #000;
                        }
                    </style>

                    <!-- Top Header: Logo on Right, Title in Center, Page on Left in RTL -->
                    <table style="width: 100%; border-collapse: collapse; border: none; margin-bottom: 2px;">
                        <tr>
                            <!-- Right in RTL: Logo -->
                            <td style="width: 25%; text-align: right; vertical-align: top;">
                                <div style="display: inline-block; text-align: center;">
                                    <img src="data:image/jpeg;base64," style="height: 48px; display: block; margin: 0 auto;"/>
                                    <div style="font-size: 15.3pt; font-family: Arial, sans-serif; margin-top: 2px; color: #000;">ضمان مستقبلك</div>
                                </div>
                            </td>
                            <!-- Center: Title -->
                            <td style="width: 50%; text-align: center; vertical-align: top;">
                                <div style="font-size: 17.2pt; font-weight: bold; display: inline-block; border-bottom: 1.5px solid #000; padding-bottom: 4px; margin-bottom: 8px; color: #000;">
                                    الكشف المالي للمؤمن عليهم الذين انتهت خدماتهم
                                </div>
                                <div style="font-size: 12.4pt; margin-top: 6px; color: #000;">
                                    الاشتراكات الشهرية للمؤمن عليهم الذين انتهت خدماتهم خلال شهر
                                    <span style="display: inline-block; border-bottom: 1.5px dotted #000; padding: 0 16px; font-size: 10.5pt;" t-out="o.get_month_name_ar()"/>
                                    /
                                    <span style="display: inline-block; border-bottom: 1.5px dotted #000; padding: 0 16px; font-size: 10.5pt;" t-out="o.year"/>
                                </div>
                            </td>
                            <!-- Left in RTL: Page Number -->
                            <td style="width: 25%; text-align: left; vertical-align: top; padding-top: 25px;">
                                <div style="font-size: 10.5pt; text-align: left; color: #000;">
                                    <span>رقم الصفحة</span>
                                    <span style="display: inline-block; border-bottom: 2px dotted #000; padding: 0 12px; letter-spacing: 4px; margin-right: 4px; white-space: nowrap; direction: ltr;">0 1</span>
                                </div>
                            </td>
                        </tr>
                    </table>

                    <!-- Facility Number and Deduction Rate -->
                    <table style="width: 100%; border-collapse: collapse; margin-top: 10px; margin-bottom: 8px;">
                        <tr>
                            <!-- Right in RTL: Facility Number -->
                            <td style="width: 55%; text-align: right; vertical-align: middle;">
                                <span style="font-size: 11.5pt; font-family: Arial, sans-serif; margin-left: 15px; color: #000;">رقم التأمين الثابت للمنشأة</span>
                                <t t-set="est_str" t-value="str(o.company_id.ssc_establishment_number or '2883').strip()"/>
                                <table class="boxes-table">
                                    <tr>
                                        <td class="box-cell"><t t-out="est_str[0] if len(est_str) &gt; 0 else '2'"/></td>
                                        <td class="box-cell"><t t-out="est_str[1] if len(est_str) &gt; 1 else '8'"/></td>
                                        <td class="box-cell"><t t-out="est_str[2] if len(est_str) &gt; 2 else '8'"/></td>
                                        <td class="box-cell"><t t-out="est_str[3] if len(est_str) &gt; 3 else '3'"/></td>
                                        <td class="box-cell"><t t-out="est_str[4] if len(est_str) &gt; 4 else ''"/></td>
                                    </tr>
                                </table>
                            </td>
                            <!-- Left in RTL: Deduction Rate -->
                            <td style="width: 45%; text-align: left; vertical-align: middle;">
                                <span style="font-size: 11.5pt; font-family: Arial, sans-serif; margin-left: 8px; color: #000;">نسبة الاقتطاع</span>
                                <table class="boxes-table" style="margin-left: 8px;">
                                    <tr>
                                        <td class="box-cell-deduct">75</td>
                                        <td class="box-cell-deduct">21</td>
                                    </tr>
                                </table>
                                <span style="font-size: 11.5pt; font-family: Arial, sans-serif; color: #000;">%</span>
                            </td>
                        </tr>
                    </table>

                    <!-- Company Name Line -->
                    <div style="font-size: 11.5pt; margin-bottom: 12px; text-align: right; color: #000;">
                        <span>اسم المنشأة : &#160;&#160;</span>
                        <span style="display: inline-block; border-bottom: 1px dotted #000; padding: 0 10px;" t-out="o.company_id.name or 'شركة نجيب ذوابي وشركاه - حلويات العنبتاوي'"/>
                        <div style="border-bottom: 1px dashed #000; width: 100%; margin-top: 4px;"></div>
                    </div>

                    <!-- Main Table -->
                    <table class="main-table-term">
                        <thead>
                            <tr style="height: 42px;">
                                <th rowspan="2" class="vth-term" style="width: 3.2%;"><span class="rot-col-seq">الرقم المتسلسل</span></th>
                                <th rowspan="2" style="width: 13.7%;">رقم التأمين الثابت</th>
                                <th colspan="4" style="width: 32.6%;">اسم المؤمن عليه</th>
                                <th colspan="2" style="width: 11.6%;">الأجر الشهري<br/>الخاضع للاقتطاع</th>
                                <th colspan="3" style="width: 21.0%;">تاريخ إيقاف<br/>الاقتطاع</th>
                                <th rowspan="2" class="vth-term" style="width: 8.4%;"><span class="rot-col-reason">سبب الإيقاف</span></th>
                                <th rowspan="2" style="width: 9.5%; line-height: 1.2;">الفرع<br/>أو<br/>المديرية</th>
                            </tr>
                            <tr style="height: 22px;">
                                <th style="width: 9.5%;">الأول</th>
                                <th style="width: 8.4%;">الأب</th>
                                <th style="width: 7.4%;">الجد</th>
                                <th style="width: 7.4%;">العائلة</th>
                                <th style="width: 5.3%;">فلس</th>
                                <th style="width: 6.3%;">دينار</th>
                                <th style="width: 6.3%;">يوم</th>
                                <th style="width: 6.3%;">شهر</th>
                                <th style="width: 8.4%;">سنة</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-set="seq" t-value="1"/>
                            <t t-set="total_wage" t-value="0.0"/>
                            <t t-set="emps" t-value="o.get_terminated_employees_data()"/>
                            <tr t-foreach="emps" t-as="emp" style="height: 18px;">
                                <t t-set="wage" t-value="emp.get_ssc_wage()"/>
                                <t t-set="total_wage" t-value="total_wage + wage"/>
                                <t t-set="dinars" t-value="int(wage)"/>
                                <t t-set="ed" t-value="emp.get_ssc_end_date()"/>
                                <t t-set="name_parts" t-value="emp.get_arabic_name_parts()"/>
                                <t t-set="ssn" t-value="emp.get_ssc_number()"/>

                                <td><t t-out="seq"/></td>
                                <td><t t-out="ssn"/></td>
                                <td><t t-out="name_parts[0]"/></td>
                                <td><t t-out="name_parts[1]"/></td>
                                <td><t t-out="name_parts[2]"/></td>
                                <td><t t-out="name_parts[3]"/></td>
                                <td>000</td>
                                <td style="font-weight: bold;"><t t-out="dinars"/></td>
                                <td><t t-out="'{:02d}'.format(ed.day) if ed else ''"/></td>
                                <td><t t-out="'{:02d}'.format(ed.month) if ed else ''"/></td>
                                <td><t t-out="ed.year if ed else ''"/></td>
                                <td>
                                    <t t-if="'departure_reason_id' in emp._fields and emp.departure_reason_id">
                                        <t t-out="emp.departure_reason_id.name"/>
                                    </t>
                                    <t t-elif="'profile_employment_status' in emp._fields and emp.profile_employment_status">
                                        <t t-out="emp.profile_employment_status"/>
                                    </t>
                                </td>
                                <!-- عامود الفرع أو المديرية فارغ تماما -->
                                <td></td>
                                <t t-set="seq" t-value="seq + 1"/>
                            </tr>
                            <tr t-if="not emps">
                                <td colspan="13" style="border: 1px solid #000; padding: 15px; color: #666; font-size: 10pt;">
                                    لا يوجد موظفين انتهت خدماتهم في الضمان الاجتماعي خلال هذا الشهر
                                </td>
                            </tr>
                        </tbody>
                    </table>

                    <!-- Total Row: Directly under العائلة (7.4%) | فلس (5.3%) | دينار (6.3%) -->
                    <t t-if="emps">
                        <table class="total-table">
                            <tr>
                                <td style="width: 42.2%; border: none;"></td>
                                <td class="total-box" style="width: 7.4%; font-size: 8.6pt; font-weight: bold;">المجموع</td>
                                <td class="total-box" style="width: 5.3%; font-size: 7.6pt;">000</td>
                                <td class="total-box" style="width: 6.3%; font-size: 7.6pt; font-weight: bold;"><t t-out="'{:,.0f}'.format(total_wage)"/></td>
                                <td style="width: 38.8%; border: none;"></td>
                            </tr>
                        </table>
                    </t>

                    <!-- Footer Declaration & Signatures -->
                    <div style="margin-top: 20px; page-break-inside: avoid;">
                        <div style="border-top: 1px solid #000; width: 100%; margin-bottom: 8px;"></div>
                        
                        <div style="font-size: 10.5pt; font-weight: bold; text-align: right; margin-bottom: 8px; color: #000;">
                            إقرار: أقر بأن البيانات أعلاه صحيحة وأتحمل مسؤولية ما يخالف ذلك """"
                        </div>

                        <table style="width: 100%; border-collapse: collapse; font-size: 10.5pt; font-weight: bold; margin-bottom: 12px;">
                            <tr>
                                <td style="width: 40%; text-align: right; vertical-align: top;">
                                    <div>اسم ضابط الارتباط المفوض بالتوقيع</div>
                                    <div style="border-bottom: 1px solid #000; width: 85%; margin-top: 10px;"></div>
                                </td>
                                <td style="width: 30%; text-align: center; vertical-align: top;">
                                    <div>التاريخ: &#160;&#160;&#160;&#160; / &#160;&#160;&#160;&#160; / &#160;&#160;&#160;&#160;</div>
                                    <div style="border-bottom: 1px solid #000; width: 70%; margin: 10px auto 0 auto;"></div>
                                </td>
                                <td style="width: 30%; text-align: left; vertical-align: top;">
                                    <div style="text-align: right; padding-right: 25px;">ختم المنشأة</div>
                                    <div style="border-bottom: 1px solid #000; width: 70%; margin-top: 10px;"></div>
                                </td>
                            </tr>
                        </table>

                        <div style="border-top: 1px solid #000; width: 100%; margin-bottom: 8px;"></div>

                        <div style="font-size: 10.5pt; font-weight: bold; text-align: right; margin-bottom: 8px; color: #000;">
                            لاستعمال المؤسسة
                        </div>

                        <table style="width: 100%; border-collapse: collapse; font-size: 10.5pt; font-weight: bold;">
                            <tr>
                                <td style="width: 40%; text-align: right; vertical-align: top;">
                                    <div>اسم مستلم البيانات وتوقيعه / ختم الوارد</div>
                                    <div style="border-bottom: 1px solid #000; width: 85%; margin-top: 10px;"></div>
                                </td>
                                <td style="width: 35%; text-align: center; vertical-align: top;">
                                    <div>اسم المدخل وتوقيعه / ختم الإدخال</div>
                                    <div style="border-bottom: 1px solid #000; width: 75%; margin: 10px auto 0 auto;"></div>
                                </td>
                                <td style="width: 25%; text-align: left; vertical-align: top;">
                                    <div style="text-align: right; padding-right: 15px;">اسم المدقق وتوقيعه</div>
                                    <div style="border-bottom: 1px solid #000; width: 75%; margin-top: 10px;"></div>
                                </td>
                            </tr>
                        </table>
                    </div>

                </div>
            </t>
        </t>
    </template>
</odoo>
