<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_meps" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.meps</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='pos_payment_method_ids']/ancestor::setting[1]" position="after">
                <setting
                    id="meps_connection_setting"
                    string="MEPS Connection"
                    help="Gateway URL and timeout for the MEPS/ApexECR terminal integration. Per-branch Tid/Mid/SecureKey are set on each Payment Method (or via Import MEPS Terminals)."
                >
                    <div class="content-group">
                        <div class="row mt16">
                            <label for="meps_endpoint_url" class="col-lg-3 o_light_label" string="Gateway URL"/>
                            <field name="meps_endpoint_url" class="col-lg-9" placeholder="https://gprs.mepspay.com/v100/ecrcomInterface.svc"/>
                        </div>
                        <div class="row">
                            <label for="meps_timeout" class="col-lg-3 o_light_label" string="Timeout (seconds)"/>
                            <field name="meps_timeout" class="col-lg-3" placeholder="90"/>
                        </div>
                        <div class="row mt8">
                            <label for="meps_enable_mock" class="col-lg-3 o_light_label" string="Built-in mock"/>
                            <field name="meps_enable_mock" class="col-lg-9"/>
                        </div>
                        <div class="mt8">
                            <button
                                name="action_meps_use_mock_url"
                                type="object"
                                string="Use mock (approve)"
                                class="btn-secondary"
                                help="Enable mock and set Gateway URL to this database's /pos_meps_terminal/mock"
                            />
                            <button
                                name="action_meps_use_mock_decline_url"
                                type="object"
                                string="Use mock (decline)"
                                class="btn-link"
                            />
                        </div>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
