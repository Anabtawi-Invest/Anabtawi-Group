<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pos_payment_method_form_meps" model="ir.ui.view">
        <field name="name">pos.payment.method.form.meps</field>
        <field name="model">pos.payment.method</field>
        <field name="inherit_id" ref="point_of_sale.pos_payment_method_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='split_transactions']" position="after">
                <group string="MEPS Terminal Configuration" invisible="use_payment_terminal != 'meps'">
                    <field name="meps_tid" placeholder="e.g. 10014263"/>
                    <field name="meps_mid" placeholder="e.g. 100042630000000"/>
                    <field name="meps_secure_key" password="True"/>
                    <field name="meps_currency_code" placeholder="400"/>
                </group>
                <button
                    name="meps_settlement_action"
                    type="object"
                    string="Run MEPS Settlement"
                    class="btn-secondary"
                    confirm="This closes the EFTPOS batch on the physical terminal and cannot be undone. Continue?"
                    invisible="use_payment_terminal != 'meps'"
                    groups="point_of_sale.group_pos_manager"
                />
            </xpath>
        </field>
    </record>

    <record id="action_pos_payment_method_meps" model="ir.actions.act_window">
        <field name="name">MEPS Terminals</field>
        <field name="res_model">pos.payment.method</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('use_payment_terminal', '=', 'meps')]</field>
        <field name="context">{'default_use_payment_terminal': 'meps', 'default_payment_method_type': 'terminal', 'default_meps_currency_code': '400'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No MEPS terminals yet. Use Point of Sale > Configuration > Import MEPS
                Terminals to upload the customer's Tid/Mid/SecureKey Excel file, or add
                one manually here (Integration: Terminal, Integrate with: MEPS).
            </p>
        </field>
    </record>

    <menuitem
        id="menu_pos_payment_method_meps"
        name="MEPS Terminals"
        parent="point_of_sale.menu_point_config_product"
        action="action_pos_payment_method_meps"
        sequence="50"
        groups="point_of_sale.group_pos_manager"
    />
</odoo>
