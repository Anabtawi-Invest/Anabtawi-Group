<odoo>
    <record id="product_template_form_direct_ordering" model="ir.ui.view">
        <field name="name">product.template.form.direct.ordering</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Direct Ordering">
                    <group>
                        <group>
                            <field name="available_for_direct_ordering"/>
                            <field name="direct_ordering_name"/>
                            <field name="direct_ordering_category"/>
                            <field name="direct_ordering_preparation_minutes"/>
                        </group>
                        <group>
                            <field name="aggregator_sku"/>
                            <field name="talabat_item_id"/>
                            <field name="careem_item_id"/>
                        </group>
                    </group>
                    <field name="direct_ordering_description"/>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
