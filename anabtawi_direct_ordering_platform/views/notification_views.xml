<odoo>
    <record id="view_anabtawi_order_notification_list" model="ir.ui.view">
        <field name="name">anabtawi.order.notification.list</field>
        <field name="model">anabtawi.order.notification</field>
        <field name="arch" type="xml">
            <list decoration-danger="priority == 'urgent' or color_status == 'red'" decoration-warning="color_status == 'yellow'" decoration-success="state == 'acknowledged'">
                <field name="create_date"/>
                <field name="branch_id"/>
                <field name="order_id"/>
                <field name="event_type"/>
                <field name="message"/>
                <field name="popup_required"/>
                <field name="sound_required"/>
                <field name="print_required"/>
                <field name="screen_required"/>
                <field name="priority"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_anabtawi_order_notification_form" model="ir.ui.view">
        <field name="name">anabtawi.order.notification.form</field>
        <field name="model">anabtawi.order.notification</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_mark_shown" type="object" string="Mark Shown" class="btn-secondary" invisible="state != 'new'"/>
                    <button name="action_acknowledge" type="object" string="Acknowledge" class="btn-primary" invisible="state in ('acknowledged','dismissed')"/>
                    <button name="action_dismiss" type="object" string="Dismiss" class="btn-secondary" invisible="state in ('acknowledged','dismissed')"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="branch_id"/>
                            <field name="order_id"/>
                            <field name="event_type"/>
                            <field name="priority"/>
                        </group>
                        <group>
                            <field name="popup_required"/>
                            <field name="blocking_popup"/>
                            <field name="sound_required"/>
                            <field name="sound_type"/>
                            <field name="repeat_until_ack"/>
                            <field name="print_required"/>
                            <field name="timer_required"/>
                            <field name="screen_required"/>
                            <field name="manager_alert_required"/>
                        </group>
                    </group>
                    <group>
                        <field name="message"/>
                        <field name="payload_json"/>
                    </group>
                    <group>
                        <field name="acknowledged_by_id"/>
                        <field name="acknowledged_datetime"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_anabtawi_order_notification" model="ir.actions.act_window">
        <field name="name">Staff Notifications</field>
        <field name="res_model">anabtawi.order.notification</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[]</field>
    </record>
</odoo>
