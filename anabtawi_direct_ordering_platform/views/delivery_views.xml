<odoo>
    <record id="view_anabtawi_delivery_zone_list" model="ir.ui.view">
        <field name="name">anabtawi.delivery.zone.list</field>
        <field name="model">anabtawi.delivery.zone</field>
        <field name="arch" type="xml">
            <list>
                <field name="branch_id"/>
                <field name="name"/>
                <field name="delivery_fee"/>
                <field name="min_order_amount"/>
                <field name="estimated_minutes"/>
                <field name="active"/>
            </list>
        </field>
    </record>
    <record id="view_anabtawi_delivery_zone_form" model="ir.ui.view">
        <field name="name">anabtawi.delivery.zone.form</field>
        <field name="model">anabtawi.delivery.zone</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="branch_id"/>
                        <field name="name"/>
                        <field name="delivery_fee"/>
                        <field name="min_order_amount"/>
                        <field name="estimated_minutes"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_anabtawi_delivery_zone" model="ir.actions.act_window">
        <field name="name">Delivery Zones</field>
        <field name="res_model">anabtawi.delivery.zone</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
