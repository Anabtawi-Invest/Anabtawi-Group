<odoo>
    <record id="view_anabtawi_ordering_branch_list" model="ir.ui.view">
        <field name="name">anabtawi.ordering.branch.list</field>
        <field name="model">anabtawi.ordering.branch</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="pos_config_id"/>
                <field name="warehouse_id"/>
                <field name="allow_delivery"/>
                <field name="allow_pickup"/>
                <field name="active"/>
            </list>
        </field>
    </record>
    <record id="view_anabtawi_ordering_branch_form" model="ir.ui.view">
        <field name="name">anabtawi.ordering.branch.form</field>
        <field name="model">anabtawi.ordering.branch</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="company_id"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="pos_config_id"/>
                            <field name="warehouse_id"/>
                            <field name="stock_location_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Operations">
                            <group>
                                <field name="allow_delivery"/>
                                <field name="allow_pickup"/>
                                <field name="opening_time" widget="float_time"/>
                                <field name="closing_time" widget="float_time"/>
                                <field name="default_preparation_minutes"/>
                                <field name="min_order_amount"/>
                            </group>
                        </page>

                        <page string="Notifications">
                            <group string="POS / Staff Alerts">
                                <field name="notify_pos_popup"/>
                                <field name="notify_blocking_popup"/>
                                <field name="notify_sound"/>
                                <field name="notify_sound_type"/>
                                <field name="notify_repeat_until_ack"/>
                                <field name="notify_auto_print"/>
                                <field name="notify_timer_colors"/>
                                <field name="notify_screen_mode"/>
                            </group>
                            <group string="Escalation / Managers">
                                <field name="notification_manager_user_ids" widget="many2many_tags"/>
                                <field name="notify_manager_activity"/>
                                <field name="notify_discuss_message"/>
                                <field name="notify_email"/>
                                <field name="yellow_after_minutes"/>
                                <field name="red_after_minutes"/>
                            </group>
                            <button name="action_send_test_notification" type="object" string="Send Test Notification" class="btn-primary"/>
                        </page>
                        <page string="Accounting">
                            <group string="Standard Journals">
                                <field name="sale_journal_id"/>
                                <field name="cash_journal_id"/>
                                <field name="receivable_journal_id"/>
                                <field name="analytic_account_id"/>
                            </group>
                            <group string="Aggregator / Talabat Accounting">
                                <field name="aggregator_accounting_journal_id"/>
                                <field name="aggregator_receivable_account_id"/>
                                <field name="commission_base"/>
                                <field name="default_commission_percent"/>
                                <field name="aggregator_commission_account_id"/>
                                <field name="aggregator_commission_tax_id"/>
                                <field name="aggregator_contribution_account_id"/>
                                <field name="company_discount_account_id"/>
                            </group>
                        </page>
                        <page string="Delivery Zones">
                            <field name="zone_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="delivery_fee"/>
                                    <field name="min_order_amount"/>
                                    <field name="estimated_minutes"/>
                                    <field name="active"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_anabtawi_ordering_branch" model="ir.actions.act_window">
        <field name="name">Ordering Branches</field>
        <field name="res_model">anabtawi.ordering.branch</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
