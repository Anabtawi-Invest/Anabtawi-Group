<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_anabtawi_ordering" model="ir.module.category">
        <field name="name">Anabtawi Ordering</field>
        <field name="description">Direct ordering, POS notifications, aggregator operations, and Talabat accounting.</field>
        <field name="sequence">35</field>
    </record>

    <record id="res_groups_privilege_anabtawi_ordering" model="res.groups.privilege">
        <field name="name">Anabtawi Ordering</field>
        <field name="category_id" ref="module_category_anabtawi_ordering"/>
        <field name="sequence">10</field>
    </record>

    <record id="group_ordering_user" model="res.groups">
        <field name="name">Direct Ordering User</field>
        <field name="privilege_id" ref="res_groups_privilege_anabtawi_ordering"/>
    </record>

    <record id="group_ordering_manager" model="res.groups">
        <field name="name">Direct Ordering Manager</field>
        <field name="privilege_id" ref="res_groups_privilege_anabtawi_ordering"/>
        <field name="implied_ids" eval="[(4, ref('group_ordering_user'))]"/>
    </record>
</odoo>
