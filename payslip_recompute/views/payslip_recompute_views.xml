<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_payslip_recompute_wizard_form" model="ir.ui.view">
        <field name="name">payslip.recompute.wizard.form</field>
        <field name="model">payslip.recompute.wizard</field>
        <field name="arch" type="xml">
            <form string="Recompute Payslips">
                <div class="alert alert-info" role="alert">
                    Each payslip is set unpaid, cancelled, its extra hours are approved, then it is put back to draft, its work entries are reset, a missing salary adjustment is put back on it, then it is computed, validated, and marked paid.
                    Archived employees are skipped. Salary structures you pick below are left out.
                    The work runs in the background.
                </div>
                <group>
                    <group>
                        <field name="date_from"/>
                        <field name="date_to"/>
                        <field name="skip_structure_ids" widget="many2many_tags"
                               options="{'no_create': True}"
                               placeholder="Leave empty to include every structure"/>
                    </group>
                    <group>
                        <field name="batch_size"/>
                        <field name="payslip_count" readonly="1"/>
                    </group>
                </group>
                <footer>
                    <button name="action_start" type="object" string="Start in background" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_payslip_recompute_line_list" model="ir.ui.view">
        <field name="name">payslip.recompute.line.list</field>
        <field name="model">payslip.recompute.line</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0"
                  decoration-danger="state == 'error'"
                  decoration-muted="state == 'pending'"
                  decoration-warning="state == 'skipped'"
                  decoration-success="state == 'done'">
                <field name="state"/>
                <field name="company_id"/>
                <field name="employee_id"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="payslip_name"/>
                <field name="payslip_id"/>
                <field name="error"/>
            </list>
        </field>
    </record>

    <record id="view_payslip_recompute_line_search" model="ir.ui.view">
        <field name="name">payslip.recompute.line.search</field>
        <field name="model">payslip.recompute.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="employee_id"/>
                <field name="payslip_name"/>
                <field name="error"/>
                <filter name="error" string="Error" domain="[('state', '=', 'error')]"/>
                <filter name="pending" string="Not recomputed" domain="[('state', '=', 'pending')]"/>
                <filter name="skipped" string="Skipped" domain="[('state', '=', 'skipped')]"/>
                <filter name="done" string="Recomputed" domain="[('state', '=', 'done')]"/>
                <group>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_payslip_recompute_batch_list" model="ir.ui.view">
        <field name="name">payslip.recompute.batch.list</field>
        <field name="model">payslip.recompute.batch</field>
        <field name="arch" type="xml">
            <list create="0">
                <field name="name"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="state"/>
                <field name="done_count"/>
                <field name="error_count"/>
                <field name="skipped_count"/>
                <field name="pending_count"/>
            </list>
        </field>
    </record>

    <record id="view_payslip_recompute_batch_form" model="ir.ui.view">
        <field name="name">payslip.recompute.batch.form</field>
        <field name="model">payslip.recompute.batch</field>
        <field name="arch" type="xml">
            <form string="Payslip Recompute" create="0">
                <header>
                    <button name="action_refresh" type="object" string="Refresh" class="btn-primary"
                            invisible="state != 'running'"/>
                    <button name="action_cancel" type="object" string="Cancel remaining"
                            invisible="state != 'running'"/>
                    <field name="state" widget="statusbar" statusbar_visible="running,done"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_errors" type="object" class="oe_stat_button" icon="fa-exclamation-triangle">
                            <field name="error_count" widget="statinfo" string="Errors"/>
                        </button>
                        <button name="action_view_pending" type="object" class="oe_stat_button" icon="fa-clock-o">
                            <field name="pending_count" widget="statinfo" string="Not recomputed"/>
                        </button>
                        <button name="action_view_skipped" type="object" class="oe_stat_button" icon="fa-ban">
                            <field name="skipped_count" widget="statinfo" string="Skipped"/>
                        </button>
                        <button class="oe_stat_button" icon="fa-check" disabled="1">
                            <field name="done_count" widget="statinfo" string="Recomputed"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="date_from" readonly="1"/>
                            <field name="date_to" readonly="1"/>
                        </group>
                        <group>
                            <field name="batch_size" readonly="1"/>
                            <field name="payslip_count" readonly="1"/>
                        </group>
                    </group>
                    <field name="line_ids" readonly="1">
                        <list decoration-danger="state == 'error'"
                              decoration-muted="state == 'pending'"
                              decoration-warning="state == 'skipped'"
                              decoration-success="state == 'done'">
                            <field name="state"/>
                            <field name="company_id"/>
                            <field name="employee_id"/>
                            <field name="date_from"/>
                            <field name="date_to"/>
                            <field name="payslip_name"/>
                            <field name="payslip_id"/>
                            <field name="error"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_payslip_recompute_wizard" model="ir.actions.act_window">
        <field name="name">Recompute Payslips</field>
        <field name="res_model">payslip.recompute.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="action_payslip_recompute_batch" model="ir.actions.act_window">
        <field name="name">Recompute Batches</field>
        <field name="res_model">payslip.recompute.batch</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_payslip_recompute"
              name="Recompute Payslips"
              parent="hr_payroll.menu_hr_payroll_payslips"
              action="action_payslip_recompute_wizard"
              groups="hr_payroll.group_hr_payroll_manager"
              sequence="90"/>

    <menuitem id="menu_payslip_recompute_batch"
              name="Recompute Batches"
              parent="hr_payroll.menu_hr_payroll_payslips"
              action="action_payslip_recompute_batch"
              groups="hr_payroll.group_hr_payroll_manager"
              sequence="91"/>

</odoo>
