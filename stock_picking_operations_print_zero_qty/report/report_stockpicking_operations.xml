<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_picking_include_zero_qty" inherit_id="stock.report_picking">
        <!-- Show the operations table when there are demand lines, even if done qty is still 0 -->
        <xpath expr="//table[hasclass('o_main_table')]" position="attributes">
            <attribute name="t-if">o._get_picking_operations_report_moves()</attribute>
        </xpath>

        <!-- Replace the move loop filter that requires done quantity > 0 -->
        <xpath expr="//table[hasclass('o_main_table')]/tbody/t[@t-foreach]" position="attributes">
            <attribute name="t-foreach">o._get_picking_operations_report_moves()</attribute>
        </xpath>

        <!-- Always show Demand and Quantity as separate columns -->
        <xpath expr="//th[@name='th_quantity']" position="replace">
            <th name="th_demand" class="text-end">
                <strong>Demand</strong>
            </th>
            <th name="th_quantity" class="text-end">
                <strong>Quantity</strong>
            </th>
        </xpath>

        <xpath expr="//td[hasclass('o_td_quantity')]" position="replace">
            <td class="o_td_demand text-end">
                <span t-out="format_number(move.product_uom_qty)" class="text-nowrap">3.00</span>
                <span t-field="move.uom_id" groups="uom.group_uom">units</span>
            </td>
            <td class="o_td_quantity text-end">
                <span t-out="format_number(move.quantity)" class="text-nowrap">3.00</span>
                <span t-field="move.uom_id" groups="uom.group_uom">units</span>
                <span t-if="move.packaging_uom_id and move.packaging_uom_id != move.uom_id">
                    (<span t-field="move.packaging_uom_qty" t-options='{"widget": "integer"}'/> <span t-field="move.packaging_uom_id.name"/>)
                </span>
            </td>
        </xpath>

        <!-- Lot/serial breakdown rows: demand is move-level, leave empty; keep line quantity -->
        <xpath expr="//t[@t-as='line']/tr/td[hasclass('text-end')]" position="before">
            <td class="text-end"/>
        </xpath>

        <!-- Fallback From/To from the move when there are no move lines yet -->
        <xpath expr="//td[@t-if='from_col_exists']/div[@t-if='move.move_line_ids and not move_has_multiple_lines']" position="after">
            <div t-if="not move.move_line_ids">
                <span t-field="move.location_id.display_name">WH/Stock</span>
            </div>
        </xpath>
        <xpath expr="//td[@t-if='to_col_exists']/div[@t-if='move.move_line_ids and not move_has_multiple_lines']" position="after">
            <div t-if="not move.move_line_ids">
                <span t-field="move.location_dest_id.display_name">WH/Outgoing</span>
            </div>
        </xpath>
    </template>
</odoo>
