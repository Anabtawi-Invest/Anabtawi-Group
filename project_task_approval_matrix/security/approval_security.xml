<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_groups_privilege_task_approval" model="res.groups.privilege">
        <field name="name">Task Approval</field>
        <field name="sequence">45</field>
        <field name="category_id" ref="base.module_category_services"/>
    </record>

    <record id="group_project_approval_user" model="res.groups">
        <field name="name">User</field>
        <field name="comment">Can read approval status on accessible project tasks.</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_task_approval"/>
        <field name="implied_ids" eval="[(4, ref('project.group_project_user'))]"/>
    </record>

    <record id="group_project_task_approver" model="res.groups">
        <field name="name">Approver</field>
        <field name="comment">Can decide their own pending task approval steps.</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_task_approval"/>
        <field name="implied_ids" eval="[(4, ref('group_project_approval_user'))]"/>
    </record>

    <record id="group_project_approval_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="comment">Can configure routes, reset workflows, and use controlled overrides.</field>
        <field name="sequence">30</field>
        <field name="privilege_id" ref="res_groups_privilege_task_approval"/>
        <field name="implied_ids" eval="[
            (4, ref('group_project_task_approver')),
            (4, ref('project.group_project_manager'))
        ]"/>
    </record>

    <data noupdate="1">
        <record id="approval_line_company_rule" model="ir.rule">
            <field name="name">Task approval lines: company isolation</field>
            <field name="model_id" ref="model_project_task_approval_line"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <record id="approval_line_project_user_rule" model="ir.rule">
            <field name="name">Task approval lines: accessible project users</field>
            <field name="model_id" ref="model_project_task_approval_line"/>
            <field name="groups" eval="[(4, ref('project.group_project_user'))]"/>
            <field name="domain_force">[
                '|',
                    '&amp;',
                        ('task_id.project_id', '!=', False),
                        '|',
                            ('task_id.project_id.privacy_visibility', 'in', ['employees', 'portal']),
                            ('task_id.project_id.message_partner_ids', 'in', [user.partner_id.id]),
                    '|',
                        ('task_id.message_partner_ids', 'in', [user.partner_id.id]),
                        ('task_id.user_ids', 'in', user.id)
            ]</field>
        </record>

        <record id="approval_line_manager_rule" model="ir.rule">
            <field name="name">Task approval lines: manager access</field>
            <field name="model_id" ref="model_project_task_approval_line"/>
            <field name="groups" eval="[(4, ref('group_project_approval_manager'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>
    </data>
</odoo>
