<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_task_approval_line_list" model="ir.ui.view">
        <field name="name">project.task.approval.line.list</field>
        <field name="model">project.task.approval.line</field>
        <field name="arch" type="xml">
            <list create="0" delete="0" decoration-success="state == 'approved'" decoration-danger="state == 'rejected'">
                <field name="task_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="sequence"/>
                <field name="approver_id" widget="many2one_avatar_user"/>
                <field name="approver_role"/>
                <field name="state" widget="badge"/>
                <field name="submitted_date"/>
                <field name="decision_date"/>
                <field name="decided_by_id" widget="many2one_avatar_user"/>
                <field name="comments" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_task_approval_line_form" model="ir.ui.view">
        <field name="name">project.task.approval.line.form</field>
        <field name="model">project.task.approval.line</field>
        <field name="arch" type="xml">
            <form create="0" delete="0">
                <sheet>
                    <group>
                        <group>
                            <field name="task_id" readonly="1"/>
                            <field name="sequence" readonly="1"/>
                            <field name="approver_id" widget="many2one_avatar_user" readonly="1"/>
                            <field name="approver_role" readonly="1"/>
                        </group>
                        <group>
                            <field name="state" widget="badge" readonly="1"/>
                            <field name="submitted_date" readonly="1"/>
                            <field name="decision_date" readonly="1"/>
                            <field name="decided_by_id" widget="many2one_avatar_user" readonly="1"/>
                        </group>
                    </group>
                    <field name="can_take_action" invisible="1"/>
                    <field name="comments" readonly="not can_take_action"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_task_approval_line_search" model="ir.ui.view">
        <field name="name">project.task.approval.line.search</field>
        <field name="model">project.task.approval.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="task_id"/>
                <field name="approver_id"/>
                <field name="state"/>
                <filter string="My Approvals" name="my_approval_lines" domain="[('approver_id', '=', uid)]"/>
                <filter string="Pending" name="pending" domain="[('state', '=', 'pending')]"/>
                <group>
                    <filter string="Task" name="group_task" context="{'group_by': 'task_id'}"/>
                    <filter string="Approver" name="group_approver" context="{'group_by': 'approver_id'}"/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_task_approval_lines" model="ir.actions.act_window">
        <field name="name">Task Approvals</field>
        <field name="res_model">project.task.approval.line</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_task_approval_line_search"/>
    </record>

    <menuitem
        id="menu_project_approval_configuration"
        name="Approval Configuration"
        parent="project.menu_project_config"
        action="action_task_approval_lines"
        groups="project_task_approval_matrix.group_project_approval_manager"
        sequence="15"
    />
</odoo>
