<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="project_task_search_approval_matrix" model="ir.ui.view">
        <field name="name">project.task.search.approval.matrix</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_search_form"/>
        <field name="priority">50</field>
        <field name="arch" type="xml">
            <filter name="my_tasks" position="after">
                <separator/>
                <filter string="Requires Approval" name="requires_approval" domain="[('approval_required', '=', True)]"/>
                <filter string="Waiting for My Approval" name="my_approvals" domain="[('current_approver_ids', 'in', [uid])]"/>
                <filter string="Submitted" name="approval_submitted" domain="[('approval_state', '=', 'submitted')]"/>
                <filter string="Partially Approved" name="approval_partial" domain="[('approval_state', '=', 'partially_approved')]"/>
                <filter string="Approved" name="approval_approved" domain="[('approval_state', '=', 'approved')]"/>
                <filter string="Changes Requested" name="approval_changes" domain="[('approval_state', '=', 'changes_requested')]"/>
                <filter string="Rejected" name="approval_rejected" domain="[('approval_state', '=', 'rejected')]"/>
            </filter>
            <filter name="stage" position="before">
                <filter string="Approval Status" name="group_approval_state" context="{'group_by': 'approval_state'}"/>
                <filter string="Current Approver" name="group_current_approver" context="{'group_by': 'current_approver_id'}"/>
                <filter string="Approval Type" name="group_approval_type" context="{'group_by': 'approval_type'}"/>
            </filter>
        </field>
    </record>
</odoo>
