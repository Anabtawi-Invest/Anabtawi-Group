<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_deferred_expense_model" model="ir.ui.view">
        <field name="name">account.move.form.deferred.expense.model</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@id='invoice_tab']//list/field[@name='analytic_distribution']" position="before">
                <field name="deferred_expense_model_id"
                         optional="show"
                         column_invisible="parent.move_type not in ('in_invoice', 'in_refund', 'in_receipt')"/>
            </xpath>
            <xpath expr="//page[@id='aml_tab']//list/field[@name='analytic_distribution']" position="before">
                <field name="deferred_expense_model_id"
                         optional="show"
                         column_invisible="parent.move_type != 'entry'"/>
            </xpath>
        </field>
    </record>

    <record id="view_move_form_deferred_expense_model_link" model="ir.ui.view">
        <field name="name">account.move.form.deferred.expense.model.link</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account_accountant.view_move_form_inherit"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='deferred_entry_type']" position="after">
                <field name="deferred_expense_model_id" invisible="1"/>
            </xpath>
            <xpath expr="//button[@name='open_deferred_entries']" position="after">
                <button name="action_open_deferred_expense_model"
                        class="oe_stat_button"
                        icon="fa-cube"
                        type="object"
                        invisible="not deferred_expense_model_id"
                        string="Deferred Model"/>
            </xpath>
        </field>
    </record>
</odoo>
