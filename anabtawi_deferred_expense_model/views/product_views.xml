<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_view_deferred_expense" model="ir.ui.view">
        <field name="name">product.template.form.deferred.expense</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="account.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='invoicing']/group" position="after">
                <group string="Deferred Expense" name="deferred_expense">
                    <field name="deferred_expense_model_id"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
