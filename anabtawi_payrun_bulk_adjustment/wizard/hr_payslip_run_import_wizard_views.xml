<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_payslip_run_import_wizard_form" model="ir.ui.view">
        <field name="name">hr.payslip.run.import.wizard.form</field>
        <field name="model">hr.payslip.run.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Partial Salary Payments Import">
                <sheet>
                    <div class="alert alert-info" role="alert">
                        <strong>Mid-Month Partial Payment Workflow:</strong><br/>
                        1. Compute the draft Payrun to calculate each employee's <strong>Actual Salary</strong>.<br/>
                        2. Click <strong>Download Excel Template</strong>. The file will include <em>Employee Code, Name, Actual Salary</em>, and an empty <em>Partial Payment Amount</em> column.<br/>
                        3. Enter the approved partial payment / salary loan amounts in Excel.<br/>
                        4. Upload the Excel file back and click <strong>Import Partial Payments</strong>.
                    </div>
                    <group>
                        <group string="1. Template Export">
                            <field name="payrun_id" readonly="1"/>
                            <button name="action_export_template" 
                                    string="Download Excel Template" 
                                    type="object" 
                                    class="btn-secondary" 
                                    icon="fa-download"/>
                        </group>
                        <group string="2. Upload Partial Payments">
                            <field name="excel_file" filename="file_name"/>
                            <field name="file_name" invisible="1"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button name="action_import_adjustments" 
                            string="Import Partial Payments" 
                            type="object" 
                            class="btn-primary" 
                            data-hotkey="q"/>
                    <button string="Cancel" 
                            class="btn-secondary" 
                            special="cancel" 
                            data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
