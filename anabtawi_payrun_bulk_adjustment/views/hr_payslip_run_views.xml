<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 1. Download Template Button on Pay Run Payslips List View (Direct Download, No Modal Popup) -->
    <record id="view_hr_payslip_list_bulk_adjustment" model="ir.ui.view">
        <field name="name">hr.payslip.list.bulk.adjustment</field>
        <field name="model">hr.payslip</field>
        <field name="inherit_id" ref="hr_payroll.view_hr_payslip_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list/header" position="inside">
                <button string="Download Baseline Template" 
                        name="action_export_template" 
                        type="object" 
                        class="btn-primary"/>
            </xpath>
        </field>
    </record>

    <!-- 2. Upload Bulk Adjustment Button on Employees List View (Opens Upload Modal) -->
    <record id="view_hr_employee_tree_bulk_adjustment" model="ir.ui.view">
        <field name="name">hr.employee.tree.bulk.adjustment</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list/header" position="inside">
                <button string="Upload Bulk Adjustment" 
                        name="action_open_bulk_adjustment_wizard" 
                        type="object" 
                        class="btn-primary"/>
            </xpath>
        </field>
    </record>

    <!-- 3. Server Action for Employees Module (Actions Menu) -->
    <record id="action_employee_bulk_adjustment_server" model="ir.actions.server">
        <field name="name">Upload Bulk Adjustment</field>
        <field name="model_id" ref="hr.model_hr_employee"/>
        <field name="binding_model_id" ref="hr.model_hr_employee"/>
        <field name="binding_view_types">list,form</field>
        <field name="state">code</field>
        <field name="code">
action = records.action_open_bulk_adjustment_wizard()
        </field>
    </record>

    <!-- 4. Server Action for Payrun / Payslips List View (Direct Download) -->
    <record id="action_payrun_bulk_adjustment_server" model="ir.actions.server">
        <field name="name">Download Baseline Template</field>
        <field name="model_id" ref="hr_payroll.model_hr_payslip_run"/>
        <field name="binding_model_id" ref="hr_payroll.model_hr_payslip_run"/>
        <field name="binding_view_types">form,list</field>
        <field name="state">code</field>
        <field name="code">
action = records.action_export_template()
        </field>
    </record>
</odoo>
