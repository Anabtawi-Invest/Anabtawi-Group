<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Header Button on Payrun Form View -->
    <record id="hr_payslip_run_form_inherit_bulk_adjustment" model="ir.ui.view">
        <field name="name">hr.payslip.run.form.inherit.bulk.adjustment</field>
        <field name="model">hr.payslip.run</field>
        <field name="inherit_id" ref="hr_payroll.hr_payslip_run_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form/*[1]" position="before">
                <header>
                    <button name="action_open_bulk_adjustment_wizard" 
                            string="Bulk Salary Adjustments" 
                            type="object" 
                            class="btn-primary" 
                            invisible="state not in ('draft', 'verify')"/>
                </header>
            </xpath>
        </field>
    </record>

    <!-- Server Action Binding for Action Menu (Gear Icon) -->
    <record id="action_payrun_bulk_adjustment_server" model="ir.actions.server">
        <field name="name">Bulk Salary Adjustments</field>
        <field name="model_id" ref="hr_payroll.model_hr_payslip_run"/>
        <field name="binding_model_id" ref="hr_payroll.model_hr_payslip_run"/>
        <field name="binding_view_types">form,list</field>
        <field name="state">code</field>
        <field name="code">
action = records.action_open_bulk_adjustment_wizard()
        </field>
    </record>
</odoo>
