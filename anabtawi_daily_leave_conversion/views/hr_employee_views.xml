<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_employee_form_daily_leave_counter" model="ir.ui.view">
        <field name="name">hr.employee.form.daily.leave.counter</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/notebook" position="inside">
                <page name="daily_leave_conversion" string="Daily Leave Conversion"
                      groups="hr_holidays.group_hr_holidays_user">
                    <group>
                        <field name="daily_leave_hours_counter"/>
                    </group>
                    <div class="text-muted">
                        Accumulated hours from the company Daily Time Off type.
                        Every 8 hours create 1 annual leave day and reduce this counter by 8.
                    </div>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
