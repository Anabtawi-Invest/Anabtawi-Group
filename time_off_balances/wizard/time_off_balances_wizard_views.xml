<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Wizard Form View (English Only) -->
    <record id="view_time_off_balances_wizard_form" model="ir.ui.view">
        <field name="name">time.off.balances.wizard.form</field>
        <field name="model">time.off.balances.wizard</field>
        <field name="arch" type="xml">
            <form string="TIME OFF BALANCES REPORT">
                <sheet>
                    <div class="oe_title">
                        <h2>TIME OFF BALANCES REPORT</h2>
                        <p class="text-muted">
                            Employee leave balance statement and chronological movement ledger.
                        </p>
                    </div>
                    <group>
                        <group string="Employee &amp; Leave Types">
                            <field name="employee_id" options="{'no_create': True, 'no_open': True}"/>
                            <field name="holiday_status_ids" widget="many2many_tags" options="{'no_create': True}"/>
                        </group>
                        <group string="Date Range">
                            <field name="date_from" placeholder="From beginning if left blank"/>
                            <field name="date_to" placeholder="Up to today if left blank"/>
                        </group>
                    </group>
                    <group>
                        <group string="Status Filter">
                            <field name="include_unposted" widget="radio"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button name="action_print_pdf" string="Print PDF" type="object" class="btn-primary" icon="fa-file-pdf-o"/>
                    <button name="action_export_excel" string="Export Excel" type="object" class="btn-success" icon="fa-file-excel-o"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Wizard Action Window -->
    <record id="action_time_off_balances_wizard" model="ir.actions.act_window">
        <field name="name">TIME OFF BALANCES REPORT</field>
        <field name="res_model">time.off.balances.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="view_id" ref="view_time_off_balances_wizard_form"/>
    </record>

    <!-- Menu Item under Time Off > Reporting -->
    <menuitem
        id="menu_time_off_balances_report"
        name="TIME OFF BALANCES REPORT"
        parent="hr_holidays.menu_hr_holidays_report"
        action="action_time_off_balances_wizard"
        sequence="15"/>

</odoo>
