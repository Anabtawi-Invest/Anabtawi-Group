<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_salary_attachment_view_tree_import" model="ir.ui.view">
        <field name="name">hr.salary.attachment.list.import</field>
        <field name="model">hr.salary.attachment</field>
        <field name="inherit_id" ref="hr_payroll.hr_salary_attachment_view_tree"/>
        <field name="arch" type="xml">
            <list position="inside">
                <header>
                    <button name="%(action_salary_adjustment_import_wizard)d" type="action"
                            string="Import from Excel" icon="fa-file-excel-o" class="btn-secondary"
                            display="always" groups="hr_payroll.group_hr_payroll_user"/>
                </header>
            </list>
        </field>
    </record>
</odoo>
