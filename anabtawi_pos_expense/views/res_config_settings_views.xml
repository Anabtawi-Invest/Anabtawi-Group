<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_pos_expense" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.pos.expense</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='set_maximum_difference']" position="after">
                <setting id="pos_expense_limit" string="Expense Limit"
                         help="Maximum total of POS expenses waiting for approval. Each expense reduces the balance until it is approved or refused. 0 hides the Expense button.">
                    <field name="pos_expense_limit"/>
                    <div class="text-muted mt-1">
                        Waiting approval: <field name="pos_expense_pending_amount" class="oe_inline"/>
                        - Available: <field name="pos_expense_available_amount" class="oe_inline"/>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
