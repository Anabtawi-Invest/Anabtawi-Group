<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_pos_expense_list" model="ir.ui.view">
        <field name="name">pos.expense.list</field>
        <field name="model">pos.expense</field>
        <field name="arch" type="xml">
            <list string="POS Expenses" create="false" delete="false"
                  decoration-info="state == 'to_approve'" decoration-danger="state == 'refused'"
                  decoration-muted="state in ('returned', 'resent')">
                <field name="name"/>
                <field name="original_expense_id" optional="hide"/>
                <field name="date"/>
                <field name="config_id"/>
                <field name="session_id" optional="show"/>
                <field name="cashier_name"/>
                <field name="type_id"/>
                <field name="amount" sum="Total"/>
                <field name="resubmit_count" optional="hide"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'to_approve'"
                       decoration-success="state == 'approved'"
                       decoration-danger="state == 'refused'"
                       decoration-warning="state == 'resent'"
                       decoration-muted="state == 'returned'"/>
            </list>
        </field>
    </record>

    <record id="view_pos_expense_form" model="ir.ui.view">
        <field name="name">pos.expense.form</field>
        <field name="model">pos.expense</field>
        <field name="arch" type="xml">
            <form string="POS Expense" create="false" delete="false">
                <header>
                    <button name="action_approve" type="object" string="Approve" class="btn-primary"
                            invisible="state != 'to_approve'" groups="point_of_sale.group_pos_manager"/>
                    <button name="action_refuse" type="object" string="Refuse"
                            invisible="state != 'to_approve'" groups="point_of_sale.group_pos_manager"
                            confirm="The amount stays reserved in the expense balance until the cashier returns it (Cash In) or edits and resends the expense from the POS. Continue?"/>
                    <field name="state" widget="statusbar" statusbar_visible="to_approve,approved,refused,returned"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_journal_entries" type="object" class="oe_stat_button" icon="fa-book"
                                invisible="not chain_move_count">
                            <field name="chain_move_count" widget="statinfo" string="Journal Entries"/>
                        </button>
                        <button name="action_open_original_expense" type="object" class="oe_stat_button" icon="fa-history"
                                invisible="not original_expense_id">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Original Expense</span>
                                <span class="o_stat_value"><field name="original_expense_id" readonly="1" options="{'no_open': True}"/></span>
                            </div>
                        </button>
                        <button name="action_open_resent_expenses" type="object" class="oe_stat_button" icon="fa-repeat"
                                invisible="not resent_expense_count">
                            <field name="resent_expense_count" widget="statinfo" string="Resent As"/>
                        </button>
                    </div>
                    <div class="alert alert-warning" role="alert" invisible="state != 'refused'">
                        This expense was refused. The cashier can return the amount or edit and resend it
                        from the POS (Actions → Refused Expenses). Until then it stays in the expense balance.
                    </div>
                    <div class="alert alert-info" role="alert" invisible="state != 'resent'">
                        This expense was refused and resent from the POS as a new expense (see Resent As).
                    </div>
                    <field name="image" widget="image" class="oe_avatar" options="{'size': [180, 180]}"/>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="type_id"/>
                            <field name="amount"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="date"/>
                        </group>
                        <group>
                            <field name="config_id"/>
                            <field name="session_id"/>
                            <field name="cashier_name"/>
                            <field name="user_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group invisible="state == 'to_approve'">
                            <field name="decided_by_id"/>
                            <field name="decision_date"/>
                        </group>
                        <group>
                            <field name="refuse_reason" readonly="state != 'to_approve'"
                                   placeholder="Required to refuse"/>
                            <field name="resubmit_count" invisible="not resubmit_count"/>
                            <field name="adjustment_statement_line_ids" widget="many2many_tags"
                                   invisible="not adjustment_statement_line_ids"/>
                        </group>
                        <group string="Return" invisible="state != 'returned'">
                            <field name="return_session_id"/>
                            <field name="return_cashier_name"/>
                            <field name="return_date"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_pos_expense_search" model="ir.ui.view">
        <field name="name">pos.expense.search</field>
        <field name="model">pos.expense</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="config_id"/>
                <field name="session_id"/>
                <field name="type_id"/>
                <field name="cashier_name"/>
                <filter name="to_approve" string="To Approve" domain="[('state', '=', 'to_approve')]"/>
                <filter name="approved" string="Approved" domain="[('state', '=', 'approved')]"/>
                <filter name="refused" string="Refused (not returned)" domain="[('state', '=', 'refused')]"/>
                <filter name="resent" string="Resent" domain="[('state', '=', 'resent')]"/>
                <filter name="returned" string="Returned" domain="[('state', '=', 'returned')]"/>
                <separator/>
                <filter name="date" string="Date" date="date"/>
                <group>
                    <filter name="group_config" string="Point of Sale" context="{'group_by': 'config_id'}"/>
                    <filter name="group_type" string="Expense Type" context="{'group_by': 'type_id'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_date" string="Date" context="{'group_by': 'date'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_pos_expense" model="ir.actions.act_window">
        <field name="name">POS Expenses</field>
        <field name="res_model">pos.expense</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_to_approve': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_empty_folder">
                No POS expenses yet
            </p><p>
                Expenses are created by cashiers from the Expense button in the POS.
            </p>
        </field>
    </record>

    <menuitem id="menu_pos_expense"
              parent="point_of_sale.menu_point_of_sale"
              action="action_pos_expense"
              groups="point_of_sale.group_pos_manager"
              sequence="50"/>

</odoo>
