<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_pos_expense_type_list" model="ir.ui.view">
        <field name="name">pos.expense.type.list</field>
        <field name="model">pos.expense.type</field>
        <field name="arch" type="xml">
            <list string="Expense Types" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="pos_config_ids" widget="many2many_tags" placeholder="All"/>
                <field name="company_id" groups="base.group_multi_company" placeholder="All"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="view_pos_expense_type_search" model="ir.ui.view">
        <field name="name">pos.expense.type.search</field>
        <field name="model">pos.expense.type</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="pos_config_ids"/>
                <filter name="inactive" string="Archived" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_pos_expense_type" model="ir.actions.act_window">
        <field name="name">Expense Types</field>
        <field name="res_model">pos.expense.type</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create an expense type
            </p><p>
                Expense types are selected by the cashier in the POS Expense popup.
            </p>
        </field>
    </record>

    <menuitem id="menu_pos_expense_type"
              parent="point_of_sale.menu_point_config_product"
              action="action_pos_expense_type"
              groups="point_of_sale.group_pos_manager"
              sequence="12"/>

</odoo>
