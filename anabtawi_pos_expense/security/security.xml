<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pos_expense_company_rule" model="ir.rule">
        <field name="name">POS Expense: multi-company</field>
        <field name="model_id" ref="model_pos_expense"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="pos_expense_type_company_rule" model="ir.rule">
        <field name="name">POS Expense Type: multi-company</field>
        <field name="model_id" ref="model_pos_expense_type"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
</odoo>
