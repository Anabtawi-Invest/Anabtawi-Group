<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- List view -->
    <record id="view_pos_order_line_cost_list" model="ir.ui.view">
        <field name="name">pos.order.line.cost.list</field>
        <field name="model">pos.order.line</field>
        <field name="arch" type="xml">
            <list string="POS Cost &amp; Margin Report" create="false" edit="false" delete="false">
                <field name="order_id"/>
                <field name="product_id"/>
                <field name="qty" sum="Qty"/>
                <field name="price_subtotal" sum="Sales (Untaxed)"/>
                <field name="cost_price" sum="Cost"/>
                <field name="margin" sum="Margin"/>
                <field name="margin_percent" avg="Margin %"/>
            </list>
        </field>
    </record>

    <!-- Pivot view -->
    <record id="view_pos_order_line_cost_pivot" model="ir.ui.view">
        <field name="name">pos.order.line.cost.pivot</field>
        <field name="model">pos.order.line</field>
        <field name="arch" type="xml">
            <pivot string="POS Cost &amp; Margin Report">
                <field name="product_id" type="row"/>
                <field name="qty" type="measure"/>
                <field name="price_subtotal" type="measure"/>
                <field name="cost_price" type="measure"/>
                <field name="margin" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- Graph view -->
    <record id="view_pos_order_line_cost_graph" model="ir.ui.view">
        <field name="name">pos.order.line.cost.graph</field>
        <field name="model">pos.order.line</field>
        <field name="arch" type="xml">
            <graph string="POS Cost &amp; Margin Report" type="bar">
                <field name="product_id" type="row"/>
                <field name="margin" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- Search view -->
    <record id="view_pos_order_line_cost_search" model="ir.ui.view">
        <field name="name">pos.order.line.cost.search</field>
        <field name="model">pos.order.line</field>
        <field name="arch" type="xml">
            <search string="POS Cost &amp; Margin Report">
                <field name="product_id"/>
                <field name="order_id"/>
                <filter string="Group by Product" name="group_product" context="{'group_by': 'product_id'}"/>
                <filter string="Group by Order" name="group_order" context="{'group_by': 'order_id'}"/>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_pos_order_line_cost_report" model="ir.actions.act_window">
        <field name="name">POS Cost &amp; Margin Report</field>
        <field name="res_model">pos.order.line</field>
        <field name="view_mode">list,pivot,graph</field>
        <field name="search_view_id" ref="view_pos_order_line_cost_search"/>
        <field name="domain">[('order_id.state', 'in', ['paid', 'done', 'invoiced'])]</field>
        <field name="context">{'search_default_group_product': 1}</field>
    </record>

    <!-- Menu: standalone top-level entry, safe to install regardless of the
         exact internal menu IDs of the point_of_sale module in this Odoo build.
         Feel free to drag it under Point of Sale > Reporting from Settings >
         Technical > Menu Items if you prefer it nested there. -->
    <menuitem id="menu_pos_order_line_cost_report_root"
              name="POS Cost &amp; Margin Report"
              sequence="80"/>

    <menuitem id="menu_pos_order_line_cost_report"
              name="POS Cost &amp; Margin Report"
              parent="menu_pos_order_line_cost_report_root"
              action="action_pos_order_line_cost_report"
              sequence="10"/>

</odoo>
