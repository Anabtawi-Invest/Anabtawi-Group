<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pos_config_view_form_close_ip_restrict" model="ir.ui.view">
        <field name="name">pos.config.form.close.ip.restrict</field>
        <field name="model">pos.config</field>
        <field name="inherit_id" ref="point_of_sale.pos_config_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='other_devices']" position="after">
                <setting
                    id="close_allowed_devices"
                    string="Allowed Close Devices"
                    help="Register the shop POS computer or tablet. A cashier phone is a different device even on the same WiFi. Leave empty to skip this check.">
                    <field name="close_allowed_device_ids" nolabel="1">
                        <list editable="bottom">
                            <field name="name"/>
                            <field name="device_token" column_invisible="1"/>
                        </list>
                    </field>
                    <div class="text-muted mt-1">
                        Open this POS as a manager and choose "Allow this device to close".
                    </div>
                </setting>
                <setting
                    id="close_allowed_ips"
                    string="Allowed Close IPs"
                    help="Optional. On Odoo.sh this is the public internet IP, not the local PC IP. Devices on the same WiFi share it, so it will not block a cashier phone in the shop.">
                    <div class="content-group">
                        <div class="row mb-2">
                            <div class="col-lg-4 o_light_label">
                                <label for="current_client_ip" string="Your Current IP"/>
                            </div>
                            <div class="col-lg-8">
                                <field name="current_client_ip" readonly="1" class="oe_inline"/>
                            </div>
                        </div>
                        <field
                            name="close_allowed_ips"
                            placeholder="176.29.250.80"
                            nolabel="1"/>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
