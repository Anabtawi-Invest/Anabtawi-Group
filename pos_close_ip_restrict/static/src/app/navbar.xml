<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-inherit="point_of_sale.Navbar" t-inherit-mode="extension" owl="1">
        <xpath expr="//div[hasclass('pos-burger-menu-items')]/DropdownItem[last()]" position="before">
            <DropdownItem t-if="canRegisterCloseDevice" onSelected="() => this.registerCloseDevice()">
                Allow this device to close
            </DropdownItem>
        </xpath>
    </t>
</templates>
